// ============================================================
// GLOBAL CONTROLS
// ============================================================
const cc = await midin()

const bpm = 140
setcpm(bpm / 4)

const globalHpf   = cc(20).range(0, 1000)
const globalLpf   = cc(28).range(0, 1000)

const globalDensity  = cc(36).range(0, 1)
const globalLevel = cc(12).range(0, 1)

// Melody
scale("B:minor")

register('acidenv', (x, pat) => pat
  // .lpf(100)       // Basisfrequenz des Filters
  .lpenv(x * 9)   // Filterhüllkurve (Envelope) basierend auf Eingabe x
  .lps(0.2)       // Sustain (Haltezeit)
  .lpd(0.12)      // Decay (Abklingzeit)
  .lpq(2)         // Q-Faktor (Resonanz) für spitze Filterkurven
)


// ============================================================
// STEMS Theb Beginning; Part 1: MAIN KICK
// ============================================================
const kickHpf   = cc(13).range(0, 0)
const kickLpf   = cc(21).range(10, 50)
const kickRoom  = cc(29).range(0, 0.15)
const kickLevel = cc(5).range(0, 4)

const stem1_kick = s("[bd bd bd bd]").bank("RolandTR909")
  .hpf(globalHpf.add(kickHpf))
  .lpf(kickLpf)
  .room(kickRoom)
  .attack(0.00)
  .dec(0.3)
  .sustain(0.15)
  .release(0.12)
  .gain(kickLevel.mul(globalLevel))


  // STEM 2: SUB-BASS
  const subHpf   = cc(16).range(50, 500)
  const subLpf   = cc(22).range(30, 500)
  const subDensity  = cc(30).range(0, 1.3)
  const subLevel = cc(6).range(0, 2.0)

  const stem2_sub = stack(
    note("c2*4")
    .s("sawtooth")
    .hpf(globalHpf.add(subHpf))
    .lpf(subLpf)
    .decay(0.112)
    .sustain(0.05)
    .gain(subLevel.mul(globalLevel)),

    note("c2*8")
    .s("sawtooth")
    .hpf(globalHpf.add(subHpf))
    .lpf(subLpf)
    .decay(0.112)
    .sustain(0.05)
    .gain(globalDensity.mul(subDensity).mul(sine.range(0, 3).slow(0.125))),

    note("c1*4")
    .s("sine")
    .hpf(globalHpf.add(subHpf))
    .lpf(subLpf)
    .decay(0.15)
    .sustain(0.1)
    .gain(subLevel.mul(globalLevel))
  )
  .room(0.2)
  .roomsize(0.8) // Großer Raum lässt den Sub massiv wummern

  // STEM 3: BASS
  const bassHpf   = cc(15).range(0, 500)
  const bassLpf   = cc(23).range(100, 800)

  const bassLevel = cc(7).range(0, 2)

  const stem3_bass = note("<[c2 ~ c2 c2] [eb2 c2 ~ eb2]>*2")
    .s("sawtooth")
    .hpf(globalHpf.add(bassHpf))
    .lpf(bassLpf)
    .lpq(5.5)
    .decay(0.15)
    .sustain(0)
    .room(0.2)
    .gain(bassLevel.mul(globalLevel))

// STEM 4: HATS
const hatsHpf   = cc(16).range(1000, 12000)
const hatsLpf   = cc(24).range(2000, 2000)
const hatsDensity  = cc(32).range(0, 1)
const hatsLevel = cc(8).range(0, 1)

const stem4_hats = stack(
  // open hats
  s("[~ oh ~ oh] * 2").bank("RolandTR909")
  .dec(1.0)
  .hpf(hatsHpf)
  .lpf(hatsLpf)
  .room(0.2)
  .gain(hatsLevel.mul(globalLevel)),

  // groovey hats
  s("hh * 16").bank("RolandTR909")
  .dec(1.0)
  .hpf(hatsHpf)
  .lpf(hatsLpf)
  .gain(hatsDensity.mul(globalDensity).mul(sine.range(0.25, 1))),
)

// STEM 5: CLAP

const clapHpf     = cc(17).range(500, 2500)
const clapLpf     = cc(25).range(1500, 12000)
const clapDensity = cc(33).range(0, 2)
const clapRoom    = cc(41).range(0, 0.5)
const clapLevel   = cc(9).range(0, 2.5)

// Main clap — classic 909 backbeat
const clapMain = s("~ cp ~ cp")
  .bank("RolandTR909")
  .hpf(clapHpf)
  .lpf(clapLpf)
  .attack(0.001)
  .dec(0.12)
  .sustain(0)
  .release(0.06)
  .room(clapRoom)
  .roomsize(0.55)
  .gain(clapLevel.mul(globalLevel))

// Quiet offbeat ghosts — add movement without clutter
const clapGhosts = s("~ ~ cp ~")
  .bank("RolandTR909")
  .hpf(clapHpf)
  .lpf(clapLpf)
  .dec(0.08)
  .room(clapRoom.mul(0.6))
  .gain(clapLevel.mul(clapDensity).mul(globalDensity).mul(0.22))

// Sparse double taps — controlled rhythmic variation
const clapFills = s("~ [~ cp] ~ ~")
  .bank("RolandTR909")
  .hpf(clapHpf)
  .lpf(clapLpf)
  .dec(0.06)
  .room(clapRoom)
  .gain(clapLevel.mul(clapDensity).mul(globalDensity).mul(0.12))

const stem5_clap = stack(
  clapMain,
  clapGhosts,
  clapFills
)

// STEM 6: STAB CHORDS
const stabHpf   = cc(18).range(0, 2000)
const stabDecay = cc(26).range(0.1, 0.2)
const stabLpf   = 800
const stabRoom  = 0.25
const stabSlow  = cc(34).range(1, 1)
const stabLevel = cc(10).range(0, 2)

const stem6_stab = chord("<Cm7 ~ Cm7 ~> <Fm7 ~ Cm7 ~> <Ab^7 ~ Fm7 ~> <Cm7 ~ Bb ~>")
  .voicing()
  .s("sawtooth")
  .hpf(sine.range(stabHpf.mul(0.1), stabHpf).slow(stabSlow))
  .lpf(stabLpf)
  .lpq(4)
  .decay(0.18)
  .sustain(0)
  .room(globalDensity.mul(stabRoom))
  .roomsize(0.65)
  .delay(0.25).delaytime(0.375).delayfeedback(0.3)
  .gain(stabLevel.mul(globalLevel))


// STEM 7: ACID PULSE
const acidHpf   = cc(19).range(50, 2000)
const acidLpf   = cc(27).range(300, 12000)
const acidRoom  = cc(35).range(0, 1)
const acidLevel = cc(11).range(0, 1)

const stem7_acid = note("<[~ c4 ~ c4] [~ eb4 ~ d4] [~ c4 ~ bb3] [~ f4 ~ g4]>")
  .s("sawtooth")
  .hpf(acidHpf)
  .lpf(saw.range(100, acidLpf).slow(8))
  .lpq(7)
  .decay(0.12)
  .room(acidRoom)
  .delay(0.3).delaytime(0.25).delayfeedback(0.4)
  .gain(acidLevel.mul(globalLevel))


// PILLOW BONGOS
const bongoHpf     = cc(18).range(80, 500)
const bongoLpf     = cc(26).range(700, 5000)
const bongoDensity = cc(34).range(0, 1)
const bongoLevel   = cc(10).range(0, 0.8)

// Soft wooden low drum: rounded, warm, gentle
const bongoLow = note("c4 ~ ~ c4 ~ g4 ~ ~")
  .s("sine")
  .decay(0.085)
  .sustain(0)
  .release(0.035)
  .gain(bongoLevel.mul(globalLevel).mul(0.65))

// Higher, hollow hand taps
const bongoHigh = note("~ g5 ~ c5 ~ ~ g5 ~")
  .s("sine")
  .decay(0.045)
  .sustain(0)
  .release(0.025)
  .gain(bongoLevel.mul(globalLevel).mul(0.85))

// Soft fingertip ghost notes
const bongoGhosts = note("~ ~ eb5 ~ ~ g5 ~ c5")
  .s("sine")
  .decay(0.035)
  .sustain(0)
  .release(0.02)
  .gain(bongoLevel.mul(bongoDensity.mul(globalLevel)))

// Tiny, playful bouncy rolls
const bongoRoll = note("~ c6 ~ g5 c6 ~ eb5 ~")
  .s("sine")
  .decay(0.025)
  .sustain(0)
  .release(0.015)
  .gain(globalLevel.mul(bongoDensity.range(0.0, 1.5)))

// Extra delicate taps for maximum density
const bongoFingers = note("c5 ~ ~ eb5 ~ c5 g5 ~")
  .s("sine")
  .decay(0.025)
  .sustain(0)
  .release(0.015)
  .gain(globalLevel.mul(bongoDensity.range(0.0, 1.36)))

const stem6_bongos = stack(
  bongoLow,
  bongoHigh,
  bongoGhosts,
  bongoRoll,
  bongoFingers
)
  .hpf(globalHpf.add(bongoHpf))
  .lpf(bongoLpf)
  .room(0.18)
  .roomsize(0.45)


// LIQUID ACID SPACE
const spaceHpf      = cc(19).range(80, 1200)
const spaceLpf    = cc(27).range(0, 0.7)
const spaceFeedback = cc(35).range(0.23115, 1.1426)
const spaceLevel    = cc(11).range(0, 0.7)
const stem7_space = stack(
  note("<c4 ~ eb4 g4 ~ bb4 ~ g4 ~ eb4>")
    .s("sawtooth")
    .hpf(globalHpf.add(spaceHpf))
    .lpf(sine.range(500, 7000).slow(8))
    .lpq(12)
    .decay(0.3)
    .sustain(0.12)
    .release(0.4)
    .delay(0.7)
    .delaytime(0.375)
    .delayfeedback(spaceFeedback)
    .gain(0.55),

  // Sparse, high liquid droplets
  note("~ c6 ~ ~ ~ g5 ~ ~ eb6 ~ ~ ~")
    .s("sine")
    .hpf(globalHpf.add(spaceHpf))
    .lpf(7000)
    .decay(0.12)
    .sustain(0)
    .delay(0.8)
    .delaytime(0.5)
    .delayfeedback(spaceFeedback)
    .gain(0.2)

)
  .room(0.4)
  .roomsize(0.9)
  .gain(spaceLevel.mul(globalLevel))

// ============================================================
// MELODIES
// Every melody uses the same controls, numbered from melody 1:
// hpf cc(52+N), lpf cc(60+N), density cc(68+N), level cc(104+N)
// ============================================================
const melodyMainLpf = 100
const baselineLpfMax = 800
const ramp = (sig, from, to) => sig.fmap(v => Math.min(1, Math.max(0, (v - from) / (to - from))))

// Random wobble, driven by a melody's hpf knob (cc 52+N, 0..1); it also drives that melody's bassline.
// 0      dry
// ~0.5   organic: audible slow detune drift and vibrato shared by all layers, breathing envelopes
// 1      extravagant: per-note pitch scatter, octave jumps, dropouts and strongly varying envelopes
const wobble = (pat, knob) => {
  const organic = ramp(knob, 0, 0.5)
  const extra   = ramp(knob, 0.5, 1)
  const drift   = perlin.slow(2).range(-1, 1)    // same signals in every layer, so layers stay in tune with each other
  const vibrato = sine.slow(4).range(-1, 1)
  const jump    = rand.lt(extra.mul(0.15)).fmap(b => b ? 12 : 0)
  const drop    = rand.gt(extra.mul(0.25)).fmap(b => b ? 1 : 0)
  const level   = rand.mul(organic.mul(-0.3)).add(1)
  // Envelope: per-note random attack, decay and sustain, each widening from organic to extravagant
  const atkAmt  = organic.mul(0.06).add(extra.mul(0.25))
  const decAmt  = organic.mul(0.2).add(extra.mul(0.5))
  const susAmt  = organic.mul(0.2).add(extra.mul(0.5))
  // Pitch in cents via detune (control arithmetic on note values is not allowed, so no .add here)
  const cents   = drift.mul(organic.mul(55)).add(vibrato.mul(organic.mul(20)))  // up to ~55 cents drift + ~20 cents vibrato
    .add(rand.range(-1, 1).mul(organic.mul(15).add(extra.mul(150))))             // per-note scatter: ±15 cents organic, up to ±150 extravagant
  return pat
    .detune(cents)
    // TODO: This feature doesnt work so well
    // .trans(jump)                                 // occasional octave jumps
    // .velocity(drop.mul(level))                   // dropouts and level variation
    // .attack(rand.mul(atkAmt))                    // up to 60 ms organic, up to 0.25 s extravagant
    // .decay(rand.mul(decAmt).add(0.05))
    // .sustain(rand.mul(susAmt).mul(-1).add(1))    // sustain drops from 1 by up to susAmt
    // .release(rand.mul(extra.mul(0.3)).add(0.05))
}

// Overtones = harmonic partials above the fundamental, in three entry groups.
// Each partial n gets amplitude 1/n; its window is set by the melody's density.
const melody = (notes, density, level, knob) => {
  const dens = globalDensity.mul(density)
  const overtone = (semis, n, from, to) => wobble(note(notes)
    .sound("sawtooth")
    .trans(semis)
    .lpf(globalLpf.add(melodyMainLpf))
    .gain(ramp(dens, from, to).mul(1 / n))
    .acidenv(0.3), knob)

  return stack(
    wobble(note(notes).sound("sawtooth").lpf(globalLpf.add(melodyMainLpf)).acidenv(0.3).gain(globalLevel.mul(level)), knob),
    // Group 1: 2nd and 3rd partial
    overtone(12, 2, 0.0, 0.3),   // octave (2nd partial)
    overtone(19, 3, 0.0, 0.3),   // octave + fifth (3rd partial)
    // Group 2: 4th and 5th partial
    overtone(24, 4, 0.3, 0.6),   // two octaves (4th partial)
    overtone(28, 5, 0.3, 0.6),   // two octaves + major third (5th partial)
    // Group 3: 6th partial
    overtone(31, 6, 0.6, 0.9)    // two octaves + fifth (6th partial)
  )
}

// Baseline: fades in with its lpf knob, from 0 up to baselineLpfMax
const baseline = (notes, lpf, knob) => wobble(note(notes)
  .sound("sawtooth")
  .lpf(lpf)
  .acidenv(0.3)
  .gain(globalLevel.mul(0.5)), knob)

// MELODY 1
const melody1Hpf    = cc(53).range(0, 1)
const melody1Density = cc(69).range(0, 1)
const melody1Level    = cc(105).range(0, 1)
const stem_melody1 = melody("[e2 e3 f2 f3 g2 g3 a2 a3]", melody1Density, melody1Level, melody1Hpf)
const baseline1Lpf = cc(61).range(0, baselineLpfMax)
// Octave-jumping eighths on E / F / G / A, following the melody's cycle
const stem_baseline1 = baseline("<[e1 e2 e1 e2 f1 f2 e1 g2] [a1 a2 a1 a2 g1 g2 a1 e2]>", baseline1Lpf, melody1Hpf)

// MELODY 2
const melody2Hpf     = cc(54).range(0, 1)
const melody2Density = cc(70).range(0, 1)
const melody2Level   = cc(106).range(0, 1)
const stem_melody2 = melody("[d3 e3 c3 f3 b2 g3 a2 a3]", melody2Density, melody2Level, melody2Hpf)
const baseline2Lpf = cc(62).range(0, baselineLpfMax)
// Root D with octave pops and passing tones from the melody (C, F, G, A)
const stem_baseline2 = baseline("<[d1 d2 d1 d2 c2 d2 a1 d2] [d1 d2 f1 d2 g1 d2 a1 d2]>", baseline2Lpf, melody2Hpf).decay(sine.range(0.4,0.6))

// MELODY 3
const melody3Hpf     = cc(55).range(0, 1)
const melody3Density = cc(71).range(0, 1)
const melody3Level   = cc(107).range(0, 1)
const stem_melody3 = melody("[a2 e3 c3 f3 b2 d3 g2 e3 a2 c3 f2 d3 g2 b2 e2 c3]*.5", melody3Density, melody3Level, melody3Hpf)
// Energetic: driving octave-jumping eighths
const baseline3Lpf = cc(63).range(0, baselineLpfMax)
const stem_baseline3 = baseline("<[a1 a1 a2 a1] [g1 g1 g2 g1]>*2", baseline3Lpf, melody3Hpf)

// MELODY 4
const melody4Hpf     = cc(56).range(0, 1)
const melody4Density = cc(72).range(0, 1)
const melody4Level   = cc(108).range(0, 1)
const stem_melody4 = melody("[c#3 f#3 a3 g3 c#3 f#3 a3 g3 c#3 f#3 g3 e3 c#3 f#3 g3 e3]*.5", melody4Density, melody4Level, melody4Hpf)
// Chord tones of the melody (F#, C#, A, G, E), 8 steps to match the melody's cycle
const baseline4Lpf = cc(64).range(0, baselineLpfMax)
const stem_baseline4 = baseline("<[f#1 f#2 ~ c#2 a1 ~ f#2 c#2] [f#1 f#2 ~ g1 e1 ~ c#2 f#2]>", baseline4Lpf, melody4Hpf)

// MELODY 5
const melody5Hpf     = cc(57).range(0, 1)
const melody5Density = cc(73).range(0, 1)
const melody5Level   = cc(109).range(0, 1)
const stem_melody5 = melody("[db3 f3 b3 e3]!2", melody5Density, melody5Level, melody5Hpf)
const baseline5Lpf = cc(65).range(0, baselineLpfMax)
// Melody's B / E / F / Db, with a turnaround on the second half of the cycle
const stem_baseline5 = baseline("<[b1 b2 e1 b2 b1 b2 f1 db2] [b1 b2 e1 b2 db2 b2 f1 b2]>", baseline5Lpf, melody5Hpf)

// MELODY 6
const melody6Hpf     = cc(58).range(0, 1)
const melody6Density = cc(74).range(0, 1)
const melody6Level   = cc(110).range(0, 1)
const stem_melody6 = melody("[c#3 f3 <a3 g3> e3]!2", melody6Density, melody6Level, melody6Hpf)
// Energetic: pulsing octave c# / f eighths (f natural, as in the melody), with a g passing tone
const baseline6Lpf = cc(66).range(0, baselineLpfMax)
const stem_baseline6 = baseline("<[c#1 c#2 c#1 c#2] [f1 f2 g1 f2]>*2", baseline6Lpf, melody6Hpf)

// MELODY 7
const melody7Hpf     = cc(59).range(0, 1)
const melody7Density = cc(75).range(0, 1)
const melody7Level   = cc(111).range(0, 1)
const stem_melody7 = melody("[db3 eb3 b3 f3]!", melody7Density, melody7Level, melody7Hpf)
const baseline7Lpf = cc(67).range(0, baselineLpfMax)
// Melody's Db / Eb / B / F (the old gb was not in the melody)
const stem_baseline7 = baseline("<[b1 ~ db2 b2 eb2 ~ f1 b2] [f1 ~ eb2 b1 db2 ~ b1 ~]>", baseline7Lpf, melody7Hpf)


// ============================================================
// MASTER AUDIO MATRIX
// ============================================================
stack(
  stem1_kick,
  stem2_sub,
  stem3_bass,
  stem4_hats,
  stem5_clap,
  stem6_bongos,
  stem7_space,
  stem_melody1,
  stem_melody2,
  stem_melody3,
  stem_melody4,
  stem_melody5,
  stem_melody6,
  stem_melody7,
  stem_baseline1,
  stem_baseline2,
  stem_baseline5,
  stem_baseline3,
  stem_baseline4,
  stem_baseline6,
  stem_baseline7
)
