// ============================================================
// TRACK 011 — the set: 007 ambient → 010 ambient house → 009 cool house → 008 groove techno, one continuous journey
// GENERATED by tools/set/make-set.mjs from the four dual tracks and tools/set/set-frame.strudel — edit those, not this.
// ============================================================
// Jonas' column 8 button 2 switches what the Fog knob does: Fog (as in every track) ↔ the set position.
// The set position runs from 0 to 1 over all four tracks: each track has a plateau (only it plays), and between two
// plateaus a slow transformation: column by column the old track's sound turns into the new one's. Events are paired
// (the nearest hit of the same sound, chord notes by pitch) and move: onset, pitch, decay, filter glide from one
// track to the other (a transport, not a crossfade). What has no partner thins out (short hits) or fades (long
// sounds). Air and pad move first, then the low end, the drums, and the melodies last.
// Tempo: 007 is written at 70 BPM but runs here on a 140 grid at half speed (sounds the same), so the way to 010 is a
// small slow-down (felt 70 → 60) plus the doubling into 120; then 120 → 122 → 140.
// 008 is moved from F to A (+4 semitones), so 009 (A minor) and 008 share their root.
// Each track keeps its own sounds, patterns and chapters; faders and knobs keep their meaning (same column = same role).
// In the set: chapters change at the next 8-bar phrase (007 and 008: 4 bars), Tension reaches 75 % of its range,
// and there is no Break / Drop (Jojo's kick button 2 still drops the kick out).
// @layout Track 011 — the set: 007 → 010 → 009 → 008 (two controllers)
// @note One continuous set through four tracks: 007 ambient (70 BPM) → 010 ambient house (120) → 009 cool house (122) → 008 groove techno (140, here in A). Every column keeps its role; the sounds behind it change with the track.
// @note Jonas’ column 8 button 2 switches the Fog knob between Fog and the set position. In set mode, turning it moves through the set: each track has a plateau, between two plateaus a slow transformation: column by column the old sound turns into the new one (hits move to their new place, pitch, decay and filters glide; what has no partner thins out or fades). Air and pad first, then the low end, drums, melodies last. Leave it anywhere: a halfway position is its own sound.
// @note Chapter, the buttons and the LC view belong to the track in focus (the nearer one in a transition). Chapters change at the next 8-bar phrase (007, 008: 4 bars). No Break / Drop in the set.
// @note The status box at the bottom right of the Strudel page shows the set position, chapter and each stem's pattern. Its button “als Fenster” opens it as a small window that stays on top (Chrome/Edge).
// @mode B16 Jojo — Foundation (beat + bass)
// @col B16:1 1 Pulse / Kick
// @col B16:2 2 Rumble / Noise
// @col B16:3 3 Sub
// @col B16:4 4 Bassline
// @col B16:5 5 Backbeat
// @col B16:6 6 Hats
// @col B16:7 7 Percussion
// @col B16:8 8 Shaker / Ride
// @row B16:k1 Row 1 \ Brightness
// @row B16:k2 Row 2 \ Space
// @row B16:k3 Row 3 \ Character
// @row B16:fader Fader \ Level
// @row B16:b1 Button 1 \ Change
// @row B16:b2 Button 2 \ Moment
// @mode 16 Jonas — Colour (chords + melodies) · column 8 = global + set
// @col 16:1 1 Pad
// @col 16:2 2 Chords
// @col 16:3 3 Arp
// @col 16:4 4 Lead
// @col 16:5 5 Answer
// @col 16:6 6 Sparkle
// @col 16:7 7 FX / Risers
// @col 16:8 8 Global + Set
// @row 16:k1 Row 1 \ Brightness
// @row 16:k2 Row 2 \ Space
// @row 16:k3 Row 3 \ Character
// @row 16:fader Fader \ Level
// @row 16:b1 Button 1 \ Change
// @row 16:b2 Button 2 \ Moment
// @ctl B16:1.k1 Brightness | dull thump ↔ clicky attack. Never fully closed.
// @ctl B16:1.k2 Space | dry and close ↔ far away in a big room (reverb + echo).
// @ctl B16:1.k3 Softness | 0 = soft and round (the default) ↔ a deep, soft thump. Punch comes from row 1 (click). 007: Drive · 009/008: Punch.
// @ctl B16:1.fader Level | 007 Pulse · 010 Kick · 009 Kick · 008 Kick.
// @ctl B16:1.b1 Change | next of at most 3 patterns, at the next bar.
// @ctl B16:1.b2 Drop out / Drop | kick pauses while held.
// @ctl B16:2.k1 Brightness | deep rumble ↔ airy hiss.
// @ctl B16:2.k2 Space | dry ↔ far away.
// @ctl B16:2.k3 Sea ↔ Wind / Motion | still ↔ rolling waves / sweeps.
// @ctl B16:2.fader Level | 007 Sea / Wind · 010 Atmo Pump · 009 Noise Pump · 008 Rumble.
// @ctl B16:2.b1 Change | next of at most 3 patterns.
// @ctl B16:2.b2 Riser | noise rises while held.
// @ctl B16:3.k1 Brightness | pure sine ↔ a little buzz on top.
// @ctl B16:3.k2 Space | dry ↔ far away.
// @ctl B16:3.k3 Beating / Length | long held tones ↔ short blips.
// @ctl B16:3.fader Level | 007 Drone · 010 Sub · 009 Sub · 008 Sub.
// @ctl B16:3.b1 Change | next of at most 3 patterns.
// @ctl B16:3.b2 Slide | notes glide into each other while held.
// @ctl B16:4.k1 Brightness | round and dark ↔ buzzing, squelchy.
// @ctl B16:4.k2 Space | dry ↔ far away.
// @ctl B16:4.k3 Groove / Sound | few notes ↔ busy, bouncing line.
// @ctl B16:4.fader Level | 007 Bass · 010 Bassline · 009 Bass · 008 Bassline.
// @ctl B16:4.b1 Change | next of at most 3 patterns.
// @ctl B16:4.b2 Octave | one octave up while held.
// @ctl B16:5.k1 Brightness | soft and far ↔ sharp crack.
// @ctl B16:5.k2 Space | dry ↔ far away.
// @ctl B16:5.k3 Ghost notes | 0 = plain backbeat ↔ extra quiet hits in between.
// @ctl B16:5.fader Level | 007 Rim · 010 Clap / Rim · 009 Clap · 008 Clap.
// @ctl B16:5.b1 Change | next of at most 3 patterns.
// @ctl B16:5.b2 Roll / Swell | snare roll while held.
// @ctl B16:6.k1 Brightness | soft hiss ↔ crisp and sharp.
// @ctl B16:6.k2 Space | dry ↔ far away.
// @ctl B16:6.k3 Density | the pattern as it is ↔ + quiet 16ths ↔ + little rolls. 009: Hats ↔ Shaker.
// @ctl B16:6.fader Level | 007 Ticks · 010 Hats · 009 Hats / Shaker · 008 Hats.
// @ctl B16:6.b1 Change | next of at most 3 patterns.
// @ctl B16:6.b2 Open | hats ring long while held.
// @ctl B16:7.k1 Brightness | woody ↔ metallic.
// @ctl B16:7.k2 Space | dry ↔ far away.
// @ctl B16:7.k3 Density | steady pattern ↔ + ghost notes and rolls.
// @ctl B16:7.fader Level | 007 Wood / Drops · 010 Congas · 009 Congas · 008 Percussion.
// @ctl B16:7.b1 Change | next of at most 3 patterns.
// @ctl B16:7.b2 Fill | a fill while held.
// @ctl B16:8.k1 Brightness | dark shimmer ↔ bright sizzle.
// @ctl B16:8.k2 Space | dry ↔ far away.
// @ctl B16:8.k3 Density / Swing | straight ↔ swung, lazy.
// @ctl B16:8.fader Level | 007 Crackle · 010 Shaker / Ride · 009 Tamb / Ride · 008 Ride.
// @ctl B16:8.b1 Change | next of at most 3 patterns.
// @ctl B16:8.b2 Double | double time while held.
// @ctl 16:1.k1 Brightness | muffled ↔ open and airy.
// @ctl 16:1.k2 Space | dry and close ↔ far away in a big room (reverb + echo).
// @ctl 16:1.k3 Swell / Strings ↔ B3 | still ↔ slowly breathing in and out.
// @ctl 16:1.fader Level | 007 Pad · 010 Pad · 009 Harmony · 008 Pad.
// @ctl 16:1.b1 Change / Progression | next pattern / melody, at the next bar.
// @ctl 16:1.b2 Freeze / Echo throw | holds the current chord while held.
// @ctl 16:2.k1 Brightness | warm ↔ bright, glassy.
// @ctl 16:2.k2 Space | dry ↔ far away.
// @ctl 16:2.k3 Rhythm | long held chords ↔ short, choppy stabs. 007: Complexity · 009: Length · 008: Motion.
// @ctl 16:2.fader Level | 007 Eno Bowed · 010 Deep Chords · 009 Keys · 008 Chord Pulse.
// @ctl 16:2.b1 Change | next pattern / melody.
// @ctl 16:2.b2 Stab | one accent chord, now. 007/008: Echo throw · 009: Sound.
// @ctl 16:3.k1 Brightness | soft plucks ↔ sharp, sparkling.
// @ctl 16:3.k2 Space / Soft | dry ↔ far away.
// @ctl 16:3.k3 Complexity / Range | few slow notes ↔ fast and wide.
// @ctl 16:3.fader Level | 007 Marimba · 010 Pluck Arp · 009 Vibraphone · 008 Sequence.
// @ctl 16:3.b1 Change / Phrase | next pattern / melody.
// @ctl 16:3.b2 Echo throw / Octave | one octave up while held.
// @ctl 16:4.k1 Brightness | soft and round ↔ biting (acid squelch).
// @ctl 16:4.k2 Space | dry ↔ far away.
// @ctl 16:4.k3 Glide | plain notes ↔ notes slide into each other. 007: Complexity · 009: Playful · 008: Variation.
// @ctl 16:4.fader Level | 007 Toms · 010 Lead · 009 Flute · 008 Lead.
// @ctl 16:4.b1 Change / Motif | next pattern / melody.
// @ctl 16:4.b2 Echo throw | the last note echoes away.
// @ctl 16:5.k1 Brightness | hushed ↔ clear.
// @ctl 16:5.k2 Space | dry ↔ far away.
// @ctl 16:5.k3 Voices / Complexity | one voice ↔ two-, three-part harmony.
// @ctl 16:5.fader Level | 007 Choir · 010 Marimba · 009 Brass · 008 Answer.
// @ctl 16:5.b1 Change / Figure | next pattern / melody.
// @ctl 16:5.b2 Answer | plays one phrase, now. 007: Full choir · 009: Lift.
// @ctl 16:6.k1 Brightness | soft glow ↔ glittering.
// @ctl 16:6.k2 Space | dry ↔ far away.
// @ctl 16:6.k3 Density / Build-up | a sparkle now and then ↔ a rain of notes.
// @ctl 16:6.fader Level | 007 Glitter · 010 Glockenspiel · 009 Strings · 008 Pings.
// @ctl 16:6.b1 Change / Figure | next pattern / melody.
// @ctl 16:6.b2 Run / Lift | one quick run of sparkles.
// @ctl 16:7.k1 Brightness | dark whoosh ↔ bright shimmer.
// @ctl 16:7.k2 Space | dry ↔ far away.
// @ctl 16:7.k3 Amount / Complexity | subtle ↔ wild.
// @ctl 16:7.fader Level | 007 Shimmer · 010 Birds · 009 Guitar · 008 FX / Breath.
// @ctl 16:7.b1 Change / Line | next pattern / melody.
// @ctl 16:7.b2 Hit | one FX hit / impact. 007: Rise · 010: Flock · 009: Lift · 008: Open.
// @ctl g.k1 Fog / Set | Fog: 0 = clear, up = everything muffled. Set mode (button 2): the set position, 007 → 010 → 009 → 008.
// @ctl g.k2 Room | 0 = each sound's own room (row 2), up = everything drowns in reverb.
// @ctl g.k3 Tension | build-up: echo grows, filters open (in the set at most 75 %). Back to 0 = release.
// @ctl g.fader Master Level | volume of everything, both controllers. 0 = silence.
// @ctl g.b1 Chapter | next chords of the track in focus, at the next phrase.
// @ctl g.b2 Set mode | Fog knob: Fog ↔ set position.
// @guide The journey | 007 → 010 → 009 → 008: from a floating heartbeat to techno. The Fog knob in set mode is the map: a full turn is the whole set, each track sits on a plateau where small moves change nothing.
// @guide The journey | A transition takes as long as you turn: slowly, over 16–32 bars, is best. Even a fast spin glides over at least 5 seconds. The tempo moves with it: 70 → 60 (007 slows a little, then 010 doubles it to 120), 120 → 122, 122 → 140.
// @guide The journey | Faders stay where they are: the same column has the same job in the next track. Bring the faders of a new track’s extra sounds up only after the transition.
// @guide Less is more | One change at a time, every 8 bars at most. Let a loop run before it changes again. Chapters wait for the next phrase on purpose.
// @guide Less is more | Fog and Room hide a transition: muffle or drown everything a little, move the set on, then clear up again.

const JOJO  = 'LCXL3 Jojo MIDI Out'
const JONAS = 'LCXL3 Jonas MIDI Out'
// Jonas' controller by its macOS name; if that name is missing (other computer, other USB port), the first MIDI input
let ccJonas
try { ccJonas = await midin(JONAS) } catch (e) { console.warn('Jonas not found: using the first MIDI input'); ccJonas = await midin() }
// Single version (written by tools/lcxl-layout/make-single.mjs with SINGLE = true): don't look for Jojo's controller
const SINGLE = false
let ccJojo = null
if (!SINGLE) {
  try { ccJojo = await midin(JOJO) } catch (e) { console.warn('Jojo not found: one controller, Mode 1 = Jojo, Mode 2 = Jonas (CC + 48)') }
}

// Status box at the bottom right: chapter, break, and which pattern each stem plays.
// Its button moves the text into a small always-on-top window (Document Picture-in-Picture, Chrome/Edge), so it
// stays visible over the layout PDF; closing that window puts it back. Kept on globalThis, so re-evaluating
// reuses the open window. Only in the browser; the Node tools have no page to draw on.
const hasPage = typeof document !== 'undefined' && !!document.createElement
const statusUi = !hasPage ? null : globalThis.ambientStatus ??= (() => {
  document.getElementById('board-status')?.remove()   // the plain box of earlier versions
  const box = document.createElement('div')
  box.style.cssText = 'position:fixed;right:12px;bottom:12px;z-index:1000;padding:8px 12px;' +
    'background:rgba(0,0,0,.75);border-radius:6px'
  const text = document.createElement('pre')
  text.style.cssText = 'margin:0;color:#eee;font:13px/1.5 monospace'
  const pop = document.createElement('button')
  pop.textContent = '⧉ als Fenster'
  pop.style.cssText = 'margin-top:6px;font:12px sans-serif;cursor:pointer'
  pop.onclick = async () => {
    if (!window.documentPictureInPicture) { pop.textContent = 'geht nur in Chrome/Edge'; return }
    const pip = await documentPictureInPicture.requestWindow({ width: 380, height: 470 })
    pip.document.body.style.cssText = 'margin:0;padding:8px 12px;background:#111'
    pip.document.body.append(text)
    box.style.display = 'none'
    pip.addEventListener('pagehide', () => { box.prepend(text); box.style.display = '' })
  }
  box.append(text, pop)
  document.body.appendChild(box)
  return { text, box }
})()

// LC view: a big, normal window (second screen, full screen) that draws both controller pages side by side, Jojo
// (Mode 1) left, Jonas (Mode 2) right: each control's name from the @ctl tags in the editor, its value, and what the buttons
// have chosen. The page in use gets a frame in its colour: two controllers = the one moved last; one controller = the
// page whose CCs move (columns 1-7: plain = Mode 1 Jojo, CC + 48 = Mode 2 Jonas; column 8 is on both). Values come
// from Web MIDI directly; a control not moved since loading shows – (Strudel reads it as 0). Kept on globalThis like
// the status box; side, pageOf and draw are set anew on every evaluation.
const lcView = !hasPage ? null : globalThis.lcxlView ??= (() => {
  const v = { win: null, cc: { jojo: {}, jonas: {} }, page: 'jojo', timer: null,
    side: () => 'jonas', pageOf: side => side, draw: () => {}, css: '' }
  v.update = () => {
    if (!v.win || v.win.closed || v.timer) return
    v.timer = setTimeout(() => { v.timer = null; if (v.win && !v.win.closed) v.draw() }, 40)
  }
  // Everything that is not a CC (a mode switch may send SysEx or a program change) is shown in the view as hex
  const onMsg = (name, e) => {
    const [status, cc, val] = e.data
    if ((status & 0xf0) !== 0xb0) {
      if (status === 0xf8 || status === 0xfe) return   // clock, active sensing
      v.other = [...e.data].map(b => b.toString(16).padStart(2, '0')).join(' ').toUpperCase()
      v.update()
      return
    }
    const side = v.side(name)
    v.cc[side][cc] = val / 127
    v.page = v.pageOf(side, cc)
    v.update()
  }
  // A second listener next to Strudel's own (addEventListener does not replace it)
  const ports = new WeakSet()
  const listen = input => {
    if (ports.has(input)) return
    ports.add(input)
    input.addEventListener('midimessage', e => onMsg(input.name, e))
    input.open?.()
  }
  // With SysEx if the browser allows it (Chrome asks once), else without
  const midiAccess = !navigator.requestMIDIAccess ? Promise.reject(new Error('no Web MIDI'))
    : navigator.requestMIDIAccess({ sysex: true }).catch(() => navigator.requestMIDIAccess())
  midiAccess.then(access => {
    access.inputs.forEach(listen)
    access.addEventListener('statechange', e => { if (e.port.type === 'input' && e.port.state === 'connected') listen(e.port) })
  }).catch(e => console.warn('LC view: no MIDI access', e))
  // The button is a link that opens a tab named lcxl-view: a link click is never stopped by the pop-up blocker, and the
  // tab can be dragged out into its own window. Strudel replaces globalThis.open (a control of its own), so the handle
  // on that tab comes from the native open of a hidden iframe (with a name and no URL it only finds the open tab).
  for (const old of document.querySelectorAll('button')) if (old.textContent.startsWith('▣ LC')) old.remove()
  const opener = document.createElement('iframe')
  opener.style.display = 'none'
  document.body.append(opener)
  const link = document.createElement('a')
  link.textContent = '▣ LC groß'
  link.href = 'about:blank'
  link.target = 'lcxl-view'
  link.style.cssText = 'display:inline-block;margin:6px 0 0 6px;padding:1px 6px;font:12px sans-serif;color:#000;' +
    'background:#ddd;border-radius:3px;text-decoration:none;cursor:pointer'
  link.onclick = () => setTimeout(() => {
    try {
      const w = opener.contentWindow.open('', 'lcxl-view')
      if (!w) { link.textContent = '▣ LC groß (Tab nicht gefunden)'; return }
      v.win = w
      w.document.title = 'LC XL 3'
      w.document.head.innerHTML = '<style>' + v.css + '</style>'
      w.document.body.innerHTML = '<div id=lc></div>'
      v.draw()
      link.textContent = '▣ LC groß'
    } catch (e) { link.textContent = '▣ LC groß: ' + e.message; console.error(e) }
  }, 100)
  if (statusUi.box) statusUi.box.append(link)
  else { link.style.cssText += ';position:fixed;right:12px;bottom:4px;z-index:1001'; document.body.append(link) }
  v.link = link
  return v
})()

// ============================================================
// SET — one knob through four tracks: position, tempo, crossfades
// ============================================================
const SET_TRACKS = [
  { id: '007', name: 'Ambient', grid: 140, slow: 2, phrase: 4, orig: 1, transpose: 0 },
  { id: '010', name: 'Ambient House', grid: 120, slow: 1, phrase: 8, orig: 4, transpose: 0 },
  { id: '009', name: 'Cool House', grid: 122, slow: 1, phrase: 8, orig: 4, transpose: 0 },
  { id: '008', name: 'Groove Techno', grid: 140, slow: 1, phrase: 4, orig: 1, transpose: 4 },
]
// Node check (tools/set/check-set.mjs): original phrase lengths and Tension range, no glide, every knob move counts
const CHECK = globalThis.setCheck === true
const TENSION_MAX = CHECK ? 1 : 0.75
const phraseOf = t => CHECK ? t.orig : t.phrase
const N = SET_TRACKS.length
// Set position 0..1: a plateau per track, a transition between two plateaus (4 × 0.1 + 3 × 0.2)
const PLATEAU = 0.1
const TRANSITION = (1 - N * PLATEAU) / (N - 1)
const SPAN = PLATEAU + TRANSITION
// The position glides after the knob (time constant in seconds) and never faster than MAX_RATE per second,
// so even a fast spin turns into a transition of at least TRANSITION / MAX_RATE = 5 seconds
const GLIDE = 0.6
const MAX_RATE = 0.04
const alone = !ccJojo   // one controller: Jojo in Mode 1, Jonas in Mode 2 (LC view, status box)
// Gate: the pattern is not queried at all while cond is false (as in the tracks; Strudel's own gate() is a sound control)
const gate = (cond, pat) => cond.fmap(on => on ? pat : silence).innerJoin()
const clamp01 = x => Math.min(1, Math.max(0, x))

// Kept on globalThis: re-evaluating the code keeps the place in the set and the fog
const setState = globalThis.setState ??= { pos: 0, smooth: 0, fog: 0, mode: false, prev: null, beat: null }

// Where a position is: track i (plateau or start of a transition) and the progress x towards track i + 1
const where = p => {
  const i = Math.min(N - 1, Math.floor(p / SPAN))
  return { i, x: i === N - 1 ? 0 : clamp01((p - i * SPAN - PLATEAU) / TRANSITION) }
}
// The track that has the buttons, chapter and LC view: the one nearer in the transition
const focusOf = p => { const { i, x } = where(p); return x < 0.5 ? i : i + 1 }
const bpmAt = p => {
  const { i, x } = where(p), a = SET_TRACKS[i].grid, b = SET_TRACKS[Math.min(N - 1, i + 1)].grid
  return a + (b - a) * x * x * (3 - 2 * x)
}

// Morph per column: per = windows per bar (events are paired within one window: a beat for the drums, a bar for
// chords), at = where in the transition (x = 0..1) the column moves from the old track (u = 0) to the new one (u = 1)
const MORPH = {
  J1: { per: 4, at: [0.3, 0.7] },  J2: { per: 1, at: [0, 0.5] },    J3: { per: 2, at: [0.35, 0.65] }, J4: { per: 2, at: [0.35, 0.65] },
  J5: { per: 2, at: [0.2, 0.8] },  J6: { per: 4, at: [0.2, 0.8] },  J7: { per: 2, at: [0.2, 0.8] },   J8: { per: 4, at: [0.2, 0.8] },
  N1: { per: 1, at: [0, 0.6] },    N2: { per: 1, at: [0.2, 0.8] },  N3: { per: 2, at: [0.4, 1] },     N4: { per: 1, at: [0.4, 1] },
  N5: { per: 1, at: [0.4, 1] },    N6: { per: 2, at: [0.4, 1] },    N7: { per: 1, at: [0, 0.6] },
}
const win = (x, [a, b]) => clamp01((x - a) / (b - a))
const progress = col => { const { i, x } = where(setState.smooth); return { i, u: win(x, MORPH[col].at) } }
// Equal-power curves, exactly 0 and 1 at the ends (gates and the safety net need a real 0)
const fadeOut = u => u <= 0 ? 1 : u >= 1 ? 0 : Math.cos(u * Math.PI / 2)
const fadeIn  = u => u <= 0 ? 0 : u >= 1 ? 1 : Math.sin(u * Math.PI / 2)
// A track is queried at all only while it sounds or has the focus
const awake = k => { const { i, x } = where(setState.smooth); return k === i || (k === i + 1 && x > 0) }

const setTaps = []
const tap = pat => (setTaps.push(pat), pat)
const off8 = signal(() => 0)
// Column 8 is read from its Mode 16 and Mode 2 CCs, last moved wins (as in the tracks)
const lastMoved8 = (a, b) => {
  let pa = null, pb = null, v = 0
  return tap(a.fmap(x => y => {
    if (pa === null) v = Math.max(x, y)
    else if (y !== pb) v = y
    else if (x !== pa) v = x
    pa = x; pb = y
    return v
  }).appLeft(b))
}
const raw8 = c => lastMoved8(ccJonas(c), ccJonas(c + 48))
const g8 = { bright: raw8(20), space: raw8(28), char: raw8(36), level: raw8(12), btn: raw8(44), btn2: raw8(52) }

// The Fog knob is an encoder with absolute values (0-127). Its moves go to the fog or, in set mode, to the position.
// Value scaling: a move covers the rest of the target's range in proportion to the rest of the knob's range, so the
// two values never jump, even if the controller did not take over the value sent on a mode switch.
// A jump larger than MAX_STEP within one tick is no move but a re-sync (re-evaluation): it is ignored.
const MAX_STEP = CHECK ? Infinity : 0.1
const follow = (v, x0, x1) => Math.abs(v - x0) < 1e-9 ? x1
  : clamp01(x1 > x0 ? v + (x1 - x0) * (1 - v) / (1 - x0) : v - (x0 - x1) * v / x0)
tap(g8.bright.fmap(x => {
  const s = setState
  if (s.prev === null) { if (!s.mode) s.fog = x }
  else if (x !== s.prev && Math.abs(x - s.prev) <= MAX_STEP) {
    if (s.mode) s.pos = follow(s.pos, s.prev, x)
    else s.fog = follow(s.fog, s.prev, x)
  }
  s.prev = x
  return 0
}))

// Feedback to the controller: on a mode switch the Fog encoder is set to the value it now controls (CC back to the
// port and channel the Fog knob last came from), so its ring and display show the right value
const fogOut = globalThis.setFogOut ??= (() => {
  const o = { send: () => false, status: 0xbf, cc: 20, from: null }
  if (typeof navigator === 'undefined' || !navigator.requestMIDIAccess) return o
  navigator.requestMIDIAccess().then(access => {
    const outFor = name => {
      const outs = [...access.outputs.values()]
      const base = (name ?? '').replace(/\s*(MIDI\s*)?Out\s*$/i, '')
      return outs.find(p => name && p.name === name.replace(/Out(\s*)$/i, 'In$1'))
        ?? (base && outs.find(p => p.name.startsWith(base)))
        ?? outs.find(p => /jonas/i.test(p.name)) ?? outs.find(p => /lcxl|launch control/i.test(p.name))
    }
    const listen = input => input.addEventListener('midimessage', e => {
      const [st, cc] = e.data
      if ((st & 0xf0) === 0xb0 && (cc === 20 || cc === 68)) { o.status = st; o.cc = cc; o.from = input.name }
    })
    access.inputs.forEach(listen)
    o.send = v => {
      const out = outFor(o.from)
      if (!out) return false
      out.send([o.status, o.cc, Math.round(clamp01(v) * 127)])
      return true
    }
  }).catch(e => console.warn('set: no MIDI output for the Fog feedback', e))
  return o
})()

let prevBtn2 = 0
tap(g8.btn2.fmap(v => {
  if (v > 0.5 && prevBtn2 <= 0.5) {
    const s = setState
    s.mode = !s.mode
    const target = s.mode ? s.pos : s.fog
    if (fogOut.send(target)) s.prev = target
    SET.refresh()
  }
  prevBtn2 = v
  return 0
}))

// Glide of the position, once per scheduler tick (setTaps come first in the master)
let lastNow = null, lastLabel = null
tap(signal(() => {
  const s = setState, now = Date.now() / 1000
  const dt = lastNow === null ? Infinity : now - lastNow
  lastNow = now
  if (CHECK || dt === Infinity) s.smooth = s.pos
  else {
    const step = (s.pos - s.smooth) * (1 - Math.exp(-dt / GLIDE))
    s.smooth += Math.max(-MAX_RATE * dt, Math.min(MAX_RATE * dt, step))
    if (Math.abs(s.pos - s.smooth) < 1e-4) s.smooth = s.pos
  }
  // Redraw status box and LC view when the shown position changes (whole percent) or the focus moves
  const label = focusOf(s.smooth) + ' ' + SET.where() + SET.knob()
  if (label !== lastLabel) { lastLabel = label; SET.refresh?.() }
  return 0
}))

const SET = {
  state: setState,
  focus: () => focusOf(setState.smooth),
  // What the tracks get for their column 8: fog from the set state, Tension limited, no break
  glob: { bright: signal(() => setState.fog), space: g8.space, char: g8.char.mul(TENSION_MAX), level: g8.level,
    btn: g8.btn, btn2: off8 },
  where: () => {
    const { i, x } = where(setState.smooth), a = SET_TRACKS[i], b = SET_TRACKS[i + 1]
    const bpm = Math.round(bpmAt(setState.smooth) / a.slow)
    return x === 0 ? a.id + ' ' + a.name + ' · ' + bpm + ' BPM'
      : a.id + ' → ' + b.id + ' · ' + Math.round(x * 100) + ' % · ' + Math.round(bpmAt(setState.smooth)) + ' BPM'
  },
  knob: () => setState.mode ? 'Set (Fog bleibt bei ' + Math.round(setState.fog * 100) + ')' : 'Fog',
  statusLines: () => ['Set         ' + SET.where(), 'Fog-Knopf   ' + SET.knob()],
  // Header of the LC view: set position, bar in the phrase with the four beats, what the Fog knob does
  headHtml: esc => {
    const b = setState.beat
    const dots = [0, 1, 2, 3].map(k => '<i' + (b && b.beat === k ? ' class=on' : '') + '></i>').join('')
    return '<div><span class=k>Set</span>' + esc(SET.where()) + '</div>' +
      '<div><span class=k>Takt</span>' + (b ? (b.bar % b.phrase + 1) + ' / ' + b.phrase : '–') + '<span class=beats>' + dots + '</span></div>' +
      '<div><span class=k>Fog-Knopf</span>' + (setState.mode ? '<span class=next>' + esc(SET.knob()) + '</span>' : 'Fog') + '</div>'
  },
}

// ============================================================
// TRACK 007 — Ambient (from tracks/007-ambient-soundscape/007-ambient-dual.strudel)
// ============================================================
// @007 layout Track 007 — ambient moods (two controllers)
// @007 note Dreamy ambient on D, about 70 BPM. Jojo plays the foundation (heartbeat, drone, bass and soft clicks), Jonas the colour (pad, bowed loops, marimba and toms, choir, sparkles) and the global column 8.
// @007 note Every row means the same everywhere: row 1 = brightness, row 2 = space, row 3 = character, fader = level, button 1 = next pattern (at the next bar, 3 per stem), button 2 = a moment while held.
// @007 note Start with all faders down. Nothing sounds until Jonas' master fader (column 8) is up.
// @007 note The status box at the bottom right of the Strudel page shows chapter, break and each stem's pattern. Its button “als Fenster” opens it as a small window that stays on top (Chrome/Edge).
// @007 mode B16 Jojo — Foundation (beat + bass)
// @007 col B16:1 1 Pulse
// @007 col B16:2 2 Sea / Wind
// @007 col B16:3 3 Drone
// @007 col B16:4 4 Bass
// @007 col B16:5 5 Rim
// @007 col B16:6 6 Ticks
// @007 col B16:7 7 Wood / Drops
// @007 col B16:8 8 Crackle
// @007 row B16:k1 Row 1 \ Brightness
// @007 row B16:k2 Row 2 \ Space
// @007 row B16:k3 Row 3 \ Character
// @007 row B16:fader Fader \ Level
// @007 row B16:b1 Button 1 \ Change
// @007 row B16:b2 Button 2 \ Moment
// @007 mode 16 Jonas — Colour (chords + melodies) · column 8 = global
// @007 col 16:1 1 Pad
// @007 col 16:2 2 Eno Bowed
// @007 col 16:3 3 Marimba
// @007 col 16:4 4 Toms
// @007 col 16:5 5 Choir
// @007 col 16:6 6 Glitter
// @007 col 16:7 7 Shimmer
// @007 col 16:8 8 Global
// @007 row 16:k1 Row 1 \ Brightness
// @007 row 16:k2 Row 2 \ Space
// @007 row 16:k3 Row 3 \ Character
// @007 row 16:fader Fader \ Level
// @007 row 16:b1 Button 1 \ Change
// @007 row 16:b2 Button 2 \ Moment
// @007 guide Playing together | Jojo builds the floor: drone and bass first, then the heartbeat, then the small clicks. Jonas colours it: pad and bowed loops, marimba and toms for movement, then choir and the sparkles on top.
// @007 guide Playing together | Jonas' column 8 acts on everything: Fog and Tension darken or open all filters, Room drowns everything in reverb, Chapter changes the key colour for both players at the next bar.
// @007 guide Playing together | Break: one press takes out the beat (pulse, bass, rim, ticks, wood) at the next bar; drone, crackle, sea and all of Jonas' sounds keep floating. The second press brings the beat back on the one.
// @007 guide Every position sounds good | No filter closes completely, and space 0 is dry but never silent. Row 2 at about the middle gives each sound the room it had in the original track.
const T007 = await (async () => {
const ID = 0
const PHRASE = phraseOf(SET_TRACKS[0])
const ORBIT0 = 0
const focusOnly = button => button.fmap(v => SET.focus() === ID ? v : 0)

const ramp = (sig, from, to) => sig.fmap(v => Math.min(1, Math.max(0, (v - from) / (to - from))))
// Row-3 crossfade: 0..0.5 brings the extra layer in, 0.5..1 fades the main layer out
const fadeMain  = knob => ramp(knob, 1, 0.5)
const fadeExtra = knob => ramp(knob, 0, 0.5)
// Exponential knob range for filters (Hz), so every part of the knob travel is audible
const expRange = (knob, lo, hi) => knob.fmap(v => lo * Math.pow(hi / lo, v))

const bpm  = 70
const beat = 60 / bpm   // seconds per quarter note, for delay times

// Mapping of column n (1-8): brightness, space, character (knob rows 1-3), fader, button rows 1-2
const colMap = (read, n) => ({ bright: read(12 + n), space: read(20 + n), char: read(28 + n), level: read(4 + n), btn: read(36 + n), btn2: read(44 + n) })
const off = () => signal(() => 0)
// Column 8 (global) is read from both its Mode 16 and Mode 2 CCs, last moved wins: it works on both pages even on a
// controller whose column 8 sends CC + 48 in Mode 2
// One controller: Jojo on the plain CCs (Mode 1), Jonas on CC + 48 (Mode 2)
const alone    = !ccJojo
const colJonas = n => n === 8 ? SET.glob : colMap(n === 8 ? c => lastMoved(ccJonas(c), ccJonas(c + 48)) : alone ? c => ccJonas(c + 48) : ccJonas, n)
const colJojo  = n => !alone ? colMap(ccJojo, n) : n === 8 ? colMap(off, n) : colMap(ccJonas, n)

const gate  = (cond, pat) => cond.fmap(on => on ? pat : silence).innerJoin()
const above = (sig, x) => sig.fmap(v => v > x)
const and   = (a, b) => a.fmap(x => y => x && y).appLeft(b)
const held  = button => button.fmap(v => v > 0.5)

// Stateful controls, collected so the master can query them every tick (see stateTaps)
const taps = []

// Two inputs for one control: the value follows whichever moved last (stateful, so it is queried via stateTaps)
const lastMoved = (a, b) => {
  let pa = null, pb = null, v = 0
  const pat = a.fmap(x => y => {
    if (pa === null) v = Math.max(x, y)
    else if (y !== pb) v = y
    else if (x !== pa) v = x
    pa = x; pb = y
    return v
  }).appLeft(b)
  taps.push(pat)
  return pat
}

// Momentary button that steps through n states, one step per press (counts presses, not the held value).
// onChange(state) runs on every step (for the status box). Re-evaluating the code starts again at 0.
const cycleButton = (button, n, onChange = () => {}) => {
  button = focusOnly(button)   // set: presses count only for the track in focus
  let prev = 0, state = 0
  const pat = button.fmap(v => {
    if (v > 0.5 && prev <= 0.5) { state = (state + 1) % n; onChange(state) }
    prev = v
    return state
  })
  taps.push(pat)
  return pat
}

// A value that a button sets now but that takes over only at the next bar line (chapter, break, change).
// at(t) is asked with bar starts in real time (outside any reseed shift); it remembers the previous value for
// queries that still reach back into the old bar. pat = the value per bar.
const barLatch = (len = 1) => {
  const l = { pending: 0, now: 0, prev: 0, bar: -Infinity }
  l.at = t => {
    const bar = Math.floor(Number(t) / len)
    if (bar > l.bar) {
      if (l.pending !== l.now) { l.prev = l.now; l.now = l.pending; showStatus() }
      else l.prev = l.now
      l.bar = bar
    }
    return bar >= l.bar ? l.now : l.prev
  }
  l.pat = signal(t => l.at(t)).segment(1)
  taps.push(l.pat)
  return l
}

// 0 → 1 over `cycles` while a button is held, back to 0 on release (for risers)
const heldRamp = (button, cycles) => {
  let start = null
  const pat = button.fmap(v => t => {
    if (v <= 0.5) { start = null; return 0 }
    start ??= t
    return Math.min(1, Math.max(0, (t - start) / cycles))
  }).appLeft(signal(t => Number(t)))
  taps.push(pat)
  return pat
}


// ============================================================
// MOODS — all on D, so a switch keeps the root and only the colour changes
// ============================================================
// Drone chords per mood (absolute notes, so each mood needs its own; the other stems use scale degrees).
// Whole tone has no fifth (D E F♯ G♯ A♯ C): its drones use tritones and major thirds instead.
const MOODS = [
  { scale: 'lydian', name: 'schwebend',   // D E F♯ G♯ A B C♯
    drones: ["[d1,a1]", "[d1,a1,e2]", "[g0,d1,a1]", "[d1,a1,c#2]", "[a0,e1,b1]", "[d1,g#1,a1]", "[e1,b1,f#2]", "[d1,d2,a2]"],
    names: ['D–A', 'D–A–E', 'G–D–A', 'D–A–C♯', 'A–E–B', 'D–G♯–A', 'E–B–F♯', 'D–D–A'] },
  { scale: 'dorian', name: 'melancholisch',   // D E F G A B C
    drones: ["[d1,a1]", "[d1,a1,e2]", "[g0,d1,a1]", "[d1,a1,c2]", "[a0,e1,b1]", "[d1,f1,a1]", "[e1,b1,g2]", "[d1,d2,a2]"],
    names: ['D–A', 'D–A–E', 'G–D–A', 'D–A–C', 'A–E–B', 'D–F–A', 'E–B–G', 'D–D–A'] },
  { scale: 'whole tone', name: 'seltsam',   // D E F♯ G♯ A♯ C
    drones: ["[d1,g#1]", "[d1,a#1,e2]", "[c1,f#1,d2]", "[d1,c2]", "[e1,a#1,d2]", "[d1,f#1,a#1]", "[g#0,d1,a#1]", "[d1,d2,g#2]"],
    names: ['D–G♯', 'D–A♯–E', 'C–F♯–D', 'D–C', 'E–A♯–D', 'D–F♯–A♯', 'G♯–D–A♯', 'D–D–G♯'] },
]

// Rows of the status box, filled by change(): { label, latch, n, names } per player
const STATUS = { jojo: [], jonas: [] }
const showStatus = () => {
  if (!statusUi || SET.focus() !== ID) return
  const dots = v => [...Array(8).keys()].map(k => k === v ? '●' : '○').join('')
  const show = (r, v) => !r.names ? String(v + 1) : typeof r.names === 'function' ? r.names(v) : r.names[v]
  const line = (r, i) => !r ? (i + 1) + ' —' : (i + 1) + ' ' + r.label.padEnd(10) + ' ' + (r.n === 8 ? dots(r.latch.now) + ' ' : '') +
    show(r, r.latch.now) + (r.latch.pending !== r.latch.now ? ' → ' + show(r, r.latch.pending) : '')
  const soon = l => l.pending !== l.now ? ' (nächster Takt)' : ''
  statusUi.text.textContent = [
    ...SET.statusLines(),
    'Kapitel     D ' + MOODS[moodLatch.now].name +
      (moodLatch.pending !== moodLatch.now ? ' → ' + MOODS[moodLatch.pending].name : '') + soon(moodLatch),
    '', alone ? 'Mode 1 · Jojo' : 'Jojo', ...STATUS.jojo.map(line),
    '', alone ? 'Mode 2 · Jonas' : 'Jonas', ...STATUS.jonas.map(line),
  ].join('\n')
  lcView?.update()
}
// Button 1 of a stem: n patterns (default 8), one step per press, taking over at the next bar
const change = (button, who, label, n = 8, names) => {
  const latch = barLatch()
  cycleButton(button, n, s => { latch.pending = s; showStatus() })
  STATUS[who].push({ label, latch, n, names })
  return latch
}

// ============================================================
// GLOBAL (Jonas, column 8) — acts on both controllers
// ============================================================
// @007 ctl g.k1 Fog | 0 = clear, up = every filter pulled down to ~6 %: distant, under water.
// @007 ctl g.k2 Room | 0 = each sound's own room (row 2), up = everything drowns in reverb.
// @007 ctl g.k3 Tension | 0–0.5: echo grows on all melodic stems, filters open. 0.5–1: + slow tape wobble on the long sounds. Back to 0 = release.
// @007 ctl g.fader Master Level | volume of everything, both controllers. 0 = silence.
// @007 ctl g.b1 Chapter | mood: floating → melancholic → strange, at the next bar.
// @007 ctl g.b2 Break / Drop | 1st: beat out. 2nd: all back on the one.
const glob          = colJonas(8)
const globalFog     = glob.bright.fmap(f => Math.pow(0.06, f))
const globalRoom    = glob.space
const tension       = glob.char
const tensionEcho   = ramp(tension, 0, 0.5).mul(0.5)     // delay send, 0..0.5
const tensionWobble = ramp(tension, 0.5, 1).mul(0.1)     // vibrato depth, 0..±0.1 semitones
// Factor on every lpf: fog darkens (down to 0.06), tension opens (up to 2.5)
const globalTone    = globalFog.fmap(f => o => f * o).appLeft(tension.fmap(t => 1 + 1.5 * t))
const globalLevel   = glob.level.range(0, 1)

const moodLatch  = barLatch(PHRASE)
cycleButton(glob.btn, MOODS.length, s => { moodLatch.pending = s; showStatus() })
const breakLatch = barLatch()
cycleButton(glob.btn2, 2, s => { breakLatch.pending = s; showStatus() })
const mood    = moodLatch.pat
const scaleIn = octave => mood.fmap(m => 'D' + octave + ':' + MOODS[m].scale)
// Jojo's beat stems, gated while the break is on
const beatOn  = breakLatch.pat.fmap(b => b === 0)
const beatOnly = pat => gate(beatOn, pat)

const audible = level => and(above(level, 0), above(globalLevel, 0))
// lpf × fog/tension, capped below Nyquist
const toned  = lpf => lpf.fmap(f => g => Math.min(18000, f * g)).appLeft(globalTone)
// Reverb send: the stem's space knob (0..0.9), raised by the global Room up to 0.95
const roomOf = space => space.fmap(s => g => { const r = 0.9 * s; return r + (0.95 - r) * g }).appLeft(globalRoom)
// Tension wobble: a slow, shallow vibrato (old tape), only set while it is > 0 (a vibrato oscillator per note costs CPU).
// Only on the long sounds; on bells and the music box any wobble sounds out of tune.
const wobble = pat => above(tensionWobble, 0).fmap(on => on ? pat.vib(0.15).vibmod(tensionWobble) : pat).innerJoin()
// Change: read the stem's randomness 1024 cycles further per step (keeps bar alignment, new random values).
// Scales are applied after reseed, so the mood follows real time.
const reseed = (latch, pat) => pat.early(latch.pat.fmap(v => v * 1024))

// Effect buses. Each orbit has one reverb and one delay, and every reverb costs a lot of CPU (its length is
// the room size in seconds), so the stems share two orbits; stems on one orbit share room size and echo time/feedback.
// Orbit 1 = pulse, drone, bass, crackle, sea/wind, music box, whale, choir (dotted-quarter echo).
// Orbit 2 = rim, ticks, wood, pad, chords, glitter, shimmer (dotted-8th echo).
const BUSES = {
  1: { hall: 6.5, time: beat * 1.5, feedback: 0.5 },
  2: { hall: 6, time: beat * 0.75, feedback: 0.6 },
}
// bus(): reverb from the space knob, and echo: the layer's own delay amount (or `echo` if it has none) × 2 × space,
// so space 0.5 = the original amount; Tension's echo takes over where it is larger.
const bus = (pat, orbit, space, echo = 0) => pat
  .fmap(v => sc => e => ({ ...v, delay: Math.max(Math.min(0.9, (v.delay ?? echo) * sc), e) }))
  .appLeft(space.fmap(s => 2 * s)).appLeft(tensionEcho)
  .room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)
  .delaytime(BUSES[orbit].time).delayfeedback(BUSES[orbit].feedback)
// Reverb only, no echo (low end and the pulse would smear)
const dryBus = (pat, orbit, space) => pat.room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)

// Channel strip: lpf × fog/tension (if given), level × master as postgain, gated while the fader or master is 0
const strip = (stem, { lpf, level }) => {
  const pat = lpf === undefined ? stem : stem.lpf(toned(lpf))
  return gate(audible(level), pat.postgain(level.mul(globalLevel)))
}

// ============================================================
// JOJO 1 PULSE — a soft kick on D, the heartbeat. No echo.
// ============================================================
// Drive picks the sound:
//   soft   = a plain sine (no click, no noise) that fades in over 15 ms and glides 4 semitones down into D
//   medium = synth bass drum (triangle + pitch drop + short noise click + light saturation), 8-semitone drop
//   firm   = the same with a 12-semitone drop: more punch and click
// @007 ctl B16:1.k1 Brightness | dull thump ↔ clicky attack (lpf 180–1500 Hz).
// @007 ctl B16:1.k2 Space | dry and close ↔ far away in a big room (reverb).
// @007 ctl B16:1.k3 Drive | three steps: soft sine thump → synth kick → firm kick with more click.
// @007 ctl B16:1.fader Level | 0 = gone. A heartbeat thump on D.
// @007 ctl B16:1.b1 Change | heartbeat → quarters → half notes.
// @007 ctl B16:1.b2 Drop out | pulse pauses while held.
const pulse       = colJojo(1)
const pulseRhythm = change(pulse.btn, 'jojo', 'Puls', 3, ['Herzschlag', 'Viertel', 'Halbe'])
const pulseDrive  = pulse.char.fmap(d => d < 1 / 3 ? 0 : d < 2 / 3 ? 1 : 2)
const PULSE_GAINS = ["[1 0.55 ~ ~]*4", "0.9*4", "1 ~ 1 ~"]   // heartbeat, quarters, half notes
const PULSE_SOUNDS = [
  g => gain(g).s("sine").note("d2").attack(0.015).decay(0.45).sustain(0).release(0.15).penv(-4).pattack(0.08),   // soft
  g => gain(g).mul(gain(0.4)).s("sbd").note("d2").decay(0.45).penv(8).pdecay(0.06),    // medium (× 0.4: as loud as soft)
  g => gain(g).mul(gain(0.4)).s("sbd").note("d2").decay(0.45).penv(12).pdecay(0.06),   // firm
]
const PULSES = PULSE_SOUNDS.map(sound => PULSE_GAINS.map(sound))   // PULSES[drive][rhythm], built once

const stemJ1_pulse = beatOnly(gate(pulse.btn2.fmap(v => v <= 0.5), strip(dryBus(
  pulseDrive.fmap(d => pulseRhythm.pat.fmap(r => PULSES[d][r]).innerJoin()).innerJoin(), 1, pulse.space), {
  lpf: expRange(pulse.bright, 180, 1500),
  level: pulse.level.range(0, 0.95),   // was 1; mix: pulse −5 dB under the pad
})))

// ============================================================
// JOJO 2 SEA / WIND — noise: rolling waves ↔ whistling gusts
// ============================================================
// @007 ctl B16:2.k1 Brightness | 0 = soft rumble ↔ airy hiss (lpf 700–12000 Hz, moves with the waves).
// @007 ctl B16:2.k2 Space | dry ↔ far away (reverb).
// @007 ctl B16:2.k3 Sea ↔ Wind | 0 = brown-noise waves rolling in, 0.5 = both, 1 = only whistling wind gusts.
// @007 ctl B16:2.fader Level | sea and wind. Keeps playing in the break.
// @007 ctl B16:2.b1 Change | next of 3 random wave / gust patterns.
// @007 ctl B16:2.b2 Riser | a noise sweep rises over 2 bars while held.
const wind     = colJojo(2)
const windVar  = change(wind.btn, 'jojo', 'Meer/Wind', 3)
const windMix  = wind.char
const windLpf  = toned(expRange(wind.bright, 700, 12000))
const windRise = heldRamp(wind.btn2, 2)

// Waves: a swell every half bar, sometimes skipped, each with its own length; the lpf breathes with them
const sea = s("brown*2").degradeBy(0.25)
  .attack(rand.range(0.6, 1.6)).sustain(0.8).release(rand.range(1.5, 3))
  .lpf(windLpf.mul(sine.slow(3).range(0.35, 1)))
  .pan(rand.range(0.2, 0.8)).gain(6)   // brown noise is ~23 dB quieter than white at the same gain
// Wind: overlapping 8th gusts through a resonant bandpass that wanders, so it whistles and moves
const gusts = s("pink*8")
  .attack(0.3).sustain(0.7).release(0.8)
  .bpf(sine.slow(7).add(rand.mul(0.15)).range(400, 2200)).bpq(rand.range(2, 7))
  .lpf(windLpf)
  .pan(sine.slow(4)).gain(perlin.range(6, 38).mul(wind.bright.fmap(b => Math.pow(0.22, b))))
  // pink noise through a narrow bandpass needs a lot of gain; less as brightness opens the lpf, so it stays even
// Riser: 16th noise bursts through a bandpass that climbs from 300 Hz to 6 kHz, getting louder
const riser = gate(held(wind.btn2), s("pink*16")
  .attack(0.03).sustain(0.8).release(0.15)
  .bpf(windRise.fmap(r => 300 * Math.pow(20, r))).bpq(4)
  .gain(windRise.mul(1.6)).pan(sine.fast(2)))

const stemJ2_wind = strip(bus(stack(
  reseed(windVar, stack(
    gate(above(fadeMain(windMix), 0), sea.mul(gain(fadeMain(windMix)))),
    gate(above(fadeExtra(windMix), 0), gusts.mul(gain(fadeExtra(windMix))))
  )),
  riser
), 1, wind.space), {
  level: wind.level.range(0, 0.4),   // was 1, then 0.68 (mix); feedback 1: too loud, −4.6 dB
})

// ============================================================
// JOJO 3 DRONE — low fifths that breathe in and out once per bar
// ============================================================
// @007 ctl B16:3.k1 Brightness | pure and dark ↔ open, the overtones come through (lpf 120–4000 Hz).
// @007 ctl B16:3.k2 Space | dry ↔ far away (reverb).
// @007 ctl B16:3.k3 Beating | 0 = pure sines. Up = a detuned saw copy fades in, the two beat against each other (slow “wah-wah”).
// @007 ctl B16:3.fader Level | slow drone chords on D.
// @007 ctl B16:3.b1 Change | 3 drone chords per chapter: D–A → D–A–E → G–D–A.
const drone      = colJojo(3)
const droneVar   = change(drone.btn, 'jojo', 'Drone', 3, i => MOODS[moodLatch.now].names[i])
const droneBeat  = drone.char
const DRONES     = MOODS.map(m => m.drones.map(d => note(d)))
// Chord = mood (per bar) × change
const droneChord = mood.fmap(m => droneVar.pat.fmap(i => DRONES[m][i]).innerJoin()).innerJoin()

const stemJ3_drone = strip(bus(wobble(stack(
  // Body: swells in over a bar, octave answer on the second half
  droneChord.s("sine").attack(1.5).decay(1).sustain(0.7).release(3).gain(0.7),
  droneChord.add(note(12)).s("triangle").late(0.5).attack(1).sustain(0.5).release(2.5).gain(0.25),
  // Beating: same chord, detuned by up to a quarter tone
  gate(above(droneBeat, 0), droneChord.add(note(droneBeat.mul(0.3))).s("sawtooth")
    .attack(1.5).sustain(0.6).release(3).gain(droneBeat.mul(0.18)))
)), 1, drone.space), {
  lpf: expRange(drone.bright, 120, 4000),
  level: drone.level.range(0, 0.46),   // was 1, then 1.15 (mix); feedback 1: played at most 40 % → full fader = old 40 %
})

// ============================================================
// JOJO 4 BASS — a soft sub bass on the mood's scale, mostly the root. No echo, no wobble (both smear the low end).
// ============================================================
// @007 ctl B16:4.k1 Brightness | round and dark ↔ the saw's buzz comes through (lpf 80–2000 Hz).
// @007 ctl B16:4.k2 Space | dry ↔ far away (reverb).
// @007 ctl B16:4.k3 Groove | 0 = a soft swell every bar. Up to 0.5 a 3-3-2 pulse fades in, at 1 only the pulse.
// @007 ctl B16:4.fader Level | slow bass swells.
// @007 ctl B16:4.b1 Change | next of 3 bass lines (a note every 2 bars).
// @007 ctl B16:4.b2 Octave | one octave up while held.
const bassCol  = colJojo(4)
const bassVar  = change(bassCol.btn, 'jojo', 'Bass', 3)
const bassMix  = bassCol.char
const bassOct  = bassCol.btn2.fmap(v => v > 0.5 ? 12 : 0)
// Scale degrees, weighted to the root; a new note every 2 bars
const BASS_DEGREES = [0, 0, 0, 4, 3, 5, -2, 1]
const bassNote = reseed(bassVar, irand(BASS_DEGREES.length).segment(1).slow(2).fmap(i => n(BASS_DEGREES[i])).innerJoin())

// Swell, re-struck every bar (the mood can change there): sine sub (octave 1)
// + a quiet saw an octave up, so it is audible on small speakers too
const bassHeld = stack(
  bassNote.scale(scaleIn(1)).s("sine").attack(0.8).sustain(0.9).release(2).gain(0.6),
  bassNote.scale(scaleIn(2)).s("sawtooth").attack(0.8).sustain(0.7).release(2).gain(0.1)
)
// Pulse: the same notes as soft plucks in a 3-3-2 rhythm on 8ths
const bassPulse = stack(
  bassNote.struct("x ~ ~ x ~ ~ x ~").scale(scaleIn(1)).s("sine").decay(0.4).sustain(0.2).release(0.3).gain(0.6),
  bassNote.struct("x ~ ~ x ~ ~ x ~").scale(scaleIn(2)).s("sawtooth").decay(0.25).sustain(0).release(0.2).gain(0.1)
)

const stemJ4_bass = beatOnly(strip(dryBus(stack(
  gate(above(fadeMain(bassMix), 0), bassHeld.mul(gain(fadeMain(bassMix)))),
  gate(above(fadeExtra(bassMix), 0), bassPulse.mul(gain(fadeExtra(bassMix))))
).add(note(bassOct)), 1, bassCol.space), {
  lpf: expRange(bassCol.bright, 80, 2000),
  level: bassCol.level.range(0, 0.38),   // was 1, then 0.94 (mix); feedback 1: played at most 40 % → full fader = old 40 %
}))

// ============================================================
// JOJO 5 RIM — a soft rim click on the backbeat: a short triangle blip + a breath of noise
// ============================================================
// @007 ctl B16:5.k1 Brightness | soft and far ↔ sharp crack (lpf 1.2–12 kHz).
// @007 ctl B16:5.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl B16:5.k3 Ghost notes | plain ↔ extra quiet clicks in between.
// @007 ctl B16:5.fader Level | soft rim click on 2 and 4.
// @007 ctl B16:5.b1 Change | backbeat → late ghost → offset click.
// @007 ctl B16:5.b2 Roll | 16th roll, growing over the bar, while held.
const rim      = colJojo(5)
const rimVar   = change(rim.btn, 'jojo', 'Rim', 3)
const rimGhost = rim.char
const RIMS = ["~ 0.5 ~ 0.5", "~ 0.5 ~ [0.5 ~ ~ 0.3]", "~ [~ 0.5] ~ 0.5", "~ 0.5 ~ ~", "[~ 0.3] 0.5 ~ 0.5",
  "~ 0.5 [~ 0.3] 0.5", "~ ~ 0.5 ~", "~ 0.5 ~ <0.5 [0.5 0.3]>"].map(g => gain(g))
const rimHits = stack(
  rimVar.pat.fmap(i => RIMS[i]).innerJoin(),
  gate(above(rimGhost, 0), reseed(rimVar, gain(rand.range(0.08, 0.18)).struct("x*16")
    .degradeBy(rimGhost.fmap(g => 1 - 0.4 * g)))),
  gate(held(rim.btn2), gain(saw.range(0.1, 0.45)).struct("x*16"))
)
const rimSound = stack(
  rimHits.s("triangle").note("a5").decay(0.045).sustain(0),
  rimHits.s("white").decay(0.012).sustain(0).hpf(2500).mul(gain(0.5))
)

const stemJ5_rim = beatOnly(strip(bus(rimSound.pan(0.45), 2, rim.space, 0.25), {
  lpf: expRange(rim.bright, 1200, 12000),
  level: rim.level.range(0, 2.2),   // was 1; mix: rim −13 dB (was barely audible)
}))

// ============================================================
// JOJO 6 TICKS — a clock: tick-tock on 8ths, FM sine (metallic), tick left, tock right
// ============================================================
// @007 ctl B16:6.k1 Brightness | soft tick ↔ crisp and sharp (lpf 3–16 kHz).
// @007 ctl B16:6.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl B16:6.k3 Density | 8ths ↔ + 16ths ↔ + little flutters.
// @007 ctl B16:6.fader Level | clock ticks.
// @007 ctl B16:6.b1 Change | next of 3 random accent / 16th patterns.
// @007 ctl B16:6.b2 Open | ticks ring long while held.
const ticks    = colJojo(6)
const tickVar  = change(ticks.btn, 'jojo', 'Ticken', 3)
const tickDens = ticks.char
const tickOpen = ticks.btn2.fmap(v => v > 0.5 ? 0.35 : 0.035)   // decay in seconds

const stemJ6_ticks = beatOnly(strip(bus(reseed(tickVar, stack(
  note("[d7 a6]*4").degradeBy(0.1).gain(rand.range(0.15, 0.3)).pan("[0.35 0.65]*4"),
  gate(above(tickDens, 0), note("[~ e7]*8").degradeBy(0.3).gain(ramp(tickDens, 0, 0.5).mul(0.2)).pan(rand.range(0.3, 0.7))),
  gate(above(tickDens, 0.6), note("a7*32").degradeBy(0.8).gain(ramp(tickDens, 0.6, 1).mul(0.12)).pan(rand))
)).s("sine").fm(2.5).fmh(2.7).decay(tickOpen).sustain(0), 2, ticks.space, 0.3), {
  lpf: expRange(ticks.bright, 3000, 16000),
  level: ticks.level.range(0, 5.7),   // was 1; mix: ticks −15 dB (were inaudible at brightness 0)
}))

// ============================================================
// JOJO 7 WOOD / DROPS — random clicks on a 16th grid; some glide up into their note like water drops
// ============================================================
// @007 ctl B16:7.k1 Brightness | woody (pure sine blip) ↔ metallic (FM).
// @007 ctl B16:7.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl B16:7.k3 Density | a click now and then ↔ a busy pattern.
// @007 ctl B16:7.fader Level | wood clicks and drops.
// @007 ctl B16:7.b1 Change | next of 3 random patterns.
// @007 ctl B16:7.b2 Fill | almost every 16th plays while held.
const wood     = colJojo(7)
const woodVar  = change(wood.btn, 'jojo', 'Holz', 3)
const woodKeep = wood.char.fmap(d => f => f > 0.5 ? 0.85 : 0.06 + 0.5 * d).appLeft(wood.btn2)   // share of 16ths

const stemJ7_wood = beatOnly(strip(bus(reseed(woodVar,
  n(irand(5).segment(16))
    .degradeBy(woodKeep.fmap(k => 1 - k))
    .sometimesBy(0.4, x => x.penv(-9).pattack(0.04))   // drops: glide up into the note
    .decay(rand.range(0.05, 0.14)).sustain(0)
    .gain(rand.range(0.2, 0.4)).pan(rand)
).scale(scaleIn(5)).s("sine").fm(wood.bright.mul(4)).fmh(2.76), 2, wood.space, 0.4), {
  lpf: pure(9000),
  level: wood.level.range(0, 1.7),   // was 1; mix: wood −13 dB
}))

// ============================================================
// JOJO 8 CRACKLE — vinyl dust: very short noise clicks on a 32nd grid
// ============================================================
// @007 ctl B16:8.k1 Brightness | 0 = soft crackle ↔ bright sizzle (lpf 5–16 kHz).
// @007 ctl B16:8.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl B16:8.k3 Density | a little dust ↔ heavy crackle.
// @007 ctl B16:8.fader Level | crackle, vinyl dust. Keeps playing in the break.
// @007 ctl B16:8.b1 Change | next of 3 random crackle patterns.
// @007 ctl B16:8.b2 Double | twice as much crackle while held.
const dust     = colJojo(8)
const dustVar  = change(dust.btn, 'jojo', 'Knistern', 3)
const dustKeep = dust.char.fmap(d => dbl => Math.min(0.9, (0.04 + 0.4 * d) * (dbl > 0.5 ? 2 : 1))).appLeft(dust.btn2)

const stemJ8_dust = strip(bus(reseed(dustVar,
  s("white*32").degradeBy(dustKeep.fmap(k => 1 - k))
    .decay(rand.range(0.002, 0.015)).sustain(0)
    .gain(rand.range(0.2, 1.2)).pan(rand)
).hpf(900), 1, dust.space, 0.15), {
  lpf: expRange(dust.bright, 5000, 16000),
  level: dust.level.range(0, 1.7),   // was 1; mix: crackle −16 dB
})

// ============================================================
// JONAS 1 PAD — slow random chords from the mood's scale
// ============================================================
// @007 ctl 16:1.k1 Brightness | muffled ↔ open and airy (lpf 300–8000 Hz).
// @007 ctl 16:1.k2 Space | dry and close ↔ far away in a big room (reverb + echo).
// @007 ctl 16:1.k3 Swell | 0 = still, held chords. Up = the chord is re-struck every half bar and breathes in and out.
// @007 ctl 16:1.fader Level | long floating chords.
// @007 ctl 16:1.b1 Change | 3 chord progressions: calm → circling → open.
// @007 ctl 16:1.b2 Freeze | holds the current chord while held.
const pad      = colJonas(1)
const padVar   = change(pad.btn, 'jonas', 'Pad', 3, ['I–IV', 'I–iii–IV–ii', 'I–vi–IV–vii'])
const padSwell = pad.char
// Scale-degree chords (stacked thirds on degrees 1, 2, 3, 4, 6, 7 of the mood's scale)
const PADS = ["[0,2,4,6]", "[1,3,5,8]", "[2,4,6,8]", "[3,5,7,9]", "[5,7,9,11]", "[6,8,10,12]"].map(c => n(c))
// Freeze: while the button is held, keep returning the chord index that was playing when it was pressed
const freeze = (button, pat) => {
  let kept = null
  return pat.fmap(v => b => b > 0.5 ? (kept ??= v) : (kept = null, v)).appLeft(button)
}
// Progressions as indices into PADS, one chord per 2 bars
const PAD_PROGS = [[0, 0, 3, 3], [0, 2, 3, 1], [0, 4, 3, 5]].map(p => cat(...p).slow(2))
const padChord = freeze(pad.btn2, padVar.pat.fmap(i => PAD_PROGS[i]).innerJoin()).fmap(i => PADS[i]).innerJoin()

const padStill = stack(
  padChord.scale(scaleIn(3)).s("sawtooth").attack(1.2).sustain(0.8).release(3).gain(0.22)
    .pan(sine.slow(5).range(0.3, 0.7)),
  padChord.scale(scaleIn(3)).s("triangle").attack(0.8).sustain(0.8).release(3).gain(0.35)
)
const padBreath = padChord.struct("x*2").scale(scaleIn(3)).s("sawtooth,triangle")
  .attack(0.9).decay(1).sustain(0.15).release(1.2).gain(0.25).pan(sine.slow(5).range(0.3, 0.7))

const stemN1_pad = strip(bus(wobble(stack(
  gate(above(fadeMain(padSwell), 0), padStill.mul(gain(fadeMain(padSwell)))),
  gate(above(fadeExtra(padSwell), 0), padBreath.mul(gain(fadeExtra(padSwell))))
)), 2, pad.space), {
  lpf: expRange(pad.bright, 300, 8000),
  level: pad.level.range(0, 0.79),   // was 1; mix: pad = reference, −14 LUFS at swell 0.5
})

// ============================================================
// JONAS 2–4 — Eno bowed, marimba, toms (Takada style): from lab/harmonie/midori-5.strudel (feedback 2: instead of
// chords, music box and whale)
// ============================================================
// Ported 1:1 from the lab board (its makeCols below, same figures, controls, levels, ranges); per column: row 1 =
// brightness (low-pass over the lab's range, brighter also up to +2 dB), row 2 = space (the lab's: a little room and
// echo even at 0), row 3 = complexity, fader = level, button 1 = change (at the next bar), button 2 held = echo throw.
// Deviations (track-wide, as for every stem): the figures' scale degrees follow the chapter (scaleIn: lydian → dorian
// → whole tone) instead of the lab's fixed D lydian; Fog / Tension on the filters, global Room, Tension echo; the
// Tension wobble on the bowed loops; orbit 2 (dotted-8th echo as in the lab, feedback 0.6 instead of 0.55).
// Levels from the lab (bowed ×1, marimba ×1.6, toms ×2.5 at full fader); GM sounds cannot be rendered offline, so they
// are not measured against the other stems yet.
// @007 ctl 16:2.k1 Brightness | soft ↔ bright (lpf 800–12000 Hz).
// @007 ctl 16:2.k2 Space | room and dotted-8th echo (a little at 0).
// @007 ctl 16:2.k3 Complexity | 2 loops ↔ 6 loops drifting against each other.
// @007 ctl 16:2.fader Level | bowed vibraphone loops (Eno, Music for Airports).
// @007 ctl 16:2.b1 Change | note set: calm (fifths) → lydian (G♯, C♯) → low and slower.
// @007 ctl 16:2.b2 Echo throw | held: long dotted-8th echo.
// @007 ctl 16:3.k1 Brightness | soft mallet ↔ bright (lpf 600–6000 Hz).
// @007 ctl 16:3.k2 Space | room and dotted-8th echo (a little at 0).
// @007 ctl 16:3.k3 Complexity | 0 = one figure ↔ all layers (Euclid: also denser; build-up: up to 7, louder and brighter).
// @007 ctl 16:3.fader Level | marimba figures laid over each other (Takada).
// @007 ctl 16:3.b1 Change | cycles → canon → cells → Euclid → build-up.
// @007 ctl 16:3.b2 Echo throw | held: long dotted-8th echo.
// @007 ctl 16:4.k1 Brightness | soft ↔ bright (lpf 600–6000 Hz).
// @007 ctl 16:4.k2 Space | room and dotted-8th echo (a little at 0).
// @007 ctl 16:4.k3 Complexity | 0 = the figure alone ↔ fuller: rests fill up, canon voices, a drifting copy.
// @007 ctl 16:4.fader Level | tom figures.
// @007 ctl 16:4.b1 Change | cycles → canon → Euclid → build-up → crossing → Clapping.
// @007 ctl 16:4.b2 Echo throw | held: long dotted-8th echo.
// The lab's column code (lab/harmonie/midori-5.strudel, makeCols), unchanged except: degrees → scaleIn (chapter),
// its knob reads (h.knob / h.at) and the drift offsets' name. Returns the three columns { name, pats, range, gain, tom }.
const makeNewJonas = (h, scaleIn) => {
  const gate = (cond, pat) => cond.fmap(on => on ? pat : silence).innerJoin()
  const md = (k, n) => ((k % n) + n) % n
  const hash = (a, b, c) => {
    let x = Math.imul(a + 0x9e3779b9 | 0, 0x85ebca6b) ^ Math.imul(b + 0x632be59b | 0, 0xc2b2ae35) ^ Math.imul(c + 0x27d4eb2f | 0, 0x165667b1)
    x ^= x >>> 15; x = Math.imul(x, 0x2c1b3c6d); x ^= x >>> 12; x = Math.imul(x, 0x297a2d39); x ^= x >>> 15
    return (x >>> 0) / 4294967296
  }
  // Scale degrees follow the chapter: n(d).scale(scaleIn(3 + octave)), 0 = D3 (the lab: fixed D lydian)
  const toks = fig => fig.trim().split(/\s+/)
  const accOf = t => { const f = t.findIndex(x => x !== '~'); return t.map((_, j) => j === f ? 1 : 0.6) }
  // A layer: a figure of scale degrees (~ = rest), one per step (`steps` per bar, 16 = 16ths), cycling over its own
  // length regardless of the bar; its first note accented
  const layer = (fig, oct = 1, pan = 0.5, g = 0.5, steps = 16) => {
    const t = toks(fig)
    return n(mini('{' + t.join(' ') + '}%' + steps)).scale(scaleIn(3 + oct))
      .velocity(mini('{' + accOf(t).join(' ') + '}%' + steps)).s('gm_marimba').gain(g).pan(pan)
  }
  // Layers on row 3 of column i: layer 1 always, the others one by one as the knob goes up
  const layers = (i, ls) => stack(...ls.map((l, v) => v === 0 ? l
    : gate(h.knob(29 + i).fmap(k => v < 1 + Math.round((ls.length - 1) * k)), l))).delay(0.12)
  const opts = (i, list) => list.map(([name, ls]) => [name, layers(i, ls)])
  // A figure padded with rests to length L
  const pad = (fig, L) => { const t = toks(fig); return [...t, ...Array(Math.max(0, L - t.length)).fill('~')].join(' ') }
  // A figure moved by `sh` scale degrees
  const shift = (fig, sh) => toks(fig).map(x => x === '~' ? x : String(+x + sh)).join(' ')
  // Euclid: `hits` spread evenly over L steps, rotated by `rot`, the hits play `notes` in turn
  const euclid = (hits, L, notes, rot = 0) => {
    let j = 0
    return [...Array(L).keys()].map(k => ((md(k + rot, L) * hits) % L) < hits ? String(notes[j++ % notes.length]) : '~').join(' ')
  }
  // A step offset that grows by 1 every `every` bars, `n` moves to a round (as a pattern of time offsets, 1 = a bar)
  const moving = (every, n, stepLen, dir = 1) =>
    mini('<' + [...Array(n).keys()].flatMap(k => Array(every).fill(md(dir * k, n) * stepLen)).join(' ') + '>')

  // 1a Cycles: [figure, octave, pan]
  const C5 = ['4 ~ 7 ~ 9', 1, 0.3], C7 = ['0 ~ ~ 2 ~ 4 ~', 0, 0.7], ANCHOR = ['0 ~ ~ ~ ~ ~ ~ ~ 4 ~ ~ ~ ~ ~ ~ ~', 0, 0.5]
  const CYCLES = [
    ['Zyklen 5·7', [C5, C7]],
    ['Zyklen 5·7·12', [C5, C7, ['7 ~ 4 ~ 2 ~ 4 ~ 6 ~ 4 ~', 1, 0.5], ANCHOR]],
    ['Zyklen 5·7·11·13', [C5, C7, ['9 ~ 7 ~ 4 ~ ~ 6 ~ 4 ~', 1, 0.55], ['2 ~ 4 ~ ~ 7 ~ ~ 11 ~ 9 ~ ~', 1, 0.45], ANCHOR]],
  ].map(([n, ls]) => [n, ls.map(s => layer(...s))])
  // 1b Canon: one figure, voices [late by 16ths, octave, pan]
  const VOICES = [[0, 1, 0.3], [3, 1, 0.7], [5, 0, 0.5], [11, 2, 0.6]]
  const canon = fig => VOICES.map(([o, oct, pan]) => layer(fig, oct, pan, oct === 2 ? 0.35 : 0.5).late(o / 16))
  const CANON = [['Kanon einfach', '0 4 ~ 7 4 ~ 2 ~'], ['Kanon mittel', '4 ~ 2 4 ~ 7 ~ ~'], ['Kanon lang', '7 ~ 6 4 ~ 2 4 ~ 9 ~ 7 ~']]
    .map(([n, f]) => [n, canon(f)])
  // 1c Similar cells: one cell, padded to slightly different lengths, each layer a little moved in pitch and place
  const CELLS = [['Zellen 2 Töne', '0 ~ 4', [4, 5, 6, 7]], ['Zellen 4 Töne', '0 ~ 4 7 ~ 9', [7, 8, 9, 10]], ['Zellen 6 Töne', '0 4 ~ 7 9 ~ 11 ~ 7', [10, 11, 12, 13]]]
  const SIM = [[0, 1, 0.3], [2, 1, 0.7], [-3, 1, 0.5], [4, 0, 0.45]]   // [shift, octave, pan] per layer
  const similar = CELLS.map(([n, cell, lens]) => [n, lens.map((L, v) => layer(pad(shift(cell, SIM[v][0]), L), SIM[v][1], SIM[v][2]))])
  // 2 Euclid: [hits, length, notes, octave, pan]
  const eu = list => list.map(([k, L, ns, oct, pan, rot = 0]) => layer(euclid(k, L, ns, rot), oct, pan))
  const EUCLID = [
    ['Locker', eu([[3, 8, [4, 7, 2], 1, 0.3], [2, 5, [9, 6], 1, 0.7], [3, 11, [0, 4, 2], 0, 0.5], [2, 13, [11, 9], 1, 0.5]])],
    ['Mittel', eu([[3, 8, [4, 7, 2], 1, 0.3], [5, 13, [0, 2, 4, 2, 7], 1, 0.7], [4, 11, [9, 7, 6, 4], 1, 0.5], [3, 16, [0, -3, 2], 0, 0.5]])],
    ['Dicht', eu([[5, 8, [4, 7, 9, 7, 2], 1, 0.3], [7, 13, [0, 2, 4, 7, 4, 2, 6], 1, 0.7], [7, 16, [9, 7, 4, 6, 11, 9, 7], 1, 0.5, 3],
      [4, 9, [0, 4, -3, 2], 0, 0.5]])],
  ]
  // 3 Build-up: layer v enters at bar v × every of a 64-bar round and stays to its end; row 3 (intensity) caps how many
  // may enter and swells them: gain ×0.7 → ×1.4, brightness ×0.6 → ×2. Layers 6–7: dense 16ths, high.
  const BUILD = [['0 ~ 4 7 ~ 4 2 ~', 1, 0.35], ['0 ~ 4 7 ~ 4 2 ~ ~', 1, 0.65], ['7 ~ ~ 9 ~ ~ 4', 1, 0.5],
    ['0 ~ ~ ~ ~ ~ -3 ~ ~ ~', 0, 0.5], ['11 ~ ~ 9 ~ ~ ~ ~ ~ 7 ~', 2, 0.55, 0.35],
    ['4 7 9 7 4 2 4 7 9 11', 1, 0.3, 0.35], ['7 9 11 9 7 4 7 9 11', 2, 0.7, 0.3]]
  const swell = p => p.fmap(v => k => ({ ...v, gain: v.gain * (0.7 + 0.7 * k), bright: 0.6 + 1.4 * k })).appLeft(h.knob(30))
  const entering = every => BUILD.map((s, v) => v === 0 ? layer(...s)
    : gate(signal(t => md(Math.floor(t + 1e-9), 64) >= v * every).segment(1), layer(...s)))
  const BUILD_RAW = [['alle 8 Takte', entering(8)], ['alle 4 Takte', entering(4)], ['alle 2 Takte', entering(2)]]
  const BUILDUP = BUILD_RAW.map(([n, ls]) => [n, ls.map(swell)])
  // 4 Bell pulse: an agogo bell on the quarters with line 1; line 2 fills the gaps of line 1 (interlocked), or runs a
  // step shorter and slides; line 3 (row 3) slides too
  const bell = note(mini('{77 ~ ~ ~}%16')).s('gm_agogo').gain(0.25).pan(0.5)
  const L1 = '4 ~ 7 ~ 2 ~ 4 ~', L2 = '~ 9 ~ 6 ~ 7 ~ 4', L2s = '~ 9 ~ 6 ~ 7 ~', L3 = '0 ~ ~ 2 ~ ~ 4 ~ ~'
  const BELL = [
    ['verzahnt', [stack(bell, layer(L1, 1, 0.3)), layer(L2, 1, 0.7), layer(pad('0 ~ ~ 2', 8), 0, 0.5)]],
    ['Linie 2 rutscht', [stack(bell, layer(L1, 1, 0.3)), layer(L2s, 1, 0.7), layer(pad('0 ~ ~ 2', 8), 0, 0.5)]],
    ['alle rutschen', [stack(bell, layer(L1, 1, 0.3)), layer(L2s, 1, 0.7), layer(L3, 0, 0.5)]],
  ]
  // 5 Railway crossing: each crossing = a two-tone bell in 8ths, [high, low, octave, pan]; crossing v runs at speed
  // 1 + spread × SPEEDS[v], so they fall out of step and come back (spread 0.01 = a 16th apart after ~6 bars)
  const CROSSINGS = [[4, 2, 1, 0.35], [7, 6, 1, 0.65], [9, 7, 1, 0.5], [2, 0, 0, 0.5]]
  const SPEEDS = [0, 1, -0.7, 1.6]
  const crossing = spread => CROSSINGS.map(([a, b, oct, pan], v) => layer(a + ' ' + b, oct, pan, 0.45, 8).fast(1 + spread * SPEEDS[v]))
  // the same, all crossings on the same two tones (A–F♯), only their speed differs (row 3 on the toms)
  const crossingSame = spread => CROSSINGS.map(([, , , pan], v) => layer('4 2', 1, pan, 0.45, 8).fast(1 + spread * SPEEDS[v]))
  const CROSS = [['weit', crossing(0.045)], ['weiter', crossing(0.07)], ['sehr weit', crossing(0.1)]]
  // 6 Clapping Music (Reich 1972): 12 pulses per bar (8th triplets), x x x . x x . x . x x .; voice 2 one pulse ahead
  // after every `every` bars, back in unison after 12 moves; the hits play the notes in turn
  const CLAP = 'x x x ~ x x ~ x ~ x x ~'
  const clapFig = notes => { let j = 0; return toks(CLAP).map(x => x === '~' ? x : String(notes[j++ % notes.length])).join(' ') }
  // The West African standard bell pattern in 12/8 (x . x . x x . x . x . x; Toussaint, “The Geometry of Musical
  // Rhythm”), on the agogo and as a marimba line that moves too
  const BELL12 = 'x ~ x ~ x x ~ x ~ x ~ x'
  const bellFig = notes => { let j = 0; return toks(BELL12).map(x => x === '~' ? x : String(notes[j++ % notes.length])).join(' ') }
  const v1 = layer(clapFig([0, 4, 7, 4, 2, 4, 7, 9]), 1, 0.3, 0.5, 12)
  const v2 = layer(clapFig([7, 9, 11, 9, 7, 4, 7, 6]), 1, 0.7, 0.5, 12).early(moving(4, 12, 1 / 12))
  const v3 = layer(clapFig([0, -3, 2, 0, 4, 2]), 0, 0.5, 0.45, 12).late(moving(6, 12, 1 / 12))
  const agogo12 = note(mini('{' + toks(BELL12).map(x => x === '~' ? x : 77).join(' ') + '}%12')).s('gm_agogo').gain(0.22).pan(0.5)
  const v4 = layer(bellFig([9, 11, 9, 7, 6, 4, 7]), 2, 0.55, 0.35, 12).early(moving(3, 12, 1 / 12))
  const CLAPPING = [
    ['Reich (2 Stimmen)', [v1, v2, layer('0 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~', 0, 0.5, 0.45, 12)]],
    ['3 Stimmen', [v1, v2, v3]],
    ['3 Stimmen + Glocke', [stack(v1, agogo12), v2, v3, v4]],
  ]

  // 1 Eno bowed (ambient rounds 1–2): single notes on loops of different lengths that drift apart
  const ENO_LOOPS = [5.3, 6.7, 7.9, 9.1, 10.7, 12.3], ENO_OFFS = [0, 2.1, 4.4, 1.3, 6.2, 3.5]
  // Note sets (user, 2026-11-08: the old open / middle / high were too alike; high sat in the shimmer's register):
  // [name, scale degrees (the first two always sound), loop stretch]. Calm = fifths only (D A E B), lydian = with G♯ and
  // C♯ first, low = down to A2 and slower. All below the shimmer (Jonas 7, from about D5).
  const ENO_SETS = [['Ruhig', [0, 4, 8, 7, 11, 12], 1], ['Lydisch', [3, 6, 4, 8, 10, 13], 1], ['Tief', [0, -3, 4, 2, 7, 1], 1.5]]
  const eno = (i, sound) => ENO_SETS.map(([name, set, sl]) => [name, sound(stack(...set.map((d, v) =>
    gate(h.knob(29 + i).fmap(k => v < 2 + Math.round(4 * k)),
      n(d).struct(mini('x ~ ~')).slow(ENO_LOOPS[v] * sl).late(ENO_OFFS[v] * sl).pan(0.2 + 0.6 * ((v * 0.37) % 1)).scale(scaleIn(3))))))])
  const bowedVib = p => p.s('vibraphone_bowed').attack(0.6).release(3).gain(6).delay(0.3)

  // 3 Toms, row 3 = Shift: layer v runs at speed 1 + spread × DRIFT_DIR[v], spread = 0.1 × knob² (0.1 = the old
  // “very far” crossing). The offset is integrated over time (per layer), so turning the knob changes the drift speed
  // without the layers jumping. Offsets live in globalThis (survive re-evaluation; reset with the board id).
  const DRIFT_DIR = [0, 1, -0.7, 1.6, -1.3, 0.8, -1.8]
  const DR = globalThis.ambient007Drift ??= {}
  const spreadNow = t => 0.1 * Math.pow(h.at(31, t), 2)
  const drifting = (key, dir, p) => dir === 0 ? p : new Pattern(state => {
    const t = state.span.begin.valueOf(), d = DR[key] ??= { t, off: 0 }
    const dt = t - d.t
    if (dt > 0 && dt < 1) d.off += dt * dir * spreadNow(t)
    d.t = t
    return d.off === 0 ? p.query(state) : p.early(d.off).query(state)
  })
  // ---- Round 5 b (user, 2026-11-08 evening): fewer options, the knob does the rest -------------------------------
  // Marimba (row 3 = cc 30): cycles as ONE option (row 3 adds 5 → 7 → anchor → 12 → 11 → 13), canon long, cells
  // 4 notes, Euclid as ONE option (row 3 adds layers AND makes each denser: sparse → middle → dense), build-up every 4 bars.
  const ZYKLEN = [C5, C7, ANCHOR, ['7 ~ 4 ~ 2 ~ 4 ~ 6 ~ 4 ~', 1, 0.5], ['9 ~ 7 ~ 4 ~ ~ 6 ~ 4 ~', 1, 0.55],
    ['2 ~ 4 ~ ~ 7 ~ ~ 11 ~ 9 ~ ~', 1, 0.45]].map(s => layer(...s))
  const eucKnob = cc => stack(...[0, 1, 2, 3].map(v => gate(h.knob(cc).fmap(k => v < 1 + Math.round(3 * k)),
    h.knob(cc).fmap(k => Math.min(2, Math.floor(3 * k))).fmap(d => EUCLID[d][1][v]).innerJoin()))).delay(0.12)
  const MARIMBA = [
    ['Zyklen', layers(1, ZYKLEN)],
    ['Kanon', layers(1, CANON[2][1])],
    ['Zellen', layers(1, similar[1][1])],
    ['Euklid', eucKnob(30)],
    ['Aufbau', layers(1, BUILDUP[1][1])],
  ]

  // Toms (row 3 = cc 31), one figure each (several different tom layers = mush):
  //   Density (cycles, canon, Euclid, build-up): the figure's rests fill up with tom strokes, one by one in a fixed
  //   order (5 steps: 0, ¼, ½, ¾, all of the rests), each a neighbour of the note before it, velocity 0.55; from the
  //   middle on every 4th filled stroke jumps an octave. 0 = the figure as written.
  //   Shift (railway crossing): one copy of the figure drifts away, faster the higher.
  //   Clapping Music: 0 = the pattern alone; up = the second voice comes in and moves one pulse every 8 → 4 → 2 bars.
  const rank = n => [...Array(n).keys()].sort((a, b) => hash(a, n, 7) - hash(b, n, 7))
  const denseFig = (fig, level) => {
    const t = toks(fig), rests = t.map((x, j) => x === '~' ? j : -1).filter(j => j >= 0)
    const fill = new Set(rank(rests.length).slice(0, Math.round(rests.length * level / 4)).map(r => rests[r]))
    let last = +(t.find(x => x !== '~') ?? 0), n = 0
    const out = t.map((x, j) => {
      if (x !== '~') { last = +x; return { d: last, vel: null } }
      if (!fill.has(j)) return { d: '~', vel: 0 }
      n++
      return { d: last + (n % 2 ? 1 : -1) + (level >= 2 && n % 4 === 0 ? 7 : 0), vel: 0.55 }
    })
    const acc = accOf(t)
    return [out.map(o => o.d).join(' '), out.map((o, j) => o.vel ?? acc[j]).join(' ')]
  }
  const denseLayer = (fig, oct, pan, g = 0.5, steps = 16) => [0, 1, 2, 3, 4].map(level => {
    const [f, v] = denseFig(fig, level)
    return n(mini('{' + f + '}%' + steps)).scale(scaleIn(3 + oct)).velocity(mini('{' + v + '}%' + steps))
      .s('gm_marimba').gain(g).pan(pan)
  })
  const dense = (fig, oct = 1, pan = 0.4, g = 0.5, steps = 16) => {
    const lv = denseLayer(fig, oct, pan, g, steps)
    return h.knob(31).fmap(k => Math.min(4, Math.round(4 * k))).fmap(l => lv[l]).innerJoin()
  }
  // Build-up on toms (user: stacked tom layers = loud, unpleasant overlaps): ONE figure that fills up by itself, a
  // density level more every 4 bars of a 32-bar round (0 → 4, then held); row 3 caps the level: 0 = level 1 at most,
  // 1 = all the rests filled
  const buildLv = denseLayer(BUILD[0][0], 1, 0.4)
  const tomBuild = h.knob(31).fmap(k => 1 + Math.round(3 * k)).fmap(cap => signal(t => Math.min(cap, Math.floor(md(Math.floor(t + 1e-9), 32) / 4)))
    .segment(1).fmap(l => buildLv[l]).innerJoin()).innerJoin()
  // Canon on toms (user: filling the rests sounded weird): row 3 brings in the canon voices — from 1/3 the same figure
  // a dotted 8th (3 16ths) later on the right, from 2/3 a third voice 5 16ths later on the left, both a little softer
  const KFIG = '0 4 ~ 7 4 ~ 2 ~'
  const tomCanon = stack(layer(KFIG, 1, 0.45),
    gate(h.knob(31).fmap(k => k > 1 / 3), layer(KFIG, 1, 0.75, 0.4).late(3 / 16)),
    gate(h.knob(31).fmap(k => k > 2 / 3), layer(KFIG, 1, 0.2, 0.35).late(5 / 16)))
  const tomShift = (name, p) => stack(p, gate(h.knob(31).fmap(k => k > 0.02), drifting(name, 1, p.pan(0.75))))
  const clapRates = [8, 4, 2].map(e => layer(clapFig([7, 9, 11, 9, 7, 4, 7, 6]), 1, 0.7, 0.5, 12).early(moving(e, 12, 1 / 12)))
  const tomClap = stack(v1, gate(h.knob(31).fmap(k => k > 0.02),
    h.knob(31).fmap(k => Math.min(2, Math.floor(3 * k))).fmap(r => clapRates[r]).innerJoin()))
  const TOMS = [
    ['Zyklen', dense(C5[0], 1, 0.4)],
    ['Kanon', tomCanon],
    ['Euklid', dense(euclid(3, 8, [4, 7, 2]), 1, 0.4)],
    ['Aufbau', tomBuild],
    ['Bahnübergang', tomShift('crossing', layer('4 2', 1, 0.35, 0.45, 8))],
    ['Clapping Music', tomClap],
  ].map(([n, p]) => [n, p.delay(0.12)])

  const col = (name, k3name, pats, extra = {}) => ({ name, space: 'bus', floor: 0.25, hall: 6, k3: 'own', k3name,
    range: [600, 6000], gain: 1, pats, ...extra })
  return [
    col('Eno-Bogen', 'Komplexität', eno(0, bowedVib), { range: [800, 12000] }),
    col('Marimba', 'Komplexität', MARIMBA, { gain: 1.6 }),            // +4 dB (user: louder)
    col('Toms', 'Komplexität', TOMS, { tom: true, gain: 4 }),    // +12 dB (user: toms louder still; 2026-11-09: louder again, was 2.5)
  ]
}

const bowed   = colJonas(2)
const marimba = colJonas(3)
const toms    = colJonas(4)
// The lab's knob access: knob(cc) = the knob as a pattern (lab CCs 29, 30, 31 = row 3 of its columns 1–3), at(cc, t) =
// its value at time t (for the toms' drift, which integrates over time)
const LAB_K3 = { 29: bowed.char, 30: marimba.char, 31: toms.char }
const knobVal = (pat, t) => pat.queryArc(t, t + 1e-4)[0]?.value ?? 0
const NEW_JONAS = makeNewJonas({ knob: cc => LAB_K3[cc], at: (cc, t) => knobVal(LAB_K3[cc], t) }, scaleIn)

// One column: the lab's options on button 1 (latched to the next bar), toms converted (GM melodic tom an octave lower,
// accents softened), the lab's space (floor 0.25: a little room and echo at 0) on orbit 2, echo throw on button 2,
// brightness = low-pass over the lab's range (×bright per note, for build-up) and ±2 dB, level × the lab's gain
const labSpace  = space => space.fmap(s => 0.25 + 0.75 * s)
const echoThrow = (pat, button) => pat.fmap(v => b => b > 0.5 ? { ...v, delay: Math.max(v.delay ?? 0, 0.65) } : v).appLeft(button)
const newJonas = (col, c, label, long = false) => {
  const latch = change(col.btn, 'jonas', label, c.pats.length, c.pats.map(([name]) => name))
  const built = c.pats.map(([, p]) => p)
  let pat = latch.pat.fmap(i => built[i]).innerJoin()
  if (c.tom) pat = pat.fmap(v => v.s === 'gm_marimba' ? { ...v, s: 'gm_melodic_tom', note: (typeof v.note === 'string' ? noteToMidi(v.note) : v.note) - 12,
    velocity: 0.6 + 0.4 * ((v.velocity ?? 0.6) - 0.6) } : v)
  if (long) pat = wobble(pat)
  return strip(echoThrow(bus(pat, 2, labSpace(col.space)), col.btn2), {
    lpf: expRange(col.bright, ...c.range),
    level: col.level.range(0, c.gain ?? 1).mul(col.bright.fmap(b => Math.pow(10, 4 * (b - 0.5) / 20))),
  }).fmap(({ bright, ...v }) => bright ? { ...v, cutoff: Math.min(18000, v.cutoff * bright) } : v)
}
const stemN2_bowed   = newJonas(bowed, NEW_JONAS[0], 'Bogen', true)
const stemN3_marimba = newJonas(marimba, NEW_JONAS[1], 'Marimba')
const stemN4_toms    = newJonas(toms, NEW_JONAS[2], 'Toms')


// ============================================================
// JONAS 5 CHOIR — the answer: breathy “aah/ooh” voices on half notes
// ============================================================
// @007 ctl 16:5.k1 Brightness | hushed ↔ clear (lpf 500–10000 Hz).
// @007 ctl 16:5.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl 16:5.k3 Voices | 0 = one voice, 0.5 = + a third above, 1 = + a fifth: three-part harmony.
// @007 ctl 16:5.fader Level | choir voices.
// @007 ctl 16:5.b1 Change | middle → low → high register (new melody each time).
// @007 ctl 16:5.b2 Full choir | all three voices while held.
const choir       = colJonas(5)
const choirVar    = change(choir.btn, 'jonas', 'Chor', 3, ['mittel', 'tief', 'hoch'])
const choirScale  = choirVar.pat.fmap(i => [scaleIn(4), scaleIn(3), scaleIn(5)][i]).innerJoin()
const choirVoices = choir.char.fmap(c => b => b > 0.5 ? 1 : c).appLeft(choir.btn2)

// One voice: a saw through a vowel filter (vowel per note: a, o, u, e). The vowel filter is 5 band-passes per
// note, the most expensive part of the track, so only the lead voice gets a slightly detuned second saw (chorus).
const choirVoice = (deg, g, detuned = false) => {
  const v = reseed(choirVar, n(irand(5).segment(2).mul(2).add(deg))).scale(choirScale)
  return (detuned ? v.superimpose(x => x.add(note(0.12))) : v)
    .s("sawtooth").vowel("<a o u e>/2")
    .attack(0.7).sustain(0.8).release(1.8)
    .gain(g)
}

const stemN5_choir = strip(bus(wobble(stack(
  choirVoice(0, 0.2, true),
  gate(above(choirVoices, 0), choirVoice(2, ramp(choirVoices, 0, 0.5).mul(0.21))),
  gate(above(choirVoices, 0.5), choirVoice(4, ramp(choirVoices, 0.5, 1).mul(0.17)))
)), 1, choir.space), {
  lpf: expRange(choir.bright, 500, 10000),
  level: choir.level.range(0, 1.0),   // was 1; mix: choir −2 dB
})

// ============================================================
// JONAS 6 GLITTER — a real glockenspiel (General MIDI soundfont) struck at random on a 16th grid: metal bars that ring
// out, random notes of the mood's scale (without the 4th and 7th degree, the sharpest ones), long echoes
// ============================================================
// @007 ctl 16:6.k1 Brightness | soft mallets ↔ bright metal (lpf 3–16 kHz).
// @007 ctl 16:6.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl 16:6.k3 Density | a drop now and then (~1 per bar) ↔ a sparkling rain (~70 % of the 16ths).
// @007 ctl 16:6.fader Level | random glockenspiel notes.
// @007 ctl 16:6.b1 Change | high → very high → middle register.
// @007 ctl 16:6.b2 Run | runs up and down the scale, denser and louder the longer it is held (full after 2 bars).
const glit     = colJonas(6)
const glitVar  = change(glit.btn, 'jonas', 'Glitzer', 3, ['hoch', 'sehr hoch', 'mittel'])
const glitKeep = glit.char.fmap(d => 0.06 + 0.64 * d)   // share of 16ths
const glitScale = glitVar.pat.fmap(i => [scaleIn(5), scaleIn(6), scaleIn(4)][i]).innerJoin()
const GLIT_TONES = [0, 1, 2, 4, 5, 7, 8, 9, 11]   // scale degrees over 1.5 octaves, without the 4th and 7th
const glitTone  = k => irand(GLIT_TONES.length).segment(k).fmap(i => GLIT_TONES[i])
const glitRise  = heldRamp(glit.btn2, 2)                 // 0 → 1 over 2 bars while held
// Every bar keeps ringing after the next is struck (a metal bar, no damper)
const glock = pat => pat.s("gm_glockenspiel").release(1.2)
// A player's sweep: up and down GLIT_TONES in 32nds
const GLIT_RUN = n("[0 1 2 4 5 7 8 9 11 9 8 7 5 4 2 1]*2")

const stemN6_glitter = strip(bus(stack(
  reseed(glitVar, glock(n(glitTone(16))
    .degradeBy(glitKeep.fmap(k => 1 - k)))
    .gain(rand.range(0.15, 0.4))
    .pan(rand)
    .delay(0.55)),
  // Run: starts as a few scattered notes of the sweep and fills in over 2 bars (15 % → 90 % of the 32nds), getting
  // louder; random velocities keep it played, not ticking. Released = gone.
  gate(held(glit.btn2), glock(GLIT_RUN.degradeBy(glitRise.fmap(r => 0.85 - 0.75 * r)))
    .gain(glitRise.fmap(r => v => (0.2 + 0.3 * r) * v).appLeft(rand.range(0.7, 1)))
    .pan(sine.fast(2).range(0.3, 0.7)).delay(0.4))
).scale(glitScale), 2, glit.space), {
  lpf: expRange(glit.bright, 3000, 16000),
  level: glit.level.range(0, 0.6),   // was 1; mix: glockenspiel −12 dB under the pad
})

// ============================================================
// JONAS 7 SHIMMER — high tones that swell in slowly and hang in the air
// ============================================================
// @007 ctl 16:7.k1 Brightness | dark whoosh ↔ bright shimmer (lpf 1.5–14 kHz).
// @007 ctl 16:7.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl 16:7.k3 Amount | subtle (one tone) ↔ wild (a bell-like chord with long echoes).
// @007 ctl 16:7.fader Level | shimmer swells.
// @007 ctl 16:7.b1 Change | a new tone every 2 bars → every 4 bars → every bar.
// @007 ctl 16:7.b2 Rise | while held, a cloud of tones climbs an octave and grows denser over 2 bars.
const fx       = colJonas(7)
const fxVar    = change(fx.btn, 'jonas', 'Schimmer', 3, ['2 Takte', '4 Takte', '1 Takt'])
const fxAmount = fx.char
const fxRise   = heldRamp(fx.btn2, 2)
const FX_NOTES = [2, 4, 1].map(len => n(irand(7).segment(1).slow(len)))   // scale degree, a new one every len bars
const fxNotes  = reseed(fxVar, fxVar.pat.fmap(i => FX_NOTES[i]).innerJoin())

const stemN7_shimmer = strip(bus(stack(
  wobble(fxNotes.scale(scaleIn(5)).s("triangle")
    .attack(2.5).sustain(0.7).release(4).gain(0.18).pan(sine.slow(9).range(0.2, 0.8))),
  gate(above(fxAmount, 0), wobble(stack(fxNotes.add(n(2)), fxNotes.add(n(4))).scale(scaleIn(5)).s("sine")
    .fm(fxAmount.mul(2)).fmh(2).attack(1.5).sustain(0.6).release(4)
    .gain(fxAmount.mul(0.14)).pan(sine.slow(7)).delay(0.6))),
  // Rise: random tones around the current note that climb an octave and thicken from a few to most 16ths over 2 bars;
  // loose timing (nudge), own level and length per tone, so it swells like a cloud, not a machine
  gate(held(fx.btn2), n(irand(5).segment(16)).add(fxNotes).add(n(fxRise.fmap(r => Math.floor(7 * r))))   // 16th grid first: add keeps the left structure
    .degradeBy(fxRise.fmap(r => 0.85 - 0.6 * r))
    .scale(scaleIn(5)).s("triangle").nudge(rand.range(0, 0.04))
    .attack(0.02).decay(rand.range(0.2, 0.7)).sustain(0).release(0.4)
    .gain(fxRise.fmap(r => 0.08 + 0.3 * r)).mul(gain(rand.range(0.5, 1)))
    .pan(rand).delay(0.6))
), 2, fx.space), {
  lpf: expRange(fx.bright, 1500, 14000),
  level: fx.level.range(0, 1.86),   // was 1; mix: shimmer −10 dB
})


// What the LC view shows for this track: the chapter (now, next) on column 8 button 1, and extra lines at the top
const lcChapter = () => ['D ' + MOODS[moodLatch.now].name, 'D ' + MOODS[moodLatch.pending].name]
const lcHead    = () => []
// Where the music is (LC view): the beat in the bar and the bar in the big cycle. A silent event per beat moves it at
// the moment the beat sounds (onTrigger, as in the set). chordAt(bar) = the chord of that bar ('' = none shown)
const CYCLE   = 8   // the pad's progression: 4 chords × 2 bars
const chordAt = bar => ''
const beatNow = { bar: null, beat: null }
const beatTick = pure(0).segment(4).fmap(() => ({})).onTrigger((hap, now, cps, t) => {
  const pos = hap.whole.begin.valueOf(), bar = Math.floor(pos + 1e-9), beat = Math.floor((pos - bar) * 4 + 1e-9)
  setTimeout(() => { beatNow.bar = bar; beatNow.beat = beat; lcView?.update() }, Math.max(0, (t - now) * 1000))
}, true)

// LC view of this evaluation: names from the tags in the editor (strudel.cc keeps the text in strudelMirror),
// buttons from the change() rows (row i = column i + 1), chapter and break on column 8
return { taps, showStatus, STATUS, lcChapter, lcHead, stems: { J1: stemJ1_pulse, J2: stemJ2_wind, J3: stemJ3_drone, J4: stemJ4_bass, J5: stemJ5_rim, J6: stemJ6_ticks, J7: stemJ7_wood, J8: stemJ8_dust, N1: stemN1_pad, N2: stemN2_bowed, N3: stemN3_marimba, N4: stemN4_toms, N5: stemN5_choir, N6: stemN6_glitter, N7: stemN7_shimmer } }
})()

// ============================================================
// TRACK 010 — Ambient House (from tracks/010-ambient-house/010-ambient-house-dual.strudel)
// ============================================================
// @010 layout Track 010 — ambient house (two controllers)
// @010 note Ambient house in D minor, 120 BPM, a sunrise mood. Jojo plays the foundation (kick, bass, drums, congas), Jonas the colour (pad, chords, melodies, birds) and the global column 8.
// @010 note Every row means the same everywhere: row 1 = brightness, row 2 = space, row 3 = character, fader = level, button 1 = next pattern (at the next bar), button 2 = a moment while held.
// @010 note Start with all faders down. Nothing sounds until Jonas' master fader (column 8) is up. Chapter (Jonas, column 8) changes the chords for everybody at the next 4-bar phrase.
// @010 note The status box at the bottom right of the Strudel page shows chapter, break and each stem's pattern. Its button “als Fenster” opens it as a small window that stays on top (Chrome/Edge).
// @010 mode B16 Jojo — Foundation (beat + bass)
// @010 col B16:1 1 Kick
// @010 col B16:2 2 Atmo Pump
// @010 col B16:3 3 Sub
// @010 col B16:4 4 Bassline
// @010 col B16:5 5 Clap / Rim
// @010 col B16:6 6 Hats
// @010 col B16:7 7 Congas
// @010 col B16:8 8 Shaker / Ride
// @010 row B16:k1 Row 1 \ Brightness
// @010 row B16:k2 Row 2 \ Space
// @010 row B16:k3 Row 3 \ Character
// @010 row B16:fader Fader \ Level
// @010 row B16:b1 Button 1 \ Change
// @010 row B16:b2 Button 2 \ Moment
// @010 mode 16 Jonas — Colour (chords + melodies) · column 8 = global
// @010 col 16:1 1 Pad
// @010 col 16:2 2 Deep Chords
// @010 col 16:3 3 Pluck Arp
// @010 col 16:4 4 Lead
// @010 col 16:5 5 Marimba
// @010 col 16:6 6 Glockenspiel
// @010 col 16:7 7 Birds
// @010 col 16:8 8 Global
// @010 row 16:k1 Row 1 \ Brightness
// @010 row 16:k2 Row 2 \ Space
// @010 row 16:k3 Row 3 \ Character
// @010 row 16:fader Fader \ Level
// @010 row 16:b1 Button 1 \ Change
// @010 row 16:b2 Button 2 \ Moment
// @010 guide Sunrise | Start like the sky before dawn: Jonas brings pad and birds, Jojo the atmo pump and the sub. The kick comes only when both are ready.
// @010 guide Playing together | Jojo builds the floor: kick, sub, off-beat hats, then the rolling bass and the groove (congas, shaker). Keep it dry; the room belongs to Jonas.
// @010 guide Playing together | Jonas colours it: pad and deep chords first (all knobs at 0 is a good start), then arp and marimba. The lead is for the long, slow moments.
// @010 guide Playing together | Chapter changes the chords for both players at the next 4-bar phrase: sub, bass and every melody follow. Pad button 2 (freeze) holds the chord for everybody.
// @010 guide Build-up and drop | Jonas turns Tension up (echo, open filters, snare roll), presses Break at the top: the beat goes out, pad and birds float. Jojo holds the atmo riser, Jonas presses Break again: back on the one. Then let Tension go.
// @010 guide Every position sounds good | No filter closes completely. Arp, lead and marimba keep a little room even at space 0.
const T010 = await (async () => {
const ID = 1
const PHRASE = phraseOf(SET_TRACKS[1])
const ORBIT0 = 3
const focusOnly = button => button.fmap(v => SET.focus() === ID ? v : 0)

const ramp = (sig, from, to) => sig.fmap(v => Math.min(1, Math.max(0, (v - from) / (to - from))))
// Row-3 crossfade: 0..0.5 brings the extra layer in, 0.5..1 fades the main layer out
const fadeMain  = knob => ramp(knob, 1, 0.5)
const fadeExtra = knob => ramp(knob, 0, 0.5)
// Exponential knob range for filters (Hz), so every part of the knob travel is audible
const expRange = (knob, lo, hi) => knob.fmap(v => lo * Math.pow(hi / lo, v))

const bpm  = 120
const beat = 60 / bpm   // seconds per quarter note, for delay times

// Mapping of column n (1-8): brightness, space, character (knob rows 1-3), fader, button rows 1-2
const colMap = (read, n) => ({ bright: read(12 + n), space: read(20 + n), char: read(28 + n), level: read(4 + n), btn: read(36 + n), btn2: read(44 + n) })
const off = () => signal(() => 0)
// Column 8 (global) is read from both its Mode 16 and Mode 2 CCs, last moved wins: it works on both pages even on a
// controller whose column 8 sends CC + 48 in Mode 2
// One controller: Jojo on the plain CCs (Mode 1), Jonas on CC + 48 (Mode 2)
const alone    = !ccJojo
const colJonas = n => n === 8 ? SET.glob : colMap(n === 8 ? c => lastMoved(ccJonas(c), ccJonas(c + 48)) : alone ? c => ccJonas(c + 48) : ccJonas, n)
const colJojo  = n => !alone ? colMap(ccJojo, n) : n === 8 ? colMap(off, n) : colMap(ccJonas, n)

const gate  = (cond, pat) => cond.fmap(on => on ? pat : silence).innerJoin()
const above = (sig, x) => sig.fmap(v => v > x)
const and   = (a, b) => a.fmap(x => y => x && y).appLeft(b)
const held  = button => button.fmap(v => v > 0.5)

// Stateful controls, collected so the master can query them every tick (see stateTaps)
const taps = []

// Two inputs for one control: the value follows whichever moved last (stateful, so it is queried via stateTaps)
const lastMoved = (a, b) => {
  let pa = null, pb = null, v = 0
  const pat = a.fmap(x => y => {
    if (pa === null) v = Math.max(x, y)
    else if (y !== pb) v = y
    else if (x !== pa) v = x
    pa = x; pb = y
    return v
  }).appLeft(b)
  taps.push(pat)
  return pat
}

// Momentary button that steps through n states, one step per press (counts presses, not the held value).
// onChange(state) runs on every step (for the status box). Re-evaluating the code starts again at 0.
const cycleButton = (button, n, onChange = () => {}) => {
  button = focusOnly(button)   // set: presses count only for the track in focus
  let prev = 0, state = 0
  const pat = button.fmap(v => {
    if (v > 0.5 && prev <= 0.5) { state = (state + 1) % n; onChange(state) }
    prev = v
    return state
  })
  taps.push(pat)
  return pat
}

// A value that a button sets now but that takes over only at the next bar line, or with len = 4 at the next
// 4-bar phrase (chapter). at(t) is asked with bar starts in real time (outside any reseed shift); it remembers the
// previous value for queries that still reach back into the old bar. pat = the value per bar.
const barLatch = (len = 1) => {
  const l = { pending: 0, now: 0, prev: 0, bar: -Infinity }
  l.at = t => {
    const bar = Math.floor(Number(t) / len)
    if (bar > l.bar) {
      if (l.pending !== l.now) { l.prev = l.now; l.now = l.pending; showStatus() }
      else l.prev = l.now
      l.bar = bar
    }
    return bar >= l.bar ? l.now : l.prev
  }
  l.pat = signal(t => l.at(t)).segment(1)
  taps.push(l.pat)
  return l
}

// 0 → 1 over `cycles` while a button is held, back to 0 on release (for risers)
const heldRamp = (button, cycles) => {
  let start = null
  const pat = button.fmap(v => t => {
    if (v <= 0.5) { start = null; return 0 }
    start ??= t
    return Math.min(1, Math.max(0, (t - start) / cycles))
  }).appLeft(signal(t => Number(t)))
  taps.push(pat)
  return pat
}

// Freeze: while the button is held, keep returning the value that was playing when it was pressed
const freeze = (button, pat) => {
  let kept = null
  return pat.fmap(v => b => b > 0.5 ? (kept ??= v) : (kept = null, v)).appLeft(button)
}


// ============================================================
// CHAPTERS — chord progressions in D minor, one chord per bar, 4 bars = one phrase
// ============================================================
// Roots as scale degrees of D natural minor (0 = D). Stacked thirds on them: Dm9, Fmaj7, Gm9, B♭maj7, C (add9).
// A (degree 4) and E (degree 1) are never roots: their 9th would clash (B♭ over A, F over E).
const CHAPTERS = [
  { name: 'Dämmerung',     roots: [0, 5, 2, 6], chords: 'Dm9 – B♭maj7 – Fmaj7 – C' },   // i–VI–III–VII
  { name: 'Sonnenaufgang', roots: [5, 6, 0, 0], chords: 'B♭maj7 – C – Dm9 – Dm9' },     // VI–VII–i–i
  { name: 'Schweben',      roots: [0, 3, 0, 3], chords: 'Dm9 – Gm9 – Dm9 – Gm9' },      // i–iv
  { name: 'Wärme',         roots: [2, 5, 3, 0], chords: 'Fmaj7 – B♭maj7 – Gm9 – Dm9' }, // III–VI–iv–i
]
const scaleIn = octave => 'D' + octave + ':minor'


// Rows of the status box, filled by change(): { label, latch, n, names } per player
const STATUS = { jojo: [], jonas: [] }
const showStatus = () => {
  if (!statusUi || SET.focus() !== ID) return
  const dots = v => [...Array(8).keys()].map(k => k === v ? '●' : '○').join('')
  const show = (r, v) => !r.names ? String(v + 1) : r.names[v]
  const line = (r, i) => (i + 1) + ' ' + r.label.padEnd(10) + ' ' + (r.n === 8 ? dots(r.latch.now) + ' ' : '') +
    show(r, r.latch.now) + (r.latch.pending !== r.latch.now ? ' → ' + show(r, r.latch.pending) : '')
  const ch = chapterLatch
  statusUi.text.textContent = [
    ...SET.statusLines(),
    'Kapitel     ' + CHAPTERS[ch.now].name +
      (ch.pending !== ch.now ? ' → ' + CHAPTERS[ch.pending].name + ' (nächste Phrase)' : ''),
    'Akkorde     ' + CHAPTERS[ch.now].chords,
    '', alone ? 'Mode 1 · Jojo' : 'Jojo', ...STATUS.jojo.map(line),
    '', alone ? 'Mode 2 · Jonas' : 'Jonas', ...STATUS.jonas.map(line),
  ].join('\n')
  lcView?.update()
}
// Button 1 of a stem: n patterns (default 8), one step per press, taking over at the next bar
const change = (button, who, label, n = 8, names) => {
  const latch = barLatch()
  cycleButton(button, n, s => { latch.pending = s; showStatus() })
  STATUS[who].push({ label, latch, n, names })
  return latch
}
// Pattern number i of a list, switched by a change latch
const pick = (latch, pats) => latch.pat.fmap(i => pats[i]).innerJoin()

// ============================================================
// GLOBAL (Jonas, column 8) — acts on both controllers
// ============================================================
// @010 ctl g.k1 Fog | 0 = clear, up = every filter pulled down to ~6 %: muffled, as if heard from outside the tent.
// @010 ctl g.k2 Room | 0 = each sound's own room (row 2), up = everything drowns in reverb.
// @010 ctl g.k3 Tension | build-up: echo grows, filters open (not hats, clap, shaker), from the middle a snare roll (clap fader). 0 = release.
// @010 ctl g.fader Master Level | volume of everything, both controllers. 0 = silence.
// @010 ctl g.b1 Chapter | next chord progression for all, at the next 4-bar phrase.
// @010 ctl g.b2 Break / Drop | 1st: beat out. 2nd: all back on the one.
const glob        = colJonas(8)
const globalFog   = glob.bright.fmap(f => Math.pow(0.06, f))
const globalRoom  = glob.space
const tension     = glob.char
const tensionEcho = ramp(tension, 0, 0.5).mul(0.45)     // delay send, 0..0.45
const tensionRoll = ramp(tension, 0.5, 1)               // snare roll, 0..1
// Factor on every lpf: fog darkens (down to 0.06), tension opens (up to 2.5)
const globalTone  = globalFog.fmap(f => o => f * o).appLeft(tension.fmap(t => 1 + 1.5 * t))
const globalLevel = glob.level.range(0, 1)

const chapterLatch = barLatch(PHRASE)
cycleButton(glob.btn, CHAPTERS.length, s => { chapterLatch.pending = s; showStatus() })
const breakLatch = barLatch()
cycleButton(glob.btn2, 2, s => { breakLatch.pending = s; showStatus() })
// Jojo's low end and backbeat, gated while the break is on
const beatOn   = breakLatch.pat.fmap(b => b === 0)
const beatOnly = pat => gate(beatOn, pat)

const audible = level => and(above(level, 0), above(globalLevel, 0))
// lpf × fog/tension, kept between 80 Hz and 18 kHz (fog never makes a stem silent)
const toned  = (lpf, tone = globalTone) => lpf.fmap(f => g => Math.min(18000, Math.max(80, f * g))).appLeft(tone)
// Reverb send: the stem's space knob (0..0.9), raised by the global Room up to 0.95
const roomOf = space => space.fmap(s => g => { const r = 0.9 * s; return r + (0.95 - r) * g }).appLeft(globalRoom)
// Change: read the stem's randomness 1024 cycles further per step (keeps bar alignment, new random values).
// The chord root is applied after reseed, so it follows real time.
const reseed = (latch, pat) => pat.early(latch.pat.fmap(v => v * 1024))

// Effect buses. Each orbit has one reverb and one delay, and every reverb costs a lot of CPU, so the stems share
// two orbits; stems on one orbit share room size and echo time/feedback.
// Orbit 1 = drums and bass: small, dry room, short dotted-8th slap.
// Orbit 2 = all of Jonas' colour (and the atmo riser): a wide open-air hall, long dotted-8th echo.
const BUSES = {
  1: { hall: 1.2, time: beat * 0.75, feedback: 0.25 },
  2: { hall: 5, time: beat * 0.75, feedback: 0.55 },
}
// bus(): reverb from the space knob, and echo: the layer's own delay amount (or `echo` if it has none) × 2 × space,
// so space 0.5 = the designed amount; Tension's echo takes over where it is larger.
const bus = (pat, orbit, space, echo = 0) => pat
  .fmap(v => sc => e => ({ ...v, delay: Math.max(Math.min(0.9, (v.delay ?? echo) * sc), e) }))
  .appLeft(space.fmap(s => 2 * s)).appLeft(tensionEcho)
  .room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)
  .delaytime(BUSES[orbit].time).delayfeedback(BUSES[orbit].feedback)
// Reverb only, no echo (kick, sub and bass would smear)
const dryBus = (pat, orbit, space) => pat.room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)

// Channel strip: lpf × fog/tension (if given), level × master as postgain, gated while the fader or master is 0.
// high: hats, clap, shaker: Fog darkens them, but Tension does not open their filter (it made them far too loud).
const strip = (stem, { lpf, level, high = false }) => {
  const pat = lpf === undefined ? stem : stem.lpf(toned(lpf, high ? globalFog : globalTone))
  return gate(audible(level), pat.postgain(level.mul(globalLevel)))
}
const drum = (names, bank = 'RolandTR909') => s(names).bank(bank)

// ============================================================
// HARMONY — Chapter picks the progression, everybody follows its root; pad button 2 freezes it for all
// ============================================================
const PROG_PATS = CHAPTERS.map(c => cat(...c.roots))   // one chord per bar, the phrase starts with chord 1
const pad       = colJonas(1)
const harmRoot  = freeze(pad.btn2, pick(chapterLatch, PROG_PATS))
// Chord = shape (scale degrees above the root) on the current root; built once per root and shape
const CHORD_CACHE = {}
const chordOn = shape => harmRoot.fmap(r => CHORD_CACHE[shape + '@' + r] ??= n(stack(...shape.map(d => d + r)))).innerJoin()
const onRoot  = pat => pat.add(n(harmRoot))

// Roots for the low end: A, B♭ and C go an octave down, so sub and bass stay between A1 and G2
const lowRoot  = harmRoot.fmap(r => r >= 4 ? r - 7 : r)
const onLow    = pat => pat.add(n(lowRoot))

// ============================================================
// JOJO 1 KICK — four on the floor: a 909 kick with a sine body tuned to D2 (the root), firm at all knobs 0
// ============================================================
// Softness up = the pitch drop gets smaller and slower, the attack fades in, the 909 fades out: a deep, soft thump.
// @010 ctl B16:1.k1 Brightness | 0 = firm, round kick with a little click ↔ clicky attack (lpf 1.5–10 kHz).
// @010 ctl B16:1.k2 Space | dry and close ↔ in a room (reverb).
// @010 ctl B16:1.k3 Softness | 0 = firm 909 kick ↔ 1 = deep, soft thump without click.
// @010 ctl B16:1.fader Level | 0 = gone. Four-on-the-floor kick, tuned to D.
// @010 ctl B16:1.b1 Change | straight → pickup before the 1 → gap every 4th bar.
// @010 ctl B16:1.b2 Drop out | kick pauses while held.
const kick     = colJojo(1)
const kickVar  = change(kick.btn, 'jojo', 'Kick', 3, ['gerade', 'Auftakt', 'Lücke'])
const kickSoft = kick.char
const KICKS = ["1*4", "1 1 1 [1 ~ ~ 0.4]", "<[1*4] [1*4] [1*4] [1 1 1 ~]>"]
  .map(g => stack(
    gain(g).note("d2").s("sine").decay(kickSoft.fmap(s => 0.4 + 0.2 * s)).sustain(0).release(0.05)
      .attack(kickSoft.fmap(s => 0.002 + 0.012 * s))
      .penv(kickSoft.fmap(s => 24 - 12 * s)).pdecay(kickSoft.fmap(s => 0.035 + 0.045 * s)),
    gain(g).mul(gain(kickSoft.fmap(s => 0.75 * (1 - s)))).s("bd").bank("RolandTR909")
  ))

const stemJ1_kick = beatOnly(gate(kick.btn2.fmap(v => v <= 0.5), strip(dryBus(
  pick(kickVar, KICKS).mul(gain(0.8)), 1, kick.space), {
  lpf: expRange(kick.bright, 1500, 10000),
  level: kick.level.range(0, 1),
})))

// ============================================================
// JOJO 2 ATMO PUMP — soft tape-hiss noise glued to the kick (swells in after every kick, like a sidechain),
// or slow waves over two bars
// ============================================================
// @010 ctl B16:2.k1 Brightness | dull whoosh ↔ airy hiss (lpf 1.5–12 kHz).
// @010 ctl B16:2.k2 Space | dry ↔ far away (reverb + echo).
// @010 ctl B16:2.k3 Motion | still ↔ the filter breathes and the noise wanders left and right.
// @010 ctl B16:2.fader Level | noise that pumps with the kick.
// @010 ctl B16:2.b1 Change | pump → off-beat breath → slow waves.
// @010 ctl B16:2.b2 Riser | a noise sweep rises over 2 bars while held.
const noiseCol  = colJojo(2)
const noiseVar  = change(noiseCol.btn, 'jojo', 'Atmo', 3, ['Pumpe', 'Offbeat', 'Wellen'])
const noiseMove = noiseCol.char
const noiseRise = heldRamp(noiseCol.btn2, 2)
const NOISES = [
  s("[~ pink@3]*4").attack(0.14).sustain(0.7).release(0.03).hpf(900).gain(2),
  s("[~ pink]*4").attack(0.08).sustain(0.5).release(0.06).hpf(1800).gain(2),
  // Waves: one long swell every 2 bars, like the sea at dawn
  s("pink/2").attack(1.8).sustain(1).release(1.8).hpf(400).gain(1.4),
]
// Riser: 16th noise bursts through a bandpass that climbs from 300 Hz to 6 kHz, getting louder. Keeps playing in the break.
const noiseRiser = gate(held(noiseCol.btn2), s("pink*16")
  .attack(0.03).sustain(0.8).release(0.15)
  .bpf(noiseRise.fmap(r => 300 * Math.pow(20, r))).bpq(4)
  .gain(noiseRise.mul(0.35)).pan(sine.fast(2)))

const stemJ2_noise = strip(stack(
  beatOnly(bus(pick(noiseVar, NOISES)
    .lpf(toned(expRange(noiseCol.bright, 1500, 12000)).fmap(f => m => w => f * (1 - 0.7 * m * w)).appLeft(noiseMove).appLeft(sine.slow(2)))
    .pan(noiseMove.fmap(m => p => 0.5 + m * (p - 0.5)).appLeft(sine.slow(3))), 1, noiseCol.space, 0.15)),
  bus(noiseRiser, 2, pure(0.3))
), {
  level: noiseCol.level.range(0, 1),
})

// ============================================================
// JOJO 3 SUB — a sine on the low chord root (A1–G2): each note starts a 16th after the kick (ducked, without a compressor)
// ============================================================
// @010 ctl B16:3.k1 Brightness | 0 = sine with a few overtones (audible on small speakers) ↔ warm and full.
// @010 ctl B16:3.k2 Space | dry ↔ a little room (reverb).
// @010 ctl B16:3.k3 Length | long, pumping notes ↔ short, bouncing ones.
// @010 ctl B16:3.fader Level | sub on the chord root, follows the chapter.
// @010 ctl B16:3.b1 Change | pump → off-beat → one long note per bar.
// @010 ctl B16:3.b2 Slide | every note bends up into its pitch while held.
const sub      = colJojo(3)
const subVar   = change(sub.btn, 'jojo', 'Sub', 3, ['Pumpe', 'Offbeat', 'lang'])
const subClip  = sub.char.fmap(c => 1 - 0.65 * c)   // share of the note length that sounds
const subSlide = sub.btn2.fmap(v => v > 0.5 ? -5 : 0)
const SUBS = ["[~ 0@3]*4", "[~ 0]*4", "~ 0@15"].map(p => onLow(n(p)).scale(scaleIn(2)))
const subNotes = pick(subVar, SUBS)

const stemJ3_sub = beatOnly(strip(dryBus(stack(
  subNotes.s("sine").gain(0.5),
  subNotes.s("triangle").gain(sub.bright.fmap(b => 0.1 + 0.17 * b))
).attack(0.015).sustain(1).release(0.04).clip(subClip).penv(subSlide).pattack(0.07), 1, sub.space), {
  level: sub.level.range(0, 1),
}))

// ============================================================
// JOJO 4 BASSLINE — rolling melodic-house bass: triangle + a quiet saw, round, a soft filter pluck, a little drive
// ============================================================
// @010 ctl B16:4.k1 Brightness | 0 = round and woody ↔ warm buzz (lpf 250–2000 Hz + envelope).
// @010 ctl B16:4.k2 Space | dry ↔ a little room (reverb).
// @010 ctl B16:4.k3 Groove | the line as it is ↔ extra 16th notes rolling in between.
// @010 ctl B16:4.fader Level | rolling bass, follows the chapter.
// @010 ctl B16:4.b1 Change | rolling → off-beat → melodic.
// @010 ctl B16:4.b2 Octave | one octave up while held.
const bassCol = colJojo(4)
const bassVar = change(bassCol.btn, 'jojo', 'Bass', 3, ['rollend', 'Offbeat', 'Melodie'])
const bassOct = bassCol.btn2.fmap(v => v > 0.5 ? 12 : 0)
// [main line, extra 16ths], scale degrees above the low chord root (7 = octave, 4 = fifth, 2 = third)
const BASS_LINES = [
  ["[~ 0 0 ~] [~ 0 0 ~] [~ 0 0 ~] [~ 0 4 ~]", "[~ ~ ~ 0]*4"],
  ["[~ 0]*4", "[~ ~ ~ 0]*4"],
  ["[0 ~ ~ 0] [~ ~ 4 ~] [~ 0 ~ ~] [2 ~ 4 ~]", "[~ 0 ~ ~]*4"],
].map(([main, extra]) => [onLow(n(main)), onLow(n(extra))])
const bassSound = pat => pat.scale(scaleIn(2)).add(note(bassOct))
  .s("triangle").superimpose(x => x.s("sawtooth").add(note(-0.07)).gain(0.35))
  .attack(0.004).decay(0.2).sustain(0.35).release(0.07).lpq(3).lpenv(1.5).lpdecay(0.15).lpsustain(0).shape(0.2)

const stemJ4_bass = beatOnly(strip(dryBus(stack(
  bassSound(pick(bassVar, BASS_LINES.map(l => l[0]))).mul(gain(0.5)),
  gate(above(bassCol.char, 0), bassSound(pick(bassVar, BASS_LINES.map(l => l[1]))).mul(gain(bassCol.char.mul(0.35))))
), 1, bassCol.space), {
  lpf: expRange(bassCol.bright, 250, 2000),
  level: bassCol.level.range(0, 1),
}))

// ============================================================
// JOJO 5 CLAP / RIM — a soft 909 clap on 2 and 4, or a dry 909 rimshot, or both
// ============================================================
// @010 ctl B16:5.k1 Brightness | 0 = natural, a little soft ↔ sharp crack (lpf 3.5–14 kHz).
// @010 ctl B16:5.k2 Space | dry ↔ far away (reverb + echo).
// @010 ctl B16:5.k3 Ghost notes | plain ↔ a quiet rim before beat 3 ↔ + small double taps.
// @010 ctl B16:5.fader Level | clap / rim on 2 and 4. Also the level of Tension's snare roll.
// @010 ctl B16:5.b1 Change | clap → rim with a pickup → clap + rim.
// @010 ctl B16:5.b2 Roll | snare roll, growing over the bar, while held.
const clap      = colJojo(5)
const clapVar   = change(clap.btn, 'jojo', 'Clap', 3, ['Clap', 'Rim', 'beides'])
const clapGhost = clap.char
// The 909 clap sample as it is, with its own tail (an envelope cut it off after 0.18 s and sounded choked)
const clapHit = g => gain(g).s("cp").bank("RolandTR909")
const rimHit  = g => gain(g).s("rim").bank("RolandTR909")
const CLAPS = [
  clapHit("~ 0.7 ~ 0.7"),
  rimHit("~ 0.6 ~ [0.6 ~ ~ 0.3]"),
  stack(clapHit("~ 0.6 ~ 0.6"), rimHit("[~ ~ ~ 0.35] ~ [~ ~ 0.3 ~] ~")),
]

const stemJ5_clap = beatOnly(strip(bus(stack(
  pick(clapVar, CLAPS),
  gate(above(clapGhost, 0), rimHit("~ ~ 0.25 ~").mul(gain(ramp(clapGhost, 0, 0.5)))),
  gate(above(clapGhost, 0.5), rimHit("~ [~ 0.18] ~ [~ ~ 0.15 ~]").mul(gain(ramp(clapGhost, 0.5, 1)))),
  gate(held(clap.btn2), drum("sd*16").gain(saw.range(0.1, 0.5))),
  // Tension roll: 8ths → 16ths, louder as Tension rises
  gate(above(tensionRoll, 0), drum("sd*16").degradeBy(tensionRoll.fmap(t => 0.5 * (1 - t)))
    .gain(tensionRoll.fmap(t => 0.1 + 0.35 * t)))
).mul(gain(0.9)).hpf(300).pan(0.47), 1, clap.space, 0.2), {   // was 1.5: the open clap peaked at 1.34 (clipping)
  lpf: expRange(clap.bright, 3500, 14000),   // was 1500: at knobs 0 only 300–1500 Hz were left, a boxy, honking clap
  high: true,
  level: clap.level.range(0, 1),
}))

// ============================================================
// JOJO 6 HATS — a short, dry open hat on the off-beat, closed 16ths in the other patterns
// ============================================================
// @010 ctl B16:6.k1 Brightness | soft hiss ↔ crisp and sharp (lpf 3–16 kHz).
// @010 ctl B16:6.k2 Space | dry ↔ far away (reverb + echo).
// @010 ctl B16:6.k3 Density | the pattern as it is ↔ + quiet 16ths ↔ + little 32nd rolls.
// @010 ctl B16:6.fader Level | off-beat hat. Keeps playing in the break.
// @010 ctl B16:6.b1 Change | off-beat → + 16ths → shuffled 16ths.
// @010 ctl B16:6.b2 Open | long open hats on every 8th while held.
const hats    = colJojo(6)
const hatVar  = change(hats.btn, 'jojo', 'Hats', 3, ['Offbeat', '16tel', 'Shuffle'])
const hatDens = hats.char
const offHat  = drum("[~ oh]*4").decay(0.12).sustain(0).gain(0.4)
const HATS = [
  offHat,
  stack(offHat, drum("hh*16").gain("[0.2 0.1 0 0.12]*4")),
  stack(offHat, drum("hh*16").gain("[0.22 0.08 0.14 0.1]*4").swingBy(0.4, 8)),
]

const stemJ6_hats = strip(bus(stack(
  pick(hatVar, HATS),
  gate(above(hatDens, 0), drum("hh*16").degradeBy(0.4).gain(ramp(hatDens, 0, 0.5).mul(0.12))),
  gate(above(hatDens, 0.5), drum("hh*32").degradeBy(0.8).gain(ramp(hatDens, 0.5, 1).mul(0.18))),
  gate(held(hats.btn2), drum("oh*8").gain(0.3))
).mul(gain(1.2)).pan(0.56), 1, hats.space, 0.2), {
  lpf: expRange(hats.bright, 3000, 16000),
  high: true,
  level: hats.level.range(0, 1),
})

// ============================================================
// JOJO 7 CONGAS — TR-727 latin percussion: conga low (n 4), bongo high / low (n 2 / 3); agogo bells (n 0 / 1) with density
// ============================================================
// @010 ctl B16:7.k1 Brightness | soft and woody ↔ crisp slap (lpf 600–12000 Hz).
// @010 ctl B16:7.k2 Space | dry ↔ far away (reverb + echo).
// @010 ctl B16:7.k3 Density | steady pattern ↔ + fingertip ghost notes ↔ + agogo bells.
// @010 ctl B16:7.fader Level | congas and bongos. Keep playing in the break.
// @010 ctl B16:7.b1 Change | pillow → rolling → latin.
// @010 ctl B16:7.b2 Fill | a conga run over the bar while held.
const perc     = colJojo(7)
const percVar  = change(perc.btn, 'jojo', 'Congas', 3, ['Kissen', 'rollend', 'Latin'])
const percDens = perc.char
const conga = (pat, g) => n(pat).s("perc").bank("RolandTR727").gain(g)
const PERCS = ["4 ~ ~ 2 ~ ~ 3 ~ 4 ~ ~ 2 ~ 3 ~ ~", "~ ~ 4 2 ~ ~ 4 ~ ~ 3 ~ 2 ~ ~ 4 ~", "3 ~ 2 ~ 4 ~ 2 3 ~ 2 ~ 4 ~ ~ 2 ~"]
  .map(p => conga(p, perlin.range(0.2, 0.3)))

const stemJ7_perc = strip(bus(stack(
  pick(percVar, PERCS),
  gate(above(percDens, 0), conga(irand(2).add(2).segment(16), ramp(percDens, 0, 0.5).mul(0.09)).degradeBy(0.55)),
  gate(above(percDens, 0.5), conga("~ 0 ~ ~ 1 ~ ~ 0 ~ ~ 1 ~ 0 ~ ~ ~", ramp(percDens, 0.5, 1).mul(0.13))),
  gate(held(perc.btn2), conga("2 2 3 3 2 3 4 4 2 2 3 3 4 3 4 4", 0.25))
).pan(sine.slow(4).range(0.35, 0.65)), 1, perc.space, 0.3), {
  lpf: expRange(perc.bright, 600, 12000),
  level: perc.level.range(0, 1),
})

// ============================================================
// JOJO 8 SHAKER / RIDE — TR-727 maracas on 16ths, a quiet 909 ride on the off-beats
// ============================================================
// @010 ctl B16:8.k1 Brightness | soft shimmer ↔ bright sizzle (lpf 4.5–16 kHz).
// @010 ctl B16:8.k2 Space | dry ↔ far away (reverb + echo).
// @010 ctl B16:8.k3 Swing | straight ↔ swung, lazy (the in-between 16ths come late).
// @010 ctl B16:8.fader Level | shaker and ride. Keep playing in the break.
// @010 ctl B16:8.b1 Change | shaker → ride → both.
// @010 ctl B16:8.b2 Double | double time while held.
const shake    = colJojo(8)
const shakeVar = change(shake.btn, 'jojo', 'Shaker', 3, ['Shaker', 'Ride', 'beides'])
const maracas  = g => gain(g).s("sh").bank("RolandTR727").n(1)
const ride     = g => gain(g).s("rd").bank("RolandTR909")
const SHAKERS = [
  maracas("[0.35 0.18 0.26 0.18]*4"),
  ride("[~ 0.16]*4"),
  stack(maracas("[0.3 0.15 0.22 0.15]*4"), ride("[~ 0.12]*4")),
]

const stemJ8_shake = strip(bus(pick(shakeVar, SHAKERS)
  .fast(shake.btn2.fmap(v => v > 0.5 ? 2 : 1))
  .swingBy(shake.char.mul(0.6), 8)   // 0.6 = the off-16th lands on the last triplet
  .mul(gain(3)).pan(0.62), 1, shake.space, 0.25), {
  lpf: expRange(shake.bright, 4500, 16000),
  high: true,
  level: shake.level.range(0, 1),
})

// ============================================================
// JONAS 1 PAD — warm, soft pad: detuned saws + a triangle on the chapter's 7th / 9th chords, slow attack
// ============================================================
// @010 ctl 16:1.k1 Brightness | muffled ↔ open and airy (lpf 300–5000 Hz).
// @010 ctl 16:1.k2 Space | dry and close ↔ far away in a big room (reverb + echo).
// @010 ctl 16:1.k3 Swell | still ↔ slowly breathing in and out (every 2 bars).
// @010 ctl 16:1.fader Level | warm pad on the chapter's chords.
// @010 ctl 16:1.b1 Change | voicing: warm → open (9th) → wide.
// @010 ctl 16:1.b2 Freeze | holds the current chord while held, for everybody.
const padVar   = change(pad.btn, 'jonas', 'Pad', 3, ['warm', 'offen', 'weit'])
const padSwell = pad.char
// Voicings in scale degrees above the root: seventh chord, upper tones with the 9th, spread (low root, 5th, 7th, 10th)
const PAD_VOICINGS = [[0, 2, 4, 6], [2, 4, 6, 8], [-7, 4, 6, 9]].map(v => chordOn(v).scale(scaleIn(3)))
const padChord = pick(padVar, PAD_VOICINGS)

const stemN1_pad = strip(bus(stack(
  padChord.s("sawtooth").superimpose(x => x.add(note(0.14))).gain(0.2),
  padChord.s("triangle").gain(0.25)
).attack(0.8).sustain(0.8).release(1.8).pan(sine.slow(5).range(0.3, 0.7))
  .mul(gain(padSwell.fmap(c => w => 1 - 0.75 * c * w).appLeft(sine.slow(2)))), 2, pad.space, 0.15), {
  lpf: expRange(pad.bright, 300, 5000),
  level: pad.level.range(0, 1),
})

// ============================================================
// JONAS 2 DEEP CHORDS — deep-house minor-9 / maj-7 stabs, rootless (the bass has the root), a soft FM e-piano tone
// ============================================================
// FM sine with ratio 1 and low index = a mellow, Rhodes-like bark; a triangle underneath for warmth. Dry at space 0.
// @010 ctl 16:2.k1 Brightness | warm and muffled ↔ bright, barking (lpf 600–8000 Hz).
// @010 ctl 16:2.k2 Space | dry ↔ the dotted-8th echoes repeat far into the room.
// @010 ctl 16:2.k3 Rhythm | long ringing chords ↔ short, choppy stabs.
// @010 ctl 16:2.fader Level | chord stabs on the chapter's chords.
// @010 ctl 16:2.b1 Change | next of 8 deep-house rhythms.
// @010 ctl 16:2.b2 Stab | a chord on every off-beat while held.
const keys      = colJonas(2)
const keysVar   = change(keys.btn, 'jonas', 'Akkorde')
const keysLen   = keys.char.fmap(c => 1.2 * Math.pow(0.1, c))   // decay seconds: 1.2 ↔ 0.12
// Rootless voicing: 3rd, 5th, 7th, 9th (Dm9 = F A C E)
const keysChord = chordOn([2, 4, 6, 8]).scale(scaleIn(3))
const KEYS_RHYTHMS = ["~ ~ ~ x ~ ~ x ~ ~ ~ ~ ~ ~ ~ ~ ~", "x ~ ~ x ~ ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~", "~ ~ x ~ ~ ~ ~ ~ ~ x ~ ~ ~ ~ x ~",
  "x ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~", "~ ~ ~ x ~ ~ ~ x ~ ~ ~ ~ ~ ~ x ~", "<[x ~ ~ x ~ ~ x ~ ~ ~ ~ ~ ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ ~ x ~ ~]>",
  "~ x ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~ x ~ ~", "x ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~ x ~ ~ ~"]
const KEYS_PATS = KEYS_RHYTHMS.map(r => keysChord.struct(r))
const keysSound = pat => stack(
  pat.s("sine").fm(0.7).fmh(1).gain(0.32),
  pat.s("triangle").gain(0.14)
).attack(0.005).decay(keysLen).sustain(0.05).release(keysLen.mul(0.6)).shape(0.1).pan(0.45)

const stemN2_keys = strip(bus(stack(
  keysSound(pick(keysVar, KEYS_PATS)).delay(0.4),
  gate(held(keys.btn2), keysSound(keysChord.struct("[~ x]*4")).delay(0.3))
), 2, keys.space), {
  lpf: expRange(keys.bright, 600, 8000),
  level: keys.level.range(0, 1),
})

// ============================================================
// JONAS 3 PLUCK ARP — soft melodic-house pluck on the chord tones (stepwise, no octave leaps), with echo
// ============================================================
// Keeps a little room even at space 0.
// @010 ctl 16:3.k1 Brightness | soft, woody plucks ↔ clear, sparkling (lpf 900–8000 Hz).
// @010 ctl 16:3.k2 Space | a little room ↔ far away (reverb + echo).
// @010 ctl 16:3.k3 Range | some notes left out ↔ every 16th, plus passing notes (9th, 6th).
// @010 ctl 16:3.fader Level | pluck arp on the chord.
// @010 ctl 16:3.b1 Change | next of 8 arp shapes.
// @010 ctl 16:3.b2 Octave | one octave up while held.
const arp      = colJonas(3)
const arpVar   = change(arp.btn, 'jonas', 'Arp')
const arpRange = arp.char
const arpOct   = arp.btn2.fmap(v => v > 0.5 ? 12 : 0)
// Scale degrees above the root: 0 2 4 6 = seventh chord, 8 = 9th (reached stepwise)
const ARPS = ["[0 2 4 2]*4", "[0 2 4 6]*4", "[4 2 0 2]*4", "[2 4 6 8 6 4 2 4]*2", "[0 ~ 2 4 ~ 2 4 ~]*2",
  "{0 2 4 6 4}%16", "[6 4 2 4]*4", "<[0 2 4 6]*4 [2 4 6 8]*4>"].map(p => n(p))

const stemN3_arp = strip(bus(onRoot(pick(arpVar, ARPS)
  .degradeBy(arpRange.fmap(r => 0.35 * (1 - r)))
  .sometimesBy(arpRange.mul(0.25), x => x.add(n("<1 5>"))))   // passing notes: 9th / 6th
  .scale(scaleIn(4)).add(note(arpOct))
  .s("triangle").superimpose(x => x.s("sawtooth").gain(0.3))
  .attack(0.003).decay(0.16).sustain(0).release(0.1)
  .gain(perlin.range(0.45, 0.65)).pan(sine.slow(3).range(0.3, 0.7)).delay(0.35),
  2, arp.space.fmap(s => 0.3 + 0.7 * s)), {
  lpf: expRange(arp.bright, 900, 8000),
  level: arp.level.range(0, 1),
})

// ============================================================
// JONAS 4 LEAD — a slow, breathy line: triangle + quiet saw through an “ooh” vowel, slight vibrato; long notes
// ============================================================
// Melodies as scale degrees above the chord root (0 root, 2 third, 4 fifth, 6 seventh, 7 octave), so they always fit.
// @010 ctl 16:4.k1 Brightness | soft and hushed ↔ open, clear voice (lpf 600–5000 Hz).
// @010 ctl 16:4.k2 Space | a little room ↔ far away (reverb + echo).
// @010 ctl 16:4.k3 Glide | plain notes ↔ notes bend gently into their pitch (at most a semitone).
// @010 ctl 16:4.fader Level | slow lead on the chord.
// @010 ctl 16:4.b1 Change | next of 8 melodies.
// @010 ctl 16:4.b2 Echo throw | long echo on the lead while held.
const lead      = colJonas(4)
const leadVar   = change(lead.btn, 'jonas', 'Lead')
const leadGlide = lead.char
const LEADS = ["4 _ _ _ ~ ~ 2 _ 0 _ _ _ ~ ~ ~ ~", "~ ~ 7 _ _ _ 6 _ 4 _ _ _ ~ ~ ~ ~", "0 _ _ 2 _ _ 4 _ _ _ _ _ ~ ~ ~ ~",
  "<[4 _ _ _ 5 _ 4 _ 2 _ _ _ ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ ~ ~ 0 _ _ _ _ _ ~ ~]>", "~ ~ ~ ~ 2 _ _ _ 4 _ _ _ 6 _ _ _",
  "7 _ _ _ _ _ ~ ~ 4 _ _ _ _ _ ~ ~", "~ ~ 4 _ 2 _ 0 _ _ _ _ _ ~ ~ ~ ~", "<[0 _ 2 _ 4 _ _ _ _ _ _ _ ~ ~ ~ ~] [~ ~ ~ ~ 6 _ _ _ 4 _ _ _ _ _ ~ ~]>"]
  .map(p => n(p))
const throwEcho = (pat, button) => pat.fmap(v => b => b > 0.5 ? { ...v, delay: 0.85 } : v).appLeft(button)
const leadNotes = onRoot(pick(leadVar, LEADS)).scale(scaleIn(4))

const stemN4_lead = strip(throwEcho(bus(stack(
  leadNotes.s("triangle").gain(0.35),
  leadNotes.s("sawtooth").vowel("o").gain(0.1)
).attack(0.08).decay(0.3).sustain(0.7).release(0.4)
  .vib(4.5).vibmod(0.07)
  .penv(leadGlide.fmap(g => -g)).pattack(0.12)
  .delay(0.3), 2, lead.space.fmap(s => 0.25 + 0.75 * s)), lead.btn2), {
  lpf: expRange(lead.bright, 600, 5000),
  level: lead.level.range(0, 1),
})

// ============================================================
// JONAS 5 MARIMBA — the answer: a short wooden phrase at the end of every second bar, bouncing left and right
// ============================================================
// Marimba = a short sine + a quiet partial two octaves up (the bright “tok” of the bar).
// @010 ctl 16:5.k1 Brightness | soft, woody ↔ clear and bright (lpf 1.2–9 kHz).
// @010 ctl 16:5.k2 Space | some room and echo ↔ far away.
// @010 ctl 16:5.k3 Voices | 0 = one voice, 0.5 = + a third above, 1 = + a fifth: three-part marimba.
// @010 ctl 16:5.fader Level | marimba phrase, every second bar.
// @010 ctl 16:5.b1 Change | next of 8 phrase rhythms (new notes too).
// @010 ctl 16:5.b2 Answer | the phrase plays in every bar while held.
const ans       = colJonas(5)
const ansVar    = change(ans.btn, 'jonas', 'Marimba')
const ansVoices = ans.char
const ANS_RHYTHMS = ["~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ x ~ ~ x ~ ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x x x ~",
  "~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ x ~ x", "~ ~ ~ ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ ~ ~ ~ ~",
  "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x x ~ x ~ ~", "~ ~ ~ ~ x ~ ~ ~ ~ ~ x ~ ~ ~ x x"]
// Every second bar normally, every bar while button 2 is held
const ansEvery2 = pick(ansVar, ANS_RHYTHMS.map(r => pure(1).struct(r).mask("<0 1>")))
const ansEvery  = pick(ansVar, ANS_RHYTHMS.map(r => pure(1).struct(r)))
const ansRhythm = held(ans.btn2).fmap(b => b ? ansEvery : ansEvery2).innerJoin()
// Notes: random chord tones (root, 3rd, 5th, 7th, octave), new ones per change
const ANS_TONES = [0, 2, 4, 6, 7]
const ansNotes = n(reseed(ansVar, irand(5).segment(16).fmap(i => ANS_TONES[i])))
const ansVoice = (deg, g) => {
  const notes = onRoot(ansRhythm.fmap(() => v => v).appLeft(ansNotes).add(n(deg))).scale(scaleIn(4))
  return stack(notes.s("sine").gain(g), notes.add(note(24)).s("sine").gain(g * 0.15))
    .attack(0.002).decay(0.22).sustain(0).release(0.1)
}

const stemN5_ans = strip(bus(stack(
  ansVoice(0, 0.6),
  gate(above(ansVoices, 0), ansVoice(2, 0.5).mul(gain(ramp(ansVoices, 0, 0.5)))),
  gate(above(ansVoices, 0.5), ansVoice(4, 0.42).mul(gain(ramp(ansVoices, 0.5, 1))))
).pan("[0.3 0.7]*8").delay(0.45), 2, ans.space.fmap(s => 0.35 + 0.65 * s)), {
  lpf: expRange(ans.bright, 1200, 9000),
  level: ans.level.range(0, 1),
})

// ============================================================
// JONAS 6 GLOCKENSPIEL — a real glockenspiel (General MIDI soundfont) on chord tones, high up, struck as by hand:
// loose velocities, a few notes per bar, each bar ringing out; long echoes
// ============================================================
// @010 ctl 16:6.k1 Brightness | soft glow ↔ ringing, bright (lpf 3–16 kHz).
// @010 ctl 16:6.k2 Space | dry ↔ far away (reverb + echo).
// @010 ctl 16:6.k3 Density | a few notes per bar ↔ a busy pattern (~60 % of the 16ths).
// @010 ctl 16:6.fader Level | glockenspiel on the chord.
// @010 ctl 16:6.b1 Change | next of 8 random patterns.
// @010 ctl 16:6.b2 Run | runs up and down the chord, denser and louder the longer it is held (full after 2 bars).
const bells    = colJonas(6)
const bellVar  = change(bells.btn, 'jonas', 'Glocken')
const bellKeep = bells.char.fmap(d => 0.1 + 0.5 * d)   // share of 16ths
const bellRise = heldRamp(bells.btn2, 2)                // 0 → 1 over 2 bars while held
const BELL_TONES = [0, 2, 4, 6, 7, 9, 11]
const bellNote = steps => n(irand(7).segment(steps).fmap(i => BELL_TONES[i]))
// Every bar keeps ringing after the next is struck (a metal bar, no damper)
const glock = pat => pat.s("gm_glockenspiel").release(1.2)
// A player's sweep: up and down the chord tones in 32nds, two octaves (scale degrees above the root)
const BELL_RUN = n("[0 2 4 6 7 9 11 13 14 13 11 9 7 6 4 2]*2")

const stemN6_bells = strip(bus(onRoot(stack(
  reseed(bellVar, glock(bellNote(16)
    .degradeBy(bellKeep.fmap(k => 1 - k)))
    .gain(rand.range(0.45, 0.85))
    .pan(rand.range(0.25, 0.75))
    .delay(0.5)),
  // Run: starts as a few scattered notes of the sweep and fills in over 2 bars (15 % → 90 % of the 32nds), getting
  // louder; random velocities keep it played, not ticking. Released = gone.
  gate(held(bells.btn2), glock(BELL_RUN.degradeBy(bellRise.fmap(r => 0.85 - 0.75 * r)))
    .gain(bellRise.fmap(r => v => (0.35 + 0.55 * r) * v).appLeft(rand.range(0.7, 1)))
    .pan(sine.fast(2).range(0.3, 0.7)).delay(0.4))
)).scale(scaleIn(5)), 2, bells.space), {
  lpf: expRange(bells.bright, 3000, 16000),
  level: bells.level.range(0, 1),
})

// ============================================================
// JONAS 7 BIRDS — the sunrise: short sine chirps on chord tones high up, each a quick pitch sweep (no samples)
// ============================================================
// Each chirp starts up to 10 semitones off its note and sweeps onto it within ~50 ms: “tsiu” down or “tuii” up.
// @010 ctl 16:7.k1 Brightness | far, muffled birds ↔ close and clear (lpf 2–14 kHz).
// @010 ctl 16:7.k2 Space | a little room ↔ far away across the field (reverb + echo).
// @010 ctl 16:7.k3 Amount | a few calls ↔ a busy dawn chorus, an octave higher too.
// @010 ctl 16:7.fader Level | bird chirps on the chord.
// @010 ctl 16:7.b1 Change | next of 8 call rhythms (new notes too).
// @010 ctl 16:7.b2 Flock | a whole flock calls while held.
const birds   = colJonas(7)
const birdVar = change(birds.btn, 'jonas', 'Vögel')
const birdAmt = birds.char
const BIRD_RHYTHMS = ["~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [x x] ~ ~ ~ ~ ~", "~ ~ ~ x ~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ ~", "~ ~ ~ ~ ~ ~ [x x x] ~ ~ ~ ~ ~ ~ ~ ~ ~",
  "<[~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [x x] ~ x ~] ~>", "~ [x x] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~", "~ ~ ~ ~ ~ x ~ ~ ~ ~ ~ ~ ~ ~ x ~",
  "<~ [~ ~ ~ ~ ~ ~ ~ ~ [x x x x] ~ ~ ~ ~ ~ ~ ~]>", "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [x x] x"]
const BIRD_TONES = [0, 2, 4, 7]
const birdNotes  = n(reseed(birdVar, irand(4).segment(32).fmap(i => BIRD_TONES[i])))
const chirp = (pat, octave, g) => onRoot(pat).scale(scaleIn(octave))
  .s("sine").penv(rand.range(-8, 10)).pdecay(0.05)
  .attack(0.003).decay(rand.range(0.05, 0.1)).sustain(0).release(0.03).gain(g)
const birdMain = pick(birdVar, BIRD_RHYTHMS.map(r => pure(1).struct(r))).fmap(() => v => v).appLeft(birdNotes)

const stemN7_birds = strip(bus(stack(
  chirp(birdMain, 6, 0.22).pan(rand.range(0.25, 0.75)).delay(0.3),
  gate(above(birdAmt, 0), chirp(birdNotes.degradeBy(birdAmt.fmap(a => 1 - 0.18 * a)), 7, 0.15)
    .mul(gain(birdAmt)).pan(rand).delay(0.5)),
  gate(held(birds.btn2), chirp(birdNotes.degradeBy(0.4), 6, 0.2).pan(rand).delay(0.4))
), 2, birds.space.fmap(s => 0.3 + 0.7 * s)), {
  lpf: expRange(birds.bright, 2000, 14000),
  level: birds.level.range(0, 1),
})


// What the LC view shows for this track: the chapter (now, next) on column 8 button 1, and extra lines at the top
const lcChapter = () => [CHAPTERS[chapterLatch.now].name, CHAPTERS[chapterLatch.pending].name]
const lcHead    = () => [['Akkorde', CHAPTERS[chapterLatch.now].chords]]
// Where the music is (LC view): the beat in the bar and the bar in the big cycle. A silent event per beat moves it at
// the moment the beat sounds (onTrigger, as in the set). chordAt(bar) = the chord of that bar ('' = none shown)
const CYCLE   = 4   // one phrase: 4 chords, one per bar
const chordAt = bar => CHAPTERS[chapterLatch.now].chords.split(' – ')[bar % 4]
const beatNow = { bar: null, beat: null }
const beatTick = pure(0).segment(4).fmap(() => ({})).onTrigger((hap, now, cps, t) => {
  const pos = hap.whole.begin.valueOf(), bar = Math.floor(pos + 1e-9), beat = Math.floor((pos - bar) * 4 + 1e-9)
  setTimeout(() => { beatNow.bar = bar; beatNow.beat = beat; lcView?.update() }, Math.max(0, (t - now) * 1000))
}, true)

// LC view of this evaluation: names from the tags in the editor (strudel.cc keeps the text in strudelMirror),
// buttons from the change() rows (row i = column i + 1), chapter and break on column 8
return { taps, showStatus, STATUS, lcChapter, lcHead, stems: { J1: stemJ1_kick, J2: stemJ2_noise, J3: stemJ3_sub, J4: stemJ4_bass, J5: stemJ5_clap, J6: stemJ6_hats, J7: stemJ7_perc, J8: stemJ8_shake, N1: stemN1_pad, N2: stemN2_keys, N3: stemN3_arp, N4: stemN4_lead, N5: stemN5_ans, N6: stemN6_bells, N7: stemN7_birds } }
})()

// ============================================================
// TRACK 009 — Cool House (from tracks/009-house/009-house-dual.strudel)
// ============================================================
// @009 layout Track 009 — house (two controllers)
// @009 note Happy, jazzy, dry house in A minor, 124 BPM. Jojo plays the rhythm (kick, bass, drums, percussion), Jonas the harmony with the chord progressions (column 1), the keys (column 2), the vibraphone (column 3), the flute (column 4; 5-7 empty for now) and the global column 8.
// @009 note Every row means the same everywhere: row 1 = brightness, row 2 = space, row 3 = character, fader = level, button 1 = next pattern (at the next bar), button 2 = a moment while held.
// @009 note Start with all faders down. Nothing sounds until Jonas' master fader (column 8) is up. Chapter (Jonas, column 8) switches between one chord (Vamp) and the progression chosen on Jonas 1 (Wechsel) at the next 4-bar phrase.
// @009 note The status box at the bottom right of the Strudel page shows chapter, break and each stem's pattern. Its button “als Fenster” opens it as a small window that stays on top (Chrome/Edge).
// @009 mode B16 Jojo — Rhythm (beat + bass)
// @009 col B16:1 1 Kick
// @009 col B16:2 2 Noise Pump
// @009 col B16:3 3 Sub
// @009 col B16:4 4 Bass
// @009 col B16:5 5 Clap
// @009 col B16:6 6 Hats / Shaker
// @009 col B16:7 7 Congas
// @009 col B16:8 8 Tamb / Ride
// @009 row B16:k1 Row 1 \ Brightness
// @009 row B16:k2 Row 2 \ Space
// @009 row B16:k3 Row 3 \ Character
// @009 row B16:fader Fader \ Level
// @009 row B16:b1 Button 1 \ Change
// @009 row B16:b2 Button 2 \ Moment
// @009 mode 16 Jonas — Melody (keys + top voices) · column 8 = global
// @009 col 16:1 1 Harmony
// @009 col 16:2 2 Keys
// @009 col 16:3 3 Vibraphone
// @009 col 16:4 4 Flute
// @009 col 16:5 5 Brass
// @009 col 16:6 6 Strings
// @009 col 16:7 7 Guitar
// @009 col 16:8 8 Global
// @009 row 16:k1 Row 1 \ Brightness
// @009 row 16:k2 Row 2 \ Space
// @009 row 16:k3 Row 3 \ Character
// @009 row 16:fader Fader \ Level
// @009 row 16:b1 Button 1 \ Change
// @009 row 16:b2 Button 2 \ Moment
// @009 guide Building it up | One layer after the other, not all at once: drums (kick, hats, clap), then bass and sub, then the keys, then percussion (congas, tambourine). Start in Vamp.
// @009 guide Harmony | Button 1 of column 1 picks the progression (at the next 8-bar phrase); it plays when Chapter is Wechsel. Row 3 fades strings → strings + B3 → B3.
// @009 guide Keys | 1:1 from the keys lab (round 19, column 2): brightness, space, length; button 1 = stab rhythm (8); button 2 = sound: the knobs mix the sound (piano → Rhodes, organ B3 → M1, vibraphone → marimba), the fader sets how strongly the overtones follow the accent.
// @009 guide Break and drop | Jonas presses Break: the whole rhythm goes out at the next bar, only the keys keep playing. Jojo holds the riser (noise pump, button 2). Jonas switches Chapter to Wechsel and presses Break again: everything is back on the one, now with the progression.
// @009 guide Every position sounds good | All knobs at 0 is dry, close and clear, as the track is meant to be. Space adds room, it does not repair. Every column has its own fader: each layer can be muted on its own.
const T009 = await (async () => {
const ID = 2
const PHRASE = phraseOf(SET_TRACKS[2])
const ORBIT0 = 0
const focusOnly = button => button.fmap(v => SET.focus() === ID ? v : 0)

const ramp = (sig, from, to) => sig.fmap(v => Math.min(1, Math.max(0, (v - from) / (to - from))))
// Row-3 crossfade: 0..0.5 brings the extra layer in, 0.5..1 fades the main layer out
const fadeMain  = knob => ramp(knob, 1, 0.5)
const fadeExtra = knob => ramp(knob, 0, 0.5)
// Exponential knob range for filters (Hz), so every part of the knob travel is audible
const expRange = (knob, lo, hi) => knob.fmap(v => lo * Math.pow(hi / lo, v))

const bpm  = 124
// Harmony at the start: 'vamp' = one chord (Am9) · 'wechsel' = Am9 ↔ D9, two bars each. Chapter switches live.
const HARMONY = 'vamp'
const beat = 60 / bpm   // seconds per quarter note, for delay times

// Keys (lab/keys round 19): Steinway B (VCSL vl3, CC0, trimmed copies in our repo: the browser refuses VCSL's own
// files) and the Rhodes Mark I (jRhodes3d file 3, the middle strike). Only the notes around the chords (F♯3 – F4).
const JRH = 'https://raw.githubusercontent.com/sfzinstruments/jlearman.jRhodes3d/master/jRhodes3d-mono/'
const OWN = 'https://raw.githubusercontent.com/hallfjonas/cerulean-echoes/johannes/samples/vcsl-keys/'
const notesMap = (keys, file) => Object.fromEntries(keys.map(k => [k.toLowerCase(), file(k)]))
if (typeof samples === 'function') await samples({
  stein: notesMap(['F#3', 'G#3', 'A#3', 'C4', 'D4', 'E4'], k => OWN + 'JHPiano_Sus_Close_' + k.replace('#', '%23') + '_vl3_rr1.flac'),
  jrh: notesMap(['G3', 'B3', 'D4', 'F4'], k => JRH + { G3: 'A_055__G3', B3: 'A_059__B3', D4: 'A_062__D4', F4: 'A_065__F4' }[k] + '_3.flac'),
})

// Mapping of column n (1-8): brightness, space, character (knob rows 1-3), fader, button rows 1-2
const colMap = (read, n) => ({ bright: read(12 + n), space: read(20 + n), char: read(28 + n), level: read(4 + n), btn: read(36 + n), btn2: read(44 + n) })
const off = () => signal(() => 0)
// Column 8 (global) is read from both its Mode 16 and Mode 2 CCs, last moved wins: it works on both pages even on a
// controller whose column 8 sends CC + 48 in Mode 2
// One controller: Jojo on the plain CCs (Mode 1), Jonas on CC + 48 (Mode 2)
const alone    = !ccJojo
const colJonas = n => n === 8 ? SET.glob : colMap(n === 8 ? c => lastMoved(ccJonas(c), ccJonas(c + 48)) : alone ? c => ccJonas(c + 48) : ccJonas, n)
const colJojo  = n => !alone ? colMap(ccJojo, n) : n === 8 ? colMap(off, n) : colMap(ccJonas, n)

const gate  = (cond, pat) => cond.fmap(on => on ? pat : silence).innerJoin()
const above = (sig, x) => sig.fmap(v => v > x)
const and   = (a, b) => a.fmap(x => y => x && y).appLeft(b)
const held  = button => button.fmap(v => v > 0.5)

// Stateful controls, collected so the master can query them every tick (see stateTaps)
const taps = []

// Two inputs for one control: the value follows whichever moved last (stateful, so it is queried via stateTaps)
const lastMoved = (a, b) => {
  let pa = null, pb = null, v = 0
  const pat = a.fmap(x => y => {
    if (pa === null) v = Math.max(x, y)
    else if (y !== pb) v = y
    else if (x !== pa) v = x
    pa = x; pb = y
    return v
  }).appLeft(b)
  taps.push(pat)
  return pat
}

// Momentary button that steps through n states, one step per press (counts presses, not the held value).
// onChange(state) runs on every step (for the status box). Re-evaluating the code starts again at 0.
const cycleButton = (button, n, onChange = () => {}) => {
  button = focusOnly(button)   // set: presses count only for the track in focus
  let prev = 0, state = 0
  const pat = button.fmap(v => {
    if (v > 0.5 && prev <= 0.5) { state = (state + 1) % n; onChange(state) }
    prev = v
    return state
  })
  taps.push(pat)
  return pat
}

// A value that a button sets now but that takes over only at the next bar line, or with len = 4 at the next
// 4-bar phrase (chapter). at(t) is asked with bar starts in real time (outside any reseed shift); it remembers the
// previous value for queries that still reach back into the old bar. pat = the value per bar.
const barLatch = (len = 1) => {
  const l = { pending: 0, now: 0, prev: 0, bar: -Infinity }
  l.at = t => {
    const bar = Math.floor(Number(t) / len)
    if (bar > l.bar) {
      if (l.pending !== l.now) { l.prev = l.now; l.now = l.pending; showStatus() }
      else l.prev = l.now
      l.bar = bar
    }
    return bar >= l.bar ? l.now : l.prev
  }
  l.pat = signal(t => l.at(t)).segment(1)
  taps.push(l.pat)
  return l
}

// 0 → 1 over `cycles` while a button is held, back to 0 on release (for risers)
const heldRamp = (button, cycles) => {
  let start = null
  const pat = button.fmap(v => t => {
    if (v <= 0.5) { start = null; return 0 }
    start ??= t
    return Math.min(1, Math.max(0, (t - start) / cycles))
  }).appLeft(signal(t => Number(t)))
  taps.push(pat)
  return pat
}

// Freeze: while the button is held, keep returning the value that was playing when it was pressed
const freeze = (button, pat) => {
  let kept = null
  return pat.fmap(v => b => b > 0.5 ? (kept ??= v) : (kept = null, v)).appLeft(button)
}



// ============================================================
// CHAPTERS — Vamp (one chord) and Wechsel (two chords, two bars each); one chord per bar, 4 bars = one phrase
// ============================================================
// Every chord: bass = the bass note as MIDI (A1 = 33, D2 = 38); root = the left hand's root (A3 / D3);
// tones = the right hand: four notes close around middle C (C4–B4), so Am9 → D9 moves by one step in two voices
// (G → F♯, B → A); scale = the pitch classes a melody note may land on over this chord.
const midi = name => {
  const m = name.match(/^([a-g])(#|b)?(\d)$/)
  return 12 * (+m[3] + 1) + { c: 0, d: 2, e: 4, f: 5, g: 7, a: 9, b: 11 }[m[1]] + (m[2] === '#' ? 1 : m[2] === 'b' ? -1 : 0)
}
const pc = m => (m % 12 + 12) % 12
const chord = (name, bassName, toneNames, scaleNames) => {
  const bass = midi(bassName), tones = toneNames.split(' ').map(midi), low = Math.min(...tones)
  return { name, bass, root: low - 12 + pc(bass - low), tones, scale: scaleNames.split(' ').map(s => pc(midi(s + '4'))) }
}
const Am9 = chord('Am9', 'a1', 'c4 e4 g4 b4', 'a b c d e f# g')    // minor 9: soulful, the 9th (B) on top
const D9  = chord('D9',  'd2', 'c4 e4 f#4 a4', 'd e f# g a b c')   // dominant 9: the major third F♯ makes it happy
const CHAPTERS = [
  { name: 'Vamp',    chords: [Am9, Am9, Am9, Am9] },   // one chord: intro and break
  { name: 'Wechsel', chords: [Am9, Am9, D9, D9] },     // i – IV, two bars each: the drop
]
// More chords for the progressions (harmony lab, Hooktheory; all in A minor, F not F♯): bass between E1 and D2,
// right hand close around middle C. Scale = A aeolian.
const AEOL = 'a b c d e f g'
const Am7   = chord('Am7',   'a1', 'c4 e4 g4 a4', AEOL)
const Cmaj7 = chord('Cmaj7', 'c2', 'c4 e4 g4 b4', AEOL)
const Em7   = chord('Em7',   'e1', 'd4 e4 g4 b4', AEOL)
const Fmaj7 = chord('Fmaj7', 'f1', 'c4 e4 f4 a4', AEOL)
const Fadd9 = chord('Fadd9', 'f1', 'c4 f4 g4 a4', AEOL)
const Gadd9 = chord('Gadd9', 'g1', 'd4 g4 a4 b4', AEOL)
const G11   = chord('G11',   'g1', 'c4 d4 f4 g4', AEOL)
const Dm7   = chord('Dm7',   'd2', 'c4 d4 f4 a4', AEOL)
const CHORDS = [Am9, D9, Am7, Cmaj7, Em7, Fmaj7, Fadd9, Gadd9, G11, Dm7]   // chord id = index
const CID = Object.fromEntries(CHORDS.map((c, i) => [c.name, i]))
// The progressions (harmony lab, harmonie-4; chord order from the records via Hooktheory, bar lengths from the lab):
// 8 bars each; only those whose chords sit well under the keys' Am9 (G B C E); 1 = the old Wechsel (keys follow it)
const x2 = bars => [...bars, ...bars]
const PROGS = [
  ['Am9 D9',     x2(['Am9', 'Am9', 'D9', 'D9'])],                                          // track 009 as it was
  ['Am7 C Em7',  x2(['Am7', 'Am7', 'Cmaj7', 'Em7'])],                                      // MAW, To Be In Love
  ['Am F G',     x2(['Am9', 'Am9', 'Fmaj7', 'Gadd9'])],                                    // Mr Fingers, Can You Feel It
  ['F G Am',     x2(['Fadd9', 'G11', 'Am9', 'Am9'])],                                      // CeCe Peniston, Finally
  ['Em7 Fmaj7',  ['Em7', 'Fmaj7', 'Em7', 'Fmaj7', 'Em7', 'Fmaj7', 'Em7', 'Am7']],          // Stardust
  ['Fmaj7 G',    x2(['Fmaj7', 'Fmaj7', 'Gadd9', 'Gadd9'])],                                // Daft Punk, One More Time
  ['F Am C Dm',  ['Fmaj7', 'Fmaj7', 'Am7', 'Am7', 'Cmaj7', 'Cmaj7', 'Dm7', 'Dm7']],        // Livin' Joy, Dreamer
  ['Am7 Dm7',    x2(['Am7', 'Am7', 'Dm7', 'Dm7'])],                                        // Black Box
  ['C F Am Em',  x2(['Cmaj7', 'Fadd9', 'Am7', 'Em7'])],                                    // Basement Jaxx, Romeo
  ['F Em Am',    x2(['Fmaj7', 'Em7', 'Am7', 'Am7'])],                                      // Joey Negro
].map(([name, bars]) => ({ name, ids: bars.map(b => CID[b]) }))
const START  = HARMONY === 'wechsel' ? 1 : 0

// Rows of the status box, filled by change(): { label, latch, n, names } per player
const STATUS = { jojo: [], jonas: [] }
// Columns that draw their own cells in the LC view ('page:column' → (row, helpers) → html): a column moved 1:1 from a
// lab board keeps the board's dashboard (its labels, values, the rhythm under button 1, shift)
const COLVIEW = {}
const showStatus = () => {
  if (!statusUi || SET.focus() !== ID) return
  const dots = v => [...Array(8).keys()].map(k => k === v ? '●' : '○').join('')
  const show = (r, v) => !r.names ? String(v + 1) : r.names[v]
  const line = (r, i) => (i + 1) + ' ' + r.label.padEnd(10) + ' ' + (r.n === 8 ? dots(r.latch.now) + ' ' : '') +
    show(r, r.latch.now) + (r.latch.pending !== r.latch.now ? ' → ' + show(r, r.latch.pending) : '')
  const ch = chapterLatch
  statusUi.text.textContent = [
    ...SET.statusLines(),
    'Kapitel     ' + CHAPTERS[ch.now].name +
      (ch.pending !== ch.now ? ' → ' + CHAPTERS[ch.pending].name + ' (nächste Phrase)' : ''),
    'Akkorde     ' + (ch.now === 0 ? 'Am9' : PROGS[progLatch.now].name) +
      (progLatch.pending !== progLatch.now ? ' → ' + PROGS[progLatch.pending].name + ' (nächste 8 Takte)' : ''),
    '', alone ? 'Mode 1 · Jojo' : 'Jojo', ...STATUS.jojo.map(line),
    '', alone ? 'Mode 2 · Jonas' : 'Jonas', ...STATUS.jonas.map(line).filter(Boolean),   // filter: empty columns leave holes
  ].join('\n')
  lcView?.update()
}
// Button 1 of a stem: n patterns (default 8), one step per press, taking over at the next bar
const change = (button, who, label, n = 8, names) => {
  const latch = barLatch()
  cycleButton(button, n, s => { latch.pending = s; showStatus() })
  STATUS[who].push({ label, latch, n, names })
  return latch
}
// Pattern number i of a list, switched by a change latch
const pick = (latch, pats) => latch.pat.fmap(i => pats[i]).innerJoin()

// ============================================================
// GLOBAL (Jonas, column 8) — acts on both controllers
// ============================================================
// @009 ctl g.k1 Fog | 0 = clear, up = every filter pulled down to ~6 %: muffled, as if from outside the club.
// @009 ctl g.k2 Room | 0 = each sound's own room (row 2), up = everything drowns in reverb.
// @009 ctl g.k3 Tension | build-up: echo grows, filters open (not hats, clap, shaker), from the middle a snare roll (clap fader). 0 = release.
// @009 ctl g.fader Master Level | volume of everything, both controllers. 0 = silence.
// @009 ctl g.b1 Chapter | Vamp (Am9) ↔ Wechsel (col. 1 chords).
// @009 ctl g.b2 Break / Drop | 1st: beat out. 2nd: all back on the one.
const glob        = colJonas(8)
const globalFog   = glob.bright.fmap(f => Math.pow(0.06, f))
const globalRoom  = glob.space
const tension     = glob.char
const tensionEcho = ramp(tension, 0, 0.5).mul(0.45)     // delay send, 0..0.45
const tensionRoll = ramp(tension, 0.5, 1)               // snare roll, 0..1
// Factor on every lpf: fog darkens (down to 0.06), tension opens (up to 2.5)
const globalTone  = globalFog.fmap(f => o => f * o).appLeft(tension.fmap(t => 1 + 1.5 * t))
const globalLevel = glob.level.range(0, 1)

const chapterLatch = barLatch(PHRASE)
chapterLatch.now = chapterLatch.pending = chapterLatch.prev = START
cycleButton(glob.btn, CHAPTERS.length, s => { chapterLatch.pending = (s + START) % CHAPTERS.length; showStatus() })
const breakLatch = barLatch()
cycleButton(glob.btn2, 2, s => { breakLatch.pending = s; showStatus() })
// Jojo's low end and backbeat, gated while the break is on
const beatOn   = breakLatch.pat.fmap(b => b === 0)
const beatOnly = pat => gate(beatOn, pat)

const audible = level => and(above(level, 0), above(globalLevel, 0))
// lpf × fog/tension, kept between 80 Hz and 18 kHz (fog never makes a stem silent)
const toned  = (lpf, tone = globalTone) => lpf.fmap(f => g => Math.min(18000, Math.max(80, f * g))).appLeft(tone)
// Reverb send: the stem's space knob (0..0.9), raised by the global Room up to 0.95
const roomOf = space => space.fmap(s => g => { const r = 0.9 * s; return r + (0.95 - r) * g }).appLeft(globalRoom)
// Change: read the stem's randomness 1024 cycles further per step (keeps bar alignment, new random values).
// The chords are applied after reseed, so they follow real time.
const reseed = (latch, pat) => pat.early(latch.pat.fmap(v => v * 1024))

// Effect buses. Each orbit has one reverb and one delay, and every reverb costs a lot of CPU, so the stems share
// two orbits; stems on one orbit share room size and echo time/feedback. Both rooms are small: the track is dry.
// Orbit 1 = drums and bass: a very small room, a short dotted-8th slap.
// Orbit 2 = all of Jonas' melody (and the noise riser): a small studio room, a short dotted-8th echo that dies after
// two or three repeats (the house piano echo).
const BUSES = {
  1: { hall: 0.6, time: beat * 0.75, feedback: 0.2 },
  2: { hall: 1.2, time: beat * 0.75, feedback: 0.3 },
}
// bus(): reverb from the space knob, and echo: the layer's own delay amount (or `echo` if it has none) × 2 × space,
// so space 0.5 = the designed amount; Tension's echo takes over where it is larger.
const bus = (pat, orbit, space, echo = 0) => pat
  .fmap(v => sc => e => ({ ...v, delay: Math.max(Math.min(0.9, (v.delay ?? echo) * sc), e) }))
  .appLeft(space.fmap(s => 2 * s)).appLeft(tensionEcho)
  .room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)
  .delaytime(BUSES[orbit].time).delayfeedback(BUSES[orbit].feedback)
// Reverb only, no echo (kick, sub and bass would smear)
const dryBus = (pat, orbit, space) => pat.room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)

// Channel strip: lpf × fog/tension (if given), level × master as postgain, gated while the fader or master is 0.
// high: hats, clap, shaker: Fog darkens them, but Tension does not open their filter (it made them far too loud).
const strip = (stem, { lpf, level, high = false }) => {
  const pat = lpf === undefined ? stem : stem.lpf(toned(lpf, high ? globalFog : globalTone))
  return gate(audible(level), pat.postgain(level.mul(globalLevel)))
}
const drum = (names, bank = 'RolandTR909') => s(names).bank(bank)


// ============================================================
// HARMONY — Chapter picks Vamp (Am9) or Wechsel (the progression of Jonas 1); sub, bass, harmony and vibraphone
// follow it, the keys stay on Am9 (keysHarm) unless the progression is the old Wechsel (Am9 D9)
// ============================================================
// Jonas 1 button 1: the next progression, taking over at the next 8-bar phrase (status row 0 = column 1)
const harmCol   = colJonas(1)
const progLatch = barLatch(8)
cycleButton(harmCol.btn, PROGS.length, s => { progLatch.pending = s; showStatus() })
STATUS.jonas.push({ label: 'Akkorde', latch: progLatch, n: PROGS.length, names: PROGS.map(p => p.name) })
// Chord id of a bar; keys: Am9, or the old Wechsel when that is the progression
const chordIdAt = bar => chapterLatch.at(bar) === 0 ? CID.Am9 : PROGS[progLatch.at(bar)].ids[((bar % 8) + 8) % 8]
const keysIdAt  = bar => chapterLatch.at(bar) === 0 || progLatch.at(bar) !== 0 ? CID.Am9 : PROGS[0].ids[((bar % 8) + 8) % 8]
// Mode of the bar for melodies: dorian (F♯) in Vamp and in Am9 D9, aeolian (F) in the others
const modeAt    = bar => chapterLatch.at(bar) === 0 || progLatch.at(bar) === 0 ? 'dorian' : 'aeolian'
const harmId  = signal(t => chordIdAt(Math.floor(t))).segment(1)
const keysHarm = signal(t => keysIdAt(Math.floor(t))).segment(1)
const bassOf  = harm => harm.fmap(id => CHORDS[id].bass)
// A pattern of semitone offsets → notes above the bar's bass note (+ shift)
const fromBass = (offsets, shift = 0) => note(reify(offsets).fmap(d => id => CHORDS[id].bass + shift + d).appLeft(harmId))
// The current chord as a stack of notes (shape: chord → MIDI notes), built once per chord and shape
const STACKS = {}
const chordStack = (key, shape, harm = harmId) => harm.fmap(id => STACKS[key + id] ??= note(stack(...shape(CHORDS[id])))).innerJoin()
// Velocity pattern ("0.9 ~ ~ 0.7 …") as rhythm: every hit plays all notes of `notes` with that gain
const playOn = (vel, notes) => gain(vel).fmap(g => v => ({ ...v, ...g })).appLeft(notes)
// Echo while a button is held: `amount` of the stem's echo (time and feedback from its bus)
const echoWhile = (pat, button, amount) => pat.fmap(v => b => b > 0.5 ? { ...v, delay: Math.max(v.delay ?? 0, amount) } : v).appLeft(button)

// ============================================================
// IMPROVISER — the bass ghosts (and later the playful top voices). A riff is made of
// rhythm cells (one per beat: x = note, X = accent, o = ghost, . = rest, chosen at random from a list) and a random
// melodic contour that drifts from beat to beat; on the beat it lands on a chord tone. It repeats every `len` bars,
// so at Play 0 it is a riff you can hum. Button 1 = the next riff (a new seed). Play (row 3) lets single beats break
// out: each beat is improvised anew with that probability, from the busier `wild` cells and up to `up` semitones
// higher. Random but deterministic (a hash of seed and step): no state, and every pass of the loop is identical.
// ============================================================
const hash = (a, b, c) => {
  let h = Math.imul(a + 0x9e3779b9 | 0, 0x85ebca6b) ^ Math.imul(b + 0x632be59b | 0, 0xc2b2ae35) ^ Math.imul(c + 0x27d4eb2f | 0, 0x165667b1)
  h ^= h >>> 15; h = Math.imul(h, 0x2c1b3c6d); h ^= h >>> 12; h = Math.imul(h, 0x297a2d39); h ^= h >>> 15
  return (h >>> 0) / 4294967296
}
// Pitch classes: the chord's tones (bass + right hand), and a pentatonic scale per chord
const chordPcs = c => [pc(c.bass), ...c.tones.map(pc)]
const PENTA = { Am9: [9, 0, 2, 4, 7], D9: [2, 4, 6, 9, 11] }   // A minor pentatonic · D major pentatonic (with F♯)
const POOLS = {}
const poolOf = (pcs, lo, hi) => POOLS[pcs.join() + ':' + lo + ':' + hi] ??= (() => {
  const out = []
  for (let m = lo; m <= hi; m++) if (pcs.includes(pc(m))) out.push(m)
  return out
})()
const STEPS = signal(t => Math.round(Number(t) * 16)).segment(16)   // the 16th number, one event per 16th
const improv = o => STEPS.fmap(s => seed => play => id => {
  const c = CHORDS[id], key = seed * 7919 + o.salt, loop = 16 * o.len
  const free = hash(key, Math.floor(s / 4), 3) < play
  const k  = free ? s + 1e6 : ((s % loop) + loop) % loop   // the step's key: looped, or fresh when free
  const kb = Math.floor(k / 4)
  const cells = free ? o.wild : o.cells
  const ch = cells[Math.floor(hash(key, kb, 1) * cells.length)][((s % 4) + 4) % 4]
  if (ch === '.') return null
  const pool = poolOf(o.pcs(c), o.lo, o.hi + (free ? o.up : 0))
  // contour: a value 0..1 per beat, interpolated over the beat, plus a jitter of about ±1 note per step
  const nb = free ? kb + 1 : (kb + 1) % (loop / 4)
  const a = hash(key, kb, 4), b = hash(key, nb, 4), x = (k % 4) / 4
  const i = Math.max(0, Math.min(pool.length - 1, Math.round((a + (b - a) * x) * (pool.length - 1) + (hash(key, k, 2) - 0.5) * 2.2)))
  let m = pool[i]
  if (s % 4 === 0) {   // on the beat: the nearest chord tone
    const tones = chordPcs(c)
    for (const d of [0, -1, 1, -2, 2]) if (tones.includes(pc(m + d))) { m += d; break }
  }
  const vel = ch === 'X' ? 1 : ch === 'o' ? 0.45 : 0.78
  return { note: m, gain: vel * (0.9 + 0.2 * hash(key, k, 5)) }
}).appLeft(o.latch.pat).appLeft(o.play).appLeft(harmId).filterValues(v => v !== null)

// Rhythm stems pause in the break; kick button 2 takes out kick, noise pump and sub together
const kick   = colJojo(1)
const kickOn = kick.btn2.fmap(v => v <= 0.5)
const lowEnd = pat => beatOnly(gate(kickOn, pat))

// ============================================================
// JOJO 1 KICK — a short, tight 909 kick, four on the floor, with a short sine body on A1 underneath (tuned to the key)
// ============================================================
// @009 ctl B16:1.k1 Brightness | 0 = round and tight ↔ extra click on top (lpf 4–16 kHz).
// @009 ctl B16:1.k2 Space | dry and close ↔ in a room (reverb).
// @009 ctl B16:1.k3 Punch | 0 = tight 909 kick ↔ harder: bigger pitch drop, more body.
// @009 ctl B16:1.fader Level | 0 = gone. Four on the floor, tuned to A.
// @009 ctl B16:1.b1 Change | 4/4 → a gap every 4th bar → a gap every 8th bar.
// @009 ctl B16:1.b2 Drop | kick, noise pump and sub pause while held.
const kickVar   = change(kick.btn, 'jojo', 'Kick', 3, ['4/4', 'Lücke 4', 'Lücke 8'])
const kickPunch = kick.char
const KICKS = ["1*4", "<[1*4]!3 [1 1 1 ~]>", "<[1*4]!7 [1 1 ~ ~]>"]
  .map(g => stack(
    gain(g).mul(gain(0.75)).s("bd").bank("RolandTR909").decay(kickPunch.fmap(p => 0.28 - 0.06 * p)).sustain(0).release(0.02),
    gain(g).mul(gain(kickPunch.fmap(p => 0.35 + 0.2 * p))).note("a1").s("sine")
      .attack(0.001).decay(0.16).sustain(0).release(0.03)
      .penv(kickPunch.fmap(p => 24 + 12 * p)).pdecay(0.03)
  ))

const stemJ1_kick = lowEnd(strip(dryBus(pick(kickVar, KICKS), 1, kick.space), {
  lpf: expRange(kick.bright, 4000, 16000),
  level: kick.level.range(0, 1),
}))

// ============================================================
// JOJO 2 NOISE PUMP — a short breath of noise glued to the kick: it swells in after every kick and stops before
// the next one (the pump of a sidechain, without a compressor). Dry and short.
// ============================================================
// @009 ctl B16:2.k1 Brightness | soft whoosh ↔ airy hiss (lpf 2–14 kHz).
// @009 ctl B16:2.k2 Space | dry ↔ far away (reverb + echo).
// @009 ctl B16:2.k3 Motion | still ↔ the filter breathes and the noise wanders left and right.
// @009 ctl B16:2.fader Level | noise that pumps with the kick.
// @009 ctl B16:2.b1 Change | pump → off-beat → 16ths.
// @009 ctl B16:2.b2 Riser | a noise sweep rises over 2 bars while held.
const noiseCol  = colJojo(2)
const noiseVar  = change(noiseCol.btn, 'jojo', 'Pumpe', 3, ['Pumpe', 'Offbeat', '16tel'])
const noiseMove = noiseCol.char
const noiseRise = heldRamp(noiseCol.btn2, 2)
const NOISES = [
  s("[~ pink@3]*4").attack(0.1).sustain(0.5).release(0.02).hpf(2000).gain(1.4),
  s("[~ pink]*4").attack(0.04).sustain(0.4).release(0.04).hpf(3000).gain(1.4),
  s("[~ pink pink pink]*4").gain("[0 0.6 1 0.7]*4").attack(0.01).decay(0.05).sustain(0).hpf(4000).mul(gain(1.4)),
]
// Riser: 16th noise bursts through a bandpass that climbs from 300 Hz to 6 kHz, getting louder
const noiseRiser = gate(held(noiseCol.btn2), s("pink*16")
  .attack(0.03).sustain(0.8).release(0.15)
  .bpf(noiseRise.fmap(r => 300 * Math.pow(20, r))).bpq(4)
  .gain(noiseRise.mul(0.35)).pan(sine.fast(2)))

const stemJ2_noise = strip(stack(
  lowEnd(bus(pick(noiseVar, NOISES)
    .lpf(toned(expRange(noiseCol.bright, 2000, 14000)).fmap(f => m => w => f * (1 - 0.7 * m * w)).appLeft(noiseMove).appLeft(sine.slow(2)))
    .pan(noiseMove.fmap(m => p => 0.5 + m * (p - 0.5)).appLeft(sine.slow(3))), 1, noiseCol.space, 0.15)),
  bus(noiseRiser, 2, pure(0.3))
), {
  level: noiseCol.level.range(0, 1),
})

// ============================================================
// JOJO 3 SUB — a sine on the chord's root (A1 / D2): each note starts a 16th after the kick (the pump, without a
// compressor). It never leaves the root; in Wechsel it follows the chord.
// ============================================================
// @009 ctl B16:3.k1 Brightness | 0 = sine with a few overtones (audible on small speakers) ↔ warm and full.
// @009 ctl B16:3.k2 Space | dry ↔ a little room (reverb).
// @009 ctl B16:3.k3 Length | long, pumping notes ↔ short, bouncing ones.
// @009 ctl B16:3.fader Level | sub on the root, follows the chapter.
// @009 ctl B16:3.b1 Change | pump → off-beat → half bars.
// @009 ctl B16:3.b2 Slide | every note bends up into its pitch while held.
const sub      = colJojo(3)
const subVar   = change(sub.btn, 'jojo', 'Sub', 3, ['Pumpe', 'Offbeat', 'Halbe'])
const subClip  = sub.char.fmap(c => 1 - 0.65 * c)   // share of the note length that sounds
const subSlide = sub.btn2.fmap(v => v > 0.5 ? -5 : 0)
const SUBS = ["[~ x@3]*4", "[~ x]*4", "[~ x@7]*2"].map(r => note(bassOf(harmId)).struct(r))

const stemJ3_sub = lowEnd(strip(dryBus(stack(
  pick(subVar, SUBS).s("sine").gain(0.5),
  pick(subVar, SUBS).s("triangle").gain(sub.bright.fmap(b => 0.1 + 0.17 * b))
).attack(0.015).sustain(1).release(0.04).clip(subClip).penv(subSlide).pattack(0.07), 1, sub.space), {
  level: sub.level.range(0, 1),
}))

// ============================================================
// JOJO 4 BASS — from the bass lab (lab/bass/house-bass-4.strudel): six of its lines on button 1 (the user's best
// grades, different enough from each other), row 3 fades through three of its sounds: FM (Daft Punk) → M1 organ → warm
// analog (user, 2026-11-08). Lines after what analyses describe of real records (tracks/009-house/recherche-bass.md),
// notes mine within those rules; every line follows the chord (Chapter + progression of Jonas 1, the change two 16ths
// early) and walks into each change with an approach note (A = a semitone below the next note).
// Deviations from the lab: row 3 = sound instead of length (length fixed at the lab's start value, ×0.93); the three
// sounds blended with equal power (a side at exactly 0 is not computed); chords from the track. Swing as the lab (56 %).
// Level: each sound at the lab's measured −25 LUFS (its column gain), then one stem level (see BASS_LEVEL).
// ============================================================
// Tokens per 16th: R root, r root short, O / o octave long / short, 3 5 7 scale steps above (diatonic in the
// progression's mode), F fifth below, g dead note, A approach the next note, - hold, . rest.
// @009 ctl B16:4.k1 Brightness | dull ↔ bright (low-pass over each sound's own range); brighter also a little louder.
// @009 ctl B16:4.k2 Space | dry ↔ a little room (reverb).
// @009 ctl B16:4.k3 Sound | FM (Daft Punk) → M1 organ → warm analog.
// @009 ctl B16:4.fader Level | bass line, follows the chords.
// @009 ctl B16:4.b1 Change | 6 lines: around the 1 + dead notes → dead notes → around the 1 → beat 4 open → pluck → Alright.
// @009 ctl B16:4.b2 Octave | one octave up while held.
const bassCol = colJojo(4)
const BASS_LINES = [
  ['Um die 1 + Dead', ['.R.5g.7.O.gR.5.F', '.R.5g.7.O.7g5.3A']],    // lab 14 (new in round 4)
  ['Dead Notes', ['RgRgO.RgRg5.RgO7', 'RgRgO.RgRg5.R.7A']],         // lab 10 (Da Funk / Attack: dead notes)
  ['Um die 1', ['.R.5..7.O..R.5.F', '.R.5..7.O.7.5.3A']],           // lab 1 (Tensnake “Coma Cat”: around the 1)
  ['Beat 4 frei', ['r.ro.r5.r7.o....', 'r.ro.r5.o7.5....']],        // lab 4 (52nd Street: beat 4 left to the clap)
  ['Zupfen', ['R.R.O.R.RgROg7R5', 'R-------....O.7A']],             // lab 7 (Daft Punk “Voyager”)
  ['Alright', ['R.O.R.O.R.O.R.O.', 'R.3.R.3.R.5.O.7A']],            // lab 13 (Jamiroquai “Alright”)
]
const bassVar = change(bassCol.btn, 'jojo', 'Bass', BASS_LINES.length, BASS_LINES.map(l => l[0]))
const bassOct = bassCol.btn2.fmap(v => v > 0.5 ? 12 : 0)
// The lab's line engine, with the track's chord (vibChord: the chord at 16th k, two 16ths early) and mode (modeAt)
const BMD = (k, n) => ((k % n) + n) % n
const BSC = { dorian: [9, 11, 0, 2, 4, 6, 7], aeolian: [9, 11, 0, 2, 4, 5, 7] }
const BSTEP = { R: 0, r: 0, g: 0, o: 7, '2': 1, '3': 2, '4': 3, '5': 4, '6': 5, '7': 6, O: 7, '9': 8, F: -3 }
const bScale = k => BSC[modeAt(Math.floor(k / 16))]
// root in F2–E3: short moves between the chords; chord tones from the chord's own root, above the bass note
const bassTone = (k, tok) => {
  const c = vibChord(k, true), sc = bScale(k), rp = pc(c.bass), r = 41 + BMD(rp - 5, 12), j = BSTEP[tok] ?? 0
  const onBass = 'RrgOoF'.includes(tok), d0 = onBass ? (sc.includes(rp) ? sc.indexOf(rp) : 0) : 'ABCDEFG'.indexOf(c.name[0])
  const iv = BMD(sc[BMD(d0 + j, 7)] - rp, 12)
  return r + (iv === 0 && !onBass ? 12 : iv) + 12 * Math.floor(j / 7)
}
const BNOTE = 'Rr234567Oo9F'
const bassApproach = (line, k) => {
  let t = 1
  while (t < 16 && !BNOTE.includes(line[BMD(k + t, line.length)])) t++
  const tok = BNOTE.includes(line[BMD(k + t, line.length)]) ? line[BMD(k + t, line.length)] : 'R'
  return bassTone(k + t, tok) - 1
}
const bassLine = bars => {
  const line = bars.join(''), L = line.length
  return new Pattern(state => {
    const b0 = state.span.begin.valueOf(), e0 = state.span.end.valueOf(), out = []
    for (let k = Math.ceil(b0 * 16 - 1e-9); k < e0 * 16 - 1e-9; k++) {
      const tok = line[BMD(k, L)]
      if (tok === '.' || tok === '-') continue
      let dur = 1
      while (dur < L && line[BMD(k + dur, L)] === '-') dur++
      const short = tok === 'r' || tok === 'o'
      // touch as the lab: the off-beat 8ths full, the rest a little softer, dead notes quiet, short and duller
      const v = { note: tok === 'A' ? bassApproach(line, k) : bassTone(k, tok),
        velocity: tok === 'g' ? 0.3 : BMD(k, 4) === 2 ? 1 : BMD(k, 2) ? 0.8 : 0.9,
        clip: 0.933 * (tok === 'g' ? 0.35 : short ? 0.4 : line[BMD(k + dur, L)] === '.' ? 0.85 : 1.02), dark: tok === 'g' }
      out.push(new Hap(new TimeSpan(k / 16, (k + dur) / 16), new TimeSpan(k / 16, Math.min((k + dur) / 16, e0)), v, {}))
    }
    return out
  })
}
// The lab's three sounds with their column gains (−25 LUFS each); brightness = low-pass over each one's own range
const BASS_SOUNDS = [
  [p => stack(p.s('sine').fm(2).fmh(1).fmdecay(0.12).fmsustain(0.1).gain(0.45), p.add(note(-12)).s('sine').gain(0.2))
    .attack(0.002).decay(0.2).sustain(0.5).release(0.05), 0.77, 400, 5000],                      // FM (Daft Punk)
  [p => stack(p.s('triangle').gain(0.5), p.add(note(19)).s('sine').gain(0.12), p.add(note(-12)).s('sine').gain(0.35))
    .attack(0.002).decay(0.2).sustain(0.45).release(0.06), 0.71, 300, 3000],                     // M1 organ bass
  [p => stack(p.s('sawtooth').gain(0.2), p.s('square').gain(0.15), p.add(note(-12)).s('sine').gain(0.3))
    .lpenv(2).lpdecay(0.2).lpsustain(0.3).lpq(2).attack(0.003).decay(0.3).sustain(0.6).release(0.08), 0.69, 250, 3500],  // warm
]
// Row 3: 0 → 0.5 FM → M1, 0.5 → 1 M1 → warm, equal power; each side gated where its gain is exactly 0 (CPU)
const bassBlend = [
  v => v < 0.5 ? Math.cos(v * Math.PI) * (v < 0.499) : 0,
  v => v < 0.5 ? Math.sin(v * Math.PI) * (v > 0.001) : Math.cos((v - 0.5) * Math.PI) * (v < 0.999),
  v => v > 0.5 ? Math.sin((v - 0.5) * Math.PI) * (v > 0.501) : 0,
]
const bassPlayed = pick(bassVar, BASS_LINES.map(l => bassLine(l[1]))).swingBy(0.12, 8).add(note(bassOct))
const bassSides = BASS_SOUNDS.map(([sound, g, lo, hi], i) => gate(bassCol.char.fmap(v => bassBlend[i](v) > 0),
  sound(bassPlayed).lpf(toned(expRange(bassCol.bright, lo, hi)))
    .fmap(({ dark, ...v }) => dark ? { ...v, cutoff: v.cutoff * 0.6 } : v)
    .mul(gain(bassCol.char.fmap(v => g * bassBlend[i](v))))))
// Level: fader × BASS_LEVEL × brightness ±2 dB (the lab's postgain). BASS_LEVEL 1.55 (+3.8 dB): offline at fader 1, all
// knobs 0 the old Jojo 4 measured −24.2 LUFS, this one −28.0 → now as loud as before (FM / M1 / warm within ±1 dB).
const BASS_LEVEL = 1.55
const stemJ4_bass = beatOnly(strip(dryBus(stack(...bassSides), 1, bassCol.space), {
  level: bassCol.level.fmap(l => b => l * BASS_LEVEL * Math.pow(10, 4 * (b - 0.5) / 20)).appLeft(bassCol.bright),
}))

// ============================================================
// JOJO 5 CLAP — the 909 clap on 2 and 4, as it is (with its own tail)
// ============================================================
// @009 ctl B16:5.k1 Brightness | natural ↔ sharp crack (lpf 3.5–14 kHz).
// @009 ctl B16:5.k2 Space | dry ↔ far away (reverb + echo).
// @009 ctl B16:5.k3 Ghost notes | plain ↔ a quiet rim before beat 3 ↔ + small double taps.
// @009 ctl B16:5.fader Level | clap on 2 and 4. Also the level of Tension's snare roll.
// @009 ctl B16:5.b1 Change | 2 + 4 → with a pickup → a fill every 4th bar.
// @009 ctl B16:5.b2 Roll | snare roll, growing over the bar, while held.
const clap      = colJojo(5)
const clapVar   = change(clap.btn, 'jojo', 'Clap', 3, ['2 + 4', 'Auftakt', 'Fill 4'])
const clapGhost = clap.char
const clapHit = g => gain(g).s("cp").bank("RolandTR909")
const rimHit  = g => gain(g).s("rim").bank("RolandTR909")
const CLAPS = ["~ 0.8 ~ 0.8", "~ 0.8 ~ [0.8 ~ ~ 0.35]", "<[~ 0.8 ~ 0.8]!3 [~ 0.8 ~ [0.8 0.5]]>"].map(clapHit)

const stemJ5_clap = beatOnly(strip(bus(stack(
  pick(clapVar, CLAPS),
  gate(above(clapGhost, 0), rimHit("~ ~ 0.25 ~").mul(gain(ramp(clapGhost, 0, 0.5)))),
  gate(above(clapGhost, 0.5), rimHit("~ [~ 0.18] ~ [~ ~ 0.15 ~]").mul(gain(ramp(clapGhost, 0.5, 1)))),
  gate(held(clap.btn2), drum("sd*16").gain(saw.range(0.1, 0.5))),
  // Tension roll: 8ths → 16ths, louder as Tension rises
  gate(above(tensionRoll, 0), drum("sd*16").degradeBy(tensionRoll.fmap(t => 0.5 * (1 - t)))
    .gain(tensionRoll.fmap(t => 0.1 + 0.35 * t)))
).mul(gain(0.8)).hpf(300).pan(0.48), 1, clap.space, 0.2), {
  lpf: expRange(clap.bright, 3500, 14000),
  high: true,
  level: clap.level.range(0, 1),
}))

// ============================================================
// JOJO 6 HATS / SHAKER — the house off-beat (a short open 909 hat between the kicks) and closed 16ths, lightly swung;
// row 3 trades the metal for a shaker on the same hits
// ============================================================
// @009 ctl B16:6.k1 Brightness | soft hiss ↔ crisp and sharp (lpf 4–16 kHz).
// @009 ctl B16:6.k2 Space | dry ↔ far away (reverb + echo).
// @009 ctl B16:6.k3 Hats ↔ Shaker | 0 = 909 hats ↔ middle = both ↔ 1 = shaker (same rhythm).
// @009 ctl B16:6.fader Level | off-beat hat + swung 16ths.
// @009 ctl B16:6.b1 Change | off-beat → + swung 16ths → driving 16ths.
// @009 ctl B16:6.b2 Open | open hats on every 8th while held.
const hats    = colJojo(6)
const hatVar  = change(hats.btn, 'jojo', 'Hats', 3, ['Offbeat', '+ 16tel', 'treibend'])
const hatMix  = hats.char
// [open off-beat, closed 16ths] as velocities; the closed 16ths are swung (the 2nd and 4th 16th come a little late)
const HAT_VELS = [
  ["[~ 0.5]*4", "[~ ~ ~ 0.12]*4"],
  ["[~ 0.5]*4", "[0.2 0.1 ~ 0.15]*4"],
  ["[~ 0.45]*4", "[0.26 0.13 ~ 0.2]*4"],
]
const hatKit = ([open, closed]) => stack(
  stack(gain(open).s("oh").bank("RolandTR909").decay(0.15).sustain(0),
    gain(closed).s("hh").bank("RolandTR909").swingBy(0.2, 8)).mul(gain(fadeMain(hatMix))),
  stack(gain(open).s("sh").bank("RolandTR727").n(0),
    gain(closed).s("sh").bank("RolandTR727").n(1).swingBy(0.2, 8)).mul(gain(fadeExtra(hatMix).mul(2.5)))
)
const HATS = HAT_VELS.map(hatKit)

const stemJ6_hats = beatOnly(strip(bus(stack(
  pick(hatVar, HATS),
  gate(held(hats.btn2), drum("oh*8").gain(0.3).decay(0.22).sustain(0))
).mul(gain(0.9)).pan(0.56), 1, hats.space, 0.2), {
  lpf: expRange(hats.bright, 4000, 16000),
  high: true,
  level: hats.level.range(0, 1),
}))

// ============================================================
// JOJO 7 CONGAS — TR-727 latin percussion, quiet: conga low (n 4), bongo high / low (n 2 / 3)
// ============================================================
// @009 ctl B16:7.k1 Brightness | soft and woody ↔ crisp slap (lpf 1–12 kHz).
// @009 ctl B16:7.k2 Space | dry ↔ far away (reverb + echo).
// @009 ctl B16:7.k3 Density | steady pattern ↔ + fingertip ghost notes.
// @009 ctl B16:7.fader Level | congas and bongos, in the background.
// @009 ctl B16:7.b1 Change | pillow → rolling → latin.
// @009 ctl B16:7.b2 Fill | a conga run over the bar while held.
const perc     = colJojo(7)
const percVar  = change(perc.btn, 'jojo', 'Congas', 3, ['Kissen', 'rollend', 'Latin'])
const conga = (pat, g) => n(pat).s("perc").bank("RolandTR727").gain(g)
const PERCS = ["4 ~ ~ 2 ~ ~ 3 ~ 4 ~ ~ 2 ~ 3 ~ ~", "~ ~ 4 2 ~ ~ 4 ~ ~ 3 ~ 2 ~ ~ 4 ~", "3 ~ 2 ~ 4 ~ 2 3 ~ 2 ~ 4 ~ ~ 2 ~"]
  .map(p => conga(p, perlin.range(0.18, 0.26)))

const stemJ7_perc = beatOnly(strip(bus(stack(
  pick(percVar, PERCS),
  gate(above(perc.char, 0), conga(irand(2).add(2).segment(16), perc.char.mul(0.08)).degradeBy(0.55)),
  gate(held(perc.btn2), conga("2 2 3 3 2 3 4 4 2 2 3 3 4 3 4 4", 0.22))
).pan(sine.slow(4).range(0.35, 0.65)), 1, perc.space, 0.3), {
  lpf: expRange(perc.bright, 1000, 12000),
  level: perc.level.range(0, 1),
}))

// ============================================================
// JOJO 8 TAMB / RIDE — TR-707 tambourine on 16ths (accent on the off-beat), or the 909 ride on the off-beats, or both
// ============================================================
// @009 ctl B16:8.k1 Brightness | soft shimmer ↔ bright sizzle (lpf 4.5–16 kHz).
// @009 ctl B16:8.k2 Space | dry ↔ far away (reverb + echo).
// @009 ctl B16:8.k3 Swing | straight ↔ swung, lazy (the in-between 16ths come late).
// @009 ctl B16:8.fader Level | tambourine / ride.
// @009 ctl B16:8.b1 Change | tambourine → ride → both.
// @009 ctl B16:8.b2 Double | double time while held.
const shake    = colJojo(8)
const shakeVar = change(shake.btn, 'jojo', 'Tamb/Ride', 3, ['Tamburin', 'Ride', 'beides'])
const tambo    = g => gain(g).s("tb").bank("RolandTR707")
const ride     = g => gain(g).s("rd").bank("RolandTR909")
const SHAKERS = [
  tambo("[0.12 0.06 0.25 0.06]*4"),
  ride("[~ 0.12]*4"),
  stack(tambo("[0.1 0.05 0.2 0.05]*4"), ride("[~ 0.09]*4")),
]

const stemJ8_shake = beatOnly(strip(bus(pick(shakeVar, SHAKERS)
  .fast(shake.btn2.fmap(v => v > 0.5 ? 2 : 1))
  .swingBy(shake.char.mul(0.6), 8)   // 0.6 = the off-16th lands on the last triplet
  .pan(0.62), 1, shake.space, 0.25), {
  lpf: expRange(shake.bright, 4500, 16000),
  high: true,
  level: shake.level.range(0, 1),
}))

// ============================================================
// A control's value at time t (controls are continuous signals); a percentage for the LC view
const valAt = (pat, t) => { const h = pat.queryArc(t, t + 1e-4)[0]; return h ? h.value : 0 }
const pct = v => Math.round((v ?? 0) * 100)

// ============================================================
// JONAS 1 HARMONY — 1:1 from the harmony lab (lab/harmonie/harmonie-4.strudel, column 2 “Liegend, B3 sanft”): the
// same controls, sounds, voicing, levels and channel strip. Held chords, as long as each chord lasts (struck again
// after 4 bars), the next chord two 16ths early (push, as the keys).
// ============================================================
// Sounds (lab): JX-10 strings (two saws ~4 cents + a layer 0.1 semitone up) and a soft Hammond B3 (16' + 8' drawbars
// as sines, slow Leslie, 60 ms attack); row 3 fades strings → both (equal power) → B3, a side at exactly 0 is not
// computed. Voicing (lab): the Kerri shape around F3–E4, four notes from E3 up. Channel strip (lab engine 3):
// brightness = low-pass 400–6000 Hz, ±2 dB with it; space = a 1/8 echo first, the room from 0.35; button 2 held =
// echo throw (dotted 8th). Fog / Tension, global Room and Tension's echo on top, as for the vibraphone.
// Only deviation: the chord comes from the track's harmony (Chapter + progression) instead of the lab's engine.
// Orbit 3 (shared with the vibraphone, as in the lab where all candidates shared one orbit).
// @009 ctl 16:1.k1 Brightness | dull ↔ bright (low-pass over the sound's range).
// @009 ctl 16:1.k2 Space | echo and room.
// @009 ctl 16:1.k3 Strings ↔ B3 | strings → both → B3 alone.
// @009 ctl 16:1.fader Level | held chords, follow the progression.
// @009 ctl 16:1.b1 Progression | next of 10, at the next 8-bar phrase (plays in Wechsel).
// @009 ctl 16:1.b2 Echo throw | held: long dotted-8th echo.
const HARM_LEVEL = 1   // the lab's column gain (held: −27 LUFS at fader 1 in the lab, 6 dB under the keys)
// The column's state: [brightness, space, strings ↔ B3, level] with the lab's start values; untouched knobs keep them
const HS = { val: [0.6, 0, 0.3, 0], held: false, prev: null }
const harmCtl = signal(t => {
  const now = [harmCol.bright, harmCol.space, harmCol.char, harmCol.level].map(p => valAt(p, t))
  now.forEach((v, i) => {
    if (HS.prev === null ? i !== 3 && v === 0 : v === HS.prev[i]) return
    HS.val[i] = v
    lcView?.update()
  })
  HS.prev = now
  const h = valAt(harmCol.btn2, t) > 0.5
  if (h !== HS.held) { HS.held = h; lcView?.update() }
  return 0
}).segment(16)
taps.push(harmCtl)
// Voicing (lab CH keys): the pitch classes; notes from E3 (52) up, four of them
const HARM_VOICING = { Am9: [55, 59, 60, 64], D9: [54, 57, 60, 64], Am7: [55, 57, 60, 64], Cmaj7: [55, 59, 60, 64],
  Em7: [55, 59, 62, 64], Fmaj7: [53, 57, 60, 64], Fadd9: [53, 55, 57, 60], Gadd9: [55, 57, 59, 62], G11: [53, 55, 60, 62],
  Dm7: [53, 57, 60, 62] }
const HARM_POOL = {}
const harmNotes = name => HARM_POOL[name] ??= (() => {
  const pcs = HARM_VOICING[name].map(pc), o = []
  for (let m = 52; m <= 76; m++) if (pcs.includes(pc(m))) o.push(m)
  return o.slice(0, 4)
})()
// The chord at 16th k, the next one two 16ths early (push)
const harmAtRaw = k => CHORDS[chordIdAt(Math.floor((k + 2) / 16))].name
// Held chords (lab padPat): one event per chord as long as it lasts, struck again every 4 bars
let harmPadLast = { key: null, haps: [] }   // (CPU) the layers ask for the same span one after the other: build it once
const harmPad = new Pattern(state => {
  const b0 = state.span.begin.valueOf(), e0 = state.span.end.valueOf(), out = []
  const key = b0 + ':' + e0
  if (harmPadLast.key === key) return harmPadLast.haps
  const memo = {}, harmAt = k => memo[k] ??= harmAtRaw(k)   // (CPU) each 16th asked once per query
  const startOf = k => {
    const name = harmAt(k)
    let c = k
    while (c > k - 64 && harmAt(c - 1) === name) c--
    if (c === k - 64) c = 64 * Math.floor(k / 64)   // no change in sight (one chord): strike on the 4-bar grid
    return c + 64 * Math.floor((k - c) / 64)
  }
  for (let st = startOf(Math.floor(b0 * 16)); st < e0 * 16;) {
    const name = harmAt(st)
    let e = st + 1
    while (e - st < 64 && harmAt(e) === name) e++
    const w0 = st / 16, w1 = e / 16, p0 = Math.max(w0, b0), p1 = Math.min(w1, e0)
    if (p1 > p0) for (const m of harmNotes(name)) out.push(new Hap(new TimeSpan(w0, w1), new TimeSpan(p0, p1), { note: m }, {}))
    st = e
  }
  harmPadLast = { key, haps: out }
  return out
})
const harmJx = notes => stack(notes.s('supersaw').unison(2).detune(0.08).spread(0.6).gain(0.5),
  notes.add(note(0.1)).s('supersaw').unison(2).detune(0.05).spread(0.9).gain(0.3))
  .attack(0.35).decay(0.1).sustain(1).release(0.8).mul(gain(0.24))
const harmB3 = notes => stack(...[[0, 0.14], [12, 0.11]].flatMap(([d, g]) => [[-0.04, 0.3], [0.04, 0.7]].map(([dt, pan]) =>
  notes.add(note(d + dt)).s('sine').gain(g).pan(pan))))
  .vib(0.8).vibmod(0.08).attack(0.06).release(0.25).mul(gain(0.47))
const harmX = signal(() => HS.val[2])
// (CPU) the gate is checked per bar: a side switched on starts with the next chord strike
const harmSide = (r, f) => harmX.fmap(v => f(v) > 0).segment(1).fmap(on => on ? r(harmPad).mul(gain(harmX.fmap(f))) : silence).innerJoin()
const harmVoices = stack(harmSide(harmJx, v => Math.cos(v * Math.PI / 2) * (v < 0.999)),
  harmSide(harmB3, v => Math.sin(v * Math.PI / 2) * (v > 0.001))).velocity(perlin.range(0.85, 1)).swingBy(0.12, 8)
// The lab's channel strip per event
// (CPU) only the haps that start in this query are played: the global controls are read once per query for them,
// the held chords' later fragments pass unchanged (they never sound)
const harmStrip = new Pattern(state => {
  const haps = harmVoices.query(state), on = haps.filter(h => h.hasOnset())
  if (!on.length) return haps
  const t = state.span.begin.valueOf(), [br, sp] = HS.val
  const r = 0.8 * Math.max(0, (sp - 0.35) / 0.65), gRoom = valAt(globalRoom, t), tone = valAt(globalTone, t)
  const ev = sp > 0 ? Math.min(1, 0.4 + 1.2 * sp) : 0
  const ef = HS.held ? { delay: 0.65, delaytime: 0.75 * 60 / bpm, delayfeedback: 0.62 }
    : { delay: 0.6 * ev, delaytime: 30 / bpm, delayfeedback: 0.15 + 0.35 * ev }
  ef.delay = Math.max(ef.delay, valAt(tensionEcho, t))
  return haps.map(h => !h.hasOnset() ? h : h.withValue(v => {
    const cutoff = Math.min(18000, Math.max(80, Math.min(18000, v.cutoff ?? 18000, 400 * Math.pow(15, br)) * tone))
    return { release: 0.1, ...v, cutoff, room: r + (0.95 - r) * gRoom, roomsize: 2, ...(ef.delay > 0 ? ef : {}), orbit: 3 }
  }))
})
const stemN1_harm = strip(harmStrip, { level: signal(() => HS.val[3] * HARM_LEVEL * Math.pow(10, 4 * (HS.val[0] - 0.5) / 20)) })
// LC view: the lab's dashboard column (Hell, Raum, Strings ↔ B3, Pegel, the progression, Echo-Wurf)
const harmMix = v => v <= 0.001 ? 'Strings' : v >= 0.999 ? 'B3' : 'beide ' + pct(v)
COLVIEW['jonas:1'] = (row, { esc, pending }) => {
  const knob = (v, name, txt) => '<div class="cell knob"><div class=dial style="--v:' + v + '"></div><b>' + (txt ?? pct(v)) +
    '</b><span>' + esc(name) + '</span></div>'
  return {
    k1: knob(HS.val[0], 'Hell'), k2: knob(HS.val[1], 'Raum'), k3: knob(HS.val[2], 'Strings ↔ B3', harmMix(HS.val[2])),
    fader: '<div class="cell fader"><div class=bar style="--v:' + HS.val[3] + '"><i></i></div><b>' + pct(HS.val[3]) +
      '</b><span>Pegel</span></div>',
    b1: '<div class="cell btn"><b>' + pending(PROGS[progLatch.now].name, PROGS[progLatch.pending].name) + '</b></div>',
    b2: '<div class="cell btn' + (HS.held ? ' on' : '') + '"><b>Echo-Wurf</b></div>',
  }[row]
}

// JONAS 2 KEYS — 1:1 from the keys lab (lab/keys/old/house-keys-lab-19.strudel, column 2: Steinway + Rhodes Mark I):
// the same controls, sounds, rhythms, touch and levels. Short stabs in Kerri Chandler's voicing.
// ============================================================
// Voicing (Kerri Chandler, Attack Magazine): the 7th at the bottom, the 9 instead of the root, moved as a block:
// Am9 = G3 B3 C4 E4 (as in the lab); D9 = F♯3 A3 C4 E4 (the lab had one chord only; two voices step down).
// Push: hits on the last two 16ths of a bar already play the next bar's chord. Swing as in the lab (56 %).
// Touch (lab round 11): a hit before a longer rest is played harder (louder) and, by the overtone amount (shift +
// fader, lab round 18), brighter; in the overlays the second rhythm is softer and darker.
// Brightness per sound over its own range (lab round 19), top third a presence peak; ±2 dB with it.
// Sound (button 2, every press on / off; the lab's “shift”): the knobs mix the sound (1 piano → Rhodes, 2 organ B3 → M1, 3 vibraphone
// → marimba), the fader sets the overtones. Only moves count: a control keeps its value until it is moved again.
// @009 ctl 16:2.k1 Brightness | dull ↔ bright over each sound's own range (lpf from 250 Hz); top third: a presence peak; brighter also plays a little harder (±2 dB).
// @009 ctl 16:2.k2 Space | 0 = dry; a 1/8 echo is there from the first turn (full at half), from about a third on the room joins (full at the top).
// @009 ctl 16:2.k3 Length | 0 = short stab ↔ hits ring four times longer.
// @009 ctl 16:2.fader Level | keys: Steinway (VCSL) and Rhodes Mark I (jRhodes3d), organs, mallets.
// @009 ctl 16:2.b1 Change | 8 stab rhythms (chain, shifted, pairs, 3-3-2, two Kerri, two overlays).
// @009 ctl 16:2.b2 Sound | on / off: knobs = sound mix (piano → Rhodes, B3 → M1, vibes → marimba); fader = overtones.
const keys = colJonas(2)
// x = chord, . = rest, - = the hit before is held one more 16th; overlays: O = both rhythms hit, a / b = only one
const KEY_VEL = { x: 0.8, X: 1, O: 1, a: 0.8, b: 0.8 * (1 - 0.45) }   // b: the second rhythm 45 % softer (lab round 11)
const KEY_CUT = { b: 1 - 0.8 * 0.45 }                                 // … and darker
const overlay = (a, b) => [...a].map((c, i) => c === 'x' ? (b[i] === 'x' ? 'O' : 'a') : b[i] === 'x' ? 'b' : '.').join('')
// [name, 16 steps, reference rhythm for the level (overlays: as loud as the chain alone)]
const KEY_PATS = [
  ['Kette',            '.x..x..x.x..x..x'],
  ['versetzte Kette',  '...x..x..x.x..x.'],
  ['Paare',            '.x.x..x..x.x..x.'],
  ['3-3-2',            'x..x..x...x..x..'],
  ['Kerri-Synkope',    '..x..x...x.x..x.'],
  ['Kerri-Riff',       'x..x..x..x..x.x.'],
  ['Kette + versetzt', overlay('.x..x..x.x..x..x', '...x..x..x.x..x.'), '.x..x..x.x..x..x'],
  ['Kette + Paare',    overlay('.x..x..x.x..x..x', '.x.x..x..x.x..x.'), '.x..x..x.x..x..x'],
]
const keysVar = change(keys.btn, 'jonas', 'Keys', KEY_PATS.length, KEY_PATS.map(p => p[0]))
const keysRow = STATUS.jonas[STATUS.jonas.length - 1]
// Accent before rests (lab round 11, strength 0.25): touch 0.5 = the pattern's average, longer rest after a hit = harder
const isHit = c => c !== '.' && c !== '-'
const gapAfter = (p, i) => { for (let d = 1; d < p.length; d++) if (isHit(p[(i + d) % p.length])) return d; return p.length }
const gapT = (p, i) => Math.min(0.9, 0.2 + 0.2 * gapAfter(p, i))
const KEY_TOUCH = KEY_PATS.map(([, p, ref]) => {
  const hits = [...p].map((c, i) => isHit(c) ? i : -1).filter(i => i >= 0)
  const mean = hits.reduce((t, i) => t + gapT(p, i), 0) / hits.length
  const touch = [...p].map((c, i) => isHit(c) ? Math.max(0, Math.min(1, 0.5 + (gapT(p, i) - mean) * 4 * 0.25)) : 0)
  // level: the loop's energy (sum of squared hit gains) as the reference rhythm's at plain velocity
  const r = ref ?? p, w = [...r].reduce((t, c) => t + (KEY_VEL[c] ?? 0) ** 2, 0)
  const d = [...p].reduce((t, c, i) => t + (isHit(c) ? (KEY_VEL[c] * (0.6 + 0.8 * touch[i])) ** 2 : 0), 0)
  return { touch, norm: Math.sqrt(w / d) }
})
const KEY_VOICING = { Am9: [55, 59, 60, 64], D9: [54, 57, 60, 64] }
// Organ voices (lab round 14), an octave above the chords
const M1K = 0.42   // −7.5 dB: the built M1 measured 7.5 dB louder than the B3
// Hammond B3 with a slow Leslie: drawbars 16' + 5 1/3' + 8' (“888”), each tonewheel a sine; the Leslie as a slow
// vibrato plus two copies a few cents apart, left and right
const B3 = n => [0, 19, 12].flatMap((d, j) => [-0.04, 0.04].map((dt, side) => ({ s: 'sine', note: n + d + dt,
  gain: [0.12, 0.07, 0.1][j], attack: 0.004, vib: 0.8, vibmod: 0.08, pan: side ? 0.7 : 0.3 })))
// M1 Organ 2 (90s house): hollow square tone + octave, a fast percussive “tock” on the twelfth
const M1 = n => [
  { s: 'square', note: n + 12, gain: 0.22 * M1K, attack: 0.002, decay: 0.25, sustain: 0.7 },
  { s: 'sine', note: n + 24, gain: 0.18 * M1K, attack: 0.002, decay: 0.25, sustain: 0.7 },
  { s: 'sine', note: n + 31, gain: 0.25 * M1K, attack: 0.001, decay: 0.08, sustain: 0 }]
const scaled = (vs, k) => vs.map(v => ({ ...v, gain: v.gain * k }))
// The sounds as in lab round 19: note → voices, each as loud as the others (measured offline, LUFS), and the
// brightness range of each [lowest, highest cutoff]
const KEY_SRC = {
  piano: n => [{ s: 'stein', note: n, gain: 0.6 * 0.49 / 0.955 * 0.99 }],
  rhodes: n => [{ s: 'jrh', note: n, gain: 0.6 * 0.292 / 0.955 * 0.902 }],
  b3: n => scaled(B3(n), 1.82 * 0.85),
  m1: n => scaled(M1(n), 1.85),
  vibes: n => [{ s: 'gm_vibraphone', note: n - 12, gain: 0.65 * 0.91 }],
  marimba: n => [{ s: 'gm_marimba', note: n, gain: 0.7 * 1.38 }],
}
const KEY_RANGE = { piano: [250, 8100], rhodes: [250, 2000], b3: [250, 2000], m1: [250, 5000], vibes: [250, 4000], marimba: [250, 3000] }
// The sound mix: a knob in three thirds: 0 silent → A fades in → A blends into B → B fades out; equal power
const sweep = v => v < 1 / 3 ? [3 * v, 0] : v > 2 / 3 ? [3 - 3 * v, 1] : [1, 3 * v - 1]
const xfade = c => [Math.cos(c * Math.PI / 2), Math.sin(c * Math.PI / 2)].map(x => x < 1e-6 ? 0 : x)
const pairLevels = (v, dip = 0) => { const [lvl, c] = sweep(v), [a, b] = xfade(c), d = Math.pow(10, -dip * Math.sin(Math.PI * c) / 20)
  return [lvl * a * d, lvl * b * d] }
// piano-Rhodes blend lifted 1.3 dB mid-way, the organs' shared partials taken out (both measured in the lab)
const keyLayers = m => [['piano', pairLevels(m[0], -1.3)[0]], ['rhodes', pairLevels(m[0], -1.3)[1]],
  ['b3', pairLevels(m[1], 1.3)[0]], ['m1', pairLevels(m[1], 1.3)[1]],
  ['vibes', pairLevels(m[2])[0]], ['marimba', pairLevels(m[2])[1]]].filter(([, l]) => l > 0)
const KEY_LEVEL = 0.88   // the stem in the track: −21 LUFS at fader 1 with the lab's settings (kick −14, clap −23.5)
// The column's state, as in the lab: knobs and fader [brightness, space, length, level], sound mix, overtones, shift.
// Shift: every press of button 2 switches it on or off. A control that moves goes to its normal job, or with shift
// on to the sound mix (knobs) / overtones (fader). The lab's start values for what has not been moved yet.
const K = { val: [0.6, 0, 0, 0], mix: [0.5, 0, 0], e: 0.5, shift: 0, prev: null }
cycleButton(keys.btn2, 2, s => { K.shift = s; keysRow.label = s ? 'Keys KLANG' : 'Keys'; showStatus() })
// LC view: the lab's dashboard column, as it was (labels, values, the rhythm under button 1; with shift on the mix)
const MIX_NAMES = [['Klavier', 'Rhodes'], ['B3', 'M1'], ['Vibra', 'Marimba']]
const mixText = r => { const [a, b] = MIX_NAMES[r], v = K.mix[r]
  return v <= 0 ? 'aus' : v < 1 / 3 ? a + ' ' + pct(3 * v) : v > 2 / 3 ? b + ' ' + pct(3 - 3 * v) : a + ' → ' + b + ' ' + pct(3 * v - 1) }
COLVIEW['jonas:2'] = (row, { esc, pending }) => {
  const knob = (v, name, txt) => '<div class="cell knob"><div class=dial style="--v:' + v + '"></div><b>' + (txt ?? pct(v)) +
    '</b><span>' + esc(name) + '</span></div>'
  const fader = (v, name) => '<div class="cell fader"><div class=bar style="--v:' + v + '"><i></i></div><b>' + pct(v) +
    '</b><span>' + esc(name) + '</span></div>'
  const off = '<div class="cell" style="opacity:.25"><span>—</span></div>'
  const now = keysVar.now, next = keysVar.pending
  return (K.shift ? {
    k1: knob(K.mix[0], 'Klavier → Rhodes', mixText(0)), k2: knob(K.mix[1], 'B3 → M1', mixText(1)),
    k3: knob(K.mix[2], 'Vibra → Marimba', mixText(2)), fader: fader(K.e, 'Obertöne'), b1: off,
    b2: '<div class="cell btn on"><b>Klang an</b></div>',
  } : {
    k1: knob(K.val[0], 'Hell'), k2: knob(K.val[1], 'Raum'), k3: knob(K.val[2], 'Länge'), fader: fader(K.val[3], 'Pegel'),
    b1: '<div class="cell btn"><b>' + pending(KEY_PATS[now][0], KEY_PATS[next][0]) + '</b><div class=pat>' + esc(KEY_PATS[now][1]) + '</div></div>',
    b2: '<div class="cell btn"><b>Klang</b></div>',
  })[row]
}
const keysCtl = signal(t => {
  const now = [keys.bright, keys.space, keys.char, keys.level].map(p => valAt(p, t))
  now.forEach((v, i) => {
    if (K.prev === null ? i !== 3 && v === 0 : v === K.prev[i]) return   // untouched knobs keep the lab's start values
    if (K.shift) { if (i < 3) K.mix[i] = v; else K.e = v } else K.val[i] = v
    lcView?.update()
  })
  K.prev = now
  return 0
}).segment(16)
taps.push(keysCtl)
const keyStabs = new Pattern(state => {
  const b0 = state.span.begin.valueOf(), e0 = state.span.end.valueOf(), out = []
  const lay = keyLayers(K.mix)
  if (!lay.length) return out
  // 16 steps per bar; swing as in the lab (56 %): the odd 16ths come 0.12 of a 16th late
  for (let k = Math.floor(b0 * 16) - 1; k < e0 * 16 + 1; k++) {
    const t = (k + (((k % 2) + 2) % 2 === 1 ? 0.12 : 0)) / 16
    if (t < b0 - 1e-9 || t >= e0 - 1e-9) continue
    const bar = Math.floor(k / 16), step = ((k % 16) + 16) % 16
    const pi = keysVar.at(bar), [, pat] = KEY_PATS[pi], sym = pat[step]
    if (!isHit(sym)) continue
    let ties = 0
    while (step + ties + 1 < 16 && pat[step + ties + 1] === '-') ties++
    const ch = CHORDS[keysIdAt(step >= 14 ? bar + 1 : bar)], notes = KEY_VOICING[ch.name] ?? ch.tones
    const [br, sp, len] = K.val
    const kt = KEY_TOUCH[pi], hitT = kt.touch[step]
    const hitGain = (0.6 + 0.8 * hitT) * kt.norm * KEY_VEL[sym]
    const hitCut = Math.pow(2, 8 * K.e * (hitT - 0.5)) * (KEY_CUT[sym] ?? 1)   // e 0.5 = round 11: ×0.25 … ×4 over the touch range
    const res = 4 + 8 * Math.max(0, (br - 2 / 3) * 3), tGain = Math.pow(10, 4 * (br - 0.5) / 20), tAtk = br < 0.3 ? 0.02 * (1 - br / 0.3) : 0
    // Space (lab): the 1/8 echo first (full at half the knob), the room from 0.35; Room and Tension (column 8) on top
    const ev = sp > 0 ? Math.min(1, 0.4 + 1.2 * sp) : 0, gRoom = valAt(globalRoom, t), r = 0.8 * Math.max(0, (sp - 0.35) / 0.65)
    const delay = Math.max(0.6 * ev, valAt(tensionEcho, t)), fb = 0.15 + 0.35 * ev
    const dur = (1 + ties) * Math.pow(4, len) / 16, tone = valAt(globalTone, t)
    for (const [src, l] of lay) {
      const [clo, chi] = KEY_RANGE[src], cutoff = Math.min(18000, Math.max(80, clo * Math.pow(chi / clo, br) * hitCut * tone))
      for (const n of notes) for (const v of KEY_SRC[src](n)) out.push(new Hap(new TimeSpan(t, t + dur), new TimeSpan(t, Math.min(t + dur, e0)),
        { release: 0.15, pan: 0.47, ...v, gain: KEY_LEVEL * v.gain * 0.955 * hitGain * tGain * l, cutoff, resonance: res,
          attack: Math.max(v.attack ?? 0, tAtk), room: r + (0.95 - r) * gRoom, roomsize: 2, orbit: 2,
          ...(delay > 0 ? { delay, delaytime: 30 / bpm, delayfeedback: fb } : {}) }, {}))
    }
  }
  return out
})

const stemN2_keys = strip(keyStabs, { level: signal(() => K.val[3]) })

// ============================================================
// JONAS 3 VIBRAPHONE — 1:1 from the melody lab (lab/melodie/melodie-2.strudel, column 1): the same controls, phrases,
// Complexity layers, touch, swing and effects; 40 % louder than in the lab (user, 2026-11-07: 30–50 % louder).
// ============================================================
// Phrases follow the chord: Offbeat = chord tones on off-beat 16ths (bar 8 climbs); Tresillo = 3-3-2 on root / fifth
// in A dorian above the chord's root, every 4th bar different; Ruf-Echo = the Escravos call an octave lower in bars 7–8.
// Complexity (row 3), as 008's Pings density: 0 = the core (2–3 notes a bar) → from 15 % the written figure (start
// 30 %) → from 45 % the gaps fill in at random with chord tones → from 75 % quick doubles and neighbour notes.
// Soft (row 2) = the lab's Space (1/8 echo first, room from 0.35) plus longer notes (ring ×4 … ×16 of a 16th).
// Only deviation: the chord comes from the track (Chapter + the progression of Jonas 1) instead of the lab's engine; as there, the last two 16ths of a bar play the next bar's chord (push) in Offbeat.
// Own orbit 3 as in the lab, so its echo throw does not change the keys' echo. Sound: VCSL vibraphone (CC0, built in).
// @009 ctl 16:3.k1 Brightness | dull ↔ bright (low-pass).
// @009 ctl 16:3.k2 Soft | dry and short ↔ long notes, echo and room.
// @009 ctl 16:3.k3 Complexity | core notes → figure → fills → doubles.
// @009 ctl 16:3.fader Level | vibraphone phrases, follow the chords.
// @009 ctl 16:3.b1 Phrase | off-beat → tresillo → echo of the call, next bar.
// @009 ctl 16:3.b2 Echo throw | held: long dotted-8th echo.
const vib = colJonas(3)
const VIB_LEVEL = 0.7   // the lab's column gain 0.5, +40 %
// The column's state: [brightness, soft, complexity, level] with the lab's start values; untouched knobs keep them
const V = { val: [0.6, 0, 0.3, 0], held: false, prev: null }
const vibCtl = signal(t => {
  const now = [vib.bright, vib.space, vib.char, vib.level].map(p => valAt(p, t))
  now.forEach((v, i) => {
    if (V.prev === null ? i !== 3 && v === 0 : v === V.prev[i]) return
    V.val[i] = v
    lcView?.update()
  })
  V.prev = now
  const h = valAt(vib.btn2, t) > 0.5
  if (h !== V.held) { V.held = h; lcView?.update() }
  return 0
}).segment(16)
taps.push(vibCtl)
const vibCx = signal(() => V.val[2]), vibSoft = signal(() => V.val[1])
// The chord at 16th k (with push: two 16ths early), its notes from E3 (52) up as in the lab's arp, its root as a degree
const vibChord = (k, push) => CHORDS[valAt(harmId, Math.floor((k + (push ? 2 : 0)) / 16) + 0.01)]
const VIB_POOL = {}
const vibNotes = c => VIB_POOL[c.name] ??= (() => {
  const pcs = (KEY_VOICING[c.name] ?? c.tones).map(pc), o = []
  for (let m = 52; m <= 76; m++) if (pcs.includes(pc(m))) o.push(m)
  return o.slice(0, 8)
})()
// the root as a scale degree, counted by letter from A (A 0, B 1, C 2, D 3, E 4, F 5, G 6): same in dorian and aeolian
const VIB_DEG = { 9: 0, 11: 1, 0: 2, 2: 3, 4: 4, 5: 5, 7: 6 }
const vibArp = idx => new Pattern(state => idx.query(state).map(h => h.withValue(i => {
  const notes = vibNotes(vibChord(Math.round(h.whole.begin.valueOf() * 16), true))
  return { note: notes[((i % notes.length) + notes.length) % notes.length] }
})))
const vibRootDeg = signal(t => VIB_DEG[pc(vibChord(Math.round(t * 16), false).bass)] ?? 0).segment(16)
const vibScale   = signal(t => 'A3:' + modeAt(Math.floor(t))).segment(16)   // dorian / aeolian per progression
// Layers of a figure, switched in by Complexity (degradeBy 1 = silent, 0 = all) — the lab's code
const vibFrom = (lo, p) => p.degradeBy(vibCx.fmap(c => c > lo ? 0 : 1))
const vibFills = p => p.degradeBy(vibCx.fmap(c => c < 0.45 ? 1 : 1 - 0.7 * (c - 0.45) / 0.55))
const vibBusy = p => p.sometimesBy(vibCx.fmap(c => c < 0.75 ? 0 : 0.35 * (c - 0.75) / 0.25), x => x.ply(2))
  .sometimesBy(vibCx.fmap(c => c < 0.75 ? 0 : 0.2 * (c - 0.75) / 0.25), x => x.add(1))
const vibLayered = (core, rest, gaps) => vibBusy(stack(mini(core), vibFrom(0.15, mini(rest)), vibFills(mini(gaps))))
const VIB_CALL = ['[g5@3 ~ f#5 e5@2 d5@7 ~ d5]', '[c5@2 b4 c5@2 e5@2 d5@5 ~@4]']   // Escravos, bars 7–8
const vibLower = (bar, k) => bar.replace(/([a-g]#?)(\d)/g, (_, n, o) => n + (+o + k))
// The call is in A dorian (F♯); in the aeolian progressions (all but Am9 D9) F♯ rubs, so it becomes F there
const vibModeFix = p => new Pattern(state => p.query(state).map(h => h.withValue(v =>
  typeof v.note === 'string' && v.note.startsWith('f#') && modeAt(Math.floor((h.whole ?? h.part).begin.valueOf())) === 'aeolian'
    ? { ...v, note: 'f' + v.note.slice(2) } : v)))
const vibPhrases = [
  ['Offbeat', vibArp(vibLayered(
    '[~ ~ ~ 1 ~@5 3 ~@6]',
    '<[~ 0 ~ ~ ~@2 2 ~@5 2 ~ 1 ~]!7 [~ 0 ~ ~ ~@2 2 ~@5 3 ~ 4 ~]>',
    '[~ ~ 4 ~ 3 1 ~ 5 2 ~ 4 0 ~ 3 ~ 5]'))],
  ['Tresillo', n(vibLayered(
    '[0 ~ ~ 4 ~ ~ 0 ~@9]',
    '<[~@10 -1 ~ 2 ~@3]!3 [~@10 2 ~ [4 4] ~@3]>',
    '[~ 2 ~ ~ 1 ~ ~ 4 ~ 3 ~ 4 ~ 5 4 ~]').add(vibRootDeg)).scale(vibScale)],
  ['Ruf-Echo', vibBusy(vibModeFix(note(mini('<' + ['~', '~', '~', '~', '~', '~', ...VIB_CALL.map(b => vibLower(b, -2))].join(' ') + '>'))))],
].map(([name, p]) => [name, p.s('vibraphone').velocity(perlin.range(0.6, 1)).pan(sine.slow(3).range(0.4, 0.6))
  .clip(vibSoft.fmap(s => 4 * Math.pow(4, s)))])          // Soft: ring ×4 … ×16 of a 16th
const vibVar = change(vib.btn, 'jonas', 'Vibraphon', vibPhrases.length, vibPhrases.map(p => p[0]))
// status rows: 0 = harmony (column 1), 1 = keys (column 2), 2 = vibraphone (column 3), 3 = flute (column 4)
// Swing as in the lab (56 %: the odd 16ths 0.12 of a 16th late), then the lab's channel strip per event; Fog /
// Tension on the cutoff, global Room and Tension's echo on top, as for the keys
const vibPlayed = pick(vibVar, vibPhrases.map(p => p[1])).swingBy(0.12, 8)
const vibStrip = new Pattern(state => vibPlayed.query(state).map(h => h.withValue(v => {
  const t = (h.whole ?? h.part).begin.valueOf(), [br, sp] = V.val
  const r = 0.8 * Math.max(0, (sp - 0.35) / 0.65), gRoom = valAt(globalRoom, t)
  const ev = sp > 0 ? Math.min(1, 0.4 + 1.2 * sp) : 0
  const ef = V.held ? { delay: 0.65, delaytime: 0.75 * 60 / bpm, delayfeedback: 0.62 }
    : { delay: 0.6 * ev, delaytime: 30 / bpm, delayfeedback: 0.15 + 0.35 * ev }
  ef.delay = Math.max(ef.delay, valAt(tensionEcho, t))
  const cutoff = Math.min(18000, Math.max(80, Math.min(18000, v.cutoff ?? 18000, 600 * Math.pow(20, br)) * valAt(globalTone, t)))
  return { release: 0.1, ...v, cutoff, room: r + (0.95 - r) * gRoom, roomsize: 2, ...(ef.delay > 0 ? ef : {}), orbit: 3 }
})))
// Level: fader × the lab's gain (+40 %) × brightness ±2 dB, as the lab's postgain
const stemN3_vibes = strip(vibStrip, { level: signal(() => V.val[3] * VIB_LEVEL * Math.pow(10, 4 * (V.val[0] - 0.5) / 20)) })
// LC view: the lab's dashboard column (Hell, Weich, Komplex, Pegel, the phrase, Echo-Wurf)
COLVIEW['jonas:3'] = (row, { esc, pending }) => {
  const knob = (v, name) => '<div class="cell knob"><div class=dial style="--v:' + v + '"></div><b>' + pct(v) +
    '</b><span>' + esc(name) + '</span></div>'
  return {
    k1: knob(V.val[0], 'Hell'), k2: knob(V.val[1], 'Weich'), k3: knob(V.val[2], 'Komplex'),
    fader: '<div class="cell fader"><div class=bar style="--v:' + V.val[3] + '"><i></i></div><b>' + pct(V.val[3]) +
      '</b><span>Pegel</span></div>',
    b1: '<div class="cell btn"><b>' + pending(vibPhrases[vibVar.now][0], vibPhrases[vibVar.pending][0]) + '</b></div>',
    b2: '<div class="cell btn' + (V.held ? ' on' : '') + '"><b>Echo-Wurf</b></div>',
  }[row]
}

// ============================================================
// JONAS 4 FLUTE — 1:1 from the melody lab (lab/melodie/melodie-4.strudel, column 6 “Flöte höher”): the same controls,
// motifs, Playful layers, flute notes, swing and effects; louder than in the lab (user, 2026-11-08: too quiet).
// ============================================================
// Single notes cut from the recorded flute (juskiddink “Flute2”, Freesound, CC BY 4.0 — the lab's phrase files, see
// samples/horn-phrases/README.md), moved to the wanted pitch by playback speed; motifs on the chord tones from G4 up,
// A A B A over 8 bars. Playful (row 3, start 30 %): from a third on two extra notes in the gaps, from three quarters a
// short trill into a note (about every second time). Space (row 2) as the lab's bus: a little room even at 0.
// Only deviation: the chord comes from the track (Chapter + the progression of Jonas 1), two 16ths early (push), as the
// lab's engine; chord tones from the track's keys voicing / chord tones. Level: the lab's gain 0.6 → 2.0 (+10.5 dB),
// measured offline in the track at fader 1 (start values, vamp): the vibraphone (Jonas 3) −23.8 LUFS, the flute now the same.
// Orbit 3, shared with the vibraphone (in the lab all candidates shared one orbit).
// @009 ctl 16:4.k1 Brightness | dull ↔ bright (low-pass).
// @009 ctl 16:4.k2 Space | echo and room (a little at 0).
// @009 ctl 16:4.k3 Playful | core motif → + neighbour notes → + a short trill.
// @009 ctl 16:4.fader Level | flute melody from real flute notes, follows the chords.
// @009 ctl 16:4.b1 Motif | hopping → call and answer → turn, next bar.
// @009 ctl 16:4.b2 Echo throw | held: long dotted-8th echo.
const flu = colJonas(4)
const FLUTE_LEVEL = 2.0   // the lab's column gain 0.6, +10.5 dB (measured in the track, see above)
// The column's state: [brightness, space, playful, level] with the lab's start values; untouched knobs keep them
const F = { val: [0.6, 0, 0.3, 0], held: false, prev: null }
const fluCtl = signal(t => {
  const now = [flu.bright, flu.space, flu.char, flu.level].map(p => valAt(p, t))
  now.forEach((v, i) => {
    if (F.prev === null ? i !== 3 && v === 0 : v === F.prev[i]) return
    F.val[i] = v
    lcView?.update()
  })
  F.prev = now
  const h = valAt(flu.btn2, t) > 0.5
  if (h !== F.held) { F.held = h; lcView?.update() }
  return 0
}).segment(16)
taps.push(fluCtl)
const fluPlay = signal(() => F.val[2])
// The flute phrases (as the lab's m4_fl) and the single notes in them: [phrase, from s, to s, MIDI] (lab's YIN analysis)
const FLU_FILES = ['flute-65509-0003', 'flute-65509-0068', 'flute-65509-0133'], FLU_LEN = [6.45, 6.11, 7.12]
if (typeof samples === 'function') await samples({ m4_fl: FLU_FILES.map(f =>
  'https://raw.githubusercontent.com/hallfjonas/cerulean-echoes/johannes/samples/horn-phrases/' + f + '.flac') })
const FLUTE_NOTES = [[2, 1.86, 4.46, 61.97], [0, 3.87, 4.53, 64.07], [2, 0.45, 0.71, 65.12], [1, 2.02, 2.61, 67.11],
  [1, 0.11, 1.63, 68.94], [1, 2.67, 3.14, 70.98], [0, 0.77, 2.39, 72.03]]
const fluteNote = m0 => {
  let m = m0
  while (m > 77) m -= 12   // above F5 the notes would be sped up too far: an octave down
  const [f, a, b, base] = FLUTE_NOTES.reduce((best, x) => Math.abs(x[3] - m) < Math.abs(best[3] - m) ? x : best)
  return { s: 'm4_fl', n: f, begin: a / FLU_LEN[f], end: b / FLU_LEN[f], speed: Math.pow(2, (m - base) / 12), clip: 1, attack: 0.02, release: 0.09 }
}
// Chord tones from G4 (67) up, 8 of them, of the track's chord at 16th k with push (as the lab's arp)
const FLU_POOL = {}
const fluNotes = c => FLU_POOL[c.name] ??= (() => {
  const pcs = (KEY_VOICING[c.name] ?? c.tones).map(pc), o = []
  for (let m = 67; m <= 91; m++) if (pcs.includes(pc(m))) o.push(m)
  return o.slice(0, 8)
})()
const fluArp = idx => new Pattern(state => idx.query(state).map(h => h.withValue(i => {
  const notes = fluNotes(vibChord(Math.round(h.whole.begin.valueOf() * 16), true))
  return { note: notes[((i % notes.length) + notes.length) % notes.length] }
})))
// The lab's motifs: [name, [bar A, bar B, bar D], extra notes, trill], 8 bars A A B A A A B D
const FLU_MOTIFS = [
  ['Hüpfer', ['[~ ~ 2 ~ ~ 3 ~ 2 ~ ~ 1 ~ ~ 2 ~ ~]', '[~ ~ 2 ~ ~ 3 ~ 4 ~ ~ 3 ~ 2 ~ 1 ~]', '[~ ~ 2 ~ ~ 3 ~ 2 ~ ~ 1 ~ 0 ~ ~ ~]'],
    '[~ ~ ~ 3 ~ ~ ~ ~ ~ 1 ~ ~ ~ ~ ~ ~]', '[~ ~ ~ ~ 2 ~@11]'],
  ['Ruf-Antwort', ['[3@3 ~ 2 ~ 3@4 ~@6]', '[~ ~ 1 ~ 2 ~ ~ 1@3 ~ 0@3 ~@3]', '[3@3 ~ 4 ~ 3@3 2 ~ ~ ~@4]'],
    '[~@8 2 ~@4 3 ~ ~]', '[~ ~ ~ 2 ~@12]'],
  ['Drehung', ['[2 ~ 3 2 ~ 1 ~ 2 ~ ~ ~ ~ ~ ~ ~ ~]', '[2 ~ 3 2 ~ 1 ~ 0@2 ~ 1 ~ 2@3 ~]', '[4 ~ 3 2 ~ 3 ~ 2 ~ ~ ~ ~ ~ ~ ~ ~]'],
    '[~@8 ~ 1 ~ ~ ~ 3 ~ ~]', '[~@14 2 ~]'],
]
const fluPhrases = FLU_MOTIFS.map(([name, [a, b, d], extra, trill]) => {
  const core = mini('<' + [a, a, b, a, a, a, b, d].join(' ') + '>')
  const nb = mini(extra).degradeBy(fluPlay.fmap(v => v < 0.33 ? 1 : 1 - (v - 0.33) / 0.67))
  const tr = mini(trill).fmap(x => mini('[' + x + ' ' + (x + 1) + ' ' + x + ' ' + (x + 1) + ']')).squeezeJoin()
    .degradeBy(fluPlay.fmap(v => v < 0.75 ? 1 : 0)).degradeBy(0.4)
  return [name, fluArp(stack(core, nb, tr)).fmap(v => fluteNote(v.note)).velocity(perlin.range(0.75, 1)).pan(0.55)]
})
const fluVar = change(flu.btn, 'jonas', 'Flöte', fluPhrases.length, fluPhrases.map(p => p[0]))
// Swing as in the lab (56 %), then the lab's channel strip per event (space 'bus', floor 0.2: room 0.9 × space, never
// below 0.2; echo throw dotted 8th); Fog / Tension on the cutoff, global Room and Tension's echo on top, as the vibraphone
const fluPlayed = pick(fluVar, fluPhrases.map(p => p[1])).swingBy(0.12, 8)
const fluStrip = new Pattern(state => fluPlayed.query(state).map(h => h.withValue(v => {
  const t = (h.whole ?? h.part).begin.valueOf(), [br, sp] = F.val
  const s2 = 0.2 + 0.8 * sp, r = 0.9 * s2, gRoom = valAt(globalRoom, t)
  const ef = F.held ? { delay: 0.65, delaytime: 0.75 * 60 / bpm, delayfeedback: 0.62 }
    : { delay: Math.min(0.9, (v.delay ?? 0) * 2 * s2), delaytime: 0.75 * 60 / bpm, delayfeedback: 0.55 }
  ef.delay = Math.max(ef.delay, valAt(tensionEcho, t))
  const cutoff = Math.min(18000, Math.max(80, Math.min(18000, v.cutoff ?? 18000, 900 * Math.pow(14000 / 900, br)) * valAt(globalTone, t)))
  return { ...v, cutoff, room: r + (0.95 - r) * gRoom, roomsize: 2, ...(ef.delay > 0 ? ef : {}), orbit: 3 }
})))
// Level: fader × the gain × brightness ±2 dB, as the lab's postgain
const stemN4_flute = strip(fluStrip, { level: signal(() => F.val[3] * FLUTE_LEVEL * Math.pow(10, 4 * (F.val[0] - 0.5) / 20)) })
// LC view: the lab's dashboard column (Hell, Raum, Verspielt, Pegel, the motif, Echo-Wurf)
COLVIEW['jonas:4'] = (row, { esc, pending }) => {
  const knob = (v, name) => '<div class="cell knob"><div class=dial style="--v:' + v + '"></div><b>' + pct(v) +
    '</b><span>' + esc(name) + '</span></div>'
  return {
    k1: knob(F.val[0], 'Hell'), k2: knob(F.val[1], 'Raum'), k3: knob(F.val[2], 'Verspielt'),
    fader: '<div class="cell fader"><div class=bar style="--v:' + F.val[3] + '"><i></i></div><b>' + pct(F.val[3]) +
      '</b><span>Pegel</span></div>',
    b1: '<div class="cell btn"><b>' + pending(fluPhrases[fluVar.now][0], fluPhrases[fluVar.pending][0]) + '</b></div>',
    b2: '<div class="cell btn' + (F.held ? ' on' : '') + '"><b>Echo-Wurf</b></div>',
  }[row]
}

// ============================================================
// JONAS 5 BRASS — from the brass lab (lab/blaeser/disco-blaeser-3.strudel): its six figures that stayed (user,
// 2026-11-08: “auf der a” and “Schweller + Fall” out), the ensemble sound, row 3 Complexity and the Lift on button 2.
// ============================================================
// Full section (Sonatina Symphonic Orchestra, CC Sampling Plus 1.0: trumpets, horns, trombones staccato + sustain), warm
// voicing: lead = the chord tone nearest C5, horns double it, trombones an octave under, two chord tones under the lead;
// every player a few ms late (fixed per position). Row 3 = complexity (pickups and answers come in, softer); button 2
// HELD = lift (over two bars the doubling and harmony grow, brighter, up to +3 dB, back over one bar).
// Deviations from the lab (all because one column has two buttons): button 1 steps through the six figures (in the lab
// each figure was a column and button 1 was solo ↔ ensemble): the track plays the ensemble. Chords from the track
// (Chapter + the progression of Jonas 1, two 16ths early as the lab's engine; same pitch classes as the lab's chords).
// Orbit 3 with the vibraphone and the flute (room size 2 there; 2.5 in the lab). Level: −6.6 dB against the lab (see
// BRASS_LEVEL). Complexity is being reworked in a lab.
// @009 ctl 16:5.k1 Brightness | dull ↔ bright (low-pass 0.9–8 kHz).
// @009 ctl 16:5.k2 Space | room at 0 ↔ hall and dotted-8th echo.
// @009 ctl 16:5.k3 Complexity | core figure → + pickups and answers → + small extra hits.
// @009 ctl 16:5.fader Level | full brass section, follows the chords.
// @009 ctl 16:5.b1 Figure | push → 3-3-2 → shout → double push → 3-3-2 long → swell + push, next bar.
// @009 ctl 16:5.b2 Lift | held: the section grows over 2 bars (voices, brightness, +3 dB); back over 1 bar after.
const brs = colJonas(5)
const BRASS_LEVEL = 0.42   // the lab's gain 0.9 measured −14.6 LUFS at fader 1 (vamp, push, start values): −6.6 dB → −21 LUFS = the keys
// The column's state: [brightness, space, complexity, level] with the lab's start values; lift 0..1 (button 2)
const B = { val: [0.6, 0, 0.3, 0], held: false, prev: null, lift: 0, t: null }
const brsCtl = signal(t => {
  const now = [brs.bright, brs.space, brs.char, brs.level].map(p => valAt(p, t))
  now.forEach((v, i) => {
    if (B.prev === null ? i !== 3 && v === 0 : v === B.prev[i]) return
    B.val[i] = v
    lcView?.update()
  })
  B.prev = now
  const h = valAt(brs.btn2, t) > 0.5
  if (h !== B.held) { B.held = h; lcView?.update() }
  // lift: up over 2 bars while held, down over 1 bar after (in cycles = bars)
  const dt = B.t === null ? 0 : Math.max(0, Math.min(0.25, Number(t) - B.t))
  B.t = Number(t)
  B.lift = B.held ? Math.min(1, B.lift + dt / 2) : Math.max(0, B.lift - dt)
  return 0
}).segment(16)
taps.push(brsCtl)
const SSO = 'https://raw.githubusercontent.com/peastman/sso/master/Sonatina%20Symphonic%20Orchestra/Samples/'
const ssoMap = (dir, pre, names, post = '') => Object.fromEntries(names.map(n => [n, SSO + dir + '/' + pre + n.replace('#', '%23') + post + '.wav']))
if (typeof samples === 'function') await samples({
  sso_tp: ssoMap('Trumpets', 'trumpets-stc-rr1-', ['e3', 'g3', 'a#3', 'c#4', 'e4', 'g4', 'a#4', 'c#5', 'e5', 'g5', 'a#5']),
  sso_tb: ssoMap('Trombones', 'trombones-stc-rr1-', ['e2', 'g2', 'a#2', 'c#3', 'e3', 'g3', 'a#3', 'c#4', 'e4']),
  sso_hn: ssoMap('Horns', 'horns-stc-rr1-', ['e2', 'g2', 'a#2', 'c#3', 'e3', 'g3', 'a#3', 'c#4', 'e4', 'g4', 'a#4']),
  sso_tp_sus: ssoMap('Trumpets', 'trumpets-sus-', ['e3', 'g3', 'a#3', 'c#4', 'e4', 'g4', 'a#4', 'c#5', 'e5', 'g5']),
  sso_tb_sus: ssoMap('Trombones', 'trombones-sus-', ['e2', 'g2', 'a#2', 'c#3', 'e3', 'g3', 'a#3', 'c#4', 'e4']),
  sso_hn_sus: ssoMap('Horns', 'horns-sus-mp-', ['e2', 'g2', 'a#2', 'c#3', 'e3', 'g3', 'a#3', 'c#4', 'e4', 'g4', 'a#4'], '-PB-loop'),
})
// The lab's figures: N(16th, length, complexity level, kind); L = figure length in 16ths
const BN = (p, len, lv = 0, kind = 'hit') => ({ p, len, lv, kind })
const BRASS_FIGS = [
  ['Push', 32, [BN(14, 1), BN(16, 3), BN(30, 1), BN(0, 3), BN(13, 1, 1), BN(29, 1, 1), BN(22, 1, 2), BN(8, 1, 2)]],
  ['3-3-2 + Antwort', 32, [BN(0, 1), BN(3, 1), BN(6, 2), BN(24, 1), BN(27, 3), BN(10, 1, 1), BN(23, 1, 1), BN(31, 1, 2), BN(14, 1, 2)]],
  ['Shout', 16, [BN(0, 1), BN(3, 1), BN(6, 1), BN(10, 2), BN(12, 1), BN(14, 1, 1), BN(15, 1, 2), BN(8, 1, 2)]],
  ['Doppel-Push', 32, [BN(13, 1), BN(14, 1), BN(16, 2), BN(29, 1), BN(30, 1), BN(0, 2), BN(6, 1, 1), BN(22, 1, 1), BN(23, 1, 2), BN(10, 1, 2)]],
  ['3-3-2 lang', 32, [BN(0, 1), BN(3, 1), BN(6, 1), BN(16, 1), BN(19, 1), BN(22, 2), BN(28, 1, 1), BN(30, 1, 1), BN(12, 1, 2), BN(27, 1, 2)]],
  ['Schweller + Push', 32, [BN(24, 6, 0, 'swell'), BN(30, 1), BN(0, 2), BN(3, 1, 1), BN(6, 1, 1), BN(10, 1, 2), BN(14, 1, 2)]],
]
const BMS = 16 / (240 / bpm * 1000)   // 16ths per millisecond
const brsPcs = c => [...new Set(chordPcs(c))]
const brsLead = c => { const p = brsPcs(c); let best = 67; for (let m = 67; m <= 76; m++) if (p.includes(pc(m)) && Math.abs(m - 72) < Math.abs(best - 72)) best = m; return best }
const brsBelow = (c, top, n) => { const p = brsPcs(c), o = []; for (let m = top - 1; m >= top - 12 && o.length < n; m--) if (p.includes(pc(m))) o.push(m); return o }
const BRS_ENS = { lead: [['sso_tp', 0.45, 0, 0.45], ['sso_hn', 0.45, 6, 0.55]], dbl: [['sso_tp', 0.32, 9, 0.6]],
  harm: [['sso_hn', 0.4, 8, 0.5], ['sso_tp', 0.25, 4, 0.6]], low: [['sso_tb', 0.5, 11, 0.6]] }
const BRS_SUS = { sso_tp: ['sso_tp_sus', 0.8], sso_hn: ['sso_hn_sus', 0.45], sso_tb: ['sso_tb_sus', 0.6] }
const brassFig = (L, notes) => new Pattern(state => {
  const b0 = state.span.begin.valueOf(), e0 = state.span.end.valueOf(), out = []
  const lvl = B.val[2] < 0.33 ? 0 : B.val[2] < 0.66 ? 1 : 2, lift = B.lift, lg = Math.pow(10, 3 * lift / 20)
  for (let k = Math.floor(b0 * 16) - 1; k < e0 * 16 + 2; k++) {
    const p = ((k % L) + L) % L
    for (const n of notes) {
      if (n.p !== p || n.lv > lvl) continue
      const c = vibChord(k, true), lead = brsLead(c), held = n.kind === 'swell', soft = n.lv > 0 ? 0.7 : 1
      const base = { clip: 1, bright: 0.75 + 0.6 * lift, attack: held ? 0.6 * n.len / 16 * 240 / bpm : 0.003,
        release: held ? 0.35 : n.len >= 3 ? 0.2 : 0.12 }
      const dur = n.len === 1 ? 0.9 : n.len - 0.3
      const close = brsBelow(c, lead, 3), harm = held ? [close[1], close[2], close[0] - 12] : close.slice(0, 2)
      const voices = [...BRS_ENS.lead.map(x => [x, lead, 1]), ...BRS_ENS.low.map(x => [x, lead - 12, 1]),
        ...BRS_ENS.dbl.map(x => [x, lead, 0.6 + 0.4 * lift]), ...harm.flatMap(m => BRS_ENS.harm.map(x => [x, m, 0.7 + 0.3 * lift])),
        ...(lift > 0.5 ? [[BRS_ENS.lead[0], lead + 12, 0.5 * (lift - 0.5) * 2]] : [])]
      for (const [[s0, g, ms, pan], note, f] of voices) {
        if (note === undefined) continue
        const [s, g2] = held ? BRS_SUS[s0] : [s0, 1]
        const t0 = (k + (ms + 8 * hash(k, note, s.length)) * BMS) / 16   // never early: an event before its 16th is lost in the swing
        if (t0 < b0 - 1e-9 || t0 >= e0 - 1e-9) continue
        out.push(new Hap(new TimeSpan(t0, t0 + dur / 16), new TimeSpan(t0, Math.min(t0 + dur / 16, e0)),
          { ...base, s, note, gain: g * g2 * soft * f * lg, pan }, {}))
      }
    }
  }
  return out
})
const brsFigs = BRASS_FIGS.map(([name, L, notes]) => [name, brassFig(L, notes)])
const brsVar = change(brs.btn, 'jonas', 'Bläser', brsFigs.length, brsFigs.map(f => f[0]))
// Swing as in the lab (56 %), then the lab's channel strip per event (space 'bus', floor 0.3: room 0.9 × space, never
// below 0.3); Fog / Tension on the cutoff, global Room and Tension's echo on top, as the flute
const brsPlayed = pick(brsVar, brsFigs.map(f => f[1])).swingBy(0.12, 8)
const brsStrip = new Pattern(state => brsPlayed.query(state).map(h => h.withValue(({ bright = 1, ...v }) => {
  const t = (h.whole ?? h.part).begin.valueOf(), [br, sp] = B.val
  const s2 = 0.3 + 0.7 * sp, r = 0.9 * s2, gRoom = valAt(globalRoom, t)
  const ef = { delay: Math.max(0, valAt(tensionEcho, t)), delaytime: 0.75 * 60 / bpm, delayfeedback: 0.55 }
  const cutoff = Math.min(18000, Math.max(80, 900 * Math.pow(8000 / 900, br) * bright * valAt(globalTone, t)))
  return { ...v, cutoff, room: r + (0.95 - r) * gRoom, roomsize: 2, ...(ef.delay > 0 ? ef : {}), orbit: 3 }
})))
// Level: fader × the gain × brightness ±2 dB, as the lab's postgain
const stemN5_brass = strip(brsStrip, { level: signal(() => B.val[3] * BRASS_LEVEL * Math.pow(10, 4 * (B.val[0] - 0.5) / 20)) })
// LC view: the lab's dashboard column (Hell, Raum, Komplexität, Pegel, the figure, Steigerung)
COLVIEW['jonas:5'] = (row, { esc, pending }) => {
  const knob = (v, name) => '<div class="cell knob"><div class=dial style="--v:' + v + '"></div><b>' + pct(v) +
    '</b><span>' + esc(name) + '</span></div>'
  return {
    k1: knob(B.val[0], 'Hell'), k2: knob(B.val[1], 'Raum'), k3: knob(B.val[2], 'Komplexität'),
    fader: '<div class="cell fader"><div class=bar style="--v:' + B.val[3] + '"><i></i></div><b>' + pct(B.val[3]) +
      '</b><span>Pegel</span></div>',
    b1: '<div class="cell btn"><b>' + pending(brsFigs[brsVar.now][0], brsFigs[brsVar.pending][0]) + '</b></div>',
    b2: '<div class="cell btn' + (B.held ? ' on' : '') + '"><b>Steigerung ' + pct(B.lift) + '</b></div>',
  }[row]
}

// ============================================================
// JONAS 6 STRINGS — from the strings lab (lab/streicher/disco-streicher-4.strudel), all five figures, NOT HEARD yet
// (user, 2026-11-08: put the current state into the track).
// ============================================================
// Sonatina Symphonic Orchestra (CC Sampling Plus 1.0) + VSCO 2 CE (CC0) string sections: one section per note (they
// alternate), the octave by the other section, staccato rings out; runs land on the one with the full echo-stab chord
// (violas, celli on the root) + a pizzicato click. Row 3 = build-up (unison → + octave → + thirds under the runs → +
// celli two octaves down); button 2 HELD = lift (octave and voices over two bars, brighter, +3 dB; back over one bar).
// Deviations from the lab: button 1 steps through the five figures (in the lab: one column each; button 1 = ensemble ↔
// solo) → the track plays the ensemble; chords from the track (two 16ths early); orbit 3 (room size 2; 3 in the lab).
// @009 ctl 16:6.k1 Brightness | dull ↔ bright (low-pass 1.2–12 kHz).
// @009 ctl 16:6.k2 Space | room at 0 ↔ hall and dotted-8th echo.
// @009 ctl 16:6.k3 Build-up | unison → + octave → + thirds under the runs → + celli two octaves down.
// @009 ctl 16:6.fader Level | string section, disco figures on the chords.
// @009 ctl 16:6.b1 Figure | echo stab → run up → long run → stab + swell → 16th figure, next bar.
// @009 ctl 16:6.b2 Lift | held: octave and voices come in over 2 bars, brighter, +3 dB; back over 1 bar after.
const str = colJonas(6)
const STRINGS_LEVEL = 0.59   // the lab's gain 0.9 = −17.3 LUFS at fader 1 (echo stab, start values): −3.7 dB → −21 LUFS = keys, brass
const SG = { val: [0.6, 0, 0.3, 0], held: false, prev: null, lift: 0, t: null }
// one state reader for the new columns: knobs keep the lab's start values until moved; lift 0 → 1 over 2 bars held
const labCtl = (col, st) => signal(t => {
  const now = [col.bright, col.space, col.char, col.level].map(p => valAt(p, t))
  now.forEach((v, i) => {
    if (st.prev === null ? i !== 3 && v === 0 : v === st.prev[i]) return
    st.val[i] = v
    lcView?.update()
  })
  st.prev = now
  const h = valAt(col.btn2, t) > 0.5
  if (h !== st.held) { st.held = h; lcView?.update() }
  const dt = st.t === null ? 0 : Math.max(0, Math.min(0.25, Number(t) - st.t))
  st.t = Number(t)
  st.lift = st.held ? Math.min(1, st.lift + dt / 2) : Math.max(0, st.lift - dt)
  return 0
}).segment(16)
taps.push(labCtl(str, SG))
const VSCO_STR = 'https://raw.githubusercontent.com/sgossner/VSCO-2-CE/master/Strings/'
const vscoUp8 = n => n.replace(/\d$/, d => +d + 1)   // VSCO sounds an octave above the file name
const vscoMap = (dir, file, names) => Object.fromEntries(names.map(n => [vscoUp8(n).toLowerCase(), VSCO_STR + dir + '/' + file(n).replace('#', '%23')]))
const STR_VA = ['c3', 'd#3', 'f#3', 'a3', 'c4', 'd#4', 'f#4', 'a4', 'c5']
if (typeof samples === 'function') await samples({
  sso_vn: ssoMap('1st%20Violins', '1st-violins-stc-rr1-', ['g3', 'c#4', 'e4', 'g4', 'a#4', 'c#5', 'e5', 'g5', 'a#5', 'c#6', 'e6', 'g6']),
  sso_vn2: ssoMap('2nd%20Violins', '2nd-violins-stc-rr1-', ['g3', 'a#3', 'c#4', 'e4', 'g4', 'a#4', 'c#5', 'e5', 'g5', 'a#5']),
  sso_va: ssoMap('Violas', 'violas-stc-rr1-', STR_VA),
  sso_vc: ssoMap('Celli', 'celli-stc-rr1-', ['c2', 'd#2', 'f#2', 'a2', 'c3', 'd#3', 'f#3', 'a3', 'c4']),
  sso_vn_sus: ssoMap('1st%20Violins', '1st-violins-sus-', ['g3', 'a#3', 'c#4', 'e4', 'g4', 'a#4', 'c#5', 'e5', 'g5', 'a#5', 'c#6']),
  sso_va_sus: ssoMap('Violas', 'violas-sus-', STR_VA),
  sso_vn_piz: ssoMap('1st%20Violins', '1st-violins-piz-rr1-', ['g3', 'a#3', 'c#4', 'e4', 'g4', 'a#4', 'c#5', 'e5', 'a#5', 'c#6']),
  vs_vn: vscoMap('Violin%20Section/Spic', n => 'VlnEns_Spic_' + n + '_v2_rr1.wav', ['G2', 'A2', 'B2', 'D3', 'F#3', 'A3', 'C4', 'E4', 'G4', 'B4', 'D5']),
  vs_va: vscoMap('Viola%20Section/spic', n => 'Violas_spic_' + n + '_v2_rr1.wav', ['C2', 'E2', 'G2', 'B2', 'D3', 'F3', 'A3', 'C4', 'E4', 'G4']),
})
// helpers shared by strings and guitar: chord tones of a track chord, the scale at 16th k, scale / chord steps
const labPcs = c => [...new Set(chordPcs(c))]
const labScale = k => BSC[modeAt(Math.floor(k / 16))]
const labSteps = (m, sc, n) => { let x = m; const d = Math.sign(n); for (let i = 0; i < Math.abs(n); i++) { x += d; while (!sc.includes(pc(x))) x += d } return x }
const labBelow = (c, top, n) => { const p = labPcs(c), o = []; for (let m = top - 1; m >= top - 12 && o.length < n; m--) if (p.includes(pc(m))) o.push(m); return o }
const labNear = (c, lo, hi, target) => { const p = labPcs(c); let best = lo; for (let m = lo; m <= hi; m++) if (p.includes(pc(m)) && Math.abs(m - target) < Math.abs(best - target)) best = m; return best }
const LMS = 16 / (240 / bpm * 1000)   // 16ths per millisecond
// events on the 16th grid from fn(k) → [{ dur, dt, …value }]; dt ≥ 0 (an event before its 16th is lost in the swing)
const labEvents = fn => new Pattern(state => {
  const b0 = state.span.begin.valueOf(), e0 = state.span.end.valueOf(), out = []
  for (let k = Math.floor(b0 * 16) - 1; k < e0 * 16 + 1; k++)
    for (const { dur = 1, dt = 0, ...v } of fn(k) ?? []) {
      const t0 = (k + dt) / 16
      if (t0 < b0 - 1e-9 || t0 >= e0 - 1e-9) continue
      out.push(new Hap(new TimeSpan(t0, t0 + dur / 16), new TimeSpan(t0, Math.min(t0 + dur / 16, e0)), v, {}))
    }
  return out
})
// the lab's channel strip (space 'bus', floor 0.3), Fog / Tension on the cutoff, global Room and Tension's echo on top
// (style 'echo' = the lab engine's other space mapping, as the guitar board: a 1/8 echo first, the room from 0.35 on)
const labStrip = (pat, st, lo, hi, style = 'bus') => new Pattern(state => pat.query(state).map(h => h.withValue(({ bright = 1, ...v }) => {
  const t = (h.whole ?? h.part).begin.valueOf(), [br, sp] = st.val, gRoom = valAt(globalRoom, t)
  let r, ef
  if (style === 'bus') {
    const s2 = 0.3 + 0.7 * sp
    r = 0.9 * s2
    ef = { delay: Math.max(Math.min(0.9, (v.delay ?? 0) * 2 * s2), valAt(tensionEcho, t)), delaytime: 0.75 * 60 / bpm, delayfeedback: 0.55 }
  } else {
    r = 0.8 * Math.max(0, (sp - 0.35) / 0.65)
    const e = sp > 0 ? Math.min(1, 0.4 + 1.2 * sp) : 0
    ef = e > 0 ? { delay: Math.max(0.6 * e, valAt(tensionEcho, t)), delaytime: 30 / bpm, delayfeedback: 0.15 + 0.35 * e }
      : { delay: Math.max(v.delay ?? 0, valAt(tensionEcho, t)), delaytime: 0.75 * 60 / bpm, delayfeedback: 0.55 }
  }
  const cutoff = Math.min(18000, Math.max(80, Math.min(v.cutoff ?? 18000, lo * Math.pow(hi / lo, br) * bright) * valAt(globalTone, t)))
  return { release: 0.1, ...v, cutoff, room: r + (0.95 - r) * gRoom, roomsize: 2, ...(ef.delay > 0 ? ef : { delay: 0 }), orbit: 3 }
})))
const SN = (p, kind, len, off = 0, at = 0, more = {}) => ({ p, kind, len, off, at, acc: 1, ...more })
const STR_TOP = { acc: 1.5, hard: true, echo: 0.3 }
const strRunTo = (end, n, L) => [...Array.from({ length: n }, (_, i) => SN(((end - n + i) % L + L) % L, 'line', 1, i - n, n - i)), SN(((end % L) + L) % L, 'stab', 2, 0, 0, STR_TOP)]
const STR_FIGS = [
  ['Echo-Stab', 32, [SN(0, 'stab', 2, 0, 0, { echo: 0.5, hard: true })]],
  ['Lauf hoch', 32, strRunTo(32, 4, 32)],
  ['Langer Lauf', 64, strRunTo(64, 8, 64)],
  ['Stab + Schweller', 64, [SN(0, 'stab', 2, 0, 0, { echo: 0.5, hard: true }), SN(32, 'swell', 30)]],
  ['16tel-Figur', 64, [...[0, -1, 0, 1, 0, -1, -2, -1].map((o, i) => SN(56 + i, 'line', 1, o, 8 - i)), SN(0, 'stab', 2, 0, 0, STR_TOP)]],
]
const STR_LINE = [['sso_vn', 0.55, 0.42], ['vs_vn', 1.6, 0.52], ['sso_vn2', 0.5, 0.58]]
const STR_FILL = [['sso_va', 0.45, 0.6], ['vs_va', 1.25, 0.45]]
const strFig = (L, notes) => labEvents(k => {
  const p = ((k % L) + L) % L, hits = notes.filter(n => n.p === p)
  if (!hits.length) return []
  const lift = SG.lift, v3 = SG.val[2], stage = Math.max(v3 < 0.25 ? 0 : v3 < 0.5 ? 1 : v3 < 0.75 ? 2 : 3, Math.floor(lift * 3))
  const out = [], lg = Math.pow(10, 3 * lift / 20), rr = ((k + 5) % 3 + 3) % 3
  for (const n of hits) {
    const c = vibChord(k + n.at, true), sc = labScale(k + n.at), top = labNear(c, 72, 81, 76), m = labSteps(top, sc, n.off)
    const swell = n.kind === 'swell'
    const base = swell ? { dur: n.len, clip: 1, attack: 0.9, release: 0.8 } : { dur: 6, attack: 0.002, release: 0.4 }
    const voice = (s, note, gain, ms, pan) => out.push({ ...base, s, note, gain: gain * n.acc * lg, pan, delay: n.echo ?? 0,
      bright: 0.8 + 0.5 * lift + (n.hard ? 0.3 : 0), dt: (ms + 4 * hash(k, note, s.length)) * LMS })
    if (swell) {
      voice('sso_vn_sus', m, 0.35, 0, 0.45)
      if (stage >= 1) voice('sso_va_sus', m - 12, 0.3, 6, 0.6)
      for (const x of labBelow(c, m, 2)) voice('sso_va_sus', x, 0.28, 9, 0.55)
      continue
    }
    const [s1, g1, p1] = STR_LINE[rr], [s2, g2, p2] = STR_LINE[(rr + 1) % 3]
    voice(s1, m, g1, 0, p1)
    if (stage >= 1) voice(s2, m + 12, g2 * 0.6, 12, p2)
    if (n.kind === 'stab') {
      labBelow(c, m, 2).forEach((x, j) => { const [s, g, pn] = STR_FILL[(rr + j) % 2]; voice(s, x, g, 8, pn) })
      voice('sso_vc', c.bass + 12, 0.5, 4, 0.65)
      if (n.hard) voice('sso_vn_piz', m, 0.55, 0, 0.5)
    } else {
      if (stage >= 2) voice(STR_FILL[rr % 2][0], labSteps(m, sc, -2), STR_FILL[rr % 2][1] * 0.8, 8, 0.6)
      if (stage >= 3) voice('sso_vc', m - 24, 0.4, 5, 0.65)
    }
  }
  return out
})
const strFigs = STR_FIGS.map(([name, L, notes]) => [name, strFig(L, notes)])
const strVar = change(str.btn, 'jonas', 'Streicher', strFigs.length, strFigs.map(f => f[0]))
const stemN6_strings = strip(labStrip(pick(strVar, strFigs.map(f => f[1])).swingBy(0.12, 8), SG, 1200, 12000),
  { level: signal(() => SG.val[3] * STRINGS_LEVEL * Math.pow(10, 4 * (SG.val[0] - 0.5) / 20)) })
const labView = (st, k3name, b1names, latch) => (row, { esc, pending }) => {
  const knob = (v, name) => '<div class="cell knob"><div class=dial style="--v:' + v + '"></div><b>' + pct(v) + '</b><span>' + esc(name) + '</span></div>'
  return {
    k1: knob(st.val[0], 'Hell'), k2: knob(st.val[1], 'Raum'), k3: knob(st.val[2], k3name),
    fader: '<div class="cell fader"><div class=bar style="--v:' + st.val[3] + '"><i></i></div><b>' + pct(st.val[3]) + '</b><span>Pegel</span></div>',
    b1: '<div class="cell btn"><b>' + pending(b1names[latch.now], b1names[latch.pending]) + '</b></div>',
    b2: '<div class="cell btn' + (st.held ? ' on' : '') + '"><b>Steigerung ' + pct(st.lift) + '</b></div>',
  }[row]
}
COLVIEW['jonas:6'] = labView(SG, 'Aufbau', strFigs.map(f => f[0]), strVar)

// ============================================================
// JONAS 7 GUITAR — from the guitar lab (lab/gitarre/disco-gitarre-3.strudel), all eight lines, open sound, NOT HEARD
// yet (user, 2026-11-08: put the current state into the track; the guitar sound is still being compared on
// lab/gitarre/gitarren-klaenge-1).
// ============================================================
// Plucked single notes of a real Stratocaster (nyanshell.strat, MIT: every note recorded, three takes), on the chord
// tones. Row 3 = complexity in four steps (line → + dead notes → + slides and a variation in bars 4 and 8 → + 16th
// motor of dead notes and a pentatonic fill in bar 8); button 2 HELD = lift (phaser, brighter, echo, +3 dB).
// Deviations from the lab: button 1 steps through the eight lines (in the lab: one column each; button 1 = open ↔
// muted) → the track plays them open; chords from the track (two 16ths early); orbit 3.
// @009 ctl 16:7.k1 Brightness | dull ↔ bright (low-pass 0.8–7 kHz).
// @009 ctl 16:7.k2 Space | dry ↔ a 1/8 echo, then room.
// @009 ctl 16:7.k3 Complexity | line → + dead notes → + slides, bar 4/8 variation → + 16th motor and a fill in bar 8.
// @009 ctl 16:7.fader Level | plucked guitar lines on the chords.
// @009 ctl 16:7.b1 Line | Stardust → e & a 4 → call + answer → repeated note → lick → dead-note groove → off-16th pairs → pickup.
// @009 ctl 16:7.b2 Lift | held: phaser, brighter, echo, +3 dB over 2 bars; back over 1 bar after.
const gtr = colJonas(7)
// the lab's gain 1 = −15.3 LUFS at fader 1 (Stardust, start values); 0.38 (−23.8 LUFS = vibraphone, flute) was too quiet
// (user, 2026-11-09): +6 dB → 0.76, about −17.8 LUFS
const GUITAR_LEVEL = 0.76
const GT = { val: [0.6, 0, 0.3, 0], held: false, prev: null, lift: 0, t: null }
taps.push(labCtl(gtr, GT))
const STRAT = 'https://raw.githubusercontent.com/nyanshell/nyanshell.strat/master/samples/'
const STRAT_FLAT = ['C', 'Db', 'D', 'Eb', 'E', 'F', 'Gb', 'G', 'Ab', 'A', 'Bb', 'B'], STRAT_KEY = ['c', 'c#', 'd', 'd#', 'e', 'f', 'f#', 'g', 'g#', 'a', 'a#', 'b']
const stratMap = take => Object.fromEntries(Array.from({ length: 86 - 52 + 1 }, (_, i) => 52 + i).map(m => {
  const n = STRAT_FLAT[m % 12] + (Math.floor(m / 12) - 1), [dir, pre] = m < 62 ? ['d_mp', 'D'] : m < 65 ? ['g_mp', 'G'] : ['e4_mp', 'E4']
  return [STRAT_KEY[m % 12] + (Math.floor(m / 12) - 1), STRAT + dir + '/' + pre + '_' + n + '_mp_' + take + '.wav']
}))
if (typeof samples === 'function') await samples({ strat1: stratMap(1), strat2: stratMap(2), strat3: stratMap(3) })
const GPENTA = [9, 0, 2, 4, 7]
const GN = (p, len, what, acc = 1) => ({ p, len, what, acc })
const GTR_LINES = [
  ['Stardust', 16, [GN(2, 2, ['top', 0]), GN(6, 1, ['ch', 0]), GN(8, 2, ['top', 12]), GN(11, 1, ['strum']), GN(15, 1, ['strum'])]],
  ['e & a 4', 16, [GN(9, 1, ['ch', 2]), GN(10, 1, ['ch', 1]), GN(11, 1, ['ch', 0]), GN(12, 3, ['top', 0], 1.1)]],
  ['Ruf + Antwort', 32, [GN(4, 1, ['ch', 1]), GN(6, 1, ['ch', 0]), GN(7, 2, ['top', 0]), GN(20, 1, ['top', -1]), GN(22, 1, ['ch', 0]), GN(24, 2, ['ch', 1])]],
  ['Wiederholter Ton', 16, [GN(0, 2, ['top', 0], 1.1), GN(3, 2, ['top', 0]), GN(6, 2, ['top', 0]), GN(10, 1, ['top', 0], 0.8)]],
  ['Lick', 64, [GN(56, 1, ['pen', 4]), GN(57, 1, ['pen', 3]), GN(58, 2, ['pen', 2]), GN(60, 1, ['pen', 1]), GN(61, 3, ['pen', 0]), GN(0, 2, ['top', 0])]],
  ['Dead-Note-Groove', 16, [GN(3, 1, ['top', 0]), GN(6, 1, ['top', 0]), GN(7, 1, ['ch', 0]), GN(11, 1, ['top', 0]), GN(14, 2, ['top', -1])]],
  ['Offbeat-Paare', 16, [GN(1, 1, ['top', 0]), GN(2, 1, ['ch', 0]), GN(5, 1, ['top', 0]), GN(6, 1, ['ch', 0]), GN(9, 1, ['top', 0]), GN(10, 1, ['ch', 1]), GN(13, 2, ['top', 0])]],
  ['Auftakt', 16, [GN(13, 1, ['ch', 1]), GN(14, 1, ['ch', 0]), GN(15, 1, ['top', -1]), GN(0, 2, ['top', 0], 1.25), GN(6, 1, ['top', 0], 0.8)]],
]
const gChordUp = (c, m) => { const p = labPcs(c); let x = m + 1; while (!p.includes(pc(x))) x++; return x }
const gPitch = (what, c, sc, up) => {
  const t0 = labNear(c, 67, 79, 72), top = up ? gChordUp(c, t0) : t0, [w, r] = what
  if (w === 'top') return [r === 12 ? top + 12 : labSteps(top, sc, r)]
  if (w === 'ch') return [labBelow(c, top, 3)[r]]
  if (w === 'pen') return [57 + 12 + GPENTA[r] - 9 + (GPENTA[r] < 9 ? 12 : 0) + (up ? 2 : 0)]
  if (w === 'strum') return labBelow(c, top + 1, 2)
  return []
}
const gtrLine = (ci, L, notes) => labEvents(k => {
  const p = ((k % L) + L) % L, s16 = ((k % 16) + 16) % 16, p128 = ((k % 128) + 128) % 128, bar8 = Math.floor(p128 / 16)
  const v3 = GT.val[2], lvl = v3 < 0.25 ? 0 : v3 < 0.5 ? 1 : v3 < 0.75 ? 2 : 3, lift = GT.lift, lg = Math.pow(10, 3 * lift / 20), out = []
  const c = vibChord(k, true), sc = labScale(k)
  const inFill = lvl >= 3 && p128 >= 120
  const hits = inFill ? [GN(p, 1, ['pen', 4 - Math.min(4, Math.floor((p128 - 120) * 5 / 8))], p128 === 120 ? 1.1 : 0.9)] : notes.filter(n => n.p === p)
  const up = lvl >= 2 && (bar8 === 3 || bar8 === 7)
  const fx = { bright: 0.85 + 0.5 * lift, delay: 0.25 * lift,
    ...(lift > 0 ? { phaserrate: 0.4, phaserdepth: 0.75 * lift, phasercenter: 1200, phasersweep: 900 } : {}) }
  for (const n of hits) gPitch(n.what, c, sc, up).filter(m => m !== undefined).forEach((m, j) => {
    const strum = n.what[0] === 'strum'
    out.push({ s: 'strat' + (1 + Math.floor(hash(p, m, ci) * 3)), note: m, begin: 0.0032, clip: 1, attack: 0.002,
      dur: strum ? 0.6 : n.len * 0.9, release: strum ? 0.03 : 0.12, gain: 5 * n.acc * lg * (strum ? 0.7 : 1), pan: 0.4,
      dt: (j * 4 + 3 * hash(k, m, j)) * LMS, ...(lvl >= 2 && n.len >= 2 ? { penv: 1, pattack: 0.05, prelease: 4 } : {}), ...fx })
  })
  if (!hits.length && (lvl >= 3 || (lvl >= 1 && [1, 5, 9, 13].includes(s16))) && !notes.some(n => n.p === ((p - 1) % L + L) % L && n.len >= 2))
    out.push({ s: 'strat' + (1 + ((k % 3) + 3) % 3), note: labBelow(c, labNear(c, 67, 79, 72), 3)[2] ?? 60, begin: 0.0032, clip: 1,
      dur: 0.35, attack: 0.001, release: 0.02, gain: (s16 % 2 ? 2.2 : 1.6) * lg, cutoff: 900, pan: 0.4, dt: 2 * LMS, ...fx })
  return out
})
const gtrLines = GTR_LINES.map(([name, L, notes], i) => [name, gtrLine(i, L, notes)])
const gtrVar = change(gtr.btn, 'jonas', 'Gitarre', gtrLines.length, gtrLines.map(f => f[0]))
const stemN7_guitar = strip(labStrip(pick(gtrVar, gtrLines.map(f => f[1])).swingBy(0.12, 8), GT, 800, 7000, 'echo'),
  { level: signal(() => GT.val[3] * GUITAR_LEVEL * Math.pow(10, 4 * (GT.val[0] - 0.5) / 20)) })
COLVIEW['jonas:7'] = labView(GT, 'Komplexität', gtrLines.map(f => f[0]), gtrVar)


// What the LC view shows for this track: the chapter (now, next) on column 8 button 1, and extra lines at the top
const lcChapter = () => [CHAPTERS[chapterLatch.now].name, CHAPTERS[chapterLatch.pending].name]
const lcHead    = () => [['Akkorde', chapterLatch.now === 0 ? 'Am9' : PROGS[progLatch.now].name]]
// Where the music is (LC view): the beat in the bar and the bar in the big cycle. A silent event per beat moves it at
// the moment the beat sounds (onTrigger, as in the set). chordAt(bar) = the chord of that bar ('' = none shown)
const CYCLE   = 8   // one progression: 8 bars
const chordAt = bar => CHORDS[chordIdAt(bar)].name
const beatNow = { bar: null, beat: null }
const beatTick = pure(0).segment(4).fmap(() => ({})).onTrigger((hap, now, cps, t) => {
  const pos = hap.whole.begin.valueOf(), bar = Math.floor(pos + 1e-9), beat = Math.floor((pos - bar) * 4 + 1e-9)
  setTimeout(() => { beatNow.bar = bar; beatNow.beat = beat; lcView?.update() }, Math.max(0, (t - now) * 1000))
}, true)

// LC view of this evaluation: names from the tags in the editor (strudel.cc keeps the text in strudelMirror),
// buttons from the change() rows (row i = column i + 1), chapter and break on column 8
return { taps, showStatus, STATUS, lcChapter, lcHead, stems: { J1: stemJ1_kick, J2: stemJ2_noise, J3: stemJ3_sub, J4: stemJ4_bass, J5: stemJ5_clap, J6: stemJ6_hats, J7: stemJ7_perc, J8: stemJ8_shake, N1: stemN1_harm, N2: stemN2_keys, N3: stemN3_vibes, N4: stemN4_flute, N5: stemN5_brass, N6: stemN6_strings, N7: stemN7_guitar } }
})()

// ============================================================
// TRACK 008 — Groove Techno (from tracks/008-groove-techno/008-groove-techno-dual.strudel)
// ============================================================
// @008 layout Track 008 — groove techno (two controllers)
// @008 note Groove techno on F, 140 BPM. Jojo plays the foundation (kick, bass, drums), Jonas the colour (pad, chord pulse, melodies) and the global column 8.
// @008 note Every row means the same everywhere: row 1 = brightness, row 2 = space, row 3 = character, fader = level, button 1 = next pattern (at the next bar), button 2 = a moment while held.
// @008 note Start with all faders down. Nothing sounds until Jonas' master fader (column 8) is up. Jonas' pad button 1 changes the chords, and Jojo's sub and bassline follow.
// @008 note The status box at the bottom right of the Strudel page shows chapter, break and each stem's pattern. Its button “als Fenster” opens it as a small window that stays on top (Chrome/Edge).
// @008 mode B16 Jojo — Foundation (beat + bass)
// @008 col B16:1 1 Kick
// @008 col B16:2 2 Rumble
// @008 col B16:3 3 Sub
// @008 col B16:4 4 Bassline
// @008 col B16:5 5 Clap
// @008 col B16:6 6 Hats
// @008 col B16:7 7 Percussion
// @008 col B16:8 8 Ride
// @008 row B16:k1 Row 1 \ Brightness
// @008 row B16:k2 Row 2 \ Space
// @008 row B16:k3 Row 3 \ Character
// @008 row B16:fader Fader \ Level
// @008 row B16:b1 Button 1 \ Change
// @008 row B16:b2 Button 2 \ Moment
// @008 mode 16 Jonas — Colour (chords + melodies) · column 8 = global
// @008 col 16:1 1 Pad
// @008 col 16:2 2 Chord Pulse
// @008 col 16:3 3 Sequence
// @008 col 16:4 4 Lead
// @008 col 16:5 5 Answer
// @008 col 16:6 6 Pings
// @008 col 16:7 7 FX / Breath
// @008 col 16:8 8 Global
// @008 row 16:k1 Row 1 \ Brightness
// @008 row 16:k2 Row 2 \ Space
// @008 row 16:k3 Row 3 \ Character
// @008 row 16:fader Fader \ Level
// @008 row 16:b1 Button 1 \ Change
// @008 row 16:b2 Button 2 \ Moment
// @008 guide Playing together | Jojo builds the floor: kick first, rumble right next to it, then sub and hats, then clap, bassline and the groove (percussion, ride).
// @008 guide Playing together | Jonas colours it: pad first, then the chord pulse under it (all knobs at 0 is a good start), then the sequence. Lead, answer and pings are for the peaks, the breathing FX for long transitions.
// @008 guide Playing together | The pad's button 1 changes the chords for both players: Jojo's sub and bassline move with it. Pad button 2 (freeze) holds the chord for everybody.
// @008 guide Playing together | Break: one press takes out kick, rumble, sub, bassline and clap at the next bar; hats, percussion, ride and all of Jonas' sounds keep going. Turn Tension up during the break, press again: everything is back on the one. Then let Tension go.
// @008 guide Every position sounds good | No filter closes completely. Sequence, answer and FX keep a little room even at space 0.
const T008 = await (async () => {
const ID = 3
const PHRASE = phraseOf(SET_TRACKS[3])
const ORBIT0 = 3
const focusOnly = button => button.fmap(v => SET.focus() === ID ? v : 0)

const ramp = (sig, from, to) => sig.fmap(v => Math.min(1, Math.max(0, (v - from) / (to - from))))
// Row-3 crossfade: 0..0.5 brings the extra layer in, 0.5..1 fades the main layer out
const fadeMain  = knob => ramp(knob, 1, 0.5)
const fadeExtra = knob => ramp(knob, 0, 0.5)
// Exponential knob range for filters (Hz), so every part of the knob travel is audible
const expRange = (knob, lo, hi) => knob.fmap(v => lo * Math.pow(hi / lo, v))

const bpm  = 140
const beat = 60 / bpm   // seconds per quarter note, for delay times

// Mapping of column n (1-8): brightness, space, character (knob rows 1-3), fader, button rows 1-2
const colMap = (read, n) => ({ bright: read(12 + n), space: read(20 + n), char: read(28 + n), level: read(4 + n), btn: read(36 + n), btn2: read(44 + n) })
const off = () => signal(() => 0)
// Column 8 (global) is read from both its Mode 16 and Mode 2 CCs, last moved wins: it works on both pages even on a
// controller whose column 8 sends CC + 48 in Mode 2
// One controller: Jojo on the plain CCs (Mode 1), Jonas on CC + 48 (Mode 2)
const alone    = !ccJojo
const colJonas = n => n === 8 ? SET.glob : colMap(n === 8 ? c => lastMoved(ccJonas(c), ccJonas(c + 48)) : alone ? c => ccJonas(c + 48) : ccJonas, n)
const colJojo  = n => !alone ? colMap(ccJojo, n) : n === 8 ? colMap(off, n) : colMap(ccJonas, n)

const gate  = (cond, pat) => cond.fmap(on => on ? pat : silence).innerJoin()
const above = (sig, x) => sig.fmap(v => v > x)
const and   = (a, b) => a.fmap(x => y => x && y).appLeft(b)
const held  = button => button.fmap(v => v > 0.5)

// Stateful controls, collected so the master can query them every tick (see stateTaps)
const taps = []

// Two inputs for one control: the value follows whichever moved last (stateful, so it is queried via stateTaps)
const lastMoved = (a, b) => {
  let pa = null, pb = null, v = 0
  const pat = a.fmap(x => y => {
    if (pa === null) v = Math.max(x, y)
    else if (y !== pb) v = y
    else if (x !== pa) v = x
    pa = x; pb = y
    return v
  }).appLeft(b)
  taps.push(pat)
  return pat
}

// Momentary button that steps through n states, one step per press (counts presses, not the held value).
// onChange(state) runs on every step (for the status box). Re-evaluating the code starts again at 0.
const cycleButton = (button, n, onChange = () => {}) => {
  button = focusOnly(button)   // set: presses count only for the track in focus
  let prev = 0, state = 0
  const pat = button.fmap(v => {
    if (v > 0.5 && prev <= 0.5) { state = (state + 1) % n; onChange(state) }
    prev = v
    return state
  })
  taps.push(pat)
  return pat
}

// A value that a button sets now but that takes over only at the next bar line (chapter, break, change).
// at(t) is asked with bar starts in real time (outside any reseed shift); it remembers the previous value for
// queries that still reach back into the old bar. pat = the value per bar.
const barLatch = (len = 1) => {
  const l = { pending: 0, now: 0, prev: 0, bar: -Infinity }
  l.at = t => {
    const bar = Math.floor(Number(t) / len)
    if (bar > l.bar) {
      if (l.pending !== l.now) { l.prev = l.now; l.now = l.pending; showStatus() }
      else l.prev = l.now
      l.bar = bar
    }
    return bar >= l.bar ? l.now : l.prev
  }
  l.pat = signal(t => l.at(t)).segment(1)
  taps.push(l.pat)
  return l
}

// 0 → 1 over `cycles` while a button is held, back to 0 on release (for risers)
const heldRamp = (button, cycles) => {
  let start = null
  const pat = button.fmap(v => t => {
    if (v <= 0.5) { start = null; return 0 }
    start ??= t
    return Math.min(1, Math.max(0, (t - start) / cycles))
  }).appLeft(signal(t => Number(t)))
  taps.push(pat)
  return pat
}

// Freeze: while the button is held, keep returning the value that was playing when it was pressed
const freeze = (button, pat) => {
  let kept = null
  return pat.fmap(v => b => b > 0.5 ? (kept ??= v) : (kept = null, v)).appLeft(button)
}


// ============================================================
// MOODS — all on F, so a switch keeps the root and only the colour changes
// ============================================================
const MOODS = [
  { scale: 'dorian',   name: 'warm' },    // F G A♭ B♭ C D E♭
  { scale: 'minor',    name: 'dunkel' },     // F G A♭ B♭ C D♭ E♭
  { scale: 'phrygian', name: 'eng' },   // F G♭ A♭ B♭ C D♭ E♭
]

// Rows of the status box, filled by change(): { label, latch, n, names } per player
const STATUS = { jojo: [], jonas: [] }
const showStatus = () => {
  if (!statusUi || SET.focus() !== ID) return
  const dots = v => [...Array(8).keys()].map(k => k === v ? '●' : '○').join('')
  const show = (r, v) => !r.names ? String(v + 1) : r.names[v]
  const line = (r, i) => (i + 1) + ' ' + r.label.padEnd(10) + ' ' + (r.n === 8 ? dots(r.latch.now) + ' ' : '') +
    show(r, r.latch.now) + (r.latch.pending !== r.latch.now ? ' → ' + show(r, r.latch.pending) : '')
  const soon = l => l.pending !== l.now ? ' (nächster Takt)' : ''
  statusUi.text.textContent = [
    ...SET.statusLines(),
    'Kapitel     A ' + MOODS[moodLatch.now].name +
      (moodLatch.pending !== moodLatch.now ? ' → ' + MOODS[moodLatch.pending].name : '') + soon(moodLatch),
    '', alone ? 'Mode 1 · Jojo' : 'Jojo', ...STATUS.jojo.map(line),
    '', alone ? 'Mode 2 · Jonas' : 'Jonas', ...STATUS.jonas.map(line),
  ].join('\n')
  lcView?.update()
}
// Button 1 of a stem: n patterns (default 8), one step per press, taking over at the next bar
const change = (button, who, label, n = 8, names) => {
  const latch = barLatch()
  cycleButton(button, n, s => { latch.pending = s; showStatus() })
  STATUS[who].push({ label, latch, n, names })
  return latch
}
// Pattern number i of a list, switched by a change latch
const pick = (latch, pats) => latch.pat.fmap(i => pats[i]).innerJoin()

// ============================================================
// GLOBAL (Jonas, column 8) — acts on both controllers
// ============================================================
// @008 ctl g.k1 Fog | 0 = clear, up = every filter pulled down to ~6 %: muffled, as if from the room next door.
// @008 ctl g.k2 Room | 0 = each sound's own room (row 2), up = everything drowns in reverb.
// @008 ctl g.k3 Tension | build-up: echo grows (answer, sequence), filters open (not hats, clap, ride), only in the last fifth a snare roll (clap fader). 0 = release.
// @008 ctl g.fader Master Level | volume of everything, both controllers. 0 = silence.
// @008 ctl g.b1 Chapter | mood: warm → dark → tense, at the next bar.
// @008 ctl g.b2 Break / Drop | 1st: beat out. 2nd: all back on the one.
const glob        = colJonas(8)
const globalFog   = glob.bright.fmap(f => Math.pow(0.06, f))
const globalRoom  = glob.space
const tension     = glob.char
const tensionEcho = ramp(tension, 0, 0.5).mul(0.45)     // delay send, 0..0.45
const tensionRoll = ramp(tension, 0.8, 1)               // snare roll, 0..1 (round 4: only the last fifth, was from 0.5)
// Factor on every lpf: fog darkens (down to 0.06), tension opens (up to 2.5)
const globalTone  = globalFog.fmap(f => o => f * o).appLeft(tension.fmap(t => 1 + 1.5 * t))
const globalLevel = glob.level.range(0, 1)

const moodLatch  = barLatch(PHRASE)
cycleButton(glob.btn, MOODS.length, s => { moodLatch.pending = s; showStatus() })
const breakLatch = barLatch()
cycleButton(glob.btn2, 2, s => { breakLatch.pending = s; showStatus() })
const mood    = moodLatch.pat
const scaleIn = octave => mood.fmap(m => 'F' + octave + ':' + MOODS[m].scale)
// Jojo's low end and backbeat, gated while the break is on
const beatOn   = breakLatch.pat.fmap(b => b === 0)
const beatOnly = pat => gate(beatOn, pat)

const audible = level => and(above(level, 0), above(globalLevel, 0))
// lpf × fog/tension, kept between 80 Hz and 18 kHz (fog never makes a stem silent)
const toned  = (lpf, tone = globalTone) => lpf.fmap(f => g => Math.min(18000, Math.max(80, f * g))).appLeft(tone)
// Reverb send: the stem's space knob (0..0.9), raised by the global Room up to 0.95
const roomOf = space => space.fmap(s => g => { const r = 0.9 * s; return r + (0.95 - r) * g }).appLeft(globalRoom)
// Change: read the stem's randomness 1024 cycles further per step (keeps bar alignment, new random values).
// Scales and the chord root are applied after reseed, so they follow real time.
const reseed = (latch, pat) => pat.early(latch.pat.fmap(v => v * 1024))

// Effect buses. Each orbit has one reverb and one delay, and every reverb costs a lot of CPU, so the stems share
// three orbits; stems on one orbit share room size and echo time/feedback.
// Orbit 1 = drums and bass: small room, short dotted-8th slap.
// Orbit 2 = all of Jonas' colour: dub room, dotted-8th echo with long feedback.
// Orbit 3 = rumble only: the reverb is the sound (kick tails rolling under the beat).
const BUSES = {
  1: { hall: 1.6, time: beat * 0.75, feedback: 0.3 },
  2: { hall: 4, time: beat * 0.75, feedback: 0.58 },
  3: { hall: 2.6, time: beat * 0.25, feedback: 0.45 },
}
// bus(): reverb from the space knob, and echo: the layer's own delay amount (or `echo` if it has none) × 2 × space,
// so space 0.5 = the designed amount; Tension's echo takes over where it is larger.
const bus = (pat, orbit, space, echo = 0) => pat
  .fmap(v => sc => e => ({ ...v, delay: Math.max(Math.min(0.9, (v.delay ?? echo) * sc), e) }))
  .appLeft(space.fmap(s => 2 * s)).appLeft(tensionEcho)
  .room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)
  .delaytime(BUSES[orbit].time).delayfeedback(BUSES[orbit].feedback)
// Reverb only, no echo from Space or Tension (round 5: echo only where it is the sound: dub chords, answer, rumble
// motion; lead only on its echo-throw button, bells a short fixed echo). Echo time/feedback set for those throws.
const dryBus = (pat, orbit, space) => pat.room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)
  .delaytime(BUSES[orbit].time).delayfeedback(BUSES[orbit].feedback)

// Channel strip: lpf × fog/tension (if given), level × master as postgain, gated while the fader or master is 0.
// high: hats, clap, ride: Fog darkens them, but Tension does not open their filter (it made them far too loud).
const strip = (stem, { lpf, level, high = false }) => {
  const pat = lpf === undefined ? stem : stem.lpf(toned(lpf, high ? globalFog : globalTone))
  return gate(audible(level), pat.postgain(level.mul(globalLevel)))
}
const drum = (names, bank = 'RolandTR909') => s(names).bank(bank)
// Echo throw: while the button is held, the layer gets a long echo (on a dryBus)
const throwEcho = (pat, button) => pat.fmap(v => b => b > 0.5 ? { ...v, delay: 0.85 } : v).appLeft(button)

// ============================================================
// HARMONY — Jonas' pad button 1 picks a progression, everybody follows its root
// ============================================================
// Chord roots as scale degrees (0 = F), one chord per 2 bars, 4 chords = 8 bars
const PROGS = [[0, 0, 0, 0], [0, 0, -2, -2], [0, 3, 0, 3], [0, -2, -3, -2], [0, 2, 3, 2], [0, 0, 4, 3], [3, 3, 0, 0], [0, 5, 3, 4]]
const PROG_NAMES = ['1', '1–6', '1–4', '1–6–5–6', '1–3–4–3', '1–5–4', '4–1', '1–6–4–5']
const PROG_PATS = PROGS.map(p => cat(...p).slow(2))
const pad      = colJonas(1)
const padVar   = change(pad.btn, 'jonas', 'Pad', 8, PROG_NAMES)
const harmRoot = freeze(pad.btn2, pick(padVar, PROG_PATS))
// Chord = shape (scale degrees above the root) on the current root; built once per root and shape
const CHORD_CACHE = {}
const chordOn = shape => harmRoot.fmap(r => CHORD_CACHE[shape + '@' + r] ??= n(stack(...shape.map(d => d + r)))).innerJoin()
const onRoot  = pat => pat.add(n(harmRoot))

// ============================================================
// JOJO 1 KICK — a sine kick tuned to C2 (the fifth of F, same pitch as the rumble; F1 at 44 Hz was inaudible on small
// speakers), with a little 909 click on top. No echo.
// ============================================================
// Punch: 0 = really soft (slow attack, small pitch drop, no click: a deep thump), 0.5 = round kick, 1 = hard
// (big fast pitch drop, sharp attack, 909 click, some drive). Each value goes soft → round → hard in two straight lines.
// @008 ctl B16:1.k1 Brightness | 0 = round but clear ↔ clicky attack (lpf 900–9000 Hz).
// @008 ctl B16:1.k2 Space | dry and close ↔ in a room (reverb).
// @008 ctl B16:1.k3 Punch | 0 = really soft thump, middle = round kick, 1 = hard and punchy.
// @008 ctl B16:1.fader Level | 0 = gone. Kick on every beat, tuned to C (fifth of F).
// @008 ctl B16:1.b1 Change | straight → ghost kick before the 1 → gap every 4th bar.
// @008 ctl B16:1.b2 Drop out | kick pauses while held.
const kick     = colJojo(1)
const kickVar  = change(kick.btn, 'jojo', 'Kick', 3, ['gerade', 'Geist vor 1', 'Lücke'])
const kickPunch = kick.char
// Value at punch 0 / 0.5 / 1, straight lines in between
const punch3 = (soft, round, hard) => kickPunch.fmap(p => p < 0.5 ? soft + (round - soft) * 2 * p : round + (hard - round) * (2 * p - 1))
const KICKS = ["1*4", "1 1 1 [1 ~ ~ 0.4]", "<[1*4] [1*4] [1*4] [1 1 1 ~]>"]
  .map(g => stack(
    gain(g).note("c2").s("sine").decay(punch3(0.55, 0.4, 0.3)).sustain(0).release(0.05)
      .attack(punch3(0.016, 0.004, 0.001))
      .penv(punch3(12, 24, 36)).pdecay(punch3(0.09, 0.05, 0.03)),
    gain(g).mul(gain(punch3(0, 0.3, 0.7))).s("bd").bank("RolandTR909")
  ).shape(punch3(0, 0, 0.4)).velocity(punch3(1, 1, 0.56)))   // level compensation: hard ≈ +3 dB, not +8

const stemJ1_kick = beatOnly(gate(kick.btn2.fmap(v => v <= 0.5), strip(dryBus(
  pick(kickVar, KICKS).mul(gain(0.8)), 1, kick.space), {
  lpf: expRange(kick.bright, 900, 9000),
  level: kick.level.range(0, 1),
})))

// ============================================================
// JOJO 2 RUMBLE — the kick's sound low-passed into a dark reverb, on the 3rd and 4th 16th of every beat (own orbit)
// ============================================================
// @008 ctl B16:2.k1 Brightness | 0 = warm rumble ↔ more of the kick's body in the tail (lpf 250–1800 Hz).
// @008 ctl B16:2.k2 Space | short rumble ↔ a long dark cloud (reverb never fully off: the reverb is the sound).
// @008 ctl B16:2.k3 Motion | still ↔ the filter breathes and the rumble echoes in 16ths.
// @008 ctl B16:2.fader Level | rumble under the kick, same pitch (C).
// @008 ctl B16:2.b1 Change | 3rd + 4th 16th → 2nd–4th → only the 3rd.
// @008 ctl B16:2.b2 Riser | a noise sweep rises over 2 bars while held.
const rumble     = colJojo(2)
const rumbleVar  = change(rumble.btn, 'jojo', 'Rumble', 3, ['3+4', '2+3+4', '3'])
const rumbleMove = rumble.char
const rumbleRise = heldRamp(rumble.btn2, 2)
const rumbleHit  = stack(
  note("c2").s("sine").penv(12).pdecay(0.05).decay(0.3).sustain(0).gain(0.5),
  s("bd").bank("RolandTR909").gain(0.2)
)
const RUMBLES = ["[~ ~ x x]*4", "[~ x x x]*4", "[~ ~ x ~]*4"].map(r => rumbleHit.struct(r))
// Riser: 16th noise bursts through a bandpass that climbs from 300 Hz to 6 kHz, getting louder.
// Not low-passed by the rumble filter (it is on the same column, but it is a high sound).
const rumbleRiser = gate(held(rumble.btn2), s("pink*16")
  .attack(0.03).sustain(0.8).release(0.15)
  .bpf(rumbleRise.fmap(r => 300 * Math.pow(20, r))).bpq(4)
  .gain(rumbleRise.mul(1.4)).pan(sine.fast(2)))   // pink noise: ~12 dB quieter than white at the same gain

const stemJ2_rumble = strip(stack(
  beatOnly(bus(pick(rumbleVar, RUMBLES)
    .lpf(toned(expRange(rumble.bright, 250, 1800)).fmap(f => m => w => f * (1 - 0.6 * m * w)).appLeft(rumbleMove).appLeft(sine.slow(2)))
    .mul(gain(0.67)).delay(rumbleMove.mul(0.4)), 3, rumble.space.fmap(s => 0.5 + 0.5 * s))),
  bus(rumbleRiser, 2, pure(0.3))
), {
  level: rumble.level.range(0, 0.68),   // was 1; mix: rumble −8 dB under the kick
})

// ============================================================
// JOJO 3 SUB — a pumping sine on the chord root: each note starts a 16th after the kick and holds until the next one
// ============================================================
// Sounds like a sub ducked by the kick (sidechain), without a compressor.
// @008 ctl B16:3.k1 Brightness | 0 = sine with a few overtones (audible on small speakers) ↔ warm and full.
// @008 ctl B16:3.k2 Space | dry ↔ a little room (reverb).
// @008 ctl B16:3.k3 Length | long, pumping notes ↔ short, bouncing ones.
// @008 ctl B16:3.fader Level | pumping sub, follows Jonas' chords.
// @008 ctl B16:3.b1 Change | pump → fifth on beat 4 → syncopated.
// @008 ctl B16:3.b2 Slide | every note bends up into its pitch while held.
const sub      = colJojo(3)
const subVar   = change(sub.btn, 'jojo', 'Sub', 3, ['Pumpe', 'Quinte', 'Synkope'])
const subClip  = sub.char.fmap(c => 1 - 0.65 * c)   // share of the note length that sounds
const subSlide = sub.btn2.fmap(v => v > 0.5 ? -5 : 0)
const SUBS = ["[~ 0@3]*4", "[~ 0@3] [~ 0@3] [~ 0@3] [~ 4@3]", "[~ 0@3] [~ 0@3] [~ 0@3] [~ 0 ~ 0]"]
  .map(p => onRoot(n(p)).scale(scaleIn(1)))
const subNotes = pick(subVar, SUBS)

const stemJ3_sub = beatOnly(strip(dryBus(stack(
  subNotes.s("sine").gain(0.9),
  subNotes.s("triangle").gain(sub.bright.fmap(b => 0.18 + 0.3 * b))
).attack(0.015).sustain(1).release(0.04).clip(subClip).penv(subSlide).pattack(0.07), 1, sub.space), {
  level: sub.level.range(0, 0.65),   // was 1; mix: sub −3 dB under the kick
}))

// ============================================================
// JOJO 4 BASSLINE — raw off-beat bass: a slightly overdriven square, no filter sweep, on the chord root
// ============================================================
// @008 ctl B16:4.k1 Brightness | 0 = round ↔ raw and buzzing (lpf 400–3000 Hz).
// @008 ctl B16:4.k2 Space | dry ↔ a little room (reverb).
// @008 ctl B16:4.k3 Groove | off-beats only ↔ extra 16th notes bouncing in between.
// @008 ctl B16:4.fader Level | off-beat bass, follows Jonas' chords.
// @008 ctl B16:4.b1 Change | off-beat → 3-3-2 → dub.
// @008 ctl B16:4.b2 Octave | one octave up while held.
const bassCol = colJojo(4)
const bassVar = change(bassCol.btn, 'jojo', 'Bass', 3, ['Offbeat', '3-3-2', 'Dub'])
const bassOct = bassCol.btn2.fmap(v => v > 0.5 ? 12 : 0)
// [main line, extra 16ths], scale degrees above the chord root (7 = octave)
const BASS_LINES = [
  ["[~ 0]*4", "[~ ~ ~ 7]*4"],
  ["[~ 0 ~ 0] [~ ~ 0 ~] [~ 0 ~ 0] [~ ~ 0 ~]", "[~ ~ ~ 2]*4"],
  ["[~ 0] ~ [~ 0] [~ ~ 0 ~]", "[~ ~ 7 ~] [~ 0 ~ ~] [~ ~ 7 ~] [~ 0 ~ ~]"],
].map(([main, extra]) => [onRoot(n(main)), onRoot(n(extra))])
const bassSound = pat => pat.scale(scaleIn(2)).add(note(bassOct)).s("square").superimpose(x => x.add(note(0.07)))
  .decay(0.14).sustain(0.1).release(0.05).lpq(2).shape(0.3)

const stemJ4_bass = beatOnly(strip(dryBus(stack(
  bassSound(pick(bassVar, BASS_LINES.map(l => l[0]))).gain(0.25),
  gate(above(bassCol.char, 0), bassSound(pick(bassVar, BASS_LINES.map(l => l[1]))).gain(bassCol.char.mul(0.2)))
), 1, bassCol.space), {
  lpf: expRange(bassCol.bright, 400, 3000),
  level: bassCol.level.range(0, 0.69),   // was 1; mix: bass −4 dB under the kick (groove at the middle)
}))

// ============================================================
// JOJO 5 CLAP — a short, simple 909 clap on 2 and 4; the full clap with its tail and double taps is kept for the drop
// ============================================================
// Feedback round 2: the full clap was too busy for the groove (only good for a drop). Default = tight clap: the
// envelope cuts the 909's noise tail, only the hit is left.
// @008 ctl B16:5.k1 Brightness | soft and far ↔ sharp crack (lpf 1.5–12 kHz).
// @008 ctl B16:5.k2 Space | dry ↔ far away (reverb).
// @008 ctl B16:5.k3 Ghost notes | plain ↔ a quiet clap before beat 3 ↔ + small double taps.
// @008 ctl B16:5.fader Level | clap on 2 and 4. Also the level of Tension's snare roll.
// @008 ctl B16:5.b1 Change | short clap → with pickup → full drop clap (tail + double).
// @008 ctl B16:5.b2 Swell | snare swell over 4 bars while held.
const clap      = colJojo(5)
const clapVar   = change(clap.btn, 'jojo', 'Clap', 3, ['einfach', 'Vorschlag', 'Drop'])
const clapGhost = clap.char
// Feedback round 3: the roll restarted every bar (cheap, symmetric). Now one slow swell from the moment of the press
// (after Attack Magazine, "10 snare rolls for the drop": velocity ramp with a little randomisation, pitch rising;
// a curved ramp sounds more natural than a straight line). Hits are left out at random, fewer and fewer.
const clapRise  = heldRamp(clap.btn2, 4)   // 0 → 1 over 4 bars while held
const snareSwell = gate(held(clap.btn2), drum("sd*16")
  .degradeBy(clapRise.fmap(r => 0.85 * Math.pow(1 - r, 1.5)))
  .gain(clapRise.fmap(r => v => (0.05 + 0.45 * r * r) * v).appLeft(rand.range(0.7, 1)))
  .speed(clapRise.fmap(r => 0.9 + 0.3 * r * r)))
const clapSound = pat => pat.s("cp").bank("RolandTR909").attack(0.001).decay(0.05).sustain(0).release(0.03)
const clapFull  = pat => pat.s("cp").bank("RolandTR909").attack(0.001).decay(0.12).sustain(0).release(0.06)
const CLAPS = [
  clapSound(gain("~ 0.8 ~ 0.8")),
  clapSound(gain("~ 0.8 ~ [0.8 ~ ~ 0.35]")),
  clapFull(gain("~ 0.8 ~ <0.8 [0.8 0.5]>")),
]

const stemJ5_clap = beatOnly(strip(dryBus(stack(
  pick(clapVar, CLAPS),
  gate(above(clapGhost, 0), clapSound(gain("~ ~ 0.22 ~").mul(gain(ramp(clapGhost, 0, 0.5))))),
  gate(above(clapGhost, 0.5), clapSound(gain("~ [~ 0.15] ~ ~").mul(gain(ramp(clapGhost, 0.5, 1))))),
  snareSwell,
  // Tension roll (last fifth of the knob): loose hits → 16ths, swelling on a curve
  gate(above(tensionRoll, 0), drum("sd*16").degradeBy(tensionRoll.fmap(t => 0.8 * Math.pow(1 - t, 1.5)))
    .gain(tensionRoll.fmap(t => 0.05 + 0.4 * t * t)))
).mul(gain(1.75)).hpf(400).pan(0.48), 1, clap.space), {
  lpf: expRange(clap.bright, 1500, 12000),
  high: true,
  level: clap.level.range(0, 0.58),   // was 1; mix: clap −8 dB: players found it too loud, LUFS underrates transients
}))

// ============================================================
// JOJO 6 HATS — 909 hats: off-beat, plain 16ths, or driving (16ths swelling + soft open hats, after 005)
// ============================================================
// @008 ctl B16:6.k1 Brightness | soft hiss ↔ crisp and sharp (lpf 3–16 kHz).
// @008 ctl B16:6.k2 Space | dry ↔ far away (reverb).
// @008 ctl B16:6.k3 Density | the pattern as it is ↔ + quiet 16ths ↔ + little 32nd rolls.
// @008 ctl B16:6.fader Level | hats. Keep playing in the break.
// @008 ctl B16:6.b1 Change | off-beat → plain 16ths → driving.
// @008 ctl B16:6.b2 Open | open hats on the off-beats while held.
const hats    = colJojo(6)
const hatVar  = change(hats.btn, 'jojo', 'Hats', 3, ['Offbeat', 'gerade', 'treibend'])
const hatDens = hats.char
const HATS = [
  drum("[~ hh]*4").gain(0.5),
  drum("hh*16").gain("[0.32 0.22 0.3 0.22]*4"),
  stack(drum("hh*16").gain(sine.fast(2).range(0.12, 0.42)), drum("[~ oh]*4").gain(0.16).decay(0.3)),
]

const stemJ6_hats = strip(dryBus(stack(
  pick(hatVar, HATS),
  gate(above(hatDens, 0), drum("hh*16").degradeBy(0.4).gain(ramp(hatDens, 0, 0.5).mul(0.12))),
  gate(above(hatDens, 0.5), drum("hh*32").degradeBy(0.8).gain(ramp(hatDens, 0.5, 1).mul(0.18))),
  gate(held(hats.btn2), drum("[~ oh]*4").gain(0.4))
).mul(gain(3.2)).pan(0.56), 1, hats.space), {
  lpf: expRange(hats.bright, 3000, 16000),
  high: true,
  level: hats.level.range(0, 0.3),   // was 1, then 0.47; feedback round 2: still too loud, −4 dB more
})

// ============================================================
// JOJO 7 PERCUSSION — soft tuned bongos (after 005's pillow bongos) in a steady pattern, plus a 909 rimshot
// ============================================================
// Notes F, C, E♭, A♭: in all three chapters.
// @008 ctl B16:7.k1 Brightness | woody ↔ metallic (FM and lpf 600–12000 Hz).
// @008 ctl B16:7.k2 Space | dry ↔ far away (reverb).
// @008 ctl B16:7.k3 Density | steady pattern ↔ + fingertip ghost notes ↔ + little rolls.
// @008 ctl B16:7.fader Level | bongos and rimshot. Keep playing in the break.
// @008 ctl B16:7.b1 Change | pillow → gallop → 3-3-2.
// @008 ctl B16:7.b2 Fill | a bongo run down over the bar while held.
const perc     = colJojo(7)
const percVar  = change(perc.btn, 'jojo', 'Perkussion', 3, ['Kissen', 'Galopp', '3-3-2'])
const percDens = perc.char
const bongo = (notes, dec, g) => note(notes).s("sine").fm(perc.bright.mul(2)).fmh(2.76)
  .decay(dec).sustain(0).release(dec / 2).gain(g)
const rimshot = drum("[~ ~ ~ ~ ~ ~ rim ~]").gain(0.28)
const PERCS = [
  ["f4 ~ ~ f4 ~ c5 ~ ~", "~ c6 ~ f5 ~ ~ c6 ~"],
  ["f4 ~ f4 ~ ~ f4 ~ c5", "~ f5 ~ ~ c6 ~ f5 ~"],
  ["f4 ~ ~ f4 ~ ~ f4 ~", "~ ~ c6 ~ ~ ~ ~ f5 ~ ~ c6 ~ ~ ~ f5 ~"],
].map(([low, high]) => stack(bongo(low, 0.085, 0.55), bongo(high, 0.045, 0.7), rimshot))

const stemJ7_perc = strip(dryBus(stack(
  pick(percVar, PERCS),
  gate(above(percDens, 0), bongo("~ ~ eb5 ~ ~ ab5 ~ c5", 0.035, ramp(percDens, 0, 0.5).mul(0.5))),
  gate(above(percDens, 0.5), bongo("~ c6 ~ ab5 c6 ~ eb5 ~ c5 ~ ~ eb5 ~ c5 ab5 ~", 0.025, ramp(percDens, 0.5, 1).mul(0.45))),
  gate(held(perc.btn2), bongo("f5 eb5 c5 ab4 f5 eb5 c5 ab4 c5 ab4 f4 eb4 f4 ~ f4 ~", 0.05, 0.6))
).mul(gain(1.6)).pan(sine.slow(4).range(0.35, 0.65)), 1, perc.space), {
  lpf: expRange(perc.bright, 600, 12000),
  level: perc.level.range(0, 0.6),   // was 1; mix: percussion −10 dB
})

// ============================================================
// JOJO 8 RIDE — 909 ride, swing on the 16ths
// ============================================================
// @008 ctl B16:8.k1 Brightness | dark shimmer ↔ bright sizzle (lpf 2.5–16 kHz).
// @008 ctl B16:8.k2 Space | dry ↔ far away (reverb).
// @008 ctl B16:8.k3 Swing | straight ↔ swung, lazy (the in-between 16ths come late).
// @008 ctl B16:8.fader Level | ride. Keeps playing in the break.
// @008 ctl B16:8.b1 Change | off-beat → 8ths → 16ths.
// @008 ctl B16:8.b2 Double | double time while held.
const ride    = colJojo(8)
const rideVar = change(ride.btn, 'jojo', 'Ride', 3, ['Offbeat', 'Achtel', 'Sechzehntel'])
const RIDES = ["[~ 0.35]*4", "[0.3 0.2]*4", "[0.3 0.12 0.2 0.12]*4"].map(g => drum("rd").struct(g).gain(g))

const stemJ8_ride = strip(dryBus(pick(rideVar, RIDES)
  .fast(ride.btn2.fmap(v => v > 0.5 ? 2 : 1))
  .swingBy(ride.char.mul(0.6), 8)   // 0.6 = the off-16th lands on the last triplet
  .mul(gain(1.6)).pan(0.6), 1, ride.space), {
  lpf: expRange(ride.bright, 2500, 16000),
  high: true,
  level: ride.level.range(0, 0.66),   // was 1; mix: ride −12 dB
})

// ============================================================
// JONAS 1 PAD — dark minor-9 chords on the progression, slow attack
// ============================================================
// @008 ctl 16:1.k1 Brightness | muffled ↔ open and airy (lpf 250–6000 Hz).
// @008 ctl 16:1.k2 Space | dry and close ↔ far away in a big room (reverb).
// @008 ctl 16:1.k3 Swell | 0 = held chords. Up = the chord is re-struck on every half bar and breathes in and out.
// @008 ctl 16:1.fader Level | dark pad.
// @008 ctl 16:1.b1 Change | next of 8 chord progressions, for all.
// @008 ctl 16:1.b2 Freeze | holds the current chord while held, for everybody.
const padSwell = pad.char
const padChord = chordOn([0, 2, 4, 6, 8]).scale(scaleIn(3))
const padStill = stack(
  padChord.s("sawtooth").superimpose(x => x.add(note(0.1))).attack(0.9).sustain(0.8).release(2).gain(0.035)
    .pan(sine.slow(5).range(0.3, 0.7)),
  padChord.s("triangle").attack(0.6).sustain(0.8).release(2).gain(0.07)
)
const padBreath = padChord.struct("x*2").s("sawtooth,triangle")
  .attack(0.4).decay(0.5).sustain(0.15).release(0.8).gain(0.05).pan(sine.slow(5).range(0.3, 0.7))

const stemN1_pad = strip(dryBus(stack(
  gate(above(fadeMain(padSwell), 0), padStill.mul(gain(fadeMain(padSwell)))),
  gate(above(fadeExtra(padSwell), 0), padBreath.mul(gain(fadeExtra(padSwell))))
), 2, pad.space), {
  lpf: expRange(pad.bright, 250, 6000),
  level: pad.level.range(0, 1),
})

// ============================================================
// JONAS 2 CHORD PULSE — the pad's own chords in short, soft pulses: rhythm for the pad, not a second instrument
// ============================================================
// Round 7 (replaces the dub chords: boring, a cheap attack that pulled attention, and soft chords were the pad's job
// already). Same chord (minor 9 on the progression) and nearly the same sound as the pad (saw + triangle), but cut
// into short pulses with a soft 15 ms fade-in, so there is no click; it sits under the pad. No echo (Space = room),
// an echo throw on button 2.
// Motion: each rhythm has 6 extra pulses that join one by one as the knob turns, always in the same order (fixed
// thresholds 0.15 … 0.9), so the rhythm grows denser and more syncopated in one flow.
// @008 ctl 16:2.k1 Brightness | muffled ↔ open (lpf 300–5000 Hz).
// @008 ctl 16:2.k2 Space | dry and close ↔ far away (reverb).
// @008 ctl 16:2.k3 Motion | a few soft pulses ↔ more pulses join one by one, denser and more syncopated.
// @008 ctl 16:2.fader Level | the pad's chords as soft pulses.
// @008 ctl 16:2.b1 Change | next of 8 pulse rhythms.
// @008 ctl 16:2.b2 Echo throw | long echo on the pulses while held.
const chords    = colJonas(2)
const pulseVar  = change(chords.btn, 'jonas', 'Akkord-Puls')
const pulseMove = chords.char
const pulseChord = chordOn([0, 2, 4, 6, 8]).scale(scaleIn(3))
// 16 steps per bar; plain strings (single quotes), parsed with mini() below
const PULSE_RHYTHMS = [
  '~ ~ x ~ ~ ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~', '~ ~ x ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~', '~ ~ ~ x ~ ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~',
  'x ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~ x ~ ~ ~', '~ ~ x ~ ~ x ~ ~ ~ ~ x ~ ~ ~ ~ ~', '~ ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~ ~ ~ x ~',
  '~ ~ x ~ ~ ~ ~ x ~ ~ ~ ~ ~ ~ x ~', '~ ~ x x ~ ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~']
let pulseSeed = 2002
const pulseRand = () => (pulseSeed = (pulseSeed * 16807) % 2147483647) / 2147483647
const oneHit = step => [...Array(16)].map((_, i) => i === step ? 'x' : '~').join(' ')
// Extra pulses per rhythm: 6 free steps, off-beat 16ths and "and"s first (syncopation), in a fixed random order
const PULSE_EXTRAS = PULSE_RHYTHMS.map(r => {
  const hits = r.split(' ')
  const free = [...Array(16).keys()].filter(i => hits[i] !== 'x' && i % 4 !== 0)
    .sort((a, b) => (a % 2) - (b % 2) || pulseRand() - 0.5)
  return free.slice(0, 6).map((step, k) => ({ step, thr: 0.15 + k * 0.15 }))
})
const PULSE_PATS = PULSE_RHYTHMS.map((r, i) => stack(
  pulseChord.struct(mini(r)),
  ...PULSE_EXTRAS[i].map(x => gate(above(pulseMove, x.thr), pulseChord.struct(mini(oneHit(x.step))).velocity(0.75)))
))
const pulseSound = pat => stack(
  pat.s("sawtooth").superimpose(x => x.add(note(0.1))).gain(0.03),
  pat.s("triangle").gain(0.06)
).attack(0.015).decay(0.16).sustain(0.25).release(0.15).pan(sine.slow(5).range(0.35, 0.65))

const stemN2_chords = strip(throwEcho(dryBus(pulseSound(pick(pulseVar, PULSE_PATS)), 2, chords.space), chords.btn2), {
  lpf: expRange(chords.bright, 300, 5000),
  level: chords.level.range(0, 0.8),   // new sound (round 7): not yet measured
})

// ============================================================
// JONAS 3 SEQUENCE — a hypnotic mallet loop: 3-, 5- or 7-step loops against the 4/4 (polymeter), mostly root and fifth
// ============================================================
// Soft FM mallet (low index, harmonic ratio) with a tiny random detune per note, so it sounds played, not programmed.
// Keeps a little room even at space 0.
// @008 ctl 16:3.k1 Brightness | soft wooden mallet ↔ sharp, glassy (lpf 1.5–12 kHz, more FM).
// @008 ctl 16:3.k2 Space | a little room and echo ↔ far away (reverb + dub echo).
// @008 ctl 16:3.k3 Complexity | few notes ↔ the loop fills in and new notes join one by one, reaching further up and down.
// @008 ctl 16:3.fader Level | hypnotic loop on the chord.
// @008 ctl 16:3.b1 Change | next of 8 loops (3, 5 or 7 steps).
// @008 ctl 16:3.b2 Octave | one octave up while held.
const seqCol   = colJonas(3)
const seqVar   = change(seqCol.btn, 'jonas', 'Sequenz')
const seqRange = seqCol.char
// Complexity (round 7), one flow: the loop fills in and gets its passing notes as in the first version, and each loop
// has 8 extra notes that join one by one as the knob turns, always in the same order (each has its own threshold,
// 0.12 … 1). The first ones stay near the chord (root, 3rd, 5th), later ones reach further: 7th, octave, 9th up,
// the 4th and the low octave down. The loop itself keeps its shape.
let seqSeed = 3003
const seqRand = () => (seqSeed = (seqSeed * 16807) % 2147483647) / 2147483647
const SEQ_TIERS = [[0, 2, 4], [4, 6, 7, -3], [7, 9, 11, -4, -7]]
const SEQ_EXTRAS = [...Array(8)].map(() => {
  const steps = [...Array(16).keys()].sort(() => seqRand() - 0.5).slice(0, 8)
  return steps.map((step, k) => {
    const tier = SEQ_TIERS[k < 3 ? 0 : k < 6 ? 1 : 2]
    const hit = [...Array(16)].map((_, i) => i === step ? 'x' : '~').join(' ')
    return { thr: 0.12 + k * 0.125, deg: tier[Math.floor(seqRand() * tier.length)], hit }
  })
})
// Plain strings (single quotes) parsed with mini(): double quotes would already be patterns, not text
const SEQ_EXTRA_PATS = SEQ_EXTRAS.map(list => stack(...list.map(x =>
  gate(above(seqRange, x.thr), n(x.deg).struct(mini(x.hit)).velocity(0.85)))))
const seqOct   = seqCol.btn2.fmap(v => v > 0.5 ? 12 : 0)
const SEQS = ["{0 ~ 0 4 ~}%16", "{0 ~ 6 ~ 4 ~ 0}%16", "{0 4 ~}%16", "{0 ~ ~ 2 ~ 4 ~}%16", "{4 ~ 0 ~ 0}%16",
  "{0 ~ 3 ~ 0 4 ~}%16", "{6 ~ 4 ~ ~}%16", "{0 0 ~ 4 ~ 2 ~}%16"].map(p => n(p))

const stemN3_seq = strip(bus(onRoot(pick(seqVar, SEQS)
  .degradeBy(seqRange.fmap(r => 0.5 * (1 - r)))
  .sometimesBy(seqRange.mul(0.25), x => x.add(n("<1 -1>")))   // passing notes: 9th / 7th
  .stack(pick(seqVar, SEQ_EXTRA_PATS))   // the extra notes, joining one by one
  )
  .scale(scaleIn(4)).add(note(seqOct))
  .add(note(rand.range(-0.06, 0.06)))
  .s("sine").fm(seqCol.bright.range(0.4, 2)).fmh(2)
  .attack(0.003).decay(0.28).sustain(0).release(0.25)
  .gain(perlin.range(0.47, 0.74)).pan(sine.slow(3).range(0.35, 0.65)).delay(0.4),   // echo back (round 5b): without it the loop lost its pull
  2, seqCol.space.fmap(s => 0.3 + 0.7 * s)), {
  lpf: expRange(seqCol.bright, 1500, 12000),
  level: seqCol.level.range(0, 0.8),   // was 1; mix: melodic stems about −5 dB under the kick
})

// ============================================================
// JONAS 4 LEAD — a driven saw pluck with a snappy filter envelope, an octave-up square on top, a slow filter LFO
// ============================================================
// Feedback round 3: the sound was uninspired and lacked energy, and glide is out for good. After MusicRadar "How to
// program a melodic techno synth sound" (snappy filter envelopes for plucks), samplefocus "Futuristic synth leads"
// (separate amp and filter envelopes, a slow LFO on the cutoff, a contrasting layer an octave up): two detuned saws,
// slightly driven, through a resonant low-pass that snaps open on every note; an octave-up square pluck on top.
// Row 3 is now Variation (like Voices / Density / Range in other columns: more change over time, never the same bar).
// @008 ctl 16:4.k1 Brightness | dark pluck ↔ open and clear (lpf 600–6000 Hz, breathing slowly).
// @008 ctl 16:4.k2 Space | a little room ↔ far away (reverb).
// @008 ctl 16:4.k3 Variation | the phrase as written ↔ notes repeat in quick 16ths and step to their neighbours, at random.
// @008 ctl 16:4.fader Level | lead line on the chord.
// @008 ctl 16:4.b1 Change | next of 8 four-bar phrases.
// @008 ctl 16:4.b2 Echo throw | long echo on the line while held.
const lead      = colJonas(4)
const leadVar   = change(lead.btn, 'jonas', 'Lead')
const leadVary  = lead.char
// Feedback round 2 (monotonous as a 1-bar loop): each line is a 4-bar phrase now, A B A C: the old bar (A), a
// variation that climbs a step (B), A again, and a closing bar that comes down to the root (C). Steps only, no leaps.
const LEADS = [
  "<[0 _ ~ ~ 3 ~ 2 _ ~ ~ 0 ~ ~ ~ -1 ~] [0 _ ~ ~ 3 ~ 4 _ ~ ~ 3 ~ 2 _ ~ ~] [0 _ ~ ~ 3 ~ 2 _ ~ ~ 0 ~ ~ ~ -1 ~] [2 _ ~ ~ 1 ~ 0 _ ~ ~ ~ ~ ~ ~ ~ ~]>",
  "<[~ ~ 0 _ ~ ~ 4 _ _ ~ 3 ~ 2 _ ~ ~] [~ ~ 0 _ ~ ~ 4 _ _ ~ 5 ~ 4 _ ~ ~] [~ ~ 0 _ ~ ~ 4 _ _ ~ 3 ~ 2 _ ~ ~] [~ ~ 3 _ ~ ~ 2 _ _ ~ 0 _ _ _ ~ ~]>",
  "<[0 ~ ~ 0 ~ ~ 2 _ ~ ~ ~ ~ -1 _ _ ~] [0 ~ ~ 0 ~ ~ 3 _ ~ ~ 2 ~ ~ ~ ~ ~] [0 ~ ~ 0 ~ ~ 2 _ ~ ~ ~ ~ -1 _ _ ~] [-1 ~ ~ -1 ~ ~ 0 _ _ _ ~ ~ ~ ~ ~ ~]>",
  // 4: on beats 1, 2 and 4, the 3 pushed a 16th before beat 3 (was all on weak 16ths: it sounded out of time)
  "<[4 _ _ ~ 3 _ ~ 2 _ _ ~ ~ 0 _ ~ ~] [4 _ _ ~ 5 _ ~ 4 _ _ ~ ~ 2 _ ~ ~] [4 _ _ ~ 3 _ ~ 2 _ _ ~ ~ 0 _ ~ ~] [3 _ _ ~ 2 _ ~ 0 _ _ _ _ ~ ~ ~ ~]>",
  "<[0 _ ~ ~ 2 _ ~ 3 _ _ ~ ~ 2 ~ 0 _] [0 _ ~ ~ 2 _ ~ 4 _ _ ~ ~ 3 ~ 2 _] [0 _ ~ ~ 2 _ ~ 3 _ _ ~ ~ 2 ~ 0 _] [~ ~ ~ ~ 2 _ ~ 0 _ _ ~ ~ -1 _ _ _]>",
  "<[0 _ ~ ~ 3 ~ 2 _ ~ ~ 0 ~ ~ ~ ~ ~] [0 _ ~ ~ 3 ~ 4 _ ~ ~ 3 ~ 2 _ ~ ~] [0 _ ~ ~ 3 ~ 2 _ ~ ~ 0 ~ ~ ~ ~ ~] [0 _ ~ ~ 2 ~ 0 _ ~ ~ -1 ~ 0 _ _ ~]>",
  "<[6 _ ~ 4 _ ~ 3 _ ~ ~ 2 _ ~ 0 _ ~] [6 _ ~ 7 _ ~ 6 _ ~ ~ 4 _ ~ 3 _ ~] [6 _ ~ 4 _ ~ 3 _ ~ ~ 2 _ ~ 0 _ ~] [4 _ ~ 3 _ ~ 2 _ ~ ~ 0 _ _ _ ~ ~]>",
  "<[~ ~ ~ ~ 0 _ _ _ ~ ~ 3 _ 2 _ _ _] [~ ~ ~ ~ 2 _ _ _ ~ ~ 4 _ 3 _ _ _] [~ ~ ~ ~ 0 _ _ _ ~ ~ 3 _ 2 _ _ _] [~ ~ ~ ~ 3 _ _ _ ~ ~ 2 _ 0 _ _ _]>",
].map(p => n(p))
const leadNotes = onRoot(pick(leadVar, LEADS)
  .sometimesBy(leadVary.mul(0.35), x => x.ply(2))                   // ratchet: the note repeats in quick 16ths
  .sometimesBy(leadVary.mul(0.25), x => x.add(n("<1 -1>"))))        // neighbour note, up or down a step
  .scale(scaleIn(4))

const stemN4_lead = strip(throwEcho(dryBus(stack(
  leadNotes.s("sawtooth").superimpose(x => x.add(note(0.12))).gain(0.45)
    .attack(0.004).decay(0.25).sustain(0.4).release(0.12),
  leadNotes.s("triangle").add(note(-12)).gain(0.3).attack(0.004).decay(0.3).sustain(0.5).release(0.12),
  leadNotes.s("square").add(note(12)).gain(0.08).attack(0.002).decay(0.09).sustain(0).release(0.05)
).lpq(2).lpenv(1.8).lpattack(0.008).lpdecay(0.2).lpsustain(0.3).shape(0.12)   // round 7: softer (was lpq 5, env 3, drive 0.3)
  .gain(0.3), 2, lead.space.fmap(s => 0.25 + 0.75 * s)), lead.btn2), {
  lpf: expRange(lead.bright, 600, 6000).mul(sine.slow(8).range(0.75, 1.3)),
  level: lead.level.range(0, 0.86),   // was 1; mix: melodic stems about −5 dB under the kick
})

// ============================================================
// JONAS 5 ANSWER — short square blips at the end of every second bar, bouncing left and right through a long echo
// ============================================================
// @008 ctl 16:5.k1 Brightness | soft ↔ clear and bright (lpf 2–12 kHz).
// @008 ctl 16:5.k2 Space | some room and echo ↔ far away in space.
// @008 ctl 16:5.k3 Voices | 0 = one voice, 0.4 = + a third, 0.75 = + a fifth ↔ top: + the 7th, the voices strum apart and the phrase spills into the other bars.
// @008 ctl 16:5.fader Level | counter blips, a short phrase every second bar.
// @008 ctl 16:5.b1 Change | next of 8 phrase rhythms (new notes too).
// @008 ctl 16:5.b2 Answer | random extra answers while held.
const ans       = colJonas(5)
const ansVar    = change(ans.btn, 'jonas', 'Antwort')
const ANS_RHYTHMS = ["~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ x ~ ~ x ~ ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x x x ~",
  "~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ x ~ x", "~ ~ ~ ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ ~ ~ ~ ~",
  "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x x ~ x ~ ~", "~ ~ ~ ~ x ~ ~ ~ ~ ~ x ~ ~ ~ x x"]
const ansVoices = ans.char
// The written phrase: every second bar
const ansEvery2 = pick(ansVar, ANS_RHYTHMS.map(r => pure(1).struct(r).mask("<0 1>")))
// Round 4: from Voices 0.75 the phrase also spills into the in-between bars at random (up to 60 % of its notes)
const ansWild   = ramp(ansVoices, 0.75, 1)
const ansSpill  = gate(above(ansWild, 0), pick(ansVar, ANS_RHYTHMS.map(r => pure(1).struct(r).mask("<1 0>")))
  .degradeBy(ansWild.fmap(w => 1 - 0.6 * w)))
// Button 2 (round 6b): while held, the bars in between get an extra answer with a random rhythm, new every bar
// (about 3 notes on the back ten 16ths); the written phrase keeps its own bars.
const ansRandom = pure(1).struct("~ ~ ~ ~ ~ ~ x x x x x x x x x x").degradeBy(0.7).mask("<1 0>")
const ansRhythm = held(ans.btn2).fmap(b => b ? stack(ansEvery2, ansRandom) : stack(ansEvery2, ansSpill)).innerJoin()
// Notes: random chord tones (root, 3rd, 5th, 7th, octave), new ones per change
const ANS_TONES = [0, 2, 4, 6, 7]
const ansNotes = n(reseed(ansVar, irand(5).segment(16).fmap(i => ANS_TONES[i])))
const ansVoice = (deg, g) => onRoot(ansRhythm.fmap(() => v => v).appLeft(ansNotes).add(n(deg)))
  .scale(scaleIn(5)).s("square").decay(0.07).sustain(0).release(0.05).gain(g)

const stemN5_ans = strip(bus(stack(
  ansVoice(0, 0.54),
  // Round 6: the old travel (third 0..0.5, fifth 0.5..1) is squeezed into 0..0.75
  gate(above(ansVoices, 0), ansVoice(2, ramp(ansVoices, 0, 0.375).mul(0.42)).late(ansWild.mul(1 / 64))),
  gate(above(ansVoices, 0.375), ansVoice(4, ramp(ansVoices, 0.375, 0.75).mul(0.36)).late(ansWild.mul(2 / 64))),
  // Round 4, top quarter: + the 7th, and the voices strum apart (each one a 64th later than the one below)
  gate(above(ansWild, 0), ansVoice(6, ansWild.mul(0.3)).late(ansWild.mul(3 / 64)))
).pan("[0.2 0.8]*8").delay(0.55), 2, ans.space.fmap(s => 0.35 + 0.65 * s)), {
  lpf: expRange(ans.bright, 2000, 12000),
  level: ans.level.range(0, 0.79),   // was 1; mix: answer −7 dB
})

// ============================================================
// JONAS 6 PINGS — a high, driven bell riff: a fixed 16th figure with its own fixed notes (a loop you can recognise),
// plus a little chance in every bar
// ============================================================
// Feedback round 4: the glockenspiel rain was great for ambient, too loose for groove techno; wanted: something more
// structured and high, still with some randomness. Sound after Attack Magazine, "Jeff Mills – The Bells, part 1"
// (Synth Secrets): a saw through a driven low-pass with a filter envelope, a triangle layer an octave up, a subtle
// unsynced warble ("a subtle warbling rather than an intense vibrato"), only a delay as effect.
// Figure: each of the 8 changes is a 16th rhythm (3-3-2 style groupings) with 16 notes drawn once from the chord
// tones (fixed seed, so the same every time you play). Chance: ~12 % of the hits step to a neighbour chord tone,
// random velocity. Density fills the gaps of the figure at random; from 75 % notes also double into 32nds.
// @008 ctl 16:6.k1 Brightness | dark, woody plink ↔ bright, biting bell (lpf 1–8 kHz).
// @008 ctl 16:6.k2 Space | dry ↔ far away (reverb).
// @008 ctl 16:6.k3 Density | the figure alone ↔ at 0.75 the gaps filled in at random ↔ top quarter: quick 32nd doubles.
// @008 ctl 16:6.fader Level | high bell riff.
// @008 ctl 16:6.b1 Change | next of 8 bell figures (rhythm + notes).
// @008 ctl 16:6.b2 Run | up and down the chord, fuller the longer it is held.
const pings    = colJonas(6)
const pingVar  = change(pings.btn, 'jonas', 'Pings')
const pingDens = pings.char
const pingRise = heldRamp(pings.btn2, 2)                // 0 → 1 over 2 bars while held
const BELL_RHYTHMS = [
  'x ~ ~ x ~ ~ x ~ ~ x ~ ~ x ~ x ~', '~ ~ x ~ ~ x ~ ~ x ~ ~ ~ x ~ ~ ~', 'x ~ x ~ ~ ~ x ~ x ~ ~ ~ x ~ ~ ~',
  '~ x ~ ~ x ~ ~ x ~ ~ x ~ ~ x ~ ~', 'x ~ ~ ~ ~ x ~ ~ ~ ~ x ~ ~ ~ x ~', '~ ~ ~ x ~ ~ x ~ ~ ~ ~ x ~ ~ x ~',
  'x ~ ~ x ~ ~ ~ x ~ ~ x ~ ~ ~ x ~', '~ x ~ x ~ ~ x ~ ~ x ~ x ~ ~ x ~']
// Fixed-seed random notes per figure (root, 3rd, 5th, octave, 10th as scale degrees)
let bellSeed = 8008
const bellRand = () => (bellSeed = (bellSeed * 16807) % 2147483647) / 2147483647
const BELL_TONES = [0, 2, 4, 7, 9]
const BELL_NOTES = BELL_RHYTHMS.map(() => [...Array(16)].map(() => BELL_TONES[Math.floor(bellRand() * 5)]).join(' '))
const gaps = r => r.split(' ').map(c => c === 'x' ? '~' : 'x').join(' ')
// Plain strings (single quotes) parsed here with mini(): double quotes would already be patterns, not text
const BELL_FIGS = BELL_RHYTHMS.map((r, i) => n(mini(BELL_NOTES[i])).struct(mini(r)))
const BELL_FILLS = BELL_RHYTHMS.map((r, i) => n(mini(BELL_NOTES[i])).struct(mini(gaps(r))))
const bell = (pat, g) => stack(
  pat.s("sawtooth").attack(0.002).decay(0.12).sustain(0).release(0.1).lpq(6).lpenv(4).lpattack(0.002).lpdecay(0.07)
    .gain(0.3 * g),
  pat.s("triangle").add(note(12)).attack(0.002).decay(0.25).sustain(0).release(0.15).gain(0.25 * g)
).shape(0.2).vib(5.3).vibmod(0.04)
// A player's sweep: up and down the chord tones in 32nds, two octaves (scale degrees above the root)
const PING_RUN = n("[0 2 4 6 7 9 11 13 14 13 11 9 7 6 4 2]*2")

const bellLine = stack(
  pick(pingVar, BELL_FIGS),
  // Round 6: the fills reach their full amount at 0.75; the top quarter only adds the 32nd doubles
  gate(above(pingDens, 0), pick(pingVar, BELL_FILLS).degradeBy(ramp(pingDens, 0, 0.75).fmap(d => 1 - 0.6 * d)))
).sometimesBy(0.12, x => x.add(n("<2 -2>")))
  .sometimesBy(ramp(pingDens, 0.75, 1).mul(0.35), x => x.ply(2))

const stemN6_pings = strip(dryBus(onRoot(stack(
  bell(bellLine.velocity(rand.range(0.6, 1)), 1).pan(perlin.slow(3).range(0.3, 0.7)).delay(0.2),   // short fixed echo
  // Run: starts as a few scattered notes of the sweep and fills in over 2 bars (15 % → 90 % of the 32nds), getting
  // louder; random velocities keep it played, not ticking. Released = gone.
  gate(held(pings.btn2), bell(PING_RUN.degradeBy(pingRise.fmap(r => 0.85 - 0.75 * r)), 0.8)
    .velocity(pingRise.fmap(r => v => (0.4 + 0.6 * r) * v).appLeft(rand.range(0.7, 1)))
    .pan(sine.fast(2).range(0.3, 0.7)).delay(0.2))
)).scale(scaleIn(5)), 2, pings.space), {
  lpf: expRange(pings.bright, 1000, 8000),
  level: pings.level.range(0, 0.5),   // new sound (round 4): not yet measured; was 0.61 for the glockenspiel
})

// ============================================================
// JONAS 7 FX / BREATH — noise that breathes in and out slowly; with Amount, the chord pulses along in 8ths
// ============================================================
// Breathing = 16th noise grains whose level and bandpass follow a slow sine (one breath per 1, 2, 4 or 8 bars).
// Feedback round 2 (repetitive): no two breaths alike: each breath has its own depth (slow random), the noise colour
// wanders on its own, and the chord pulse leaves out a quarter of its 8ths at random.
// Feedback round 3 (still too loud, ringing, clearly repeating): the noise no longer ticks in steady 16ths. Grains
// come at random (about half the 16ths) with random length and level, like wind; a wider, lower-resonance bandpass
// (no whistle); less reverb and echo at the bottom of the Space knob; −4 dB again.
// @008 ctl 16:7.k1 Brightness | dark whoosh ↔ bright hiss (lpf 1.5–14 kHz).
// @008 ctl 16:7.k2 Space | nearly dry ↔ far away (reverb).
// @008 ctl 16:7.k3 Amount | 0 = only the breathing noise. Up = the chord pulses along in loose 8ths, at 1 also a 16th shimmer an octave up.
// @008 ctl 16:7.fader Level | slow, uneven breathing.
// @008 ctl 16:7.b1 Change | one breath per 2 → 4 → 8 → 1 bar(s).
// @008 ctl 16:7.b2 Open | the breath opens fully while held.
const fx       = colJonas(7)
const fxVar    = change(fx.btn, 'jonas', 'Atem', 4, ['2 Takte', '4 Takte', '8 Takte', '1 Takt'])
const fxAmount = fx.char
// Breath shape (sine) × a depth that changes slowly from breath to breath (0.3–1)
const FX_BREATHS = [2, 4, 8, 1].map(len => sine.slow(len).mul(perlin.slow(2 * len).range(0.3, 1)))
// 0..1, eased so the quiet part is long and the peak short (like breathing); held button = fully open
const breath = pick(fxVar, FX_BREATHS).fmap(v => b => b > 0.5 ? 1 : Math.pow(v, 1.6)).appLeft(fx.btn2)
const fxColour = perlin.slow(11).range(0.6, 1.7)   // the bandpass wanders, independent of the breath
const fxNoise = s("pink*16").degradeBy(0.5).attack(0.04).sustain(0.8).release(rand.range(0.06, 0.3))
  .bpf(breath.fmap(b => c => 400 * Math.pow(10, b) * c).appLeft(fxColour)).bpq(0.8)
  .gain(breath.fmap(b => r => (1 + 9 * b) * r).appLeft(rand.range(0.5, 1))).pan(rand.range(0.25, 0.75))
const ramp01  = x => Math.min(1, Math.max(0, x))
const fxChord = chordOn([0, 4, 7]).scale(scaleIn(4))
const fxPulse = stack(
  fxChord.struct("x*8").degradeBy(0.25).s("triangle").attack(0.02).sustain(0.8).release(0.1)
    .gain(breath.fmap(b => a => 0.15 * b * ramp01(a / 0.5)).appLeft(fxAmount)),
  gate(above(fxAmount, 0.5), fxChord.add(note(12)).struct("x*16").s("sine").attack(0.01).sustain(0.6).release(0.08)
    .gain(breath.fmap(b => a => 0.09 * b * ramp01((a - 0.5) / 0.5)).appLeft(fxAmount)))
)

const stemN7_fx = strip(dryBus(stack(
  fxNoise,
  gate(above(fxAmount, 0), fxPulse)
), 2, fx.space.fmap(s => 0.08 + 0.92 * s)), {
  lpf: expRange(fx.bright, 1500, 14000),
  level: fx.level.range(0, 0.19),   // was 1, then 0.48 (mix), 0.3 (round 2); round 3: still too loud, −4 dB
})


// What the LC view shows for this track: the chapter (now, next) on column 8 button 1, and extra lines at the top
const lcChapter = () => ['A ' + MOODS[moodLatch.now].name, 'A ' + MOODS[moodLatch.pending].name]
const lcHead    = () => []
// Where the music is (LC view): the beat in the bar and the bar in the big cycle. A silent event per beat moves it at
// the moment the beat sounds (onTrigger, as in the set). chordAt(bar) = the chord of that bar ('' = none shown)
const CYCLE   = 8   // the progression: 4 chords × 2 bars
const chordAt = bar => ''
const beatNow = { bar: null, beat: null }
const beatTick = pure(0).segment(4).fmap(() => ({})).onTrigger((hap, now, cps, t) => {
  const pos = hap.whole.begin.valueOf(), bar = Math.floor(pos + 1e-9), beat = Math.floor((pos - bar) * 4 + 1e-9)
  setTimeout(() => { beatNow.bar = bar; beatNow.beat = beat; lcView?.update() }, Math.max(0, (t - now) * 1000))
}, true)

// LC view of this evaluation: names from the tags in the editor (strudel.cc keeps the text in strudelMirror),
// buttons from the change() rows (row i = column i + 1), chapter and break on column 8
return { taps, showStatus, STATUS, lcChapter, lcHead, stems: { J1: stemJ1_kick, J2: stemJ2_rumble, J3: stemJ3_sub, J4: stemJ4_bass, J5: stemJ5_clap, J6: stemJ6_hats, J7: stemJ7_perc, J8: stemJ8_ride, N1: stemN1_pad, N2: stemN2_chords, N3: stemN3_seq, N4: stemN4_lead, N5: stemN5_ans, N6: stemN6_pings, N7: stemN7_fx } }
})()

SET.tracks = [T007, T010, T009, T008]
SET.track = () => SET.tracks[SET.focus()]
SET.refresh = () => SET.track().showStatus()

// Every column of every track: 007 at half speed on the 140 grid, 008 transposed (+4 semitones to A)
const COLS = ['J1', 'J2', 'J3', 'J4', 'J5', 'J6', 'J7', 'J8', 'N1', 'N2', 'N3', 'N4', 'N5', 'N6', 'N7']
const midiOf = x => typeof x === 'number' ? x : noteToMidi(x)
const transposed = (v, semis) => v.note === undefined ? v : { ...v, note: midiOf(v.note) + semis }
const prep = (k, stem) => {
  const t = SET_TRACKS[k], p = t.slow === 1 ? stem : stem.slow(t.slow)
  return t.transpose ? p.fmap(v => transposed(v, t.transpose)) : p
}

// ---- Morph: one track's column turns into the next one's --------------------------------------------------------
// Within a window both columns are queried; their events are paired by an alignment that keeps their order (time,
// then pitch) and pays for distance in time and pitch, for a different sound, or for leaving an event alone.
// A pair of the same sound (s, bank, sample) becomes one event between the two: onset, length, pitch and every
// number glide (filters on a log scale); orbit, room size and echo time come from the nearer side (one reverb per
// orbit). A pair of two different sounds (e.g. 007's synth kick and 010's sine kick) moves together the same way, but
// stays two voices whose timbres cross over. An event without a partner thins out (short hits: each one leaves or
// enters at its own point of the way) or fades (long sounds).
const GAP = 0.25                     // cost of an unpaired event; a pair is taken while cheaper than two gaps
const CROSS = 0.15                   // extra cost of pairing two different sounds
const UNPITCHED = 0.15              // extra cost of pairing a pitched with an unpitched event
const SHORT = 0.3                    // events shorter than this (cycles) thin out instead of fading
const ORBIT_KEYS = new Set(['orbit', 'roomsize', 'roomfade', 'roomlp', 'roomdim', 'delaytime', 'delayfeedback', 'ir'])
const LOG_KEYS = new Set(['cutoff', 'hcutoff', 'bandf', 'freq'])
// Values a missing key stands for, so a key on one side only can still glide (e.g. a pitch envelope fading in)
const MISSING = { cutoff: 20000, hcutoff: 20, penv: 0, shape: 0, distort: 0, delay: 0, room: 0, vib: 0, vibmod: 0,
  fm: 0, pan: 0.5, gain: 1, postgain: 1, velocity: 1, resonance: 0, detune: 0, pdecay: 0, pattack: 0 }
const lerp = (a, b, u) => a + (b - a) * u
const classOf = e => e.v.s + '|' + (e.v.bank ?? '') + '|' + (e.v.note === undefined ? e.v.n ?? '' : '')
const pitchOf = e => e.v.note === undefined ? undefined : midiOf(e.v.note)
const hash = e => { const x = Math.sin(e.t * 12.9898 + (pitchOf(e) ?? 0) * 78.233 + e.d * 3.7) * 43758.5453; return x - Math.floor(x) }
const blend = (va, vb, u) => {
  const near = u < 0.5 ? va : vb, out = {}
  for (const k of new Set([...Object.keys(va), ...Object.keys(vb)])) {
    if (ORBIT_KEYS.has(k)) { if (near[k] !== undefined) out[k] = near[k]; continue }
    let a = va[k] ?? MISSING[k], b = vb[k] ?? MISSING[k]
    if (k === 'note' && a !== undefined && b !== undefined) { a = midiOf(a); b = midiOf(b) }
    if (typeof a === 'number' && typeof b === 'number')
      out[k] = LOG_KEYS.has(k) && a > 0 && b > 0 ? Math.exp(lerp(Math.log(a), Math.log(b), u)) : lerp(a, b, u)
    else if (near[k] !== undefined) out[k] = near[k]
  }
  return out
}
// Order-keeping alignment of two event lists (dynamic programming): [a, b] pairs, [a, null] / [null, b] alone
const align = (ea, eb, len) => {
  const n = ea.length, m = eb.length
  const cost = (a, b) => {
    const pa = pitchOf(a), pb = pitchOf(b)
    return ((a.t - b.t) / len) ** 2 + (pa !== undefined && pb !== undefined ? ((pa - pb) / 12) ** 2 : 0) +
      (classOf(a) === classOf(b) ? 0 : CROSS) + ((pa === undefined) !== (pb === undefined) ? UNPITCHED : 0)
  }
  const D = [...Array(n + 1)].map((_, i) => [...Array(m + 1)].map((_, j) => (i + j) * GAP))
  for (let i = 1; i <= n; i++) for (let j = 1; j <= m; j++)
    D[i][j] = Math.min(D[i - 1][j - 1] + cost(ea[i - 1], eb[j - 1]), D[i - 1][j] + GAP, D[i][j - 1] + GAP)
  const steps = []
  for (let i = n, j = m; i > 0 || j > 0;) {
    if (i > 0 && j > 0 && D[i][j] === D[i - 1][j - 1] + cost(ea[i - 1], eb[j - 1])) { steps.push([ea[--i], eb[--j]]) }
    else if (i > 0 && D[i][j] === D[i - 1][j] + GAP) steps.push([ea[--i], null])
    else steps.push([null, eb[--j]])
  }
  return steps
}
// One voice of a pair of different sounds: the shared numbers glide, its own sound and room stay, its level crosses
const voice = (own, other, u, g) => {
  const v = blend(own, other, u)
  for (const k of new Set([...Object.keys(own), ...Object.keys(other)])) {
    const ownsIt = k in own && (ORBIT_KEYS.has(k) || typeof own[k] !== 'number' || !(k in other) && !(k in MISSING))
    if (ownsIt) v[k] = own[k]
    else if (!(k in own) && (ORBIT_KEYS.has(k) || typeof other[k] !== 'number' || !(k in MISSING))) delete v[k]
  }
  v.postgain = (v.postgain ?? 1) * g
  return v
}
const render = ([a, b], u) => {
  if (a && b) {
    const t = lerp(a.t, b.t, u), d = lerp(a.d, b.d, u)
    if (classOf(a) === classOf(b)) return [{ t, d, v: blend(a.v, b.v, u), ctx: u < 0.5 ? a.ctx : b.ctx }]
    return [{ t, d, v: voice(a.v, b.v, u, fadeOut(u)), ctx: a.ctx }, { t, d, v: voice(b.v, a.v, 1 - u, fadeIn(u)), ctx: b.ctx }]
  }
  const e = a ?? b
  if (e.d < SHORT) return (a ? hash(e) >= u : hash(e) < u) ? [e] : []
  const g = a ? fadeOut(win(u, [0, 0.6])) : fadeIn(win(u, [0.4, 1]))
  return g > 0 ? [{ ...e, v: { ...e.v, postgain: (e.v.postgain ?? 1) * g } }] : []
}
const morph = (A, B, col) => {
  const per = MORPH[col].per, cache = new Map()
  const events = (pat, ws, we, state) => pat.query(state.setSpan(new TimeSpan(ws, we)))
    .filter(h => h.hasOnset())
    .map(h => ({ t: h.whole.begin.valueOf(), d: h.whole.end.valueOf() - h.whole.begin.valueOf(), v: h.value, ctx: h.context }))
    .filter(e => e.t >= ws - 1e-9 && e.t < we - 1e-9)
  // pitched events first at the same time, so a tuned kick body meets the other tuned body, not a sample
  const byOrder = (x, y) => x.t - y.t || (pitchOf(x) ?? 1000) - (pitchOf(y) ?? 1000)
  // The plan of a window is made once, at its first query, with the progress of that moment (so no event can move
  // across a query boundary and sound twice or not at all)
  const plan = (w, state) => {
    if (cache.has(w)) return cache.get(w)
    const ws = w / per, we = (w + 1) / per
    const a = events(A, ws, we, state), b = events(B, ws, we, state)
    const u = progress(col).u
    const out = align(a.sort(byOrder), b.sort(byOrder), 1 / per).flatMap(st => render(st, u))
    cache.set(w, out)
    if (cache.size > 16) cache.delete(cache.keys().next().value)
    return out
  }
  return new Pattern(state => {
    const b0 = state.span.begin.valueOf(), e0 = state.span.end.valueOf(), haps = []
    for (let w = Math.floor(b0 * per + 1e-9); w < e0 * per - 1e-9; w++)
      for (const ev of plan(w, state))
        if (ev.t >= b0 - 1e-9 && ev.t < e0 - 1e-9)
          haps.push(new Hap(new TimeSpan(ev.t, ev.t + ev.d), new TimeSpan(ev.t, Math.min(ev.t + ev.d, Math.max(e0, ev.t + 1e-6))), ev.v, ev.ctx))
    return haps
  })
}

// A column: on a plateau (u = 0 or 1) the track's own stem, unchanged; in between the morph of the two tracks
const column = col => {
  const pats = SET.tracks.map((t, k) => t.stems[col] ? prep(k, t.stems[col]) : silence)
  const plain = pats.map((p, k) => gate(signal(() => {
    const { i, u } = progress(col)
    return (i === k && u === 0) || (i === k - 1 && u === 1)
  }), p))
  const moving = pats.slice(0, -1).map((p, k) => gate(signal(() => {
    const { i, u } = progress(col)
    return i === k && u > 0 && u < 1
  }), morph(p, pats[k + 1], col)))
  return stack(...plain, ...moving)
}
const stems = COLS.map(column)
// Stateful controls of each track (see stateTaps in the tracks), queried only while the track is awake
const trackTaps = SET.tracks.map((t, k) => {
  const all = stack(...t.taps)
  return gate(signal(() => awake(k)), SET_TRACKS[k].slow === 1 ? all : all.slow(SET_TRACKS[k].slow)).filterValues(() => false)
})

// Tempo: a silent event per 8th note carries the tempo of the current position; the scheduler takes over its cps
// (keeping the bar count). It sits last in the master, so no other event of the same tick is timed with the new tempo.
// Its trigger also moves the beat in the LC view, at the moment the beat sounds.
const tempoStem = pure(0).segment(8).fmap(() => ({ cps: bpmAt(setState.smooth) / 240 }))
  .onTrigger((hap, now, cps, t) => {
    const tr = SET_TRACKS[focusOf(setState.smooth)]
    const inner = hap.whole.begin.valueOf() / tr.slow
    const bar = Math.floor(inner + 1e-9), beat = Math.floor((inner - bar) * 4 + 1e-9)
    if (setState.beat && setState.beat.bar === bar && setState.beat.beat === beat) return
    setTimeout(() => { setState.beat = { bar, beat, phrase: phraseOf(tr) }; lcView?.update() }, Math.max(0, (t - now) * 1000))
  }, true)
setcps(bpmAt(setState.smooth) / 240)

if (lcView) {
  const CC_ROW = { k1: 12, k2: 20, k3: 28, fader: 4, b1: 36, b2: 44 }   // CC = row base + column (Mode 16 / Mode 1)
  const ROWS = ['k1', 'k2', 'k3', 'fader', 'b1', 'b2']
  const code = globalThis.strudelMirror?.code ?? ''
  const TAGS_OF = SET_TRACKS.map(t => {
    const T = {}
    for (const m of code.matchAll(new RegExp('^// @' + t.id + ' (?:mode|col|ctl) (\\S+) (.*)$', 'gm'))) T[m[1]] = m[2]
    for (const m of code.matchAll(/^\/\/ @ctl (g\.\S+) (.*)$/gm)) T[m[1]] = m[2]
    return T
  })
  // Tag prefix of a page: dual file B16 (Jojo) / 16 (Jonas), single file 16 (Mode 1) / 2 (Mode 2)
  const prefix = page => page === 'jojo' ? 'B16' : '16'   // per-track tags stay in the dual form
  const esc = s => String(s).replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c])
  const isGlobal = (page, n) => n === 8 && (alone || page === 'jonas')
  // Short page title without the players' names: 'Mode 2 — Jonas: Colour (chords + melodies)' → 'Mode 2 — Chords +
  // melodies', 'Jonas — Colour (chords + melodies)' → 'Chords + melodies'
  const shortTitle = t => {
    const m = t.match(/^(.*?) — .*?\((.+?)\)/)
    if (!m) return t.split(' · ')[0]
    const what = m[2][0].toUpperCase() + m[2].slice(1)
    return /^Mode \d/.test(m[1]) ? m[1] + ' — ' + what : what
  }

  lcView.side = name => !alone && /jojo/i.test(name ?? '') ? 'jojo' : 'jonas'
  // Column 8 CCs ((cc - 4) % 8 == 0) are on both pages and keep the page
  lcView.pageOf = (side, cc) => !alone ? side : (cc - 4) % 8 === 0 ? lcView.page : cc > 52 ? 'jonas' : 'jojo'
  const valueOf = (page, n, row) => {
    const base = CC_ROW[row] + n
    const t = lcView.cc[alone ? 'jonas' : page]
    return alone && page === 'jonas' && n < 8 ? t[base + 48] : t[base] ?? (n === 8 ? t[base + 48] : undefined)
  }
  const pending = (now, next) => esc(now) + (next !== now ? '<span class=next> → ' + esc(next) + '</span>' : '')
  const choice = (page, n) => {
    if (isGlobal(page, n)) return SET.track().lcChapter()
    const r = SET.track().STATUS[page][n - 1]
    if (!r) return ['', '']
    const show = i => !r.names ? (i + 1) + ' / ' + r.n : typeof r.names === 'function' ? r.names(i) : r.names[i]
    return [show(r.latch.now), show(r.latch.pending)]
  }
  // Button 1 in two lines like button 2: its name and the choice; while a change waits for the bar line, the current
  // choice small on top and the next one below (so the button keeps its size)
  const b1Lines = (name, now, next) => next !== now ? '<span>' + esc(now) + '</span><b class=next>→ ' + esc(next) + '</b>'
    : '<span>' + esc(name) + '</span><b>' + esc(now) + '</b>'
  const cell = (page, n, row) => {
    const val = valueOf(page, n, row)
    const [name, desc] = (TAGS_OF[SET.focus()][isGlobal(page, n) ? 'g.' + row : prefix(page) + ':' + n + '.' + row] ?? '').split(' | ')
    const num = val === undefined ? '–' : Math.round(val * 100)
    const v = 'style="--v:' + (val ?? 0) + '"'
    const title = ' title="' + esc(desc ?? '').replace(/"/g, '&quot;') + '"'
    if (row === 'fader') return '<div class="cell fader"' + title + '><div class=bar ' + v + '><i></i></div>' +
      '<b>' + num + '</b><span>' + esc(name) + '</span></div>'
    if (row === 'b1') return '<div class="cell btn"' + title + '>' + b1Lines(name, ...choice(page, n)) + '</div>'
    if (row === 'b2') {
      const on = isGlobal(page, n) ? setState.mode : (val ?? 0) > 0.5
      const what = isGlobal(page, n) ? esc(setState.mode ? 'Set' : 'Fog')
        : on ? 'gedrückt' : ''
      return '<div class="cell btn' + (on ? ' on' : '') + '"' + title + '><span>' + esc(name) + '</span><b>' + what + '</b></div>'
    }
    return '<div class="cell knob"' + title + '><div class=dial ' + v + '></div><b>' + num + '</b><span>' + esc(name) + '</span></div>'
  }
  // Bar in the cycle (bars) and beat in the bar (dots, the one ringed), then the bar's chord
  const marks = (n, on) => [...Array(n).keys()].map(k => '<i' + (k === on ? ' class=on' : '') + '></i>').join('')
  const beatHtml = () => beatNow.bar === null ? '–' : (beatNow.bar % CYCLE + 1) + ' / ' + CYCLE +
    '<span class=bars>' + marks(CYCLE, beatNow.bar % CYCLE) + '</span><span class=beats>' + marks(4, beatNow.beat) + '</span>' +
    (chordAt(beatNow.bar) ? '<span class=chord>' + esc(chordAt(beatNow.bar)) + '</span>' : '')
  lcView.css = [
    ':root{--acc:#ddd}html,body{margin:0;height:100%;background:#111;color:#eee;font:clamp(10px,.8vw,18px)/1.25 system-ui,sans-serif}',
    '.pages{flex:1;display:flex;gap:1vw;min-height:0}',
    '.page{flex:1;min-width:0;display:flex;flex-direction:column;gap:.4vh;min-height:0;padding:.6vh .8vw;border:2px solid #222;border-radius:8px}',
    '.page.live{border-color:var(--acc)}.page h2{margin:0;font-size:1.15em;color:var(--acc)}',
    '#lc{display:flex;flex-direction:column;gap:1vh;padding:1.5vh 1.5vw;box-sizing:border-box;height:100%;overflow:hidden}',
    '.head{display:flex;gap:2.5vw;align-items:baseline;flex-wrap:wrap}.head h1{margin:0;font-size:1.6em;color:var(--acc)}',
    '.head .k{opacity:.6;margin-right:.4em}.next{color:var(--acc)}',
    '.grid{flex:1;min-height:0;display:grid;grid-template-columns:repeat(8,1fr);grid-template-rows:2.9em repeat(3,minmax(0,1fr)) minmax(0,1.4fr) 3.3em 3.3em;gap:.8vh .5vw}',
    '.col{text-align:center;font-weight:600;padding:.3em;border-bottom:2px solid #333;overflow:hidden;display:flex;align-items:flex-end;justify-content:center}.col.g{color:var(--acc)}',
    '.cell{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:.1em;min-width:0;min-height:0}',
    '.cell span{opacity:.7;font-size:.85em;overflow-wrap:anywhere}.cell b{font-variant-numeric:tabular-nums}',
    '.dial{width:min(3vw,6.5vh);aspect-ratio:1;border-radius:50%;',
    'background:conic-gradient(from -135deg,var(--acc) 0 calc(var(--v)*270deg),#333 0 270deg,transparent 0);',
    '-webkit-mask:radial-gradient(circle,transparent 52%,#000 54%);mask:radial-gradient(circle,transparent 52%,#000 54%)}',
    '.bar{position:relative;width:1vw;min-width:12px;flex:1;min-height:30px;background:#333;border-radius:4px;overflow:hidden}',
    '.bar i{position:absolute;left:0;right:0;bottom:0;height:calc(var(--v)*100%);background:var(--acc)}',
    '.btn{background:#222;border-radius:6px;padding:.4em .3em;justify-content:flex-start;overflow:hidden;box-sizing:border-box}',
    '.btn b{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.btn .next{display:block;overflow:hidden;text-overflow:ellipsis}.btn.on{background:var(--acc);color:#111}',
    '.btn.on span{opacity:.8}.btn b{font-size:1.05em}',
    '.beats{margin-left:.6em}.beats i{display:inline-block;width:.75em;height:.75em;border-radius:50%;background:#333;margin-left:.3em}',
    '.beats i:first-child{outline:2px solid #555}.beats i.on{background:var(--acc)}',
    '.bars{margin-left:.6em}.bars i{display:inline-block;width:1.1em;height:.55em;border-radius:2px;background:#333;margin-left:.15em}',
    '.bars i.on{background:var(--acc)}.chord{margin-left:.6em;font-weight:600;color:var(--acc)}',
  ].join('\n')
  // One page as a block: its title, the column names and the six rows. The page moved last gets a frame in its colour.
  // The pages stand side by side like the two controllers on the table; swap the order here if Jonas stands left.
  const PAGE_ORDER = ['jojo', 'jonas']
  const cols = [1, 2, 3, 4, 5, 6, 7, 8]
  const pageHtml = page => '<section class="page' + (page === lcView.page ? ' live' : '') + '" style="--acc:' +
    (page === 'jojo' ? '#f0a040' : '#50c8e8') + '"><h2>' +
    esc(shortTitle(TAGS_OF[SET.focus()][prefix(page)] ?? (page === 'jojo' ? 'Mode 1' : 'Mode 2'))) + '</h2><div class=grid>' +
    cols.map(n => '<div class="col' + (isGlobal(page, n) ? ' g' : '') + '">' +
      esc((TAGS_OF[SET.focus()][prefix(page) + ':' + n] ?? (isGlobal(page, n) ? '8 Global' : String(n))).replace(/^\d+\s*/, n + ' ')) + '</div>').join('') +
    ROWS.map(row => cols.map(n => cell(page, n, row)).join('')).join('') + '</div></section>'
  lcView.draw = () => {
    const doc = lcView.win.document
    const root = doc.getElementById('lc')
    if (!root) return
    root.innerHTML = '<div class=head>' +
      '<div><span class=k>Kapitel</span>' + pending(...SET.track().lcChapter()) + '</div>' +
      SET.track().lcHead().map(([k, text]) => '<div><span class=k>' + esc(k) + '</span>' + esc(text) + '</div>').join('') +
      SET.headHtml(esc) +
      (code ? '' : '<div class=next>Namen fehlen: Editor nicht gefunden</div>') +
      (lcView.other ? '<div><span class=k>MIDI</span>' + esc(lcView.other) + '</div>' : '') + '</div><div class=pages>' + PAGE_ORDER.map(pageHtml).join('') + '</div>'
  }
  // Another track's status box may be the one on the page now: the link moves into it
  if (statusUi?.box && lcView.link) statusUi.box.append(lcView.link)
  if (lcView.win && !lcView.win.closed) lcView.win.document.head.innerHTML = '<style>' + lcView.css + '</style>'
}
SET.refresh()


// ============================================================
// MASTER AUDIO MATRIX
// ============================================================
stack(
  stack(
    stack(...setTaps).filterValues(() => false),
    ...trackTaps,
    ...stems
  ).filterValues(v => (v.gain ?? 1) * (v.postgain ?? 1) > 0),   // safety net: drop anything that is silent anyway
  tempoStem
)
