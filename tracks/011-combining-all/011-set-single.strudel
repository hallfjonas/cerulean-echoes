// ============================================================
// GENERATED from 011-set-dual.strudel by tools/lcxl-layout/make-single.mjs — edit the dual file, not this one.
// TRACK 011 — the set: 007 ambient → 010 ambient house → 009 cool house → 008 groove techno, one continuous journey
// GENERATED by tools/set/make-set.mjs from the four dual tracks and tools/set/set-frame.strudel — edit those, not this.
// ============================================================
// Jonas' column 8 button 2 switches what the Fog knob does: Fog (as in every track) ↔ the set position.
// The set position runs from 0 to 1 over all four tracks: each track has a plateau (only it plays), and between two
// plateaus a slow transformation: column by column the old track's sound turns into the new one's. Events are paired
// (the nearest hit of the same sound, chord notes by pitch) and move: onset, pitch, decay, filter glide from one
// track to the other (a transport, not a crossfade). What has no partner thins out (short hits) or fades (long
// sounds). Air and pad move first, then the low end, the drums, and the melodies last.
// Tempo: 007 is written at 70 BPM but runs here on a 140 grid at half speed (sounds the same), so the way to 010 is a
// small slow-down (felt 70 → 60) plus the doubling into 120; then 120 → 122 → 140.
// 008 is moved from F to A (+4 semitones), so 009 (A minor) and 008 share their root.
// Each track keeps its own sounds, patterns and chapters; faders and knobs keep their meaning (same column = same role).
// In the set: chapters change at the next 8-bar phrase (007 and 008: 4 bars), Tension reaches 75 % of its range,
// and there is no Break / Drop (Jojo's kick button 2 still drops the kick out).
// @layout Track 011 — the set: 007 → 010 → 009 → 008 (one controller)
// @globalcc same
// @note One continuous set through four tracks: 007 ambient (70 BPM) → 010 ambient house (120) → 009 cool house (122) → 008 groove techno (140, here in A). Every column keeps its role; the sounds behind it change with the track.
// @note Jonas’ column 8 button 2 switches the Fog knob between Fog and the set position. In set mode, turning it moves through the set: each track has a plateau, between two plateaus a slow transformation: column by column the old sound turns into the new one (hits move to their new place, pitch, decay and filters glide; what has no partner thins out or fades). Air and pad first, then the low end, drums, melodies last. Leave it anywhere: a halfway position is its own sound.
// @note Chapter, the buttons and the LC view belong to the track in focus (the nearer one in a transition). Chapters change at the next 8-bar phrase (007, 008: 4 bars). No Break / Drop in the set.
// @note One controller: Mode 1 = Jojo (foundation, columns 1–7; Jojo's column 8 (Shaker / Ride) stays off; Mode 1 sends the same CCs as Mode 16), Mode 2 = Jonas (colour). Column 8 is global on both pages.
// @mode 16 Mode 1 — Jojo: Foundation (beat + bass) · same CCs as Mode 16
// @col 16:8 8 Global
// @col 16:1 1 Pulse / Kick
// @col 16:2 2 Rumble / Noise
// @col 16:3 3 Sub
// @col 16:4 4 Bassline
// @col 16:5 5 Backbeat
// @col 16:6 6 Hats
// @col 16:7 7 Percussion
// @row 16:k1 Row 1 \ Brightness
// @row 16:k2 Row 2 \ Space
// @row 16:k3 Row 3 \ Character
// @row 16:fader Fader \ Level
// @row 16:b1 Button 1 \ Change
// @row 16:b2 Button 2 \ Moment
// @mode 2 Mode 2 — Jonas: Colour (chords + melodies) · CC + 48
// @col 2:1 1 Pad
// @col 2:2 2 Chords
// @col 2:3 3 Arp
// @col 2:4 4 Lead
// @col 2:5 5 Answer
// @col 2:6 6 Sparkle
// @col 2:7 7 FX / Risers
// @col 2:8 8 Global + Set
// @row 2:k1 Row 1 \ Brightness
// @row 2:k2 Row 2 \ Space
// @row 2:k3 Row 3 \ Character
// @row 2:fader Fader \ Level
// @row 2:b1 Button 1 \ Change
// @row 2:b2 Button 2 \ Moment
// @ctl 16:1.k1 Brightness | dull thump ↔ clicky attack. Never fully closed.
// @ctl 16:1.k2 Space | dry and close ↔ far away in a big room (reverb + echo).
// @ctl 16:1.k3 Softness | 0 = soft and round (the default) ↔ a deep, soft thump. Punch comes from row 1 (click). 007: Drive · 008: Punch.
// @ctl 16:1.fader Level | 007 Pulse · 010 Kick · 009 Kick · 008 Kick.
// @ctl 16:1.b1 Change | next of at most 3 patterns, at the next bar.
// @ctl 16:1.b2 Drop out | kick pauses while held.
// @ctl 16:2.k1 Brightness | deep rumble ↔ airy hiss.
// @ctl 16:2.k2 Space | dry ↔ far away.
// @ctl 16:2.k3 Sea ↔ Wind / Motion | still ↔ rolling waves / sweeps.
// @ctl 16:2.fader Level | 007 Sea / Wind · 010 Atmo Pump · 009 Atmo · 008 Rumble.
// @ctl 16:2.b1 Change | next of at most 3 patterns.
// @ctl 16:2.b2 Riser | noise rises while held.
// @ctl 16:3.k1 Brightness | pure sine ↔ a little buzz on top.
// @ctl 16:3.k2 Space | dry ↔ far away.
// @ctl 16:3.k3 Beating / Length | long held tones ↔ short blips.
// @ctl 16:3.fader Level | 007 Drone · 010 Sub · 009 Sub · 008 Sub.
// @ctl 16:3.b1 Change | next of at most 3 patterns.
// @ctl 16:3.b2 Slide | notes glide into each other while held.
// @ctl 16:4.k1 Brightness | round and dark ↔ buzzing, squelchy.
// @ctl 16:4.k2 Space | dry ↔ far away.
// @ctl 16:4.k3 Groove / Rubber | few notes ↔ busy, bouncing line.
// @ctl 16:4.fader Level | 007 Bass · 010 Bassline · 009 Rubber Bass · 008 Bassline.
// @ctl 16:4.b1 Change | next of at most 3 patterns.
// @ctl 16:4.b2 Octave | one octave up while held.
// @ctl 16:5.k1 Brightness | soft and far ↔ sharp crack.
// @ctl 16:5.k2 Space | dry ↔ far away.
// @ctl 16:5.k3 Ghost notes / Snare | 0 = plain backbeat ↔ extra quiet hits in between.
// @ctl 16:5.fader Level | 007 Rim · 010 Clap / Rim · 009 Clap / Snare · 008 Clap.
// @ctl 16:5.b1 Change | next of at most 3 patterns.
// @ctl 16:5.b2 Roll | snare roll while held.
// @ctl 16:6.k1 Brightness | soft hiss ↔ crisp and sharp.
// @ctl 16:6.k2 Space | dry ↔ far away.
// @ctl 16:6.k3 Density | the pattern as it is ↔ + quiet 16ths ↔ + little rolls.
// @ctl 16:6.fader Level | 007 Ticks · 010 Hats · 009 Hats · 008 Hats.
// @ctl 16:6.b1 Change | next of at most 3 patterns.
// @ctl 16:6.b2 Open | hats ring long while held.
// @ctl 16:7.k1 Brightness | woody ↔ metallic.
// @ctl 16:7.k2 Space | dry ↔ far away.
// @ctl 16:7.k3 Density / Toms | steady pattern ↔ + ghost notes and rolls.
// @ctl 16:7.fader Level | 007 Wood / Drops · 010 Congas · 009 Rim / Toms · 008 Percussion.
// @ctl 16:7.b1 Change | next of at most 3 patterns.
// @ctl 16:7.b2 Fill | a fill while held.
// @ctl 2:1.k1 Brightness | muffled ↔ open and airy.
// @ctl 2:1.k2 Space | dry and close ↔ far away in a big room (reverb + echo).
// @ctl 2:1.k3 Swell / Motion | still ↔ slowly breathing in and out.
// @ctl 2:1.fader Level | 007 Pad · 010 Pad · 009 Pad · 008 Pad.
// @ctl 2:1.b1 Change | next pattern / melody, at the next bar.
// @ctl 2:1.b2 Freeze | holds the current chord while held.
// @ctl 2:2.k1 Brightness | warm ↔ bright, glassy.
// @ctl 2:2.k2 Space | dry ↔ far away.
// @ctl 2:2.k3 Rhythm | long held chords ↔ short, choppy stabs. 007/008: Length · 009: Sound.
// @ctl 2:2.fader Level | 007 Chords · 010 Deep Chords · 009 Stab · 008 Dub Chords.
// @ctl 2:2.b1 Change | next pattern / melody.
// @ctl 2:2.b2 Stab / Open | one accent chord, now.
// @ctl 2:3.k1 Brightness | soft plucks ↔ sharp, sparkling.
// @ctl 2:3.k2 Space | dry ↔ far away.
// @ctl 2:3.k3 Range | few slow notes ↔ fast and wide. 007: Density · 009: Pedal.
// @ctl 2:3.fader Level | 007 Music Box · 010 Pluck Arp · 009 Riff · 008 Sequence.
// @ctl 2:3.b1 Change | next pattern / melody.
// @ctl 2:3.b2 Octave | one octave up while held.
// @ctl 2:4.k1 Brightness | soft and round ↔ biting (acid squelch).
// @ctl 2:4.k2 Space | dry ↔ far away.
// @ctl 2:4.k3 Glide / Acid | plain notes ↔ notes slide into each other.
// @ctl 2:4.fader Level | 007 Whale · 010 Lead · 009 Acid · 008 Lead.
// @ctl 2:4.b1 Change | next pattern / melody.
// @ctl 2:4.b2 Echo throw / Accent | the last note echoes away.
// @ctl 2:5.k1 Brightness | hushed ↔ clear.
// @ctl 2:5.k2 Space | dry ↔ far away.
// @ctl 2:5.k3 Voices / Length | one voice ↔ two-, three-part harmony.
// @ctl 2:5.fader Level | 007 Choir · 010 Marimba · 009 Rhodes · 008 Answer.
// @ctl 2:5.b1 Change | next pattern / melody.
// @ctl 2:5.b2 Answer | plays one phrase, now. 007: Full choir · 009: Swell.
// @ctl 2:6.k1 Brightness | soft glow ↔ glittering.
// @ctl 2:6.k2 Space | dry ↔ far away.
// @ctl 2:6.k3 Density / Glide | a sparkle now and then ↔ a rain of notes.
// @ctl 2:6.fader Level | 007 Glitter · 010 Glockenspiel · 009 Voice · 008 Pings.
// @ctl 2:6.b1 Change | next pattern / melody.
// @ctl 2:6.b2 Run / Echo throw | one quick run of sparkles.
// @ctl 2:7.k1 Brightness | dark whoosh ↔ bright shimmer.
// @ctl 2:7.k2 Space | dry ↔ far away.
// @ctl 2:7.k3 Amount / Hits | subtle ↔ wild.
// @ctl 2:7.fader Level | 007 Shimmer · 010 Birds · 009 Dub Chord · 008 FX / Breath.
// @ctl 2:7.b1 Change | next pattern / melody.
// @ctl 2:7.b2 Hit | one FX hit / impact. 007: Rise · 010: Flock · 009: Throw · 008: Open.
// @ctl g.k1 Fog / Set | Fog: 0 = clear, up = everything muffled. Set mode (button 2): the set position, 007 → 010 → 009 → 008.
// @ctl g.k2 Room | 0 = each sound's own room (row 2), up = everything drowns in reverb.
// @ctl g.k3 Tension | build-up: echo grows, filters open (in the set at most 75 %). Back to 0 = release.
// @ctl g.fader Master Level | volume of everything, both controllers. 0 = silence.
// @ctl g.b1 Chapter | next chords of the track in focus, at the next phrase.
// @ctl g.b2 Set mode | Fog knob: Fog ↔ set position.
// @guide The journey | 007 → 010 → 009 → 008: from a floating heartbeat to techno. The Fog knob in set mode is the map: a full turn is the whole set, each track sits on a plateau where small moves change nothing.
// @guide The journey | A transition takes as long as you turn: slowly, over 16–32 bars, is best. Even a fast spin glides over at least 5 seconds. The tempo moves with it: 70 → 60 (007 slows a little, then 010 doubles it to 120), 120 → 122, 122 → 140.
// @guide The journey | Faders stay where they are: the same column has the same job in the next track. Bring the faders of a new track’s extra sounds up only after the transition.
// @guide Less is more | One change at a time, every 8 bars at most. Let a loop run before it changes again. Chapters wait for the next phrase on purpose.
// @guide Less is more | Fog and Room hide a transition: muffle or drown everything a little, move the set on, then clear up again.
// @guide Status box | The status box at the bottom right of the Strudel page shows the set position, chapter and each stem's pattern. Its button “als Fenster” opens it as a small window that stays on top (Chrome/Edge).
// @guide Playing alone | A run is: build the beat in Mode 1, switch to Mode 2, add colour, use column 8 for the drop. Mode 1 is set up in Components with the same CCs as Mode 16.
// @guide Playing alone | Faders are shared hardware: after a mode switch each sound keeps its value until you touch its fader, then it jumps to where the fader physically is. Move faders gently after switching.

const JOJO  = 'LCXL3 Jojo MIDI Out'
const JONAS = 'LCXL3 Jonas MIDI Out'
// Jonas' controller by its macOS name; if that name is missing (other computer, other USB port), the first MIDI input
let ccJonas
try { ccJonas = await midin(JONAS) } catch (e) { console.warn('Jonas not found: using the first MIDI input'); ccJonas = await midin() }
// Single version (written by tools/lcxl-layout/make-single.mjs with SINGLE = true): don't look for Jojo's controller
const SINGLE = true
let ccJojo = null
if (!SINGLE) {
  try { ccJojo = await midin(JOJO) } catch (e) { console.warn('Jojo not found: one controller, Mode 1 = Jojo, Mode 2 = Jonas (CC + 48)') }
}

// Status box at the bottom right: chapter, break, and which pattern each stem plays.
// Its button moves the text into a small always-on-top window (Document Picture-in-Picture, Chrome/Edge), so it
// stays visible over the layout PDF; closing that window puts it back. Kept on globalThis, so re-evaluating
// reuses the open window. Only in the browser; the Node tools have no page to draw on.
const hasPage = typeof document !== 'undefined' && !!document.createElement
const statusUi = !hasPage ? null : globalThis.ambientStatus ??= (() => {
  document.getElementById('board-status')?.remove()   // the plain box of earlier versions
  const box = document.createElement('div')
  box.style.cssText = 'position:fixed;right:12px;bottom:12px;z-index:1000;padding:8px 12px;' +
    'background:rgba(0,0,0,.75);border-radius:6px'
  const text = document.createElement('pre')
  text.style.cssText = 'margin:0;color:#eee;font:13px/1.5 monospace'
  const pop = document.createElement('button')
  pop.textContent = '⧉ als Fenster'
  pop.style.cssText = 'margin-top:6px;font:12px sans-serif;cursor:pointer'
  pop.onclick = async () => {
    if (!window.documentPictureInPicture) { pop.textContent = 'geht nur in Chrome/Edge'; return }
    const pip = await documentPictureInPicture.requestWindow({ width: 380, height: 470 })
    pip.document.body.style.cssText = 'margin:0;padding:8px 12px;background:#111'
    pip.document.body.append(text)
    box.style.display = 'none'
    pip.addEventListener('pagehide', () => { box.prepend(text); box.style.display = '' })
  }
  box.append(text, pop)
  document.body.appendChild(box)
  return { text, box }
})()

// LC view: a big, normal window (second screen, full screen) that draws the controller page in use: each control's
// name from the @ctl tags in the editor, its value, and what the buttons have chosen. One controller: the page follows
// the CCs that move (columns 1-7: plain = Mode 1 Jojo, CC + 48 = Mode 2 Jonas; column 8 is on both). Two controllers:
// the page of the controller moved last. Values come from Web MIDI directly; a control not moved since loading shows –
// (Strudel reads it as 0). Kept on globalThis like the status box; side, pageOf and draw are set anew on every evaluation.
const lcView = !hasPage ? null : globalThis.lcxlView ??= (() => {
  const v = { win: null, cc: { jojo: {}, jonas: {} }, page: 'jojo', timer: null,
    side: () => 'jonas', pageOf: side => side, draw: () => {}, css: '' }
  v.update = () => {
    if (!v.win || v.win.closed || v.timer) return
    v.timer = setTimeout(() => { v.timer = null; if (v.win && !v.win.closed) v.draw() }, 40)
  }
  // Everything that is not a CC (a mode switch may send SysEx or a program change) is shown in the view as hex
  const onMsg = (name, e) => {
    const [status, cc, val] = e.data
    if ((status & 0xf0) !== 0xb0) {
      if (status === 0xf8 || status === 0xfe) return   // clock, active sensing
      v.other = [...e.data].map(b => b.toString(16).padStart(2, '0')).join(' ').toUpperCase()
      v.update()
      return
    }
    const side = v.side(name)
    v.cc[side][cc] = val / 127
    v.page = v.pageOf(side, cc)
    v.update()
  }
  // A second listener next to Strudel's own (addEventListener does not replace it)
  const ports = new WeakSet()
  const listen = input => {
    if (ports.has(input)) return
    ports.add(input)
    input.addEventListener('midimessage', e => onMsg(input.name, e))
    input.open?.()
  }
  // With SysEx if the browser allows it (Chrome asks once), else without
  const midiAccess = !navigator.requestMIDIAccess ? Promise.reject(new Error('no Web MIDI'))
    : navigator.requestMIDIAccess({ sysex: true }).catch(() => navigator.requestMIDIAccess())
  midiAccess.then(access => {
    access.inputs.forEach(listen)
    access.addEventListener('statechange', e => { if (e.port.type === 'input' && e.port.state === 'connected') listen(e.port) })
  }).catch(e => console.warn('LC view: no MIDI access', e))
  // The button is a link that opens a tab named lcxl-view: a link click is never stopped by the pop-up blocker, and the
  // tab can be dragged out into its own window. Strudel replaces globalThis.open (a control of its own), so the handle
  // on that tab comes from the native open of a hidden iframe (with a name and no URL it only finds the open tab).
  for (const old of document.querySelectorAll('button')) if (old.textContent.startsWith('▣ LC')) old.remove()
  const opener = document.createElement('iframe')
  opener.style.display = 'none'
  document.body.append(opener)
  const link = document.createElement('a')
  link.textContent = '▣ LC groß'
  link.href = 'about:blank'
  link.target = 'lcxl-view'
  link.style.cssText = 'display:inline-block;margin:6px 0 0 6px;padding:1px 6px;font:12px sans-serif;color:#000;' +
    'background:#ddd;border-radius:3px;text-decoration:none;cursor:pointer'
  link.onclick = () => setTimeout(() => {
    try {
      const w = opener.contentWindow.open('', 'lcxl-view')
      if (!w) { link.textContent = '▣ LC groß (Tab nicht gefunden)'; return }
      v.win = w
      w.document.title = 'LC XL 3'
      w.document.head.innerHTML = '<style>' + v.css + '</style>'
      w.document.body.innerHTML = '<div id=lc></div>'
      v.draw()
      link.textContent = '▣ LC groß'
    } catch (e) { link.textContent = '▣ LC groß: ' + e.message; console.error(e) }
  }, 100)
  if (statusUi.box) statusUi.box.append(link)
  else { link.style.cssText += ';position:fixed;right:12px;bottom:4px;z-index:1001'; document.body.append(link) }
  v.link = link
  return v
})()

// ============================================================
// SET — one knob through four tracks: position, tempo, crossfades
// ============================================================
const SET_TRACKS = [
  { id: '007', name: 'Ambient', grid: 140, slow: 2, phrase: 4, orig: 1, transpose: 0 },
  { id: '010', name: 'Ambient House', grid: 120, slow: 1, phrase: 8, orig: 4, transpose: 0 },
  { id: '009', name: 'Cool House', grid: 122, slow: 1, phrase: 8, orig: 4, transpose: 0 },
  { id: '008', name: 'Groove Techno', grid: 140, slow: 1, phrase: 4, orig: 1, transpose: 4 },
]
// Node check (tools/set/check-set.mjs): original phrase lengths and Tension range, no glide, every knob move counts
const CHECK = globalThis.setCheck === true
const TENSION_MAX = CHECK ? 1 : 0.75
const phraseOf = t => CHECK ? t.orig : t.phrase
const N = SET_TRACKS.length
// Set position 0..1: a plateau per track, a transition between two plateaus (4 × 0.1 + 3 × 0.2)
const PLATEAU = 0.1
const TRANSITION = (1 - N * PLATEAU) / (N - 1)
const SPAN = PLATEAU + TRANSITION
// The position glides after the knob (time constant in seconds) and never faster than MAX_RATE per second,
// so even a fast spin turns into a transition of at least TRANSITION / MAX_RATE = 5 seconds
const GLIDE = 0.6
const MAX_RATE = 0.04
const alone = !ccJojo   // one controller: Jojo in Mode 1, Jonas in Mode 2 (LC view, status box)
// Gate: the pattern is not queried at all while cond is false (as in the tracks; Strudel's own gate() is a sound control)
const gate = (cond, pat) => cond.fmap(on => on ? pat : silence).innerJoin()
const clamp01 = x => Math.min(1, Math.max(0, x))

// Kept on globalThis: re-evaluating the code keeps the place in the set and the fog
const setState = globalThis.setState ??= { pos: 0, smooth: 0, fog: 0, mode: false, prev: null, beat: null }

// Where a position is: track i (plateau or start of a transition) and the progress x towards track i + 1
const where = p => {
  const i = Math.min(N - 1, Math.floor(p / SPAN))
  return { i, x: i === N - 1 ? 0 : clamp01((p - i * SPAN - PLATEAU) / TRANSITION) }
}
// The track that has the buttons, chapter and LC view: the one nearer in the transition
const focusOf = p => { const { i, x } = where(p); return x < 0.5 ? i : i + 1 }
const bpmAt = p => {
  const { i, x } = where(p), a = SET_TRACKS[i].grid, b = SET_TRACKS[Math.min(N - 1, i + 1)].grid
  return a + (b - a) * x * x * (3 - 2 * x)
}

// Morph per column: per = windows per bar (events are paired within one window: a beat for the drums, a bar for
// chords), at = where in the transition (x = 0..1) the column moves from the old track (u = 0) to the new one (u = 1)
const MORPH = {
  J1: { per: 4, at: [0.3, 0.7] },  J2: { per: 1, at: [0, 0.5] },    J3: { per: 2, at: [0.35, 0.65] }, J4: { per: 2, at: [0.35, 0.65] },
  J5: { per: 2, at: [0.2, 0.8] },  J6: { per: 4, at: [0.2, 0.8] },  J7: { per: 2, at: [0.2, 0.8] },   J8: { per: 4, at: [0.2, 0.8] },
  N1: { per: 1, at: [0, 0.6] },    N2: { per: 1, at: [0.2, 0.8] },  N3: { per: 2, at: [0.4, 1] },     N4: { per: 1, at: [0.4, 1] },
  N5: { per: 1, at: [0.4, 1] },    N6: { per: 2, at: [0.4, 1] },    N7: { per: 1, at: [0, 0.6] },
}
const win = (x, [a, b]) => clamp01((x - a) / (b - a))
const progress = col => { const { i, x } = where(setState.smooth); return { i, u: win(x, MORPH[col].at) } }
// Equal-power curves, exactly 0 and 1 at the ends (gates and the safety net need a real 0)
const fadeOut = u => u <= 0 ? 1 : u >= 1 ? 0 : Math.cos(u * Math.PI / 2)
const fadeIn  = u => u <= 0 ? 0 : u >= 1 ? 1 : Math.sin(u * Math.PI / 2)
// A track is queried at all only while it sounds or has the focus
const awake = k => { const { i, x } = where(setState.smooth); return k === i || (k === i + 1 && x > 0) }

const setTaps = []
const tap = pat => (setTaps.push(pat), pat)
const off8 = signal(() => 0)
// Column 8 is read from its Mode 16 and Mode 2 CCs, last moved wins (as in the tracks)
const lastMoved8 = (a, b) => {
  let pa = null, pb = null, v = 0
  return tap(a.fmap(x => y => {
    if (pa === null) v = Math.max(x, y)
    else if (y !== pb) v = y
    else if (x !== pa) v = x
    pa = x; pb = y
    return v
  }).appLeft(b))
}
const raw8 = c => lastMoved8(ccJonas(c), ccJonas(c + 48))
const g8 = { bright: raw8(20), space: raw8(28), char: raw8(36), level: raw8(12), btn: raw8(44), btn2: raw8(52) }

// The Fog knob is an encoder with absolute values (0-127). Its moves go to the fog or, in set mode, to the position.
// Value scaling: a move covers the rest of the target's range in proportion to the rest of the knob's range, so the
// two values never jump, even if the controller did not take over the value sent on a mode switch.
// A jump larger than MAX_STEP within one tick is no move but a re-sync (re-evaluation): it is ignored.
const MAX_STEP = CHECK ? Infinity : 0.1
const follow = (v, x0, x1) => Math.abs(v - x0) < 1e-9 ? x1
  : clamp01(x1 > x0 ? v + (x1 - x0) * (1 - v) / (1 - x0) : v - (x0 - x1) * v / x0)
tap(g8.bright.fmap(x => {
  const s = setState
  if (s.prev === null) { if (!s.mode) s.fog = x }
  else if (x !== s.prev && Math.abs(x - s.prev) <= MAX_STEP) {
    if (s.mode) s.pos = follow(s.pos, s.prev, x)
    else s.fog = follow(s.fog, s.prev, x)
  }
  s.prev = x
  return 0
}))

// Feedback to the controller: on a mode switch the Fog encoder is set to the value it now controls (CC back to the
// port and channel the Fog knob last came from), so its ring and display show the right value
const fogOut = globalThis.setFogOut ??= (() => {
  const o = { send: () => false, status: 0xbf, cc: 20, from: null }
  if (typeof navigator === 'undefined' || !navigator.requestMIDIAccess) return o
  navigator.requestMIDIAccess().then(access => {
    const outFor = name => {
      const outs = [...access.outputs.values()]
      const base = (name ?? '').replace(/\s*(MIDI\s*)?Out\s*$/i, '')
      return outs.find(p => name && p.name === name.replace(/Out(\s*)$/i, 'In$1'))
        ?? (base && outs.find(p => p.name.startsWith(base)))
        ?? outs.find(p => /jonas/i.test(p.name)) ?? outs.find(p => /lcxl|launch control/i.test(p.name))
    }
    const listen = input => input.addEventListener('midimessage', e => {
      const [st, cc] = e.data
      if ((st & 0xf0) === 0xb0 && (cc === 20 || cc === 68)) { o.status = st; o.cc = cc; o.from = input.name }
    })
    access.inputs.forEach(listen)
    o.send = v => {
      const out = outFor(o.from)
      if (!out) return false
      out.send([o.status, o.cc, Math.round(clamp01(v) * 127)])
      return true
    }
  }).catch(e => console.warn('set: no MIDI output for the Fog feedback', e))
  return o
})()

let prevBtn2 = 0
tap(g8.btn2.fmap(v => {
  if (v > 0.5 && prevBtn2 <= 0.5) {
    const s = setState
    s.mode = !s.mode
    const target = s.mode ? s.pos : s.fog
    if (fogOut.send(target)) s.prev = target
    SET.refresh()
  }
  prevBtn2 = v
  return 0
}))

// Glide of the position, once per scheduler tick (setTaps come first in the master)
let lastNow = null, lastLabel = null
tap(signal(() => {
  const s = setState, now = Date.now() / 1000
  const dt = lastNow === null ? Infinity : now - lastNow
  lastNow = now
  if (CHECK || dt === Infinity) s.smooth = s.pos
  else {
    const step = (s.pos - s.smooth) * (1 - Math.exp(-dt / GLIDE))
    s.smooth += Math.max(-MAX_RATE * dt, Math.min(MAX_RATE * dt, step))
    if (Math.abs(s.pos - s.smooth) < 1e-4) s.smooth = s.pos
  }
  // Redraw status box and LC view when the shown position changes (whole percent) or the focus moves
  const label = focusOf(s.smooth) + ' ' + SET.where() + SET.knob()
  if (label !== lastLabel) { lastLabel = label; SET.refresh?.() }
  return 0
}))

const SET = {
  state: setState,
  focus: () => focusOf(setState.smooth),
  // What the tracks get for their column 8: fog from the set state, Tension limited, no break
  glob: { bright: signal(() => setState.fog), space: g8.space, char: g8.char.mul(TENSION_MAX), level: g8.level,
    btn: g8.btn, btn2: off8 },
  where: () => {
    const { i, x } = where(setState.smooth), a = SET_TRACKS[i], b = SET_TRACKS[i + 1]
    const bpm = Math.round(bpmAt(setState.smooth) / a.slow)
    return x === 0 ? a.id + ' ' + a.name + ' · ' + bpm + ' BPM'
      : a.id + ' → ' + b.id + ' · ' + Math.round(x * 100) + ' % · ' + Math.round(bpmAt(setState.smooth)) + ' BPM'
  },
  knob: () => setState.mode ? 'Set (Fog bleibt bei ' + Math.round(setState.fog * 100) + ')' : 'Fog',
  statusLines: () => ['Set         ' + SET.where(), 'Fog-Knopf   ' + SET.knob()],
  // Header of the LC view: set position, bar in the phrase with the four beats, what the Fog knob does
  headHtml: esc => {
    const b = setState.beat
    const dots = [0, 1, 2, 3].map(k => '<i' + (b && b.beat === k ? ' class=on' : '') + '></i>').join('')
    return '<div><span class=k>Set</span>' + esc(SET.where()) + '</div>' +
      '<div><span class=k>Takt</span>' + (b ? (b.bar % b.phrase + 1) + ' / ' + b.phrase : '–') + '<span class=beats>' + dots + '</span></div>' +
      '<div><span class=k>Fog-Knopf</span>' + (setState.mode ? '<span class=next>' + esc(SET.knob()) + '</span>' : 'Fog') + '</div>'
  },
}

// ============================================================
// TRACK 007 — Ambient (from tracks/007/007-ambient-dual.strudel)
// ============================================================
// @007 layout Track 007 — ambient moods (two controllers)
// @007 note Dreamy ambient on D, about 70 BPM. Jojo plays the foundation (heartbeat, drone, bass and soft clicks), Jonas the colour (pad, chords, melodies) and the global column 8.
// @007 note Every row means the same everywhere: row 1 = brightness, row 2 = space, row 3 = character, fader = level, button 1 = next pattern (at the next bar, 3 per stem), button 2 = a moment while held.
// @007 note Start with all faders down. Nothing sounds until Jonas' master fader (column 8) is up.
// @007 note The status box at the bottom right of the Strudel page shows chapter, break and each stem's pattern. Its button “als Fenster” opens it as a small window that stays on top (Chrome/Edge).
// @007 mode B16 Jojo — Foundation (beat + bass)
// @007 col B16:1 1 Pulse
// @007 col B16:2 2 Sea / Wind
// @007 col B16:3 3 Drone
// @007 col B16:4 4 Bass
// @007 col B16:5 5 Rim
// @007 col B16:6 6 Ticks
// @007 col B16:7 7 Wood / Drops
// @007 col B16:8 8 Crackle
// @007 row B16:k1 Row 1 \ Brightness
// @007 row B16:k2 Row 2 \ Space
// @007 row B16:k3 Row 3 \ Character
// @007 row B16:fader Fader \ Level
// @007 row B16:b1 Button 1 \ Change
// @007 row B16:b2 Button 2 \ Moment
// @007 mode 16 Jonas — Colour (chords + melodies) · column 8 = global
// @007 col 16:1 1 Pad
// @007 col 16:2 2 Chords
// @007 col 16:3 3 Music Box
// @007 col 16:4 4 Whale
// @007 col 16:5 5 Choir
// @007 col 16:6 6 Glitter
// @007 col 16:7 7 Shimmer
// @007 col 16:8 8 Global
// @007 row 16:k1 Row 1 \ Brightness
// @007 row 16:k2 Row 2 \ Space
// @007 row 16:k3 Row 3 \ Character
// @007 row 16:fader Fader \ Level
// @007 row 16:b1 Button 1 \ Change
// @007 row 16:b2 Button 2 \ Moment
// @007 guide Playing together | Jojo builds the floor: drone and bass first, then the heartbeat, then the small clicks. Jonas colours it: pad and chords, then whale, choir and the sparkles on top.
// @007 guide Playing together | Jonas' column 8 acts on everything: Fog and Tension darken or open all filters, Room drowns everything in reverb, Chapter changes the key colour for both players at the next bar.
// @007 guide Playing together | Break: one press takes out the beat (pulse, bass, rim, ticks, wood) at the next bar; drone, crackle, sea and all of Jonas' sounds keep floating. The second press brings the beat back on the one.
// @007 guide Every position sounds good | No filter closes completely, and space 0 is dry but never silent. Row 2 at about the middle gives each sound the room it had in the original track.
const T007 = (() => {
const ID = 0
const PHRASE = phraseOf(SET_TRACKS[0])
const ORBIT0 = 0
const focusOnly = button => button.fmap(v => SET.focus() === ID ? v : 0)

const ramp = (sig, from, to) => sig.fmap(v => Math.min(1, Math.max(0, (v - from) / (to - from))))
// Row-3 crossfade: 0..0.5 brings the extra layer in, 0.5..1 fades the main layer out
const fadeMain  = knob => ramp(knob, 1, 0.5)
const fadeExtra = knob => ramp(knob, 0, 0.5)
// Exponential knob range for filters (Hz), so every part of the knob travel is audible
const expRange = (knob, lo, hi) => knob.fmap(v => lo * Math.pow(hi / lo, v))

const bpm  = 70
const beat = 60 / bpm   // seconds per quarter note, for delay times

// Mapping of column n (1-8): brightness, space, character (knob rows 1-3), fader, button rows 1-2
const colMap = (read, n) => ({ bright: read(12 + n), space: read(20 + n), char: read(28 + n), level: read(4 + n), btn: read(36 + n), btn2: read(44 + n) })
const off = () => signal(() => 0)
// Column 8 (global) is read from both its Mode 16 and Mode 2 CCs, last moved wins: it works on both pages even on a
// controller whose column 8 sends CC + 48 in Mode 2
// One controller: Jojo on the plain CCs (Mode 1), Jonas on CC + 48 (Mode 2)
const alone    = !ccJojo
const colJonas = n => n === 8 ? SET.glob : colMap(n === 8 ? c => lastMoved(ccJonas(c), ccJonas(c + 48)) : alone ? c => ccJonas(c + 48) : ccJonas, n)
const colJojo  = n => !alone ? colMap(ccJojo, n) : n === 8 ? colMap(off, n) : colMap(ccJonas, n)

const gate  = (cond, pat) => cond.fmap(on => on ? pat : silence).innerJoin()
const above = (sig, x) => sig.fmap(v => v > x)
const and   = (a, b) => a.fmap(x => y => x && y).appLeft(b)
const held  = button => button.fmap(v => v > 0.5)

// Stateful controls, collected so the master can query them every tick (see stateTaps)
const taps = []

// Two inputs for one control: the value follows whichever moved last (stateful, so it is queried via stateTaps)
const lastMoved = (a, b) => {
  let pa = null, pb = null, v = 0
  const pat = a.fmap(x => y => {
    if (pa === null) v = Math.max(x, y)
    else if (y !== pb) v = y
    else if (x !== pa) v = x
    pa = x; pb = y
    return v
  }).appLeft(b)
  taps.push(pat)
  return pat
}

// Momentary button that steps through n states, one step per press (counts presses, not the held value).
// onChange(state) runs on every step (for the status box). Re-evaluating the code starts again at 0.
const cycleButton = (button, n, onChange = () => {}) => {
  button = focusOnly(button)   // set: presses count only for the track in focus
  let prev = 0, state = 0
  const pat = button.fmap(v => {
    if (v > 0.5 && prev <= 0.5) { state = (state + 1) % n; onChange(state) }
    prev = v
    return state
  })
  taps.push(pat)
  return pat
}

// A value that a button sets now but that takes over only at the next bar line (chapter, break, change).
// at(t) is asked with bar starts in real time (outside any reseed shift); it remembers the previous value for
// queries that still reach back into the old bar. pat = the value per bar.
const barLatch = (len = 1) => {
  const l = { pending: 0, now: 0, prev: 0, bar: -Infinity }
  l.at = t => {
    const bar = Math.floor(Number(t) / len)
    if (bar > l.bar) {
      if (l.pending !== l.now) { l.prev = l.now; l.now = l.pending; showStatus() }
      else l.prev = l.now
      l.bar = bar
    }
    return bar >= l.bar ? l.now : l.prev
  }
  l.pat = signal(t => l.at(t)).segment(1)
  taps.push(l.pat)
  return l
}

// 0 → 1 over `cycles` while a button is held, back to 0 on release (for risers)
const heldRamp = (button, cycles) => {
  let start = null
  const pat = button.fmap(v => t => {
    if (v <= 0.5) { start = null; return 0 }
    start ??= t
    return Math.min(1, Math.max(0, (t - start) / cycles))
  }).appLeft(signal(t => Number(t)))
  taps.push(pat)
  return pat
}


// ============================================================
// MOODS — all on D, so a switch keeps the root and only the colour changes
// ============================================================
// Drone chords per mood (absolute notes, so each mood needs its own; the other stems use scale degrees).
// Whole tone has no fifth (D E F♯ G♯ A♯ C): its drones use tritones and major thirds instead.
const MOODS = [
  { scale: 'lydian', name: 'schwebend',   // D E F♯ G♯ A B C♯
    drones: ["[d1,a1]", "[d1,a1,e2]", "[g0,d1,a1]", "[d1,a1,c#2]", "[a0,e1,b1]", "[d1,g#1,a1]", "[e1,b1,f#2]", "[d1,d2,a2]"],
    names: ['D–A', 'D–A–E', 'G–D–A', 'D–A–C♯', 'A–E–B', 'D–G♯–A', 'E–B–F♯', 'D–D–A'] },
  { scale: 'dorian', name: 'melancholisch',   // D E F G A B C
    drones: ["[d1,a1]", "[d1,a1,e2]", "[g0,d1,a1]", "[d1,a1,c2]", "[a0,e1,b1]", "[d1,f1,a1]", "[e1,b1,g2]", "[d1,d2,a2]"],
    names: ['D–A', 'D–A–E', 'G–D–A', 'D–A–C', 'A–E–B', 'D–F–A', 'E–B–G', 'D–D–A'] },
  { scale: 'whole tone', name: 'seltsam',   // D E F♯ G♯ A♯ C
    drones: ["[d1,g#1]", "[d1,a#1,e2]", "[c1,f#1,d2]", "[d1,c2]", "[e1,a#1,d2]", "[d1,f#1,a#1]", "[g#0,d1,a#1]", "[d1,d2,g#2]"],
    names: ['D–G♯', 'D–A♯–E', 'C–F♯–D', 'D–C', 'E–A♯–D', 'D–F♯–A♯', 'G♯–D–A♯', 'D–D–G♯'] },
]

// Rows of the status box, filled by change(): { label, latch, n, names } per player
const STATUS = { jojo: [], jonas: [] }
const showStatus = () => {
  if (!statusUi || SET.focus() !== ID) return
  const dots = v => [...Array(8).keys()].map(k => k === v ? '●' : '○').join('')
  const show = (r, v) => !r.names ? String(v + 1) : typeof r.names === 'function' ? r.names(v) : r.names[v]
  const line = (r, i) => (i + 1) + ' ' + r.label.padEnd(10) + ' ' + (r.n === 8 ? dots(r.latch.now) + ' ' : '') +
    show(r, r.latch.now) + (r.latch.pending !== r.latch.now ? ' → ' + show(r, r.latch.pending) : '')
  const soon = l => l.pending !== l.now ? ' (nächster Takt)' : ''
  statusUi.text.textContent = [
    ...SET.statusLines(),
    'Kapitel     D ' + MOODS[moodLatch.now].name +
      (moodLatch.pending !== moodLatch.now ? ' → ' + MOODS[moodLatch.pending].name : '') + soon(moodLatch),
    '', alone ? 'Mode 1 · Jojo' : 'Jojo', ...STATUS.jojo.map(line),
    '', alone ? 'Mode 2 · Jonas' : 'Jonas', ...STATUS.jonas.map(line),
  ].join('\n')
  lcView?.update()
}
// Button 1 of a stem: n patterns (default 8), one step per press, taking over at the next bar
const change = (button, who, label, n = 8, names) => {
  const latch = barLatch()
  cycleButton(button, n, s => { latch.pending = s; showStatus() })
  STATUS[who].push({ label, latch, n, names })
  return latch
}

// ============================================================
// GLOBAL (Jonas, column 8) — acts on both controllers
// ============================================================
// @007 ctl g.k1 Fog | 0 = clear, up = every filter pulled down to ~6 %: distant, under water.
// @007 ctl g.k2 Room | 0 = each sound's own room (row 2), up = everything drowns in reverb.
// @007 ctl g.k3 Tension | 0–0.5: echo grows on all melodic stems, filters open. 0.5–1: + slow tape wobble on the long sounds. Back to 0 = release.
// @007 ctl g.fader Master Level | volume of everything, both controllers. 0 = silence.
// @007 ctl g.b1 Chapter | mood: floating → melancholic → strange, at the next bar.
// @007 ctl g.b2 Break / Drop | 1st: beat out. 2nd: all back on the one.
const glob          = colJonas(8)
const globalFog     = glob.bright.fmap(f => Math.pow(0.06, f))
const globalRoom    = glob.space
const tension       = glob.char
const tensionEcho   = ramp(tension, 0, 0.5).mul(0.5)     // delay send, 0..0.5
const tensionWobble = ramp(tension, 0.5, 1).mul(0.1)     // vibrato depth, 0..±0.1 semitones
// Factor on every lpf: fog darkens (down to 0.06), tension opens (up to 2.5)
const globalTone    = globalFog.fmap(f => o => f * o).appLeft(tension.fmap(t => 1 + 1.5 * t))
const globalLevel   = glob.level.range(0, 1)

const moodLatch  = barLatch(PHRASE)
cycleButton(glob.btn, MOODS.length, s => { moodLatch.pending = s; showStatus() })
const breakLatch = barLatch()
cycleButton(glob.btn2, 2, s => { breakLatch.pending = s; showStatus() })
const mood    = moodLatch.pat
const scaleIn = octave => mood.fmap(m => 'D' + octave + ':' + MOODS[m].scale)
// Jojo's beat stems, gated while the break is on
const beatOn  = breakLatch.pat.fmap(b => b === 0)
const beatOnly = pat => gate(beatOn, pat)

const audible = level => and(above(level, 0), above(globalLevel, 0))
// lpf × fog/tension, capped below Nyquist
const toned  = lpf => lpf.fmap(f => g => Math.min(18000, f * g)).appLeft(globalTone)
// Reverb send: the stem's space knob (0..0.9), raised by the global Room up to 0.95
const roomOf = space => space.fmap(s => g => { const r = 0.9 * s; return r + (0.95 - r) * g }).appLeft(globalRoom)
// Tension wobble: a slow, shallow vibrato (old tape), only set while it is > 0 (a vibrato oscillator per note costs CPU).
// Only on the long sounds; on bells and the music box any wobble sounds out of tune.
const wobble = pat => above(tensionWobble, 0).fmap(on => on ? pat.vib(0.15).vibmod(tensionWobble) : pat).innerJoin()
// Change: read the stem's randomness 1024 cycles further per step (keeps bar alignment, new random values).
// Scales are applied after reseed, so the mood follows real time.
const reseed = (latch, pat) => pat.early(latch.pat.fmap(v => v * 1024))

// Effect buses. Each orbit has one reverb and one delay, and every reverb costs a lot of CPU (its length is
// the room size in seconds), so the stems share two orbits; stems on one orbit share room size and echo time/feedback.
// Orbit 1 = pulse, drone, bass, crackle, sea/wind, music box, whale, choir (dotted-quarter echo).
// Orbit 2 = rim, ticks, wood, pad, chords, glitter, shimmer (dotted-8th echo).
const BUSES = {
  1: { hall: 6.5, time: beat * 1.5, feedback: 0.5 },
  2: { hall: 6, time: beat * 0.75, feedback: 0.6 },
}
// bus(): reverb from the space knob, and echo: the layer's own delay amount (or `echo` if it has none) × 2 × space,
// so space 0.5 = the original amount; Tension's echo takes over where it is larger.
const bus = (pat, orbit, space, echo = 0) => pat
  .fmap(v => sc => e => ({ ...v, delay: Math.max(Math.min(0.9, (v.delay ?? echo) * sc), e) }))
  .appLeft(space.fmap(s => 2 * s)).appLeft(tensionEcho)
  .room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)
  .delaytime(BUSES[orbit].time).delayfeedback(BUSES[orbit].feedback)
// Reverb only, no echo (low end and the pulse would smear)
const dryBus = (pat, orbit, space) => pat.room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)

// Channel strip: lpf × fog/tension (if given), level × master as postgain, gated while the fader or master is 0
const strip = (stem, { lpf, level }) => {
  const pat = lpf === undefined ? stem : stem.lpf(toned(lpf))
  return gate(audible(level), pat.postgain(level.mul(globalLevel)))
}

// ============================================================
// JOJO 1 PULSE — a soft kick on D, the heartbeat. No echo.
// ============================================================
// Drive picks the sound:
//   soft   = a plain sine (no click, no noise) that fades in over 15 ms and glides 4 semitones down into D
//   medium = synth bass drum (triangle + pitch drop + short noise click + light saturation), 8-semitone drop
//   firm   = the same with a 12-semitone drop: more punch and click
// @007 ctl B16:1.k1 Brightness | dull thump ↔ clicky attack (lpf 180–1500 Hz).
// @007 ctl B16:1.k2 Space | dry and close ↔ far away in a big room (reverb).
// @007 ctl B16:1.k3 Drive | three steps: soft sine thump → synth kick → firm kick with more click.
// @007 ctl B16:1.fader Level | 0 = gone. A heartbeat thump on D.
// @007 ctl B16:1.b1 Change | heartbeat → quarters → half notes.
// @007 ctl B16:1.b2 Drop out | pulse pauses while held.
const pulse       = colJojo(1)
const pulseRhythm = change(pulse.btn, 'jojo', 'Puls', 3, ['Herzschlag', 'Viertel', 'Halbe'])
const pulseDrive  = pulse.char.fmap(d => d < 1 / 3 ? 0 : d < 2 / 3 ? 1 : 2)
const PULSE_GAINS = ["[1 0.55 ~ ~]*4", "0.9*4", "1 ~ 1 ~"]   // heartbeat, quarters, half notes
const PULSE_SOUNDS = [
  g => gain(g).s("sine").note("d2").attack(0.015).decay(0.45).sustain(0).release(0.15).penv(-4).pattack(0.08),   // soft
  g => gain(g).mul(gain(0.4)).s("sbd").note("d2").decay(0.45).penv(8).pdecay(0.06),    // medium (× 0.4: as loud as soft)
  g => gain(g).mul(gain(0.4)).s("sbd").note("d2").decay(0.45).penv(12).pdecay(0.06),   // firm
]
const PULSES = PULSE_SOUNDS.map(sound => PULSE_GAINS.map(sound))   // PULSES[drive][rhythm], built once

const stemJ1_pulse = beatOnly(gate(pulse.btn2.fmap(v => v <= 0.5), strip(dryBus(
  pulseDrive.fmap(d => pulseRhythm.pat.fmap(r => PULSES[d][r]).innerJoin()).innerJoin(), 1, pulse.space), {
  lpf: expRange(pulse.bright, 180, 1500),
  level: pulse.level.range(0, 0.95),   // was 1; mix: pulse −5 dB under the pad
})))

// ============================================================
// JOJO 2 SEA / WIND — noise: rolling waves ↔ whistling gusts
// ============================================================
// @007 ctl B16:2.k1 Brightness | 0 = soft rumble ↔ airy hiss (lpf 700–12000 Hz, moves with the waves).
// @007 ctl B16:2.k2 Space | dry ↔ far away (reverb).
// @007 ctl B16:2.k3 Sea ↔ Wind | 0 = brown-noise waves rolling in, 0.5 = both, 1 = only whistling wind gusts.
// @007 ctl B16:2.fader Level | sea and wind. Keeps playing in the break.
// @007 ctl B16:2.b1 Change | next of 3 random wave / gust patterns.
// @007 ctl B16:2.b2 Riser | a noise sweep rises over 2 bars while held.
const wind     = colJojo(2)
const windVar  = change(wind.btn, 'jojo', 'Meer/Wind', 3)
const windMix  = wind.char
const windLpf  = toned(expRange(wind.bright, 700, 12000))
const windRise = heldRamp(wind.btn2, 2)

// Waves: a swell every half bar, sometimes skipped, each with its own length; the lpf breathes with them
const sea = s("brown*2").degradeBy(0.25)
  .attack(rand.range(0.6, 1.6)).sustain(0.8).release(rand.range(1.5, 3))
  .lpf(windLpf.mul(sine.slow(3).range(0.35, 1)))
  .pan(rand.range(0.2, 0.8)).gain(6)   // brown noise is ~23 dB quieter than white at the same gain
// Wind: overlapping 8th gusts through a resonant bandpass that wanders, so it whistles and moves
const gusts = s("pink*8")
  .attack(0.3).sustain(0.7).release(0.8)
  .bpf(sine.slow(7).add(rand.mul(0.15)).range(400, 2200)).bpq(rand.range(2, 7))
  .lpf(windLpf)
  .pan(sine.slow(4)).gain(perlin.range(6, 38).mul(wind.bright.fmap(b => Math.pow(0.22, b))))
  // pink noise through a narrow bandpass needs a lot of gain; less as brightness opens the lpf, so it stays even
// Riser: 16th noise bursts through a bandpass that climbs from 300 Hz to 6 kHz, getting louder
const riser = gate(held(wind.btn2), s("pink*16")
  .attack(0.03).sustain(0.8).release(0.15)
  .bpf(windRise.fmap(r => 300 * Math.pow(20, r))).bpq(4)
  .gain(windRise.mul(1.6)).pan(sine.fast(2)))

const stemJ2_wind = strip(bus(stack(
  reseed(windVar, stack(
    gate(above(fadeMain(windMix), 0), sea.mul(gain(fadeMain(windMix)))),
    gate(above(fadeExtra(windMix), 0), gusts.mul(gain(fadeExtra(windMix))))
  )),
  riser
), 1, wind.space), {
  level: wind.level.range(0, 0.68),   // was 1; mix: sea/wind −10 dB
})

// ============================================================
// JOJO 3 DRONE — low fifths that breathe in and out once per bar
// ============================================================
// @007 ctl B16:3.k1 Brightness | pure and dark ↔ open, the overtones come through (lpf 120–4000 Hz).
// @007 ctl B16:3.k2 Space | dry ↔ far away (reverb).
// @007 ctl B16:3.k3 Beating | 0 = pure sines. Up = a detuned saw copy fades in, the two beat against each other (slow “wah-wah”).
// @007 ctl B16:3.fader Level | slow drone chords on D.
// @007 ctl B16:3.b1 Change | 3 drone chords per chapter: D–A → D–A–E → G–D–A.
const drone      = colJojo(3)
const droneVar   = change(drone.btn, 'jojo', 'Drone', 3, i => MOODS[moodLatch.now].names[i])
const droneBeat  = drone.char
const DRONES     = MOODS.map(m => m.drones.map(d => note(d)))
// Chord = mood (per bar) × change
const droneChord = mood.fmap(m => droneVar.pat.fmap(i => DRONES[m][i]).innerJoin()).innerJoin()

const stemJ3_drone = strip(bus(wobble(stack(
  // Body: swells in over a bar, octave answer on the second half
  droneChord.s("sine").attack(1.5).decay(1).sustain(0.7).release(3).gain(0.7),
  droneChord.add(note(12)).s("triangle").late(0.5).attack(1).sustain(0.5).release(2.5).gain(0.25),
  // Beating: same chord, detuned by up to a quarter tone
  gate(above(droneBeat, 0), droneChord.add(note(droneBeat.mul(0.3))).s("sawtooth")
    .attack(1.5).sustain(0.6).release(3).gain(droneBeat.mul(0.18)))
)), 1, drone.space), {
  lpf: expRange(drone.bright, 120, 4000),
  level: drone.level.range(0, 1.15),   // was 1; mix: drone −2 dB
})

// ============================================================
// JOJO 4 BASS — a soft sub bass on the mood's scale, mostly the root. No echo, no wobble (both smear the low end).
// ============================================================
// @007 ctl B16:4.k1 Brightness | round and dark ↔ the saw's buzz comes through (lpf 80–2000 Hz).
// @007 ctl B16:4.k2 Space | dry ↔ far away (reverb).
// @007 ctl B16:4.k3 Groove | 0 = a soft swell every bar. Up to 0.5 a 3-3-2 pulse fades in, at 1 only the pulse.
// @007 ctl B16:4.fader Level | slow bass swells.
// @007 ctl B16:4.b1 Change | next of 3 bass lines (a note every 2 bars).
// @007 ctl B16:4.b2 Octave | one octave up while held.
const bassCol  = colJojo(4)
const bassVar  = change(bassCol.btn, 'jojo', 'Bass', 3)
const bassMix  = bassCol.char
const bassOct  = bassCol.btn2.fmap(v => v > 0.5 ? 12 : 0)
// Scale degrees, weighted to the root; a new note every 2 bars
const BASS_DEGREES = [0, 0, 0, 4, 3, 5, -2, 1]
const bassNote = reseed(bassVar, irand(BASS_DEGREES.length).segment(1).slow(2).fmap(i => n(BASS_DEGREES[i])).innerJoin())

// Swell, re-struck every bar (the mood can change there): sine sub (octave 1)
// + a quiet saw an octave up, so it is audible on small speakers too
const bassHeld = stack(
  bassNote.scale(scaleIn(1)).s("sine").attack(0.8).sustain(0.9).release(2).gain(0.6),
  bassNote.scale(scaleIn(2)).s("sawtooth").attack(0.8).sustain(0.7).release(2).gain(0.1)
)
// Pulse: the same notes as soft plucks in a 3-3-2 rhythm on 8ths
const bassPulse = stack(
  bassNote.struct("x ~ ~ x ~ ~ x ~").scale(scaleIn(1)).s("sine").decay(0.4).sustain(0.2).release(0.3).gain(0.6),
  bassNote.struct("x ~ ~ x ~ ~ x ~").scale(scaleIn(2)).s("sawtooth").decay(0.25).sustain(0).release(0.2).gain(0.1)
)

const stemJ4_bass = beatOnly(strip(dryBus(stack(
  gate(above(fadeMain(bassMix), 0), bassHeld.mul(gain(fadeMain(bassMix)))),
  gate(above(fadeExtra(bassMix), 0), bassPulse.mul(gain(fadeExtra(bassMix))))
).add(note(bassOct)), 1, bassCol.space), {
  lpf: expRange(bassCol.bright, 80, 2000),
  level: bassCol.level.range(0, 0.94),   // was 1; mix: bass −5 dB
}))

// ============================================================
// JOJO 5 RIM — a soft rim click on the backbeat: a short triangle blip + a breath of noise
// ============================================================
// @007 ctl B16:5.k1 Brightness | soft and far ↔ sharp crack (lpf 1.2–12 kHz).
// @007 ctl B16:5.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl B16:5.k3 Ghost notes | plain ↔ extra quiet clicks in between.
// @007 ctl B16:5.fader Level | soft rim click on 2 and 4.
// @007 ctl B16:5.b1 Change | backbeat → late ghost → offset click.
// @007 ctl B16:5.b2 Roll | 16th roll, growing over the bar, while held.
const rim      = colJojo(5)
const rimVar   = change(rim.btn, 'jojo', 'Rim', 3)
const rimGhost = rim.char
const RIMS = ["~ 0.5 ~ 0.5", "~ 0.5 ~ [0.5 ~ ~ 0.3]", "~ [~ 0.5] ~ 0.5", "~ 0.5 ~ ~", "[~ 0.3] 0.5 ~ 0.5",
  "~ 0.5 [~ 0.3] 0.5", "~ ~ 0.5 ~", "~ 0.5 ~ <0.5 [0.5 0.3]>"].map(g => gain(g))
const rimHits = stack(
  rimVar.pat.fmap(i => RIMS[i]).innerJoin(),
  gate(above(rimGhost, 0), reseed(rimVar, gain(rand.range(0.08, 0.18)).struct("x*16")
    .degradeBy(rimGhost.fmap(g => 1 - 0.4 * g)))),
  gate(held(rim.btn2), gain(saw.range(0.1, 0.45)).struct("x*16"))
)
const rimSound = stack(
  rimHits.s("triangle").note("a5").decay(0.045).sustain(0),
  rimHits.s("white").decay(0.012).sustain(0).hpf(2500).mul(gain(0.5))
)

const stemJ5_rim = beatOnly(strip(bus(rimSound.pan(0.45), 2, rim.space, 0.25), {
  lpf: expRange(rim.bright, 1200, 12000),
  level: rim.level.range(0, 2.2),   // was 1; mix: rim −13 dB (was barely audible)
}))

// ============================================================
// JOJO 6 TICKS — a clock: tick-tock on 8ths, FM sine (metallic), tick left, tock right
// ============================================================
// @007 ctl B16:6.k1 Brightness | soft tick ↔ crisp and sharp (lpf 3–16 kHz).
// @007 ctl B16:6.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl B16:6.k3 Density | 8ths ↔ + 16ths ↔ + little flutters.
// @007 ctl B16:6.fader Level | clock ticks.
// @007 ctl B16:6.b1 Change | next of 3 random accent / 16th patterns.
// @007 ctl B16:6.b2 Open | ticks ring long while held.
const ticks    = colJojo(6)
const tickVar  = change(ticks.btn, 'jojo', 'Ticken', 3)
const tickDens = ticks.char
const tickOpen = ticks.btn2.fmap(v => v > 0.5 ? 0.35 : 0.035)   // decay in seconds

const stemJ6_ticks = beatOnly(strip(bus(reseed(tickVar, stack(
  note("[d7 a6]*4").degradeBy(0.1).gain(rand.range(0.15, 0.3)).pan("[0.35 0.65]*4"),
  gate(above(tickDens, 0), note("[~ e7]*8").degradeBy(0.3).gain(ramp(tickDens, 0, 0.5).mul(0.2)).pan(rand.range(0.3, 0.7))),
  gate(above(tickDens, 0.6), note("a7*32").degradeBy(0.8).gain(ramp(tickDens, 0.6, 1).mul(0.12)).pan(rand))
)).s("sine").fm(2.5).fmh(2.7).decay(tickOpen).sustain(0), 2, ticks.space, 0.3), {
  lpf: expRange(ticks.bright, 3000, 16000),
  level: ticks.level.range(0, 5.7),   // was 1; mix: ticks −15 dB (were inaudible at brightness 0)
}))

// ============================================================
// JOJO 7 WOOD / DROPS — random clicks on a 16th grid; some glide up into their note like water drops
// ============================================================
// @007 ctl B16:7.k1 Brightness | woody (pure sine blip) ↔ metallic (FM).
// @007 ctl B16:7.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl B16:7.k3 Density | a click now and then ↔ a busy pattern.
// @007 ctl B16:7.fader Level | wood clicks and drops.
// @007 ctl B16:7.b1 Change | next of 3 random patterns.
// @007 ctl B16:7.b2 Fill | almost every 16th plays while held.
const wood     = colJojo(7)
const woodVar  = change(wood.btn, 'jojo', 'Holz', 3)
const woodKeep = wood.char.fmap(d => f => f > 0.5 ? 0.85 : 0.06 + 0.5 * d).appLeft(wood.btn2)   // share of 16ths

const stemJ7_wood = beatOnly(strip(bus(reseed(woodVar,
  n(irand(5).segment(16))
    .degradeBy(woodKeep.fmap(k => 1 - k))
    .sometimesBy(0.4, x => x.penv(-9).pattack(0.04))   // drops: glide up into the note
    .decay(rand.range(0.05, 0.14)).sustain(0)
    .gain(rand.range(0.2, 0.4)).pan(rand)
).scale(scaleIn(5)).s("sine").fm(wood.bright.mul(4)).fmh(2.76), 2, wood.space, 0.4), {
  lpf: pure(9000),
  level: wood.level.range(0, 1.7),   // was 1; mix: wood −13 dB
}))

// ============================================================
// JOJO 8 CRACKLE — vinyl dust: very short noise clicks on a 32nd grid
// ============================================================
// @007 ctl B16:8.k1 Brightness | 0 = soft crackle ↔ bright sizzle (lpf 5–16 kHz).
// @007 ctl B16:8.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl B16:8.k3 Density | a little dust ↔ heavy crackle.
// @007 ctl B16:8.fader Level | crackle, vinyl dust. Keeps playing in the break.
// @007 ctl B16:8.b1 Change | next of 3 random crackle patterns.
// @007 ctl B16:8.b2 Double | twice as much crackle while held.
const dust     = colJojo(8)
const dustVar  = change(dust.btn, 'jojo', 'Knistern', 3)
const dustKeep = dust.char.fmap(d => dbl => Math.min(0.9, (0.04 + 0.4 * d) * (dbl > 0.5 ? 2 : 1))).appLeft(dust.btn2)

const stemJ8_dust = strip(bus(reseed(dustVar,
  s("white*32").degradeBy(dustKeep.fmap(k => 1 - k))
    .decay(rand.range(0.002, 0.015)).sustain(0)
    .gain(rand.range(0.2, 1.2)).pan(rand)
).hpf(900), 1, dust.space, 0.15), {
  lpf: expRange(dust.bright, 5000, 16000),
  level: dust.level.range(0, 1.7),   // was 1; mix: crackle −16 dB
})

// ============================================================
// JONAS 1 PAD — slow random chords from the mood's scale
// ============================================================
// @007 ctl 16:1.k1 Brightness | muffled ↔ open and airy (lpf 300–8000 Hz).
// @007 ctl 16:1.k2 Space | dry and close ↔ far away in a big room (reverb + echo).
// @007 ctl 16:1.k3 Swell | 0 = still, held chords. Up = the chord is re-struck every half bar and breathes in and out.
// @007 ctl 16:1.fader Level | long floating chords.
// @007 ctl 16:1.b1 Change | 3 chord progressions: calm → circling → open.
// @007 ctl 16:1.b2 Freeze | holds the current chord while held.
const pad      = colJonas(1)
const padVar   = change(pad.btn, 'jonas', 'Pad', 3, ['I–IV', 'I–iii–IV–ii', 'I–vi–IV–vii'])
const padSwell = pad.char
// Scale-degree chords (stacked thirds on degrees 1, 2, 3, 4, 6, 7 of the mood's scale)
const PADS = ["[0,2,4,6]", "[1,3,5,8]", "[2,4,6,8]", "[3,5,7,9]", "[5,7,9,11]", "[6,8,10,12]"].map(c => n(c))
// Freeze: while the button is held, keep returning the chord index that was playing when it was pressed
const freeze = (button, pat) => {
  let kept = null
  return pat.fmap(v => b => b > 0.5 ? (kept ??= v) : (kept = null, v)).appLeft(button)
}
// Progressions as indices into PADS, one chord per 2 bars
const PAD_PROGS = [[0, 0, 3, 3], [0, 2, 3, 1], [0, 4, 3, 5]].map(p => cat(...p).slow(2))
const padChord = freeze(pad.btn2, padVar.pat.fmap(i => PAD_PROGS[i]).innerJoin()).fmap(i => PADS[i]).innerJoin()

const padStill = stack(
  padChord.scale(scaleIn(3)).s("sawtooth").attack(1.2).sustain(0.8).release(3).gain(0.22)
    .pan(sine.slow(5).range(0.3, 0.7)),
  padChord.scale(scaleIn(3)).s("triangle").attack(0.8).sustain(0.8).release(3).gain(0.35)
)
const padBreath = padChord.struct("x*2").scale(scaleIn(3)).s("sawtooth,triangle")
  .attack(0.9).decay(1).sustain(0.15).release(1.2).gain(0.25).pan(sine.slow(5).range(0.3, 0.7))

const stemN1_pad = strip(bus(wobble(stack(
  gate(above(fadeMain(padSwell), 0), padStill.mul(gain(fadeMain(padSwell)))),
  gate(above(fadeExtra(padSwell), 0), padBreath.mul(gain(fadeExtra(padSwell))))
)), 2, pad.space), {
  lpf: expRange(pad.bright, 300, 8000),
  level: pad.level.range(0, 0.79),   // was 1; mix: pad = reference, −14 LUFS at swell 0.5
})

// ============================================================
// JONAS 2 CHORDS — the pad's chord an octave higher, pinging in a Euclid rhythm with echoes
// ============================================================
// @007 ctl 16:2.k1 Brightness | warm ↔ bright, glassy (lpf 400–10000 Hz).
// @007 ctl 16:2.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl 16:2.k3 Length | long ringing chords ↔ short, choppy stabs.
// @007 ctl 16:2.fader Level | soft chord pings over the pad (same chords as the pad).
// @007 ctl 16:2.b1 Change | sparse (2 in 8) → medium (3 in 8) → busy (5 in 8).
// @007 ctl 16:2.b2 Stab | chord stabs on every 8th while held.
const chords    = colJonas(2)
const chordVar  = change(chords.btn, 'jonas', 'Akkorde', 3, ['selten', 'mittel', 'dicht'])
const chordLen  = chords.char.fmap(c => 2 * Math.pow(0.06, c))   // decay seconds: 2 ↔ 0.12; ~0.5 = the original ping
const CHORD_RHYTHMS = ["x(2,8,3)", "x(3,8,2)", "x(5,8,1)"]
const CHORD_PATS = CHORD_RHYTHMS.map(r => padChord.struct(r))

const stemN2_chords = strip(bus(stack(
  chordVar.pat.fmap(i => CHORD_PATS[i]).innerJoin().scale(scaleIn(4)).s("triangle")
    .decay(chordLen).sustain(0).release(chordLen).gain(0.35).delay(0.5),
  gate(held(chords.btn2), padChord.struct("x*8").scale(scaleIn(4)).s("triangle")
    .decay(0.15).sustain(0).release(0.1).gain(0.35))
), 2, chords.space), {
  lpf: expRange(chords.bright, 400, 10000),
  level: chords.level.range(0, 1.22),   // was 1; mix: chords −4 dB
})

// ============================================================
// JONAS 3 MUSIC BOX — a slow 8th arpeggio that randomly leaps an octave
// ============================================================
// @007 ctl 16:3.k1 Brightness | soft plucks ↔ sharp, sparkling (lpf 1.5–14 kHz).
// @007 ctl 16:3.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl 16:3.k3 Density | a few notes of the tune ↔ every 8th plays.
// @007 ctl 16:3.fader Level | slow music box.
// @007 ctl 16:3.b1 Change | up and down → rising → lullaby.
// @007 ctl 16:3.b2 Octave | one octave up while held.
const box     = colJonas(3)
const boxVar  = change(box.btn, 'jonas', 'Spieluhr', 3, ['auf und ab', 'steigend', 'Wiegenlied'])
const boxKeep = box.char.fmap(d => 0.3 + 0.7 * d)
const boxOct  = box.btn2.fmap(v => v > 0.5 ? 12 : 0)
const BOX_TUNES = [
  "<[0 2 4 6 7 6 4 2] [1 3 5 8 7 5 3 1] [2 4 6 8 9 8 6 4] [-1 1 3 5 4 3 1 -1]>",
  "<[0 2 4 6 7 9 11 14] [1 3 5 7 8 10 12 15] [-1 1 3 5 6 8 10 13] [0 2 4 7 9 11 14 ~]>",
  "<[4 ~ 2 ~ 0 ~ 2 4] [5 ~ 4 ~ 2 ~ 0 ~] [4 ~ 2 ~ 0 ~ 2 4] [1 ~ 2 ~ 0 ~ ~ ~]>",
].map(t => n(t))

const stemN3_box = strip(bus(reseed(boxVar,
  boxVar.pat.fmap(i => BOX_TUNES[i]).innerJoin()
    .sometimesBy(0.25, x => x.add(n(7)))
    .degradeBy(boxKeep.fmap(k => 1 - k))
    .s("sine").fm(0.8).fmh(5)
    .decay(0.6).sustain(0).release(0.6)
    .gain(rand.range(0.2, 0.35)).pan(sine.slow(6).range(0.3, 0.7))
    .delay(0.35)
).scale(scaleIn(4)).add(note(boxOct)), 1, box.space), {
  lpf: expRange(box.bright, 1500, 14000),
  level: box.level.range(0, 2.0),   // was 1; mix: music box −8 dB
})

// ============================================================
// JONAS 4 WHALE — the lead: slow calls that glide into their note
// ============================================================
// @007 ctl 16:4.k1 Brightness | soft and round ↔ clear and nasal (lpf 300–6000 Hz).
// @007 ctl 16:4.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl 16:4.k3 Glide | how far each call slides into its note: 0 = ±2 semitones, 1 = ±12 (deep, eerie bends).
// @007 ctl 16:4.fader Level | whale calls, about two in three bars.
// @007 ctl 16:4.b1 Change | rare → normal → conversation (more calls).
// @007 ctl 16:4.b2 Echo throw | long echo on the calls while held.
const whale      = colJonas(4)
const whaleVar   = change(whale.btn, 'jonas', 'Wal', 3, ['selten', 'normal', 'Gespräch'])
const whaleDepth = whale.char.fmap(c => 2 + 10 * c)
// Call grid and share left out: rare, normal (about two calls in three bars), conversation (half notes)
const WHALE_CALLS = [[1, 0.65], [1, 0.35], [2, 0.3]].map(([per, drop]) => n(irand(7).segment(per)).degradeBy(drop))
const throwEcho  = (pat, button) => pat.fmap(v => b => b > 0.5 ? { ...v, delay: 0.85 } : v).appLeft(button)

const stemN4_whale = strip(throwEcho(bus(reseed(whaleVar,
  whaleVar.pat.fmap(i => WHALE_CALLS[i]).innerJoin()
    .s("<sine triangle>")
    .penv(rand.range(-1, 1).mul(whaleDepth)).pattack(rand.range(0.8, 2.2)).prelease(2)
    .vib(rand.range(3, 6)).vibmod(0.12)
    .attack(0.8).sustain(0.8).release(2.5)
    .gain(0.45).pan(rand.range(0.25, 0.75))
    .delay(0.4)
).scale(scaleIn(3)), 1, whale.space), whale.btn2), {
  lpf: expRange(whale.bright, 300, 6000),
  level: whale.level.range(0, 1.37),   // was 1; mix: whale −6 dB
})

// ============================================================
// JONAS 5 CHOIR — the answer: breathy “aah/ooh” voices on half notes
// ============================================================
// @007 ctl 16:5.k1 Brightness | hushed ↔ clear (lpf 500–10000 Hz).
// @007 ctl 16:5.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl 16:5.k3 Voices | 0 = one voice, 0.5 = + a third above, 1 = + a fifth: three-part harmony.
// @007 ctl 16:5.fader Level | choir voices.
// @007 ctl 16:5.b1 Change | middle → low → high register (new melody each time).
// @007 ctl 16:5.b2 Full choir | all three voices while held.
const choir       = colJonas(5)
const choirVar    = change(choir.btn, 'jonas', 'Chor', 3, ['mittel', 'tief', 'hoch'])
const choirScale  = choirVar.pat.fmap(i => [scaleIn(4), scaleIn(3), scaleIn(5)][i]).innerJoin()
const choirVoices = choir.char.fmap(c => b => b > 0.5 ? 1 : c).appLeft(choir.btn2)

// One voice: a saw through a vowel filter (vowel per note: a, o, u, e). The vowel filter is 5 band-passes per
// note, the most expensive part of the track, so only the lead voice gets a slightly detuned second saw (chorus).
const choirVoice = (deg, g, detuned = false) => {
  const v = reseed(choirVar, n(irand(5).segment(2).mul(2).add(deg))).scale(choirScale)
  return (detuned ? v.superimpose(x => x.add(note(0.12))) : v)
    .s("sawtooth").vowel("<a o u e>/2")
    .attack(0.7).sustain(0.8).release(1.8)
    .gain(g)
}

const stemN5_choir = strip(bus(wobble(stack(
  choirVoice(0, 0.2, true),
  gate(above(choirVoices, 0), choirVoice(2, ramp(choirVoices, 0, 0.5).mul(0.21))),
  gate(above(choirVoices, 0.5), choirVoice(4, ramp(choirVoices, 0.5, 1).mul(0.17)))
)), 1, choir.space), {
  lpf: expRange(choir.bright, 500, 10000),
  level: choir.level.range(0, 1.0),   // was 1; mix: choir −2 dB
})

// ============================================================
// JONAS 6 GLITTER — a real glockenspiel (General MIDI soundfont) struck at random on a 16th grid: metal bars that ring
// out, random notes of the mood's scale (without the 4th and 7th degree, the sharpest ones), long echoes
// ============================================================
// @007 ctl 16:6.k1 Brightness | soft mallets ↔ bright metal (lpf 3–16 kHz).
// @007 ctl 16:6.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl 16:6.k3 Density | a drop now and then (~1 per bar) ↔ a sparkling rain (~70 % of the 16ths).
// @007 ctl 16:6.fader Level | random glockenspiel notes.
// @007 ctl 16:6.b1 Change | high → very high → middle register.
// @007 ctl 16:6.b2 Run | runs up and down the scale, denser and louder the longer it is held (full after 2 bars).
const glit     = colJonas(6)
const glitVar  = change(glit.btn, 'jonas', 'Glitzer', 3, ['hoch', 'sehr hoch', 'mittel'])
const glitKeep = glit.char.fmap(d => 0.06 + 0.64 * d)   // share of 16ths
const glitScale = glitVar.pat.fmap(i => [scaleIn(5), scaleIn(6), scaleIn(4)][i]).innerJoin()
const GLIT_TONES = [0, 1, 2, 4, 5, 7, 8, 9, 11]   // scale degrees over 1.5 octaves, without the 4th and 7th
const glitTone  = k => irand(GLIT_TONES.length).segment(k).fmap(i => GLIT_TONES[i])
const glitRise  = heldRamp(glit.btn2, 2)                 // 0 → 1 over 2 bars while held
// Every bar keeps ringing after the next is struck (a metal bar, no damper)
const glock = pat => pat.s("gm_glockenspiel").release(1.2)
// A player's sweep: up and down GLIT_TONES in 32nds
const GLIT_RUN = n("[0 1 2 4 5 7 8 9 11 9 8 7 5 4 2 1]*2")

const stemN6_glitter = strip(bus(stack(
  reseed(glitVar, glock(n(glitTone(16))
    .degradeBy(glitKeep.fmap(k => 1 - k)))
    .gain(rand.range(0.15, 0.4))
    .pan(rand)
    .delay(0.55)),
  // Run: starts as a few scattered notes of the sweep and fills in over 2 bars (15 % → 90 % of the 32nds), getting
  // louder; random velocities keep it played, not ticking. Released = gone.
  gate(held(glit.btn2), glock(GLIT_RUN.degradeBy(glitRise.fmap(r => 0.85 - 0.75 * r)))
    .gain(glitRise.fmap(r => v => (0.2 + 0.3 * r) * v).appLeft(rand.range(0.7, 1)))
    .pan(sine.fast(2).range(0.3, 0.7)).delay(0.4))
).scale(glitScale), 2, glit.space), {
  lpf: expRange(glit.bright, 3000, 16000),
  level: glit.level.range(0, 0.6),   // was 1; mix: glockenspiel −12 dB under the pad
})

// ============================================================
// JONAS 7 SHIMMER — high tones that swell in slowly and hang in the air
// ============================================================
// @007 ctl 16:7.k1 Brightness | dark whoosh ↔ bright shimmer (lpf 1.5–14 kHz).
// @007 ctl 16:7.k2 Space | dry ↔ far away (reverb + echo).
// @007 ctl 16:7.k3 Amount | subtle (one tone) ↔ wild (a bell-like chord with long echoes).
// @007 ctl 16:7.fader Level | shimmer swells.
// @007 ctl 16:7.b1 Change | a new tone every 2 bars → every 4 bars → every bar.
// @007 ctl 16:7.b2 Rise | while held, a cloud of tones climbs an octave and grows denser over 2 bars.
const fx       = colJonas(7)
const fxVar    = change(fx.btn, 'jonas', 'Schimmer', 3, ['2 Takte', '4 Takte', '1 Takt'])
const fxAmount = fx.char
const fxRise   = heldRamp(fx.btn2, 2)
const FX_NOTES = [2, 4, 1].map(len => n(irand(7).segment(1).slow(len)))   // scale degree, a new one every len bars
const fxNotes  = reseed(fxVar, fxVar.pat.fmap(i => FX_NOTES[i]).innerJoin())

const stemN7_shimmer = strip(bus(stack(
  wobble(fxNotes.scale(scaleIn(5)).s("triangle")
    .attack(2.5).sustain(0.7).release(4).gain(0.18).pan(sine.slow(9).range(0.2, 0.8))),
  gate(above(fxAmount, 0), wobble(stack(fxNotes.add(n(2)), fxNotes.add(n(4))).scale(scaleIn(5)).s("sine")
    .fm(fxAmount.mul(2)).fmh(2).attack(1.5).sustain(0.6).release(4)
    .gain(fxAmount.mul(0.14)).pan(sine.slow(7)).delay(0.6))),
  // Rise: random tones around the current note that climb an octave and thicken from a few to most 16ths over 2 bars;
  // loose timing (nudge), own level and length per tone, so it swells like a cloud, not a machine
  gate(held(fx.btn2), n(irand(5).segment(16)).add(fxNotes).add(n(fxRise.fmap(r => Math.floor(7 * r))))   // 16th grid first: add keeps the left structure
    .degradeBy(fxRise.fmap(r => 0.85 - 0.6 * r))
    .scale(scaleIn(5)).s("triangle").nudge(rand.range(0, 0.04))
    .attack(0.02).decay(rand.range(0.2, 0.7)).sustain(0).release(0.4)
    .gain(fxRise.fmap(r => 0.08 + 0.3 * r)).mul(gain(rand.range(0.5, 1)))
    .pan(rand).delay(0.6))
), 2, fx.space), {
  lpf: expRange(fx.bright, 1500, 14000),
  level: fx.level.range(0, 1.86),   // was 1; mix: shimmer −10 dB
})


// What the LC view shows for this track: the chapter (now, next) on column 8 button 1, and extra lines at the top
const lcChapter = () => ['D ' + MOODS[moodLatch.now].name, 'D ' + MOODS[moodLatch.pending].name]
const lcHead    = () => []
// Where the music is (LC view): the beat in the bar and the bar in the big cycle. A silent event per beat moves it at
// the moment the beat sounds (onTrigger, as in the set). chordAt(bar) = the chord of that bar ('' = none shown)
const CYCLE   = 8   // the pad's progression: 4 chords × 2 bars
const chordAt = bar => ''
const beatNow = { bar: null, beat: null }
const beatTick = pure(0).segment(4).fmap(() => ({})).onTrigger((hap, now, cps, t) => {
  const pos = hap.whole.begin.valueOf(), bar = Math.floor(pos + 1e-9), beat = Math.floor((pos - bar) * 4 + 1e-9)
  setTimeout(() => { beatNow.bar = bar; beatNow.beat = beat; lcView?.update() }, Math.max(0, (t - now) * 1000))
}, true)

// LC view of this evaluation: names from the tags in the editor (strudel.cc keeps the text in strudelMirror),
// buttons from the change() rows (row i = column i + 1), chapter and break on column 8
return { taps, showStatus, STATUS, lcChapter, lcHead, stems: { J1: stemJ1_pulse, J2: stemJ2_wind, J3: stemJ3_drone, J4: stemJ4_bass, J5: stemJ5_rim, J6: stemJ6_ticks, J7: stemJ7_wood, J8: stemJ8_dust, N1: stemN1_pad, N2: stemN2_chords, N3: stemN3_box, N4: stemN4_whale, N5: stemN5_choir, N6: stemN6_glitter, N7: stemN7_shimmer } }
})()

// ============================================================
// TRACK 010 — Ambient House (from tracks/010/010-ambient-house-dual.strudel)
// ============================================================
// @010 layout Track 010 — ambient house (two controllers)
// @010 note Ambient house in D minor, 120 BPM, a sunrise mood. Jojo plays the foundation (kick, bass, drums, congas), Jonas the colour (pad, chords, melodies, birds) and the global column 8.
// @010 note Every row means the same everywhere: row 1 = brightness, row 2 = space, row 3 = character, fader = level, button 1 = next pattern (at the next bar), button 2 = a moment while held.
// @010 note Start with all faders down. Nothing sounds until Jonas' master fader (column 8) is up. Chapter (Jonas, column 8) changes the chords for everybody at the next 4-bar phrase.
// @010 note The status box at the bottom right of the Strudel page shows chapter, break and each stem's pattern. Its button “als Fenster” opens it as a small window that stays on top (Chrome/Edge).
// @010 mode B16 Jojo — Foundation (beat + bass)
// @010 col B16:1 1 Kick
// @010 col B16:2 2 Atmo Pump
// @010 col B16:3 3 Sub
// @010 col B16:4 4 Bassline
// @010 col B16:5 5 Clap / Rim
// @010 col B16:6 6 Hats
// @010 col B16:7 7 Congas
// @010 col B16:8 8 Shaker / Ride
// @010 row B16:k1 Row 1 \ Brightness
// @010 row B16:k2 Row 2 \ Space
// @010 row B16:k3 Row 3 \ Character
// @010 row B16:fader Fader \ Level
// @010 row B16:b1 Button 1 \ Change
// @010 row B16:b2 Button 2 \ Moment
// @010 mode 16 Jonas — Colour (chords + melodies) · column 8 = global
// @010 col 16:1 1 Pad
// @010 col 16:2 2 Deep Chords
// @010 col 16:3 3 Pluck Arp
// @010 col 16:4 4 Lead
// @010 col 16:5 5 Marimba
// @010 col 16:6 6 Glockenspiel
// @010 col 16:7 7 Birds
// @010 col 16:8 8 Global
// @010 row 16:k1 Row 1 \ Brightness
// @010 row 16:k2 Row 2 \ Space
// @010 row 16:k3 Row 3 \ Character
// @010 row 16:fader Fader \ Level
// @010 row 16:b1 Button 1 \ Change
// @010 row 16:b2 Button 2 \ Moment
// @010 guide Sunrise | Start like the sky before dawn: Jonas brings pad and birds, Jojo the atmo pump and the sub. The kick comes only when both are ready.
// @010 guide Playing together | Jojo builds the floor: kick, sub, off-beat hats, then the rolling bass and the groove (congas, shaker). Keep it dry; the room belongs to Jonas.
// @010 guide Playing together | Jonas colours it: pad and deep chords first (all knobs at 0 is a good start), then arp and marimba. The lead is for the long, slow moments.
// @010 guide Playing together | Chapter changes the chords for both players at the next 4-bar phrase: sub, bass and every melody follow. Pad button 2 (freeze) holds the chord for everybody.
// @010 guide Build-up and drop | Jonas turns Tension up (echo, open filters, snare roll), presses Break at the top: the beat goes out, pad and birds float. Jojo holds the atmo riser, Jonas presses Break again: back on the one. Then let Tension go.
// @010 guide Every position sounds good | No filter closes completely. Arp, lead and marimba keep a little room even at space 0.
const T010 = (() => {
const ID = 1
const PHRASE = phraseOf(SET_TRACKS[1])
const ORBIT0 = 3
const focusOnly = button => button.fmap(v => SET.focus() === ID ? v : 0)

const ramp = (sig, from, to) => sig.fmap(v => Math.min(1, Math.max(0, (v - from) / (to - from))))
// Row-3 crossfade: 0..0.5 brings the extra layer in, 0.5..1 fades the main layer out
const fadeMain  = knob => ramp(knob, 1, 0.5)
const fadeExtra = knob => ramp(knob, 0, 0.5)
// Exponential knob range for filters (Hz), so every part of the knob travel is audible
const expRange = (knob, lo, hi) => knob.fmap(v => lo * Math.pow(hi / lo, v))

const bpm  = 120
const beat = 60 / bpm   // seconds per quarter note, for delay times

// Mapping of column n (1-8): brightness, space, character (knob rows 1-3), fader, button rows 1-2
const colMap = (read, n) => ({ bright: read(12 + n), space: read(20 + n), char: read(28 + n), level: read(4 + n), btn: read(36 + n), btn2: read(44 + n) })
const off = () => signal(() => 0)
// Column 8 (global) is read from both its Mode 16 and Mode 2 CCs, last moved wins: it works on both pages even on a
// controller whose column 8 sends CC + 48 in Mode 2
// One controller: Jojo on the plain CCs (Mode 1), Jonas on CC + 48 (Mode 2)
const alone    = !ccJojo
const colJonas = n => n === 8 ? SET.glob : colMap(n === 8 ? c => lastMoved(ccJonas(c), ccJonas(c + 48)) : alone ? c => ccJonas(c + 48) : ccJonas, n)
const colJojo  = n => !alone ? colMap(ccJojo, n) : n === 8 ? colMap(off, n) : colMap(ccJonas, n)

const gate  = (cond, pat) => cond.fmap(on => on ? pat : silence).innerJoin()
const above = (sig, x) => sig.fmap(v => v > x)
const and   = (a, b) => a.fmap(x => y => x && y).appLeft(b)
const held  = button => button.fmap(v => v > 0.5)

// Stateful controls, collected so the master can query them every tick (see stateTaps)
const taps = []

// Two inputs for one control: the value follows whichever moved last (stateful, so it is queried via stateTaps)
const lastMoved = (a, b) => {
  let pa = null, pb = null, v = 0
  const pat = a.fmap(x => y => {
    if (pa === null) v = Math.max(x, y)
    else if (y !== pb) v = y
    else if (x !== pa) v = x
    pa = x; pb = y
    return v
  }).appLeft(b)
  taps.push(pat)
  return pat
}

// Momentary button that steps through n states, one step per press (counts presses, not the held value).
// onChange(state) runs on every step (for the status box). Re-evaluating the code starts again at 0.
const cycleButton = (button, n, onChange = () => {}) => {
  button = focusOnly(button)   // set: presses count only for the track in focus
  let prev = 0, state = 0
  const pat = button.fmap(v => {
    if (v > 0.5 && prev <= 0.5) { state = (state + 1) % n; onChange(state) }
    prev = v
    return state
  })
  taps.push(pat)
  return pat
}

// A value that a button sets now but that takes over only at the next bar line, or with len = 4 at the next
// 4-bar phrase (chapter). at(t) is asked with bar starts in real time (outside any reseed shift); it remembers the
// previous value for queries that still reach back into the old bar. pat = the value per bar.
const barLatch = (len = 1) => {
  const l = { pending: 0, now: 0, prev: 0, bar: -Infinity }
  l.at = t => {
    const bar = Math.floor(Number(t) / len)
    if (bar > l.bar) {
      if (l.pending !== l.now) { l.prev = l.now; l.now = l.pending; showStatus() }
      else l.prev = l.now
      l.bar = bar
    }
    return bar >= l.bar ? l.now : l.prev
  }
  l.pat = signal(t => l.at(t)).segment(1)
  taps.push(l.pat)
  return l
}

// 0 → 1 over `cycles` while a button is held, back to 0 on release (for risers)
const heldRamp = (button, cycles) => {
  let start = null
  const pat = button.fmap(v => t => {
    if (v <= 0.5) { start = null; return 0 }
    start ??= t
    return Math.min(1, Math.max(0, (t - start) / cycles))
  }).appLeft(signal(t => Number(t)))
  taps.push(pat)
  return pat
}

// Freeze: while the button is held, keep returning the value that was playing when it was pressed
const freeze = (button, pat) => {
  let kept = null
  return pat.fmap(v => b => b > 0.5 ? (kept ??= v) : (kept = null, v)).appLeft(button)
}


// ============================================================
// CHAPTERS — chord progressions in D minor, one chord per bar, 4 bars = one phrase
// ============================================================
// Roots as scale degrees of D natural minor (0 = D). Stacked thirds on them: Dm9, Fmaj7, Gm9, B♭maj7, C (add9).
// A (degree 4) and E (degree 1) are never roots: their 9th would clash (B♭ over A, F over E).
const CHAPTERS = [
  { name: 'Dämmerung',     roots: [0, 5, 2, 6], chords: 'Dm9 – B♭maj7 – Fmaj7 – C' },   // i–VI–III–VII
  { name: 'Sonnenaufgang', roots: [5, 6, 0, 0], chords: 'B♭maj7 – C – Dm9 – Dm9' },     // VI–VII–i–i
  { name: 'Schweben',      roots: [0, 3, 0, 3], chords: 'Dm9 – Gm9 – Dm9 – Gm9' },      // i–iv
  { name: 'Wärme',         roots: [2, 5, 3, 0], chords: 'Fmaj7 – B♭maj7 – Gm9 – Dm9' }, // III–VI–iv–i
]
const scaleIn = octave => 'D' + octave + ':minor'


// Rows of the status box, filled by change(): { label, latch, n, names } per player
const STATUS = { jojo: [], jonas: [] }
const showStatus = () => {
  if (!statusUi || SET.focus() !== ID) return
  const dots = v => [...Array(8).keys()].map(k => k === v ? '●' : '○').join('')
  const show = (r, v) => !r.names ? String(v + 1) : r.names[v]
  const line = (r, i) => (i + 1) + ' ' + r.label.padEnd(10) + ' ' + (r.n === 8 ? dots(r.latch.now) + ' ' : '') +
    show(r, r.latch.now) + (r.latch.pending !== r.latch.now ? ' → ' + show(r, r.latch.pending) : '')
  const ch = chapterLatch
  statusUi.text.textContent = [
    ...SET.statusLines(),
    'Kapitel     ' + CHAPTERS[ch.now].name +
      (ch.pending !== ch.now ? ' → ' + CHAPTERS[ch.pending].name + ' (nächste Phrase)' : ''),
    'Akkorde     ' + CHAPTERS[ch.now].chords,
    '', alone ? 'Mode 1 · Jojo' : 'Jojo', ...STATUS.jojo.map(line),
    '', alone ? 'Mode 2 · Jonas' : 'Jonas', ...STATUS.jonas.map(line),
  ].join('\n')
  lcView?.update()
}
// Button 1 of a stem: n patterns (default 8), one step per press, taking over at the next bar
const change = (button, who, label, n = 8, names) => {
  const latch = barLatch()
  cycleButton(button, n, s => { latch.pending = s; showStatus() })
  STATUS[who].push({ label, latch, n, names })
  return latch
}
// Pattern number i of a list, switched by a change latch
const pick = (latch, pats) => latch.pat.fmap(i => pats[i]).innerJoin()

// ============================================================
// GLOBAL (Jonas, column 8) — acts on both controllers
// ============================================================
// @010 ctl g.k1 Fog | 0 = clear, up = every filter pulled down to ~6 %: muffled, as if heard from outside the tent.
// @010 ctl g.k2 Room | 0 = each sound's own room (row 2), up = everything drowns in reverb.
// @010 ctl g.k3 Tension | build-up: echo grows, filters open, from the middle a snare roll (clap fader). 0 = release.
// @010 ctl g.fader Master Level | volume of everything, both controllers. 0 = silence.
// @010 ctl g.b1 Chapter | next chord progression for all, at the next 4-bar phrase.
// @010 ctl g.b2 Break / Drop | 1st: beat out. 2nd: all back on the one.
const glob        = colJonas(8)
const globalFog   = glob.bright.fmap(f => Math.pow(0.06, f))
const globalRoom  = glob.space
const tension     = glob.char
const tensionEcho = ramp(tension, 0, 0.5).mul(0.45)     // delay send, 0..0.45
const tensionRoll = ramp(tension, 0.5, 1)               // snare roll, 0..1
// Factor on every lpf: fog darkens (down to 0.06), tension opens (up to 2.5)
const globalTone  = globalFog.fmap(f => o => f * o).appLeft(tension.fmap(t => 1 + 1.5 * t))
const globalLevel = glob.level.range(0, 1)

const chapterLatch = barLatch(PHRASE)
cycleButton(glob.btn, CHAPTERS.length, s => { chapterLatch.pending = s; showStatus() })
const breakLatch = barLatch()
cycleButton(glob.btn2, 2, s => { breakLatch.pending = s; showStatus() })
// Jojo's low end and backbeat, gated while the break is on
const beatOn   = breakLatch.pat.fmap(b => b === 0)
const beatOnly = pat => gate(beatOn, pat)

const audible = level => and(above(level, 0), above(globalLevel, 0))
// lpf × fog/tension, kept between 80 Hz and 18 kHz (fog never makes a stem silent)
const toned  = lpf => lpf.fmap(f => g => Math.min(18000, Math.max(80, f * g))).appLeft(globalTone)
// Reverb send: the stem's space knob (0..0.9), raised by the global Room up to 0.95
const roomOf = space => space.fmap(s => g => { const r = 0.9 * s; return r + (0.95 - r) * g }).appLeft(globalRoom)
// Change: read the stem's randomness 1024 cycles further per step (keeps bar alignment, new random values).
// The chord root is applied after reseed, so it follows real time.
const reseed = (latch, pat) => pat.early(latch.pat.fmap(v => v * 1024))

// Effect buses. Each orbit has one reverb and one delay, and every reverb costs a lot of CPU, so the stems share
// two orbits; stems on one orbit share room size and echo time/feedback.
// Orbit 1 = drums and bass: small, dry room, short dotted-8th slap.
// Orbit 2 = all of Jonas' colour (and the atmo riser): a wide open-air hall, long dotted-8th echo.
const BUSES = {
  1: { hall: 1.2, time: beat * 0.75, feedback: 0.25 },
  2: { hall: 5, time: beat * 0.75, feedback: 0.55 },
}
// bus(): reverb from the space knob, and echo: the layer's own delay amount (or `echo` if it has none) × 2 × space,
// so space 0.5 = the designed amount; Tension's echo takes over where it is larger.
const bus = (pat, orbit, space, echo = 0) => pat
  .fmap(v => sc => e => ({ ...v, delay: Math.max(Math.min(0.9, (v.delay ?? echo) * sc), e) }))
  .appLeft(space.fmap(s => 2 * s)).appLeft(tensionEcho)
  .room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)
  .delaytime(BUSES[orbit].time).delayfeedback(BUSES[orbit].feedback)
// Reverb only, no echo (kick, sub and bass would smear)
const dryBus = (pat, orbit, space) => pat.room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)

// Channel strip: lpf × fog/tension (if given), level × master as postgain, gated while the fader or master is 0
const strip = (stem, { lpf, level }) => {
  const pat = lpf === undefined ? stem : stem.lpf(toned(lpf))
  return gate(audible(level), pat.postgain(level.mul(globalLevel)))
}
const drum = (names, bank = 'RolandTR909') => s(names).bank(bank)

// ============================================================
// HARMONY — Chapter picks the progression, everybody follows its root; pad button 2 freezes it for all
// ============================================================
const PROG_PATS = CHAPTERS.map(c => cat(...c.roots))   // one chord per bar, the phrase starts with chord 1
const pad       = colJonas(1)
const harmRoot  = freeze(pad.btn2, pick(chapterLatch, PROG_PATS))
// Chord = shape (scale degrees above the root) on the current root; built once per root and shape
const CHORD_CACHE = {}
const chordOn = shape => harmRoot.fmap(r => CHORD_CACHE[shape + '@' + r] ??= n(stack(...shape.map(d => d + r)))).innerJoin()
const onRoot  = pat => pat.add(n(harmRoot))

// Roots for the low end: A, B♭ and C go an octave down, so sub and bass stay between A1 and G2
const lowRoot  = harmRoot.fmap(r => r >= 4 ? r - 7 : r)
const onLow    = pat => pat.add(n(lowRoot))

// ============================================================
// JOJO 1 KICK — four on the floor: a 909 kick with a sine body tuned to D2 (the root), firm at all knobs 0
// ============================================================
// Softness up = the pitch drop gets smaller and slower, the attack fades in, the 909 fades out: a deep, soft thump.
// @010 ctl B16:1.k1 Brightness | 0 = firm, round kick with a little click ↔ clicky attack (lpf 1.5–10 kHz).
// @010 ctl B16:1.k2 Space | dry and close ↔ in a room (reverb).
// @010 ctl B16:1.k3 Softness | 0 = firm 909 kick ↔ 1 = deep, soft thump without click.
// @010 ctl B16:1.fader Level | 0 = gone. Four-on-the-floor kick, tuned to D.
// @010 ctl B16:1.b1 Change | straight → pickup before the 1 → gap every 4th bar.
// @010 ctl B16:1.b2 Drop out | kick pauses while held.
const kick     = colJojo(1)
const kickVar  = change(kick.btn, 'jojo', 'Kick', 3, ['gerade', 'Auftakt', 'Lücke'])
const kickSoft = kick.char
const KICKS = ["1*4", "1 1 1 [1 ~ ~ 0.4]", "<[1*4] [1*4] [1*4] [1 1 1 ~]>"]
  .map(g => stack(
    gain(g).note("d2").s("sine").decay(kickSoft.fmap(s => 0.4 + 0.2 * s)).sustain(0).release(0.05)
      .attack(kickSoft.fmap(s => 0.002 + 0.012 * s))
      .penv(kickSoft.fmap(s => 24 - 12 * s)).pdecay(kickSoft.fmap(s => 0.035 + 0.045 * s)),
    gain(g).mul(gain(kickSoft.fmap(s => 0.75 * (1 - s)))).s("bd").bank("RolandTR909")
  ))

const stemJ1_kick = beatOnly(gate(kick.btn2.fmap(v => v <= 0.5), strip(dryBus(
  pick(kickVar, KICKS).mul(gain(0.8)), 1, kick.space), {
  lpf: expRange(kick.bright, 1500, 10000),
  level: kick.level.range(0, 1),
})))

// ============================================================
// JOJO 2 ATMO PUMP — soft tape-hiss noise glued to the kick (swells in after every kick, like a sidechain),
// or slow waves over two bars
// ============================================================
// @010 ctl B16:2.k1 Brightness | dull whoosh ↔ airy hiss (lpf 1.5–12 kHz).
// @010 ctl B16:2.k2 Space | dry ↔ far away (reverb + echo).
// @010 ctl B16:2.k3 Motion | still ↔ the filter breathes and the noise wanders left and right.
// @010 ctl B16:2.fader Level | noise that pumps with the kick.
// @010 ctl B16:2.b1 Change | pump → off-beat breath → slow waves.
// @010 ctl B16:2.b2 Riser | a noise sweep rises over 2 bars while held.
const noiseCol  = colJojo(2)
const noiseVar  = change(noiseCol.btn, 'jojo', 'Atmo', 3, ['Pumpe', 'Offbeat', 'Wellen'])
const noiseMove = noiseCol.char
const noiseRise = heldRamp(noiseCol.btn2, 2)
const NOISES = [
  s("[~ pink@3]*4").attack(0.14).sustain(0.7).release(0.03).hpf(900).gain(2),
  s("[~ pink]*4").attack(0.08).sustain(0.5).release(0.06).hpf(1800).gain(2),
  // Waves: one long swell every 2 bars, like the sea at dawn
  s("pink/2").attack(1.8).sustain(1).release(1.8).hpf(400).gain(1.4),
]
// Riser: 16th noise bursts through a bandpass that climbs from 300 Hz to 6 kHz, getting louder. Keeps playing in the break.
const noiseRiser = gate(held(noiseCol.btn2), s("pink*16")
  .attack(0.03).sustain(0.8).release(0.15)
  .bpf(noiseRise.fmap(r => 300 * Math.pow(20, r))).bpq(4)
  .gain(noiseRise.mul(0.35)).pan(sine.fast(2)))

const stemJ2_noise = strip(stack(
  beatOnly(bus(pick(noiseVar, NOISES)
    .lpf(toned(expRange(noiseCol.bright, 1500, 12000)).fmap(f => m => w => f * (1 - 0.7 * m * w)).appLeft(noiseMove).appLeft(sine.slow(2)))
    .pan(noiseMove.fmap(m => p => 0.5 + m * (p - 0.5)).appLeft(sine.slow(3))), 1, noiseCol.space, 0.15)),
  bus(noiseRiser, 2, pure(0.3))
), {
  level: noiseCol.level.range(0, 1),
})

// ============================================================
// JOJO 3 SUB — a sine on the low chord root (A1–G2): each note starts a 16th after the kick (ducked, without a compressor)
// ============================================================
// @010 ctl B16:3.k1 Brightness | 0 = sine with a few overtones (audible on small speakers) ↔ warm and full.
// @010 ctl B16:3.k2 Space | dry ↔ a little room (reverb).
// @010 ctl B16:3.k3 Length | long, pumping notes ↔ short, bouncing ones.
// @010 ctl B16:3.fader Level | sub on the chord root, follows the chapter.
// @010 ctl B16:3.b1 Change | pump → off-beat → one long note per bar.
// @010 ctl B16:3.b2 Slide | every note bends up into its pitch while held.
const sub      = colJojo(3)
const subVar   = change(sub.btn, 'jojo', 'Sub', 3, ['Pumpe', 'Offbeat', 'lang'])
const subClip  = sub.char.fmap(c => 1 - 0.65 * c)   // share of the note length that sounds
const subSlide = sub.btn2.fmap(v => v > 0.5 ? -5 : 0)
const SUBS = ["[~ 0@3]*4", "[~ 0]*4", "~ 0@15"].map(p => onLow(n(p)).scale(scaleIn(2)))
const subNotes = pick(subVar, SUBS)

const stemJ3_sub = beatOnly(strip(dryBus(stack(
  subNotes.s("sine").gain(0.5),
  subNotes.s("triangle").gain(sub.bright.fmap(b => 0.1 + 0.17 * b))
).attack(0.015).sustain(1).release(0.04).clip(subClip).penv(subSlide).pattack(0.07), 1, sub.space), {
  level: sub.level.range(0, 1),
}))

// ============================================================
// JOJO 4 BASSLINE — rolling melodic-house bass: triangle + a quiet saw, round, a soft filter pluck, a little drive
// ============================================================
// @010 ctl B16:4.k1 Brightness | 0 = round and woody ↔ warm buzz (lpf 250–2000 Hz + envelope).
// @010 ctl B16:4.k2 Space | dry ↔ a little room (reverb).
// @010 ctl B16:4.k3 Groove | the line as it is ↔ extra 16th notes rolling in between.
// @010 ctl B16:4.fader Level | rolling bass, follows the chapter.
// @010 ctl B16:4.b1 Change | rolling → off-beat → melodic.
// @010 ctl B16:4.b2 Octave | one octave up while held.
const bassCol = colJojo(4)
const bassVar = change(bassCol.btn, 'jojo', 'Bass', 3, ['rollend', 'Offbeat', 'Melodie'])
const bassOct = bassCol.btn2.fmap(v => v > 0.5 ? 12 : 0)
// [main line, extra 16ths], scale degrees above the low chord root (7 = octave, 4 = fifth, 2 = third)
const BASS_LINES = [
  ["[~ 0 0 ~] [~ 0 0 ~] [~ 0 0 ~] [~ 0 4 ~]", "[~ ~ ~ 0]*4"],
  ["[~ 0]*4", "[~ ~ ~ 0]*4"],
  ["[0 ~ ~ 0] [~ ~ 4 ~] [~ 0 ~ ~] [2 ~ 4 ~]", "[~ 0 ~ ~]*4"],
].map(([main, extra]) => [onLow(n(main)), onLow(n(extra))])
const bassSound = pat => pat.scale(scaleIn(2)).add(note(bassOct))
  .s("triangle").superimpose(x => x.s("sawtooth").add(note(-0.07)).gain(0.35))
  .attack(0.004).decay(0.2).sustain(0.35).release(0.07).lpq(3).lpenv(1.5).lpdecay(0.15).lpsustain(0).shape(0.2)

const stemJ4_bass = beatOnly(strip(dryBus(stack(
  bassSound(pick(bassVar, BASS_LINES.map(l => l[0]))).mul(gain(0.5)),
  gate(above(bassCol.char, 0), bassSound(pick(bassVar, BASS_LINES.map(l => l[1]))).mul(gain(bassCol.char.mul(0.35))))
), 1, bassCol.space), {
  lpf: expRange(bassCol.bright, 250, 2000),
  level: bassCol.level.range(0, 1),
}))

// ============================================================
// JOJO 5 CLAP / RIM — a soft 909 clap on 2 and 4, or a dry 909 rimshot, or both
// ============================================================
// @010 ctl B16:5.k1 Brightness | 0 = natural, a little soft ↔ sharp crack (lpf 3.5–14 kHz).
// @010 ctl B16:5.k2 Space | dry ↔ far away (reverb + echo).
// @010 ctl B16:5.k3 Ghost notes | plain ↔ a quiet rim before beat 3 ↔ + small double taps.
// @010 ctl B16:5.fader Level | clap / rim on 2 and 4. Also the level of Tension's snare roll.
// @010 ctl B16:5.b1 Change | clap → rim with a pickup → clap + rim.
// @010 ctl B16:5.b2 Roll | snare roll, growing over the bar, while held.
const clap      = colJojo(5)
const clapVar   = change(clap.btn, 'jojo', 'Clap', 3, ['Clap', 'Rim', 'beides'])
const clapGhost = clap.char
// The 909 clap sample as it is, with its own tail (an envelope cut it off after 0.18 s and sounded choked)
const clapHit = g => gain(g).s("cp").bank("RolandTR909")
const rimHit  = g => gain(g).s("rim").bank("RolandTR909")
const CLAPS = [
  clapHit("~ 0.7 ~ 0.7"),
  rimHit("~ 0.6 ~ [0.6 ~ ~ 0.3]"),
  stack(clapHit("~ 0.6 ~ 0.6"), rimHit("[~ ~ ~ 0.35] ~ [~ ~ 0.3 ~] ~")),
]

const stemJ5_clap = beatOnly(strip(bus(stack(
  pick(clapVar, CLAPS),
  gate(above(clapGhost, 0), rimHit("~ ~ 0.25 ~").mul(gain(ramp(clapGhost, 0, 0.5)))),
  gate(above(clapGhost, 0.5), rimHit("~ [~ 0.18] ~ [~ ~ 0.15 ~]").mul(gain(ramp(clapGhost, 0.5, 1)))),
  gate(held(clap.btn2), drum("sd*16").gain(saw.range(0.1, 0.5))),
  // Tension roll: 8ths → 16ths, louder as Tension rises
  gate(above(tensionRoll, 0), drum("sd*16").degradeBy(tensionRoll.fmap(t => 0.5 * (1 - t)))
    .gain(tensionRoll.fmap(t => 0.1 + 0.35 * t)))
).mul(gain(0.9)).hpf(300).pan(0.47), 1, clap.space, 0.2), {   // was 1.5: the open clap peaked at 1.34 (clipping)
  lpf: expRange(clap.bright, 3500, 14000),   // was 1500: at knobs 0 only 300–1500 Hz were left, a boxy, honking clap
  level: clap.level.range(0, 1),
}))

// ============================================================
// JOJO 6 HATS — a short, dry open hat on the off-beat, closed 16ths in the other patterns
// ============================================================
// @010 ctl B16:6.k1 Brightness | soft hiss ↔ crisp and sharp (lpf 3–16 kHz).
// @010 ctl B16:6.k2 Space | dry ↔ far away (reverb + echo).
// @010 ctl B16:6.k3 Density | the pattern as it is ↔ + quiet 16ths ↔ + little 32nd rolls.
// @010 ctl B16:6.fader Level | off-beat hat. Keeps playing in the break.
// @010 ctl B16:6.b1 Change | off-beat → + 16ths → shuffled 16ths.
// @010 ctl B16:6.b2 Open | long open hats on every 8th while held.
const hats    = colJojo(6)
const hatVar  = change(hats.btn, 'jojo', 'Hats', 3, ['Offbeat', '16tel', 'Shuffle'])
const hatDens = hats.char
const offHat  = drum("[~ oh]*4").decay(0.12).sustain(0).gain(0.4)
const HATS = [
  offHat,
  stack(offHat, drum("hh*16").gain("[0.2 0.1 0 0.12]*4")),
  stack(offHat, drum("hh*16").gain("[0.22 0.08 0.14 0.1]*4").swingBy(0.4, 8)),
]

const stemJ6_hats = strip(bus(stack(
  pick(hatVar, HATS),
  gate(above(hatDens, 0), drum("hh*16").degradeBy(0.4).gain(ramp(hatDens, 0, 0.5).mul(0.12))),
  gate(above(hatDens, 0.5), drum("hh*32").degradeBy(0.8).gain(ramp(hatDens, 0.5, 1).mul(0.18))),
  gate(held(hats.btn2), drum("oh*8").gain(0.3))
).mul(gain(1.2)).pan(0.56), 1, hats.space, 0.2), {
  lpf: expRange(hats.bright, 3000, 16000),
  level: hats.level.range(0, 1),
})

// ============================================================
// JOJO 7 CONGAS — TR-727 latin percussion: conga low (n 4), bongo high / low (n 2 / 3); agogo bells (n 0 / 1) with density
// ============================================================
// @010 ctl B16:7.k1 Brightness | soft and woody ↔ crisp slap (lpf 600–12000 Hz).
// @010 ctl B16:7.k2 Space | dry ↔ far away (reverb + echo).
// @010 ctl B16:7.k3 Density | steady pattern ↔ + fingertip ghost notes ↔ + agogo bells.
// @010 ctl B16:7.fader Level | congas and bongos. Keep playing in the break.
// @010 ctl B16:7.b1 Change | pillow → rolling → latin.
// @010 ctl B16:7.b2 Fill | a conga run over the bar while held.
const perc     = colJojo(7)
const percVar  = change(perc.btn, 'jojo', 'Congas', 3, ['Kissen', 'rollend', 'Latin'])
const percDens = perc.char
const conga = (pat, g) => n(pat).s("perc").bank("RolandTR727").gain(g)
const PERCS = ["4 ~ ~ 2 ~ ~ 3 ~ 4 ~ ~ 2 ~ 3 ~ ~", "~ ~ 4 2 ~ ~ 4 ~ ~ 3 ~ 2 ~ ~ 4 ~", "3 ~ 2 ~ 4 ~ 2 3 ~ 2 ~ 4 ~ ~ 2 ~"]
  .map(p => conga(p, perlin.range(0.2, 0.3)))

const stemJ7_perc = strip(bus(stack(
  pick(percVar, PERCS),
  gate(above(percDens, 0), conga(irand(2).add(2).segment(16), ramp(percDens, 0, 0.5).mul(0.09)).degradeBy(0.55)),
  gate(above(percDens, 0.5), conga("~ 0 ~ ~ 1 ~ ~ 0 ~ ~ 1 ~ 0 ~ ~ ~", ramp(percDens, 0.5, 1).mul(0.13))),
  gate(held(perc.btn2), conga("2 2 3 3 2 3 4 4 2 2 3 3 4 3 4 4", 0.25))
).pan(sine.slow(4).range(0.35, 0.65)), 1, perc.space, 0.3), {
  lpf: expRange(perc.bright, 600, 12000),
  level: perc.level.range(0, 1),
})

// ============================================================
// JOJO 8 SHAKER / RIDE — TR-727 maracas on 16ths, a quiet 909 ride on the off-beats
// ============================================================
// @010 ctl B16:8.k1 Brightness | soft shimmer ↔ bright sizzle (lpf 4.5–16 kHz).
// @010 ctl B16:8.k2 Space | dry ↔ far away (reverb + echo).
// @010 ctl B16:8.k3 Swing | straight ↔ swung, lazy (the in-between 16ths come late).
// @010 ctl B16:8.fader Level | shaker and ride. Keep playing in the break.
// @010 ctl B16:8.b1 Change | shaker → ride → both.
// @010 ctl B16:8.b2 Double | double time while held.
const shake    = colJojo(8)
const shakeVar = change(shake.btn, 'jojo', 'Shaker', 3, ['Shaker', 'Ride', 'beides'])
const maracas  = g => gain(g).s("sh").bank("RolandTR727").n(1)
const ride     = g => gain(g).s("rd").bank("RolandTR909")
const SHAKERS = [
  maracas("[0.35 0.18 0.26 0.18]*4"),
  ride("[~ 0.16]*4"),
  stack(maracas("[0.3 0.15 0.22 0.15]*4"), ride("[~ 0.12]*4")),
]

const stemJ8_shake = strip(bus(pick(shakeVar, SHAKERS)
  .fast(shake.btn2.fmap(v => v > 0.5 ? 2 : 1))
  .swingBy(shake.char.mul(0.6), 8)   // 0.6 = the off-16th lands on the last triplet
  .mul(gain(3)).pan(0.62), 1, shake.space, 0.25), {
  lpf: expRange(shake.bright, 4500, 16000),
  level: shake.level.range(0, 1),
})

// ============================================================
// JONAS 1 PAD — warm, soft pad: detuned saws + a triangle on the chapter's 7th / 9th chords, slow attack
// ============================================================
// @010 ctl 16:1.k1 Brightness | muffled ↔ open and airy (lpf 300–5000 Hz).
// @010 ctl 16:1.k2 Space | dry and close ↔ far away in a big room (reverb + echo).
// @010 ctl 16:1.k3 Swell | still ↔ slowly breathing in and out (every 2 bars).
// @010 ctl 16:1.fader Level | warm pad on the chapter's chords.
// @010 ctl 16:1.b1 Change | voicing: warm → open (9th) → wide.
// @010 ctl 16:1.b2 Freeze | holds the current chord while held, for everybody.
const padVar   = change(pad.btn, 'jonas', 'Pad', 3, ['warm', 'offen', 'weit'])
const padSwell = pad.char
// Voicings in scale degrees above the root: seventh chord, upper tones with the 9th, spread (low root, 5th, 7th, 10th)
const PAD_VOICINGS = [[0, 2, 4, 6], [2, 4, 6, 8], [-7, 4, 6, 9]].map(v => chordOn(v).scale(scaleIn(3)))
const padChord = pick(padVar, PAD_VOICINGS)

const stemN1_pad = strip(bus(stack(
  padChord.s("sawtooth").superimpose(x => x.add(note(0.14))).gain(0.2),
  padChord.s("triangle").gain(0.25)
).attack(0.8).sustain(0.8).release(1.8).pan(sine.slow(5).range(0.3, 0.7))
  .mul(gain(padSwell.fmap(c => w => 1 - 0.75 * c * w).appLeft(sine.slow(2)))), 2, pad.space, 0.15), {
  lpf: expRange(pad.bright, 300, 5000),
  level: pad.level.range(0, 1),
})

// ============================================================
// JONAS 2 DEEP CHORDS — deep-house minor-9 / maj-7 stabs, rootless (the bass has the root), a soft FM e-piano tone
// ============================================================
// FM sine with ratio 1 and low index = a mellow, Rhodes-like bark; a triangle underneath for warmth. Dry at space 0.
// @010 ctl 16:2.k1 Brightness | warm and muffled ↔ bright, barking (lpf 600–8000 Hz).
// @010 ctl 16:2.k2 Space | dry ↔ the dotted-8th echoes repeat far into the room.
// @010 ctl 16:2.k3 Rhythm | long ringing chords ↔ short, choppy stabs.
// @010 ctl 16:2.fader Level | chord stabs on the chapter's chords.
// @010 ctl 16:2.b1 Change | next of 8 deep-house rhythms.
// @010 ctl 16:2.b2 Stab | a chord on every off-beat while held.
const keys      = colJonas(2)
const keysVar   = change(keys.btn, 'jonas', 'Akkorde')
const keysLen   = keys.char.fmap(c => 1.2 * Math.pow(0.1, c))   // decay seconds: 1.2 ↔ 0.12
// Rootless voicing: 3rd, 5th, 7th, 9th (Dm9 = F A C E)
const keysChord = chordOn([2, 4, 6, 8]).scale(scaleIn(3))
const KEYS_RHYTHMS = ["~ ~ ~ x ~ ~ x ~ ~ ~ ~ ~ ~ ~ ~ ~", "x ~ ~ x ~ ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~", "~ ~ x ~ ~ ~ ~ ~ ~ x ~ ~ ~ ~ x ~",
  "x ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~", "~ ~ ~ x ~ ~ ~ x ~ ~ ~ ~ ~ ~ x ~", "<[x ~ ~ x ~ ~ x ~ ~ ~ ~ ~ ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ ~ x ~ ~]>",
  "~ x ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~ x ~ ~", "x ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~ x ~ ~ ~"]
const KEYS_PATS = KEYS_RHYTHMS.map(r => keysChord.struct(r))
const keysSound = pat => stack(
  pat.s("sine").fm(0.7).fmh(1).gain(0.32),
  pat.s("triangle").gain(0.14)
).attack(0.005).decay(keysLen).sustain(0.05).release(keysLen.mul(0.6)).shape(0.1).pan(0.45)

const stemN2_keys = strip(bus(stack(
  keysSound(pick(keysVar, KEYS_PATS)).delay(0.4),
  gate(held(keys.btn2), keysSound(keysChord.struct("[~ x]*4")).delay(0.3))
), 2, keys.space), {
  lpf: expRange(keys.bright, 600, 8000),
  level: keys.level.range(0, 1),
})

// ============================================================
// JONAS 3 PLUCK ARP — soft melodic-house pluck on the chord tones (stepwise, no octave leaps), with echo
// ============================================================
// Keeps a little room even at space 0.
// @010 ctl 16:3.k1 Brightness | soft, woody plucks ↔ clear, sparkling (lpf 900–8000 Hz).
// @010 ctl 16:3.k2 Space | a little room ↔ far away (reverb + echo).
// @010 ctl 16:3.k3 Range | some notes left out ↔ every 16th, plus passing notes (9th, 6th).
// @010 ctl 16:3.fader Level | pluck arp on the chord.
// @010 ctl 16:3.b1 Change | next of 8 arp shapes.
// @010 ctl 16:3.b2 Octave | one octave up while held.
const arp      = colJonas(3)
const arpVar   = change(arp.btn, 'jonas', 'Arp')
const arpRange = arp.char
const arpOct   = arp.btn2.fmap(v => v > 0.5 ? 12 : 0)
// Scale degrees above the root: 0 2 4 6 = seventh chord, 8 = 9th (reached stepwise)
const ARPS = ["[0 2 4 2]*4", "[0 2 4 6]*4", "[4 2 0 2]*4", "[2 4 6 8 6 4 2 4]*2", "[0 ~ 2 4 ~ 2 4 ~]*2",
  "{0 2 4 6 4}%16", "[6 4 2 4]*4", "<[0 2 4 6]*4 [2 4 6 8]*4>"].map(p => n(p))

const stemN3_arp = strip(bus(onRoot(pick(arpVar, ARPS)
  .degradeBy(arpRange.fmap(r => 0.35 * (1 - r)))
  .sometimesBy(arpRange.mul(0.25), x => x.add(n("<1 5>"))))   // passing notes: 9th / 6th
  .scale(scaleIn(4)).add(note(arpOct))
  .s("triangle").superimpose(x => x.s("sawtooth").gain(0.3))
  .attack(0.003).decay(0.16).sustain(0).release(0.1)
  .gain(perlin.range(0.45, 0.65)).pan(sine.slow(3).range(0.3, 0.7)).delay(0.35),
  2, arp.space.fmap(s => 0.3 + 0.7 * s)), {
  lpf: expRange(arp.bright, 900, 8000),
  level: arp.level.range(0, 1),
})

// ============================================================
// JONAS 4 LEAD — a slow, breathy line: triangle + quiet saw through an “ooh” vowel, slight vibrato; long notes
// ============================================================
// Melodies as scale degrees above the chord root (0 root, 2 third, 4 fifth, 6 seventh, 7 octave), so they always fit.
// @010 ctl 16:4.k1 Brightness | soft and hushed ↔ open, clear voice (lpf 600–5000 Hz).
// @010 ctl 16:4.k2 Space | a little room ↔ far away (reverb + echo).
// @010 ctl 16:4.k3 Glide | plain notes ↔ notes bend gently into their pitch (at most a semitone).
// @010 ctl 16:4.fader Level | slow lead on the chord.
// @010 ctl 16:4.b1 Change | next of 8 melodies.
// @010 ctl 16:4.b2 Echo throw | long echo on the lead while held.
const lead      = colJonas(4)
const leadVar   = change(lead.btn, 'jonas', 'Lead')
const leadGlide = lead.char
const LEADS = ["4 _ _ _ ~ ~ 2 _ 0 _ _ _ ~ ~ ~ ~", "~ ~ 7 _ _ _ 6 _ 4 _ _ _ ~ ~ ~ ~", "0 _ _ 2 _ _ 4 _ _ _ _ _ ~ ~ ~ ~",
  "<[4 _ _ _ 5 _ 4 _ 2 _ _ _ ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ ~ ~ 0 _ _ _ _ _ ~ ~]>", "~ ~ ~ ~ 2 _ _ _ 4 _ _ _ 6 _ _ _",
  "7 _ _ _ _ _ ~ ~ 4 _ _ _ _ _ ~ ~", "~ ~ 4 _ 2 _ 0 _ _ _ _ _ ~ ~ ~ ~", "<[0 _ 2 _ 4 _ _ _ _ _ _ _ ~ ~ ~ ~] [~ ~ ~ ~ 6 _ _ _ 4 _ _ _ _ _ ~ ~]>"]
  .map(p => n(p))
const throwEcho = (pat, button) => pat.fmap(v => b => b > 0.5 ? { ...v, delay: 0.85 } : v).appLeft(button)
const leadNotes = onRoot(pick(leadVar, LEADS)).scale(scaleIn(4))

const stemN4_lead = strip(throwEcho(bus(stack(
  leadNotes.s("triangle").gain(0.35),
  leadNotes.s("sawtooth").vowel("o").gain(0.1)
).attack(0.08).decay(0.3).sustain(0.7).release(0.4)
  .vib(4.5).vibmod(0.07)
  .penv(leadGlide.fmap(g => -g)).pattack(0.12)
  .delay(0.3), 2, lead.space.fmap(s => 0.25 + 0.75 * s)), lead.btn2), {
  lpf: expRange(lead.bright, 600, 5000),
  level: lead.level.range(0, 1),
})

// ============================================================
// JONAS 5 MARIMBA — the answer: a short wooden phrase at the end of every second bar, bouncing left and right
// ============================================================
// Marimba = a short sine + a quiet partial two octaves up (the bright “tok” of the bar).
// @010 ctl 16:5.k1 Brightness | soft, woody ↔ clear and bright (lpf 1.2–9 kHz).
// @010 ctl 16:5.k2 Space | some room and echo ↔ far away.
// @010 ctl 16:5.k3 Voices | 0 = one voice, 0.5 = + a third above, 1 = + a fifth: three-part marimba.
// @010 ctl 16:5.fader Level | marimba phrase, every second bar.
// @010 ctl 16:5.b1 Change | next of 8 phrase rhythms (new notes too).
// @010 ctl 16:5.b2 Answer | the phrase plays in every bar while held.
const ans       = colJonas(5)
const ansVar    = change(ans.btn, 'jonas', 'Marimba')
const ansVoices = ans.char
const ANS_RHYTHMS = ["~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ x ~ ~ x ~ ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x x x ~",
  "~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ x ~ x", "~ ~ ~ ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ ~ ~ ~ ~",
  "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x x ~ x ~ ~", "~ ~ ~ ~ x ~ ~ ~ ~ ~ x ~ ~ ~ x x"]
// Every second bar normally, every bar while button 2 is held
const ansEvery2 = pick(ansVar, ANS_RHYTHMS.map(r => pure(1).struct(r).mask("<0 1>")))
const ansEvery  = pick(ansVar, ANS_RHYTHMS.map(r => pure(1).struct(r)))
const ansRhythm = held(ans.btn2).fmap(b => b ? ansEvery : ansEvery2).innerJoin()
// Notes: random chord tones (root, 3rd, 5th, 7th, octave), new ones per change
const ANS_TONES = [0, 2, 4, 6, 7]
const ansNotes = n(reseed(ansVar, irand(5).segment(16).fmap(i => ANS_TONES[i])))
const ansVoice = (deg, g) => {
  const notes = onRoot(ansRhythm.fmap(() => v => v).appLeft(ansNotes).add(n(deg))).scale(scaleIn(4))
  return stack(notes.s("sine").gain(g), notes.add(note(24)).s("sine").gain(g * 0.15))
    .attack(0.002).decay(0.22).sustain(0).release(0.1)
}

const stemN5_ans = strip(bus(stack(
  ansVoice(0, 0.6),
  gate(above(ansVoices, 0), ansVoice(2, 0.5).mul(gain(ramp(ansVoices, 0, 0.5)))),
  gate(above(ansVoices, 0.5), ansVoice(4, 0.42).mul(gain(ramp(ansVoices, 0.5, 1))))
).pan("[0.3 0.7]*8").delay(0.45), 2, ans.space.fmap(s => 0.35 + 0.65 * s)), {
  lpf: expRange(ans.bright, 1200, 9000),
  level: ans.level.range(0, 1),
})

// ============================================================
// JONAS 6 GLOCKENSPIEL — a real glockenspiel (General MIDI soundfont) on chord tones, high up, struck as by hand:
// loose velocities, a few notes per bar, each bar ringing out; long echoes
// ============================================================
// @010 ctl 16:6.k1 Brightness | soft glow ↔ ringing, bright (lpf 3–16 kHz).
// @010 ctl 16:6.k2 Space | dry ↔ far away (reverb + echo).
// @010 ctl 16:6.k3 Density | a few notes per bar ↔ a busy pattern (~60 % of the 16ths).
// @010 ctl 16:6.fader Level | glockenspiel on the chord.
// @010 ctl 16:6.b1 Change | next of 8 random patterns.
// @010 ctl 16:6.b2 Run | runs up and down the chord, denser and louder the longer it is held (full after 2 bars).
const bells    = colJonas(6)
const bellVar  = change(bells.btn, 'jonas', 'Glocken')
const bellKeep = bells.char.fmap(d => 0.1 + 0.5 * d)   // share of 16ths
const bellRise = heldRamp(bells.btn2, 2)                // 0 → 1 over 2 bars while held
const BELL_TONES = [0, 2, 4, 6, 7, 9, 11]
const bellNote = steps => n(irand(7).segment(steps).fmap(i => BELL_TONES[i]))
// Every bar keeps ringing after the next is struck (a metal bar, no damper)
const glock = pat => pat.s("gm_glockenspiel").release(1.2)
// A player's sweep: up and down the chord tones in 32nds, two octaves (scale degrees above the root)
const BELL_RUN = n("[0 2 4 6 7 9 11 13 14 13 11 9 7 6 4 2]*2")

const stemN6_bells = strip(bus(onRoot(stack(
  reseed(bellVar, glock(bellNote(16)
    .degradeBy(bellKeep.fmap(k => 1 - k)))
    .gain(rand.range(0.45, 0.85))
    .pan(rand.range(0.25, 0.75))
    .delay(0.5)),
  // Run: starts as a few scattered notes of the sweep and fills in over 2 bars (15 % → 90 % of the 32nds), getting
  // louder; random velocities keep it played, not ticking. Released = gone.
  gate(held(bells.btn2), glock(BELL_RUN.degradeBy(bellRise.fmap(r => 0.85 - 0.75 * r)))
    .gain(bellRise.fmap(r => v => (0.35 + 0.55 * r) * v).appLeft(rand.range(0.7, 1)))
    .pan(sine.fast(2).range(0.3, 0.7)).delay(0.4))
)).scale(scaleIn(5)), 2, bells.space), {
  lpf: expRange(bells.bright, 3000, 16000),
  level: bells.level.range(0, 1),
})

// ============================================================
// JONAS 7 BIRDS — the sunrise: short sine chirps on chord tones high up, each a quick pitch sweep (no samples)
// ============================================================
// Each chirp starts up to 10 semitones off its note and sweeps onto it within ~50 ms: “tsiu” down or “tuii” up.
// @010 ctl 16:7.k1 Brightness | far, muffled birds ↔ close and clear (lpf 2–14 kHz).
// @010 ctl 16:7.k2 Space | a little room ↔ far away across the field (reverb + echo).
// @010 ctl 16:7.k3 Amount | a few calls ↔ a busy dawn chorus, an octave higher too.
// @010 ctl 16:7.fader Level | bird chirps on the chord.
// @010 ctl 16:7.b1 Change | next of 8 call rhythms (new notes too).
// @010 ctl 16:7.b2 Flock | a whole flock calls while held.
const birds   = colJonas(7)
const birdVar = change(birds.btn, 'jonas', 'Vögel')
const birdAmt = birds.char
const BIRD_RHYTHMS = ["~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [x x] ~ ~ ~ ~ ~", "~ ~ ~ x ~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ ~", "~ ~ ~ ~ ~ ~ [x x x] ~ ~ ~ ~ ~ ~ ~ ~ ~",
  "<[~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [x x] ~ x ~] ~>", "~ [x x] ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~", "~ ~ ~ ~ ~ x ~ ~ ~ ~ ~ ~ ~ ~ x ~",
  "<~ [~ ~ ~ ~ ~ ~ ~ ~ [x x x x] ~ ~ ~ ~ ~ ~ ~]>", "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ [x x] x"]
const BIRD_TONES = [0, 2, 4, 7]
const birdNotes  = n(reseed(birdVar, irand(4).segment(32).fmap(i => BIRD_TONES[i])))
const chirp = (pat, octave, g) => onRoot(pat).scale(scaleIn(octave))
  .s("sine").penv(rand.range(-8, 10)).pdecay(0.05)
  .attack(0.003).decay(rand.range(0.05, 0.1)).sustain(0).release(0.03).gain(g)
const birdMain = pick(birdVar, BIRD_RHYTHMS.map(r => pure(1).struct(r))).fmap(() => v => v).appLeft(birdNotes)

const stemN7_birds = strip(bus(stack(
  chirp(birdMain, 6, 0.22).pan(rand.range(0.25, 0.75)).delay(0.3),
  gate(above(birdAmt, 0), chirp(birdNotes.degradeBy(birdAmt.fmap(a => 1 - 0.18 * a)), 7, 0.15)
    .mul(gain(birdAmt)).pan(rand).delay(0.5)),
  gate(held(birds.btn2), chirp(birdNotes.degradeBy(0.4), 6, 0.2).pan(rand).delay(0.4))
), 2, birds.space.fmap(s => 0.3 + 0.7 * s)), {
  lpf: expRange(birds.bright, 2000, 14000),
  level: birds.level.range(0, 1),
})


// What the LC view shows for this track: the chapter (now, next) on column 8 button 1, and extra lines at the top
const lcChapter = () => [CHAPTERS[chapterLatch.now].name, CHAPTERS[chapterLatch.pending].name]
const lcHead    = () => [['Akkorde', CHAPTERS[chapterLatch.now].chords]]
// Where the music is (LC view): the beat in the bar and the bar in the big cycle. A silent event per beat moves it at
// the moment the beat sounds (onTrigger, as in the set). chordAt(bar) = the chord of that bar ('' = none shown)
const CYCLE   = 4   // one phrase: 4 chords, one per bar
const chordAt = bar => CHAPTERS[chapterLatch.now].chords.split(' – ')[bar % 4]
const beatNow = { bar: null, beat: null }
const beatTick = pure(0).segment(4).fmap(() => ({})).onTrigger((hap, now, cps, t) => {
  const pos = hap.whole.begin.valueOf(), bar = Math.floor(pos + 1e-9), beat = Math.floor((pos - bar) * 4 + 1e-9)
  setTimeout(() => { beatNow.bar = bar; beatNow.beat = beat; lcView?.update() }, Math.max(0, (t - now) * 1000))
}, true)

// LC view of this evaluation: names from the tags in the editor (strudel.cc keeps the text in strudelMirror),
// buttons from the change() rows (row i = column i + 1), chapter and break on column 8
return { taps, showStatus, STATUS, lcChapter, lcHead, stems: { J1: stemJ1_kick, J2: stemJ2_noise, J3: stemJ3_sub, J4: stemJ4_bass, J5: stemJ5_clap, J6: stemJ6_hats, J7: stemJ7_perc, J8: stemJ8_shake, N1: stemN1_pad, N2: stemN2_keys, N3: stemN3_arp, N4: stemN4_lead, N5: stemN5_ans, N6: stemN6_bells, N7: stemN7_birds } }
})()

// ============================================================
// TRACK 009 — Cool House (from tracks/009/009-cool-house-dual.strudel)
// ============================================================
// @009 layout Track 009 — cool house (two controllers)
// @009 note Cool, minimal classic house in A minor, 122 BPM: few parts, straight grid, one iconic stab. Jojo plays the foundation (kick, bass, drums, ride), Jonas the colour (pad, stab, riff, acid, Rhodes, voice, dub chord) and the global column 8.
// @009 note Every row means the same everywhere: row 1 = brightness, row 2 = space, row 3 = character, fader = level, button 1 = next pattern (at the next bar), button 2 = a moment while held.
// @009 note Start with all faders down. Nothing sounds until Jonas' master fader (column 8) is up. Chapter (Jonas, column 8) changes the chords for everybody at the next 4-bar phrase.
// @009 note The status box at the bottom right of the Strudel page shows chapter, break and each stem's pattern. Its button “als Fenster” opens it as a small window that stays on top (Chrome/Edge).
// @009 mode B16 Jojo — Foundation (beat + bass)
// @009 col B16:1 1 Kick
// @009 col B16:2 2 Atmo
// @009 col B16:3 3 Sub
// @009 col B16:4 4 Rubber Bass
// @009 col B16:5 5 Clap / Snare
// @009 col B16:6 6 Hats
// @009 col B16:7 7 Rim / Toms
// @009 col B16:8 8 Shaker / Ride
// @009 row B16:k1 Row 1 \ Brightness
// @009 row B16:k2 Row 2 \ Space
// @009 row B16:k3 Row 3 \ Character
// @009 row B16:fader Fader \ Level
// @009 row B16:b1 Button 1 \ Change
// @009 row B16:b2 Button 2 \ Moment
// @009 mode 16 Jonas — Colour (chords + melodies) · column 8 = global
// @009 col 16:1 1 Pad
// @009 col 16:2 2 Stab
// @009 col 16:3 3 Riff
// @009 col 16:4 4 Acid
// @009 col 16:5 5 Rhodes
// @009 col 16:6 6 Voice
// @009 col 16:7 7 Dub Chord
// @009 col 16:8 8 Global
// @009 row 16:k1 Row 1 \ Brightness
// @009 row 16:k2 Row 2 \ Space
// @009 row 16:k3 Row 3 \ Character
// @009 row 16:fader Fader \ Level
// @009 row 16:b1 Button 1 \ Change
// @009 row 16:b2 Button 2 \ Moment
// @009 guide Playing together | Less is the point: Jojo builds kick, hats, sub and clap and then mostly leaves the patterns alone. Atmo, rim and shaker / ride come and go with the faders.
// @009 guide Playing together | Jonas: the stab is the hook. Bring it in alone, let it run for 16 bars, work only its brightness. The riff or the acid line is the second voice, rarely all three at once. Pad, Rhodes, voice and dub chord are for the quiet parts.
// @009 guide Playing together | Chapter changes the chords for both players at the next 4-bar phrase. Chapters 1-4 are voice-led progressions, 5-8 the parallel minor-9 chord memory. Sub, bass and the chords follow; riff, acid and voice keep their melody and only bend a note where it would clash. Pad button 2 (freeze) holds the chord for everybody.
// @009 guide Playing together | Build-up and drop: Jonas turns Tension up (echo, open filters, snare roll), presses Break at the top: the beat goes out, pad and stab float. Jojo holds the riser (atmo, button 2), Jonas presses Break again: everything is back on the one. Then let Tension go.
// @009 guide Every position sounds good | Space 0 is dry and close, as the track is meant to be; room is a colour you add. No filter closes completely.
const T009 = (() => {
const ID = 2
const PHRASE = phraseOf(SET_TRACKS[2])
const ORBIT0 = 0
const focusOnly = button => button.fmap(v => SET.focus() === ID ? v : 0)

const ramp = (sig, from, to) => sig.fmap(v => Math.min(1, Math.max(0, (v - from) / (to - from))))
// Row-3 crossfade: 0..0.5 brings the extra layer in, 0.5..1 fades the main layer out
const fadeMain  = knob => ramp(knob, 1, 0.5)
const fadeExtra = knob => ramp(knob, 0, 0.5)
// Exponential knob range for filters (Hz), so every part of the knob travel is audible
const expRange = (knob, lo, hi) => knob.fmap(v => lo * Math.pow(hi / lo, v))

const bpm  = 122
const beat = 60 / bpm   // seconds per quarter note, for delay times

// Mapping of column n (1-8): brightness, space, character (knob rows 1-3), fader, button rows 1-2
const colMap = (read, n) => ({ bright: read(12 + n), space: read(20 + n), char: read(28 + n), level: read(4 + n), btn: read(36 + n), btn2: read(44 + n) })
const off = () => signal(() => 0)
// Column 8 (global) is read from both its Mode 16 and Mode 2 CCs, last moved wins: it works on both pages even on a
// controller whose column 8 sends CC + 48 in Mode 2
// One controller: Jojo on the plain CCs (Mode 1), Jonas on CC + 48 (Mode 2)
const alone    = !ccJojo
const colJonas = n => n === 8 ? SET.glob : colMap(n === 8 ? c => lastMoved(ccJonas(c), ccJonas(c + 48)) : alone ? c => ccJonas(c + 48) : ccJonas, n)
const colJojo  = n => !alone ? colMap(ccJojo, n) : n === 8 ? colMap(off, n) : colMap(ccJonas, n)

const gate  = (cond, pat) => cond.fmap(on => on ? pat : silence).innerJoin()
const above = (sig, x) => sig.fmap(v => v > x)
const and   = (a, b) => a.fmap(x => y => x && y).appLeft(b)
const held  = button => button.fmap(v => v > 0.5)

// Stateful controls, collected so the master can query them every tick (see stateTaps)
const taps = []

// Two inputs for one control: the value follows whichever moved last (stateful, so it is queried via stateTaps)
const lastMoved = (a, b) => {
  let pa = null, pb = null, v = 0
  const pat = a.fmap(x => y => {
    if (pa === null) v = Math.max(x, y)
    else if (y !== pb) v = y
    else if (x !== pa) v = x
    pa = x; pb = y
    return v
  }).appLeft(b)
  taps.push(pat)
  return pat
}

// Momentary button that steps through n states, one step per press (counts presses, not the held value).
// onChange(state) runs on every step (for the status box). Re-evaluating the code starts again at 0.
const cycleButton = (button, n, onChange = () => {}) => {
  button = focusOnly(button)   // set: presses count only for the track in focus
  let prev = 0, state = 0
  const pat = button.fmap(v => {
    if (v > 0.5 && prev <= 0.5) { state = (state + 1) % n; onChange(state) }
    prev = v
    return state
  })
  taps.push(pat)
  return pat
}

// A value that a button sets now but that takes over only at the next bar line, or with len = 4 at the next
// 4-bar phrase (chapter). at(t) is asked with bar starts in real time (outside any reseed shift); it remembers the
// previous value for queries that still reach back into the old bar. pat = the value per bar.
const barLatch = (len = 1) => {
  const l = { pending: 0, now: 0, prev: 0, bar: -Infinity }
  l.at = t => {
    const bar = Math.floor(Number(t) / len)
    if (bar > l.bar) {
      if (l.pending !== l.now) { l.prev = l.now; l.now = l.pending; showStatus() }
      else l.prev = l.now
      l.bar = bar
    }
    return bar >= l.bar ? l.now : l.prev
  }
  l.pat = signal(t => l.at(t)).segment(1)
  taps.push(l.pat)
  return l
}

// 0 → 1 over `cycles` while a button is held, back to 0 on release (for risers)
const heldRamp = (button, cycles) => {
  let start = null
  const pat = button.fmap(v => t => {
    if (v <= 0.5) { start = null; return 0 }
    start ??= t
    return Math.min(1, Math.max(0, (t - start) / cycles))
  }).appLeft(signal(t => Number(t)))
  taps.push(pat)
  return pat
}

// Freeze: while the button is held, keep returning the value that was playing when it was pressed
const freeze = (button, pat) => {
  let kept = null
  return pat.fmap(v => b => b > 0.5 ? (kept ??= v) : (kept = null, v)).appLeft(button)
}


// ============================================================
// CHAPTERS — eight chord sequences in A minor, one chord per bar, 4 bars = one phrase
// ============================================================
// Every chord: bass = the bass note as MIDI between A1 and G♯2 (55–104 Hz); root = the stab's root between F3 and
// E4; tones = four chord notes (G3–B4) for pad, stab, Rhodes and dub; scale = the pitch classes a melody note may
// land on over this chord (chord tones + tensions that fit).
const midi = name => {
  const m = name.match(/^([a-g])(#|b)?(\d)$/)
  return 12 * (+m[3] + 1) + { c: 0, d: 2, e: 4, f: 5, g: 7, a: 9, b: 11 }[m[1]] + (m[2] === '#' ? 1 : m[2] === 'b' ? -1 : 0)
}
const pc = m => (m % 12 + 12) % 12
const rootOf = bass => 53 + pc(bass - 53)
// Chapters 1-4: voice-led chords (each chord moves to the nearest notes of the next), tones and scale by name;
// the stab's root sits just below the lowest tone (C3–A3), so it never crowds the voicing
const chord = (name, bassName, toneNames, scaleNames) => {
  const bass = midi(bassName), tones = toneNames.split(' ').map(midi), low = Math.min(...tones)
  return { name, bass, root: low - 12 + pc(bass - low), tones, scale: scaleNames.split(' ').map(s => pc(midi(s + '4'))) }
}
// Chapters 5-8 (v1): the same minor-9 shape (root, ♭3, 5, ♭7, 9) on every bass note, moved in parallel: the
// chord-memory sound of early house, cool and a little chromatic (Fm9 and Gm9 are not in A minor; that is the point)
const m9 = (name, bassName) => {
  const bass = midi(bassName), root = rootOf(bass)
  return { name, bass, root, tones: [3, 7, 10, 14].map(i => root + i), scale: [0, 2, 3, 5, 7, 10].map(i => pc(root + i)) }
}
const Am9   = chord('Am9',   'a1', 'c4 e4 g4 b4',   'a b c d e g')
const D9    = chord('D9',    'd2', 'c4 e4 f#4 a4',  'd e f# a b c')     // the Dorian IV: the F♯ is the colour
const G69   = chord('G6/9',  'g2', 'b3 d4 e4 a4',   'g a b d e')
const Fmaj9 = chord('Fmaj9', 'f2', 'a3 c4 e4 g4',   'f g a c e')
const Em11  = chord('Em11',  'e2', 'g3 b3 d4 a4',   'e g a b d')
const Dm9   = chord('Dm9',   'd2', 'c4 e4 f4 a4',   'd e f g a c')
const E7b9  = chord('E7♭9',  'e2', 'g#3 b3 d4 f4',  'e f g# a b d')     // the dominant: G♯ pulls back home
const G13   = chord('G13',   'g2', 'b3 e4 f4 a4',   'g a b d e f')
const Cmaj9 = chord('Cmaj9', 'c2', 'b3 d4 e4 g4',   'c d e g a b')
const Am = m9('Am9', 'a1'), Dm = m9('Dm9', 'd2'), Em = m9('Em9', 'e2'), Fm = m9('Fm9', 'f2'), Gm = m9('Gm9', 'g2')
const CHAPTERS = [
  { name: 'Offen',   chords: [Am9, Am9, D9, D9] },          // i – IV (Dorian): two chords, warm and open
  { name: 'Abstieg', chords: [Am9, G69, Fmaj9, Em11] },     // i – ♭VII – ♭VI – v: the descent, step by step
  { name: 'Seele',   chords: [Fmaj9, Em11, Dm9, E7b9] },    // ♭VI – v – iv – V: soulful, the E7 pulls into the next round
  { name: 'Kreis',   chords: [Dm9, G13, Cmaj9, E7b9] },     // iv – ♭VII – ♭III – V: around the circle of fifths
  { name: 'Memory Eins',   chords: [Am, Am, Am, Am] },     // one chord: the vamp, the most classic of all
  { name: 'Memory Pendel', chords: [Am, Am, Dm, Dm] },     // i – iv, two bars each
  { name: 'Memory Tief',   chords: [Am, Am, Fm, Gm] },     // down a major third, then up a step: dark, chromatic
  { name: 'Memory Nacht',  chords: [Dm, Em, Am, Am] },     // iv – v – i
]
const CHORDS = CHAPTERS.flatMap(c => c.chords)   // chord id = chapter * 4 + bar

// Rows of the status box, filled by change(): { label, latch, n, names } per player
const STATUS = { jojo: [], jonas: [] }
const showStatus = () => {
  if (!statusUi || SET.focus() !== ID) return
  const dots = v => [...Array(8).keys()].map(k => k === v ? '●' : '○').join('')
  const show = (r, v) => !r.names ? String(v + 1) : r.names[v]
  const line = (r, i) => (i + 1) + ' ' + r.label.padEnd(10) + ' ' + (r.n === 8 ? dots(r.latch.now) + ' ' : '') +
    show(r, r.latch.now) + (r.latch.pending !== r.latch.now ? ' → ' + show(r, r.latch.pending) : '')
  const ch = chapterLatch
  statusUi.text.textContent = [
    ...SET.statusLines(),
    'Kapitel     ' + CHAPTERS[ch.now].name +
      (ch.pending !== ch.now ? ' → ' + CHAPTERS[ch.pending].name + ' (nächste Phrase)' : ''),
    'Akkorde     ' + CHAPTERS[ch.now].chords.map(c => c.name).join(' – '),
    '', alone ? 'Mode 1 · Jojo' : 'Jojo', ...STATUS.jojo.map(line),
    '', alone ? 'Mode 2 · Jonas' : 'Jonas', ...STATUS.jonas.map(line),
  ].join('\n')
  lcView?.update()
}
// Button 1 of a stem: n patterns (default 8), one step per press, taking over at the next bar
const change = (button, who, label, n = 8, names) => {
  const latch = barLatch()
  cycleButton(button, n, s => { latch.pending = s; showStatus() })
  STATUS[who].push({ label, latch, n, names })
  return latch
}
// Pattern number i of a list, switched by a change latch
const pick = (latch, pats) => latch.pat.fmap(i => pats[i]).innerJoin()

// ============================================================
// GLOBAL (Jonas, column 8) — acts on both controllers
// ============================================================
// @009 ctl g.k1 Fog | 0 = clear, up = every filter pulled down to ~6 %: muffled, as if from outside the club.
// @009 ctl g.k2 Room | 0 = each sound's own room (row 2), up = everything drowns in reverb.
// @009 ctl g.k3 Tension | build-up: echo grows, filters open, from the middle a snare roll (clap fader). 0 = release.
// @009 ctl g.fader Master Level | volume of everything, both controllers. 0 = silence.
// @009 ctl g.b1 Chapter | next chords for all, at the next phrase (5-8: chord memory).
// @009 ctl g.b2 Break / Drop | 1st: beat out. 2nd: all back on the one.
const glob        = colJonas(8)
const globalFog   = glob.bright.fmap(f => Math.pow(0.06, f))
const globalRoom  = glob.space
const tension     = glob.char
const tensionEcho = ramp(tension, 0, 0.5).mul(0.45)     // delay send, 0..0.45
const tensionRoll = ramp(tension, 0.5, 1)               // snare roll, 0..1
// Factor on every lpf: fog darkens (down to 0.06), tension opens (up to 2.5)
const globalTone  = globalFog.fmap(f => o => f * o).appLeft(tension.fmap(t => 1 + 1.5 * t))
const globalLevel = glob.level.range(0, 1)

const chapterLatch = barLatch(PHRASE)
cycleButton(glob.btn, CHAPTERS.length, s => { chapterLatch.pending = s; showStatus() })
const breakLatch = barLatch()
cycleButton(glob.btn2, 2, s => { breakLatch.pending = s; showStatus() })
// Jojo's low end and backbeat, gated while the break is on
const beatOn   = breakLatch.pat.fmap(b => b === 0)
const beatOnly = pat => gate(beatOn, pat)

const audible = level => and(above(level, 0), above(globalLevel, 0))
// lpf × fog/tension, kept between 80 Hz and 18 kHz (fog never makes a stem silent)
const toned  = lpf => lpf.fmap(f => g => Math.min(18000, Math.max(80, f * g))).appLeft(globalTone)
// Reverb send: the stem's space knob (0..0.9), raised by the global Room up to 0.95
const roomOf = space => space.fmap(s => g => { const r = 0.9 * s; return r + (0.95 - r) * g }).appLeft(globalRoom)
// Change: read the stem's randomness 1024 cycles further per step (keeps bar alignment, new random values).
// The chords are applied after reseed, so they follow real time.
const reseed = (latch, pat) => pat.early(latch.pat.fmap(v => v * 1024))

// Effect buses. Each orbit has one reverb and one delay, and every reverb costs a lot of CPU, so the stems share
// two orbits; stems on one orbit share room size and echo time/feedback. Both rooms are small: the track is dry.
// Orbit 1 = drums and bass: a small room, short dotted-8th slap.
// Orbit 2 = all of Jonas' colour (and the noise riser): a studio room, dotted-8th echo (the house piano echo).
const BUSES = {
  1: { hall: 1, time: beat * 0.75, feedback: 0.25 },
  2: { hall: 2.2, time: beat * 0.75, feedback: 0.4 },
}
// bus(): reverb from the space knob, and echo: the layer's own delay amount (or `echo` if it has none) × 2 × space,
// so space 0.5 = the designed amount; Tension's echo takes over where it is larger.
const bus = (pat, orbit, space, echo = 0) => pat
  .fmap(v => sc => e => ({ ...v, delay: Math.max(Math.min(0.9, (v.delay ?? echo) * sc), e) }))
  .appLeft(space.fmap(s => 2 * s)).appLeft(tensionEcho)
  .room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)
  .delaytime(BUSES[orbit].time).delayfeedback(BUSES[orbit].feedback)
// Reverb only, no echo (kick, sub and bass would smear)
const dryBus = (pat, orbit, space) => pat.room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)

// Channel strip: lpf × fog/tension (if given), level × master as postgain, gated while the fader or master is 0
const strip = (stem, { lpf, level }) => {
  const pat = lpf === undefined ? stem : stem.lpf(toned(lpf))
  return gate(audible(level), pat.postgain(level.mul(globalLevel)))
}
const drum = (names, bank = 'RolandTR909') => s(names).bank(bank)

// ============================================================
// HARMONY — Chapter picks the bass notes, everybody follows in parallel; pad button 2 freezes the chord for all
// ============================================================
const PROG_PATS = CHAPTERS.map((c, ci) => cat(...c.chords.map((_, i) => ci * 4 + i)))   // chord id per bar
const pad     = colJonas(1)
const harmId  = freeze(pad.btn2, pick(chapterLatch, PROG_PATS))
const bassOf  = harm => harm.fmap(id => CHORDS[id].bass)
// A pattern of semitone offsets → notes above the bar's bass note (+ shift) or the stab's root (+ shift)
const fromBass = (offsets, shift = 0) => note(reify(offsets).fmap(d => id => CHORDS[id].bass + shift + d).appLeft(harmId))
const fromRoot = (offsets, shift = 0) => note(reify(offsets).fmap(d => id => CHORDS[id].root + shift + d).appLeft(harmId))
// A fixed melody (note names, A minor): each note stays where it is if it fits the bar's chord, otherwise it moves
// to the nearest note of the chord's scale (one or two semitones). So the line stays put while the chords move.
const snap = (m, scale) => { for (const d of [0, -1, 1, -2, 2]) if (scale.includes(pc(m + d))) return m + d; return m }
const fixed = names => note(reify(names).fmap(n => id => snap(midi(n), CHORDS[id].scale)).appLeft(harmId))
// The current chord as a stack of notes (shape: chord → MIDI notes), built once per chord and shape
const STACKS = {}
const chordStack = (key, shape, harm = harmId) => harm.fmap(id => STACKS[key + id] ??= note(stack(...shape(CHORDS[id])))).innerJoin()
// Velocity pattern ("0.9 ~ ~ 0.7 …") as rhythm: every hit plays all notes of `notes` with that gain
const playOn = (vel, notes) => gain(vel).fmap(g => v => ({ ...v, ...g })).appLeft(notes)

// ============================================================
// JOJO 1 KICK — a punchy 909 kick with a short sine body on A1 underneath (tuned to the key)
// ============================================================
// Knobs at 0 = the full house kick. Softness up = the 909 fades back, the body gets rounder and longer.
// @009 ctl B16:1.k1 Brightness | 0 = full and punchy ↔ extra click on top (lpf 3–16 kHz).
// @009 ctl B16:1.k2 Space | dry and close ↔ in a room (reverb).
// @009 ctl B16:1.k3 Softness | 0 = punchy 909 kick ↔ 1 = soft, round thump.
// @009 ctl B16:1.fader Level | 0 = gone. Four-on-the-floor kick, tuned to A.
// @009 ctl B16:1.b1 Change | straight → a gap every 4th bar → a gap every 8th bar.
// @009 ctl B16:1.b2 Drop out | kick pauses while held.
const kick     = colJojo(1)
const kickVar  = change(kick.btn, 'jojo', 'Kick', 3, ['gerade', 'Lücke 4', 'Lücke 8'])
const kickSoft = kick.char
const KICKS = ["1*4", "<[1*4] [1*4] [1*4] [1 1 1 ~]>", "<[1*4]!7 [1 1 ~ ~]>"]
  .map(g => stack(
    gain(g).mul(gain(kickSoft.fmap(s => 0.7 * (1 - 0.75 * s)))).s("bd").bank("RolandTR909"),
    gain(g).mul(gain(kickSoft.fmap(s => 0.4 + 0.2 * s))).note("a1").s("sine")
      .attack(kickSoft.fmap(s => 0.002 + 0.01 * s)).decay(kickSoft.fmap(s => 0.22 + 0.2 * s)).sustain(0).release(0.04)
      .penv(kickSoft.fmap(s => 30 - 14 * s)).pdecay(kickSoft.fmap(s => 0.03 + 0.04 * s))
  ))

const stemJ1_kick = beatOnly(gate(kick.btn2.fmap(v => v <= 0.5), strip(dryBus(
  pick(kickVar, KICKS), 1, kick.space), {
  lpf: expRange(kick.bright, 3000, 16000),
  level: kick.level.range(0, 1),
})))

// ============================================================
// JOJO 2 ATMO — soft tape-hiss noise glued to the kick (swells in after every kick, like a sidechain), cooler and
// thinner than in 010; or off-beat breaths, or slow waves. Button 2: the noise riser (was on the ride column).
// ============================================================
// @009 ctl B16:2.k1 Brightness | dull whoosh ↔ airy hiss (lpf 1.5–12 kHz).
// @009 ctl B16:2.k2 Space | dry ↔ far away (reverb + echo).
// @009 ctl B16:2.k3 Motion | still ↔ the filter breathes and the noise wanders left and right.
// @009 ctl B16:2.fader Level | noise that pumps with the kick.
// @009 ctl B16:2.b1 Change | pump → off-beat breath → slow waves.
// @009 ctl B16:2.b2 Riser | a noise sweep rises over 2 bars while held. Keeps playing in the break.
const noiseCol  = colJojo(2)
const noiseVar  = change(noiseCol.btn, 'jojo', 'Atmo', 3, ['Pumpe', 'Offbeat', 'Wellen'])
const noiseMove = noiseCol.char
const noiseRise = heldRamp(noiseCol.btn2, 2)
const NOISES = [
  s("[~ pink@3]*4").attack(0.12).sustain(0.6).release(0.03).hpf(1500).gain(1.6),
  s("[~ pink]*4").attack(0.06).sustain(0.4).release(0.05).hpf(2500).gain(1.6),
  s("pink/2").attack(1.8).sustain(1).release(1.8).hpf(600).gain(1.1),
]
// Riser: 16th noise bursts through a bandpass that climbs from 300 Hz to 6 kHz, getting louder
const noiseRiser = gate(held(noiseCol.btn2), s("pink*16")
  .attack(0.03).sustain(0.8).release(0.15)
  .bpf(noiseRise.fmap(r => 300 * Math.pow(20, r))).bpq(4)
  .gain(noiseRise.mul(0.35)).pan(sine.fast(2)))

const stemJ2_noise = strip(stack(
  beatOnly(bus(pick(noiseVar, NOISES)
    .lpf(toned(expRange(noiseCol.bright, 1500, 12000)).fmap(f => m => w => f * (1 - 0.7 * m * w)).appLeft(noiseMove).appLeft(sine.slow(2)))
    .pan(noiseMove.fmap(m => p => 0.5 + m * (p - 0.5)).appLeft(sine.slow(3))), 1, noiseCol.space, 0.15)),
  bus(noiseRiser, 2, pure(0.3))
), {
  level: noiseCol.level.range(0, 1),
})

// ============================================================
// JOJO 3 SUB — a sine on the chord's bass note (55–104 Hz): each note starts a 16th after the kick (ducked, without a compressor)
// ============================================================
// @009 ctl B16:3.k1 Brightness | 0 = sine with a few overtones (audible on small speakers) ↔ warm and full.
// @009 ctl B16:3.k2 Space | dry ↔ a little room (reverb).
// @009 ctl B16:3.k3 Length | long, pumping notes ↔ short, bouncing ones.
// @009 ctl B16:3.fader Level | sub on the chord's bass note, follows the chapter.
// @009 ctl B16:3.b1 Change | pump → off-beat → half bars.
// @009 ctl B16:3.b2 Slide | every note bends up into its pitch while held.
const sub      = colJojo(3)
const subVar   = change(sub.btn, 'jojo', 'Sub', 3, ['Pumpe', 'Offbeat', 'Halbe'])
const subClip  = sub.char.fmap(c => 1 - 0.65 * c)   // share of the note length that sounds
const subSlide = sub.btn2.fmap(v => v > 0.5 ? -5 : 0)
const SUBS = ["[~ x@3]*4", "[~ x]*4", "[~ x@7]*2"].map(r => note(bassOf(harmId)).struct(r))
const subNotes = pick(subVar, SUBS)

const stemJ3_sub = beatOnly(strip(dryBus(stack(
  subNotes.s("sine").gain(0.5),
  subNotes.s("triangle").gain(sub.bright.fmap(b => 0.1 + 0.17 * b))
).attack(0.015).sustain(1).release(0.04).clip(subClip).penv(subSlide).pattack(0.07), 1, sub.space), {
  level: sub.level.range(0, 1),
}))

// ============================================================
// JOJO 4 RUBBER BASS — a short, dark bass on the chord's bass note an octave up (110–208 Hz): sine body + a
// low-passed saw. Plain notes, no jumping around: the stab is the melody.
// ============================================================
// @009 ctl B16:4.k1 Brightness | dark and round ↔ a buzzing edge (lpf 250–2500 Hz).
// @009 ctl B16:4.k2 Space | dry ↔ a little room (reverb).
// @009 ctl B16:4.k3 Rubber | 0 = plain notes ↔ the filter snaps open on every note (rubbery, “bwop”).
// @009 ctl B16:4.fader Level | rubber bass, follows the chapter.
// @009 ctl B16:4.b1 Change | off-beat → off-beat with octave → 3-3-2.
// @009 ctl B16:4.b2 Octave | one octave up while held.
const bassCol = colJojo(4)
const bassVar = change(bassCol.btn, 'jojo', 'Bass', 3, ['Offbeat', 'Oktave', '3-3-2'])
const bassOct = bassCol.btn2.fmap(v => v > 0.5 ? 12 : 0)
// Semitones above the chord's bass note + 12 (12 = another octave)
const BASS_LINES = ["[~ ~ 0 ~]*4", "[~ ~ 0 ~] [~ ~ 12 ~] [~ ~ 0 ~] [~ ~ 12 ~]", "0 ~ ~ 0 ~ ~ 0 ~ ~ ~ ~ ~ ~ ~ ~ ~"]
  .map(p => fromBass(p, 12))
const bassNotes = pick(bassVar, BASS_LINES).add(note(bassOct))

const stemJ4_bass = beatOnly(strip(dryBus(stack(
  bassNotes.s("sine").gain(0.25),
  bassNotes.s("sawtooth").gain(0.12).lpenv(bassCol.char.mul(4)).lpdecay(0.1).lpq(2)
).attack(0.004).decay(0.2).sustain(0.2).release(0.05), 1, bassCol.space), {
  lpf: expRange(bassCol.bright, 250, 2500),
  level: bassCol.level.range(0, 1),
}))

// ============================================================
// JOJO 5 CLAP / SNARE — one 909 clap on 2 and 4; the character knob trades it for the 909 snare
// ============================================================
// @009 ctl B16:5.k1 Brightness | warm ↔ sharp crack (lpf 2–12 kHz).
// @009 ctl B16:5.k2 Space | dry ↔ far away (reverb + echo).
// @009 ctl B16:5.k3 Snare | 0 = 909 clap ↔ clap + snare ↔ 1 = 909 snare.
// @009 ctl B16:5.fader Level | clap on 2 and 4. Also the level of Tension's snare roll.
// @009 ctl B16:5.b1 Change | 2 and 4 → only 4 (half time) → a little fill every 4th bar.
// @009 ctl B16:5.b2 Roll | snare roll, growing over the bar, while held.
const clap     = colJojo(5)
const clapVar  = change(clap.btn, 'jojo', 'Clap', 3, ['2 + 4', 'nur 4', 'Fill 4'])
const snareMix = clap.char
const clapSound = pat => stack(
  pat.mul(gain(fadeMain(snareMix))).s("cp").bank("RolandTR909"),
  pat.mul(gain(fadeExtra(snareMix).mul(0.6))).s("sd").bank("RolandTR909")
).attack(0.001).decay(0.14).sustain(0).release(0.06)
const CLAPS = ["~ 0.8 ~ 0.8", "~ ~ ~ 0.8", "<[~ 0.8 ~ 0.8]!3 [~ 0.8 ~ [0.8 0.4]]>"].map(g => clapSound(gain(g)))

const stemJ5_clap = beatOnly(strip(bus(stack(
  pick(clapVar, CLAPS),
  gate(held(clap.btn2), drum("sd*16").gain(saw.range(0.1, 0.5))),
  // Tension roll: 8ths → 16ths, louder as Tension rises
  gate(above(tensionRoll, 0), drum("sd*16").degradeBy(tensionRoll.fmap(t => 0.5 * (1 - t)))
    .gain(tensionRoll.fmap(t => 0.1 + 0.35 * t)))
).mul(gain(0.7)).hpf(300).pan(0.48), 1, clap.space, 0.2), {
  lpf: expRange(clap.bright, 2000, 12000),
  level: clap.level.range(0, 1),
}))

// ============================================================
// JOJO 6 HATS — the house off-beat: a short open 909 hat between the kicks, closed 16ths in the other patterns
// ============================================================
// @009 ctl B16:6.k1 Brightness | soft hiss ↔ crisp and sharp (lpf 4–16 kHz).
// @009 ctl B16:6.k2 Space | dry ↔ far away (reverb + echo).
// @009 ctl B16:6.k3 Density | the pattern as it is ↔ + quiet, scattered 16ths.
// @009 ctl B16:6.fader Level | off-beat open hat. Keeps playing in the break.
// @009 ctl B16:6.b1 Change | off-beat → + straight 16ths → closed only.
// @009 ctl B16:6.b2 Open | open hats on every 8th while held.
const hats    = colJojo(6)
const hatVar  = change(hats.btn, 'jojo', 'Hats', 3, ['Offbeat', '+ 16tel', 'geschlossen'])
const hatDens = hats.char
const offHat  = drum("[~ oh]*4").gain(0.4).decay(0.22).sustain(0)   // short open hat: dry
const HATS = [
  offHat,
  stack(offHat, drum("hh*16").gain("[0.18 0.1 0.14 0.1]*4")),
  stack(drum("[~ hh]*4").gain(0.35), drum("hh*16").gain("[0.16 0.08 0.12 0.08]*4")),
]

const stemJ6_hats = strip(bus(stack(
  pick(hatVar, HATS),
  gate(above(hatDens, 0), drum("hh*16").degradeBy(0.5).gain(hatDens.mul(0.14))),
  gate(held(hats.btn2), drum("oh*8").gain(0.3).decay(0.22).sustain(0))
).mul(gain(0.7)).pan(0.56), 1, hats.space, 0.2), {
  lpf: expRange(hats.bright, 4000, 16000),
  level: hats.level.range(0, 1),
})

// ============================================================
// JOJO 7 PERC — RIM + TOMS — a 909 rimshot figure (the clave of house), toms with the character knob
// ============================================================
// @009 ctl B16:7.k1 Brightness | woody ↔ sharp click (lpf 2–14 kHz).
// @009 ctl B16:7.k2 Space | dry ↔ far away (reverb + echo).
// @009 ctl B16:7.k3 Toms | 0 = rim only ↔ + low and mid 909 toms.
// @009 ctl B16:7.fader Level | rimshot figure. Keeps playing in the break.
// @009 ctl B16:7.b1 Change | clave → offbeat pair → two-bar figure.
// @009 ctl B16:7.b2 Fill | a tom run over the bar while held.
const perc     = colJojo(7)
const percVar  = change(perc.btn, 'jojo', 'Rim', 3, ['Clave', 'Paar', 'Zweitakt'])
const rim      = g => gain(g).s("rim").bank("RolandTR909")
const RIMS = ["~ ~ ~ 0.3 ~ ~ 0.3 ~ ~ ~ ~ ~ 0.3 ~ ~ ~", "~ ~ 0.3 ~ ~ ~ ~ 0.22 ~ ~ 0.3 ~ ~ ~ ~ ~",
  "<[~ ~ ~ 0.3 ~ ~ 0.3 ~ ~ ~ ~ ~ 0.3 ~ ~ ~] [~ ~ ~ 0.3 ~ ~ 0.3 ~ ~ ~ 0.3 ~ ~ ~ ~ ~]>"].map(rim)

const stemJ7_perc = strip(bus(stack(
  pick(percVar, RIMS),
  gate(above(perc.char, 0), drum("~ ~ ~ ~ ~ ~ ~ lt ~ ~ ~ ~ ~ ~ mt ~").gain(perc.char.mul(0.3))),
  gate(held(perc.btn2), drum("[lt lt mt mt ht mt ht ht]*2").gain(saw.range(0.15, 0.35)))
).pan(0.4), 1, perc.space, 0.3), {
  lpf: expRange(perc.bright, 2000, 14000),
  level: perc.level.range(0, 1),
})

// ============================================================
// JOJO 8 SHAKER / RIDE — the 909 ride on the off-beats (the cool, metallic pulse of classic New York house),
// TR-727 maracas, or both with a TR-707 tambourine on 2 and 4; swing only with the knob
// ============================================================
// @009 ctl B16:8.k1 Brightness | soft shimmer ↔ bright sizzle (lpf 4.5–16 kHz).
// @009 ctl B16:8.k2 Space | dry ↔ far away (reverb + echo).
// @009 ctl B16:8.k3 Swing | straight ↔ swung, lazy (the in-between 16ths come late).
// @009 ctl B16:8.fader Level | ride and shaker. Keep playing in the break.
// @009 ctl B16:8.b1 Change | ride → shaker → both + tambourine.
// @009 ctl B16:8.b2 Double | double time while held.
const shake    = colJojo(8)
const shakeVar = change(shake.btn, 'jojo', 'Shaker', 3, ['Ride', 'Shaker', 'beides'])
const maracas  = g => gain(g).s("sh").bank("RolandTR727").n(1)
const tambo    = g => gain(g).s("tb").bank("RolandTR707")
const ride     = g => gain(g).s("rd").bank("RolandTR909").mul(gain(1 / 3))   // the stem's gain(3) is for the maracas
const SHAKERS = [
  ride("[~ 0.3]*4"),
  maracas("[0.3 0.15 0.22 0.15]*4"),
  stack(ride("[~ 0.24]*4"), maracas("[0.22 0.11 0.16 0.11]*4"), tambo("~ 0.3 ~ 0.3")),
]

const stemJ8_shake = strip(bus(pick(shakeVar, SHAKERS)
  .fast(shake.btn2.fmap(v => v > 0.5 ? 2 : 1))
  .swingBy(shake.char.mul(0.6), 8)   // 0.6 = the off-16th lands on the last triplet
  .mul(gain(3)).pan(0.62), 1, shake.space, 0.25), {
  lpf: expRange(shake.bright, 4500, 16000),
  level: shake.level.range(0, 1),
})

// ============================================================
// JONAS 1 PAD — a warm pad (soundfont) on the minor-9 chord, low in the mix: the room the stab plays in
// ============================================================
// @009 ctl 16:1.k1 Brightness | dark and far ↔ open (lpf 0.8–6 kHz).
// @009 ctl 16:1.k2 Space | dry ↔ a big hall (reverb + echo).
// @009 ctl 16:1.k3 Motion | 0 = still ↔ the filter breathes slowly over 8 bars.
// @009 ctl 16:1.fader Level | pad on the chapter's chords.
// @009 ctl 16:1.b1 Change | full chord → only the top (thin, high) → low and wide.
// @009 ctl 16:1.b2 Freeze | holds the current chord while held, for everybody.
const padVar  = change(pad.btn, 'jonas', 'Pad', 3, ['voll', 'hoch', 'tief'])
const PAD_VOICINGS = [
  chordStack('pv', c => c.tones),
  chordStack('ph', c => c.tones.slice(2).map(t => t + 12)),        // ♭7 and 9, an octave up
  chordStack('pl', c => [c.root - 12, c.root - 5, c.tones[0], c.tones[2]]),
]

const stemN1_pad = strip(bus(pick(padVar, PAD_VOICINGS)
  .s("gm_pad_warm").attack(0.8).sustain(0.9).release(1.5).gain(0.35).pan(sine.slow(5).range(0.4, 0.6)), 2, pad.space, 0.1), {
  lpf: expRange(pad.bright, 800, 6000).fmap(f => m => w => f * (1 - 0.7 * m * w)).appLeft(pad.char).appLeft(sine.slow(8)),
  level: pad.level.range(0, 1),
})

// ============================================================
// JONAS 2 STAB — the hook: the chapter's chord on its root, short and dry (in the Memory chapters the same minor-9
// shape on every bass note: chord memory). A saw stab, or with the character knob the M1-style organ stab.
// ============================================================
// @009 ctl 16:2.k1 Brightness | dark, muted stab ↔ open and biting (lpf 0.6–8 kHz).
// @009 ctl 16:2.k2 Space | dry ↔ the echoes repeat into the room.
// @009 ctl 16:2.k3 Sound | 0 = synth stab (saw) ↔ both ↔ 1 = M1-style organ stab.
// @009 ctl 16:2.fader Level | the stab on the chapter's chords.
// @009 ctl 16:2.b1 Change | off-beat → syncopated → a two-bar call.
// @009 ctl 16:2.b2 Open | the filter opens wide while held.
const stab     = colJonas(2)
const stabVar  = change(stab.btn, 'jonas', 'Stab', 3, ['Offbeat', 'Synkope', 'Ruf'])
const STAB_RHYTHMS = ["~ ~ 0.8 ~ ~ ~ 0.8 ~ ~ ~ 0.8 ~ ~ ~ 0.8 ~", "~ ~ 0.8 ~ ~ 0.7 ~ ~ ~ ~ 0.8 ~ ~ 0.7 ~ ~",
  "<[0.9 ~ ~ 0.7 ~ ~ 0.8 ~ ~ ~ ~ ~ ~ ~ ~ ~] [~ ~ ~ ~ ~ ~ 0.8 ~ ~ ~ 0.7 ~ ~ ~ ~ ~]>"]
const stabShape = chordStack('st', c => [c.root, ...c.tones])
const stabHits  = pick(stabVar, STAB_RHYTHMS.map(r => playOn(r, stabShape)))

const stemN2_stab = strip(bus(stack(
  gate(above(fadeMain(stab.char), 0), stabHits.s("sawtooth").mul(gain(fadeMain(stab.char).mul(0.1)))
    .attack(0.002).decay(0.22).sustain(0).release(0.05).lpenv(3).lpdecay(0.12).lpq(3)),
  gate(above(fadeExtra(stab.char), 0), stabHits.s("gm_percussive_organ").mul(gain(fadeExtra(stab.char).mul(0.4)))
    .decay(0.25).sustain(0).release(0.06))
).hpf(150).pan(0.45).delay(0.3), 2, stab.space), {
  lpf: expRange(stab.bright, 600, 8000).fmap(f => b => b > 0.5 ? Math.min(16000, f * 4) : f).appLeft(stab.btn2),
  level: stab.level.range(0, 1),
})

// ============================================================
// JONAS 3 RIFF — a piano riff in A minor that stays put while the chords move (a note bends only where it would
// clash), or, as an option, the v1 riffs that move in parallel with the chords
// ============================================================
// Piano as played: each note sounds for its written length, then the damper stops it; Pedal lets the notes ring on.
// Parallel riffs: semitones above the stab's root an octave up (3 = ♭3, 7 = 5, 10 = ♭7, 14 = 9).
// @009 ctl 16:3.k1 Brightness | warm, soft touch ↔ open, bright grand (lpf 2.5–18 kHz).
// @009 ctl 16:3.k2 Space | dry ↔ the echoes repeat into the room.
// @009 ctl 16:3.k3 Pedal | 0 = played, damped after each note ↔ 1 = sustain pedal, notes ring on.
// @009 ctl 16:3.fader Level | piano riff.
// @009 ctl 16:3.b1 Change | ostinato → answer → 2 riffs that follow the chords.
// @009 ctl 16:3.b2 Octave | one octave up while held.
const riff     = colJonas(3)
const riffVar  = change(riff.btn, 'jonas', 'Riff', 4, ['Ostinato', 'Frage/Antwort', 'parallel Ruf', 'parallel Aufstieg'])
const riffPedal = riff.char.fmap(c => 0.25 * Math.pow(12, c))   // release seconds after the written length: 0.25 ↔ 3
const RIFFS = [
  fixed("a4 _ _ e5 _ _ c5 _ _ e5 _ _ g5 _ _ _"),   // 3 + 3 + 3 + 3 + 4: across the beat
  fixed("<[e5 _ _ c5 _ _ a4 _ _ _ _ _ _ _ _ _] [g5 _ _ e5 _ _ d5 _ _ _ c5 _ _ _ _ _]>"),
  fromRoot("7 _ _ 3 _ _ 10 _ _ _ 7 _ _ _ _ _", 12),
  fromRoot("0 _ _ 3 _ _ 7 _ _ _ 3 _ _ _ _ _", 12),
]

const stemN3_riff = strip(bus(pick(riffVar, RIFFS)
  .add(note(riff.btn2.fmap(v => v > 0.5 ? 12 : 0)))
  .s("piano").release(riffPedal).hpf(120)
  .velocity(perlin.range(0.75, 1)).gain(0.5).pan(0.6).delay(0.3), 2, riff.space), {
  lpf: expRange(riff.bright, 2500, 18000),
  level: riff.level.range(0, 1),
})

// ============================================================
// JONAS 4 ACID — a 303-style line around A2 (110 Hz): saw through a resonant low-pass. It stays on A while the bass
// moves underneath; single notes bend only where they would clash with the chord.
// ============================================================
// @009 ctl 16:4.k1 Brightness | closed and dark ↔ open (filter cutoff 200–2500 Hz).
// @009 ctl 16:4.k2 Space | dry ↔ echoes into the room.
// @009 ctl 16:4.k3 Acid | 0 = soft and round ↔ resonant squelch (more resonance and filter envelope).
// @009 ctl 16:4.fader Level | acid line.
// @009 ctl 16:4.b1 Change | 16ths → 8ths → two-bar line.
// @009 ctl 16:4.b2 Accent | every note accented (louder, the filter snaps) while held.
const acid     = colJonas(4)
const acidVar  = change(acid.btn, 'jonas', 'Acid', 3, ['16tel', 'Achtel', 'Zweitakt'])
const accent   = acid.btn2.fmap(v => v > 0.5 ? 1 : 0)
const ACID_LINES = ["a2 a2 a3 a2 ~ a2 g3 ~ a2 a2 ~ a3 a2 ~ c3 a2", "a2 ~ a2 ~ a3 ~ a2 ~ a2 ~ a2 ~ g3 ~ e3 ~",
  "<[a2 a2 a3 ~ a2 ~ c3 a2 ~ a2 a3 ~ a2 g3 ~ a2] [a2 a2 a3 ~ a2 ~ c3 a2 ~ e3 ~ a2 c4 ~ a3 a2]>"].map(fixed)

const stemN4_acid = strip(bus(pick(acidVar, ACID_LINES)
  .s("sawtooth").attack(0.003).decay(0.18).sustain(0.3).release(0.04)
  .lpf(toned(expRange(acid.bright, 200, 2500)))
  .lpq(acid.char.fmap(c => 2 + 14 * c))
  .lpenv(acid.char.fmap(c => a => 0.5 + 4 * c + 2 * a).appLeft(accent)).lpdecay(0.14)
  .gain(accent.fmap(a => 0.28 + 0.12 * a)).pan(0.5), 2, acid.space, 0.15), {
  level: acid.level.range(0, 1),
})

// ============================================================
// JONAS 5 RHODES — soft Rhodes chords (soundfont), one or two per bar: the deep, warm alternative to the stab
// ============================================================
// @009 ctl 16:5.k1 Brightness | mellow ↔ bell-like tine (lpf 1.5–10 kHz).
// @009 ctl 16:5.k2 Space | dry ↔ far away (reverb + echo).
// @009 ctl 16:5.k3 Length | short chords ↔ held over the bar.
// @009 ctl 16:5.fader Level | Rhodes chords on the chapter's chords.
// @009 ctl 16:5.b1 Change | on 1 → on 3-and → 1 + a late answer.
// @009 ctl 16:5.b2 Swell | the chord swells in slowly while held.
const rhodes    = colJonas(5)
const rhodesVar = change(rhodes.btn, 'jonas', 'Rhodes', 3, ['Eins', 'Drei-und', 'Antwort'])
const rhodesLen = rhodes.char.fmap(c => 0.4 + 1.8 * c)
const RHODES_RHYTHMS = ["0.6 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~", "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 0.6 ~ ~ ~ ~ ~", "0.6 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 0.45 ~"]
const rhodesChord = chordStack('rh', c => c.tones)

const stemN5_rhodes = strip(bus(pick(rhodesVar, RHODES_RHYTHMS.map(r => playOn(r, rhodesChord)))
  .s("gm_epiano1").attack(rhodes.btn2.fmap(v => v > 0.5 ? 0.4 : 0.005))
  .decay(rhodesLen).sustain(0).release(0.3).mul(gain(0.8)).pan(0.4), 2, rhodes.space, 0.15), {
  lpf: expRange(rhodes.bright, 1500, 10000),
  level: rhodes.level.range(0, 1),
})

// ============================================================
// JONAS 6 VOICE — one long sung “ooh” (voice soundfont) now and then, around E5: it holds its note while the chords
// move under it (bending only where it would clash)
// ============================================================
// @009 ctl 16:6.k1 Brightness | hushed ↔ open, clear voice (lpf 1–8 kHz).
// @009 ctl 16:6.k2 Space | dry ↔ far away (reverb + echo).
// @009 ctl 16:6.k3 Glide | plain notes ↔ notes bend gently into their pitch (at most a semitone).
// @009 ctl 16:6.fader Level | the voice.
// @009 ctl 16:6.b1 Change | one note → a falling pair → three notes.
// @009 ctl 16:6.b2 Echo throw | long echo on the voice while held.
const voice     = colJonas(6)
const voiceVar  = change(voice.btn, 'jonas', 'Stimme', 3, ['ein Ton', 'Paar', 'drei Töne'])
const VOICES = ["<e5 ~>", "<[~ e5] [d5 _] ~ ~>", "<[c5 _ _ d5] [e5 _ _ ~] ~ ~>"].map(fixed)
const throwEcho = (pat, button) => pat.fmap(v => b => b > 0.5 ? { ...v, delay: 0.85 } : v).appLeft(button)

const stemN6_voice = strip(throwEcho(bus(pick(voiceVar, VOICES)
  .s("gm_voice_oohs").attack(0.2).sustain(0.8).release(0.6)
  .vib(5).vibmod(0.06)
  .penv(voice.char.fmap(g => -g)).pattack(0.15)
  .gain(0.5).delay(0.3), 2, voice.space), voice.btn2), {
  lpf: expRange(voice.bright, 1000, 8000),
  level: voice.level.range(0, 1),
})

// ============================================================
// JONAS 7 DUB CHORD — the stab's chord, dark and short, with an echo that always rings a little (dub techno)
// ============================================================
// @009 ctl 16:7.k1 Brightness | deep and muffled ↔ clear (lpf 0.4–4 kHz).
// @009 ctl 16:7.k2 Space | a short echo ↔ a long tail into the room.
// @009 ctl 16:7.k3 Hits | one hit per bar ↔ + a second, quieter hit.
// @009 ctl 16:7.fader Level | dub chord, follows the chapter.
// @009 ctl 16:7.b1 Change | on 2-and → on 4-and → every 2nd bar.
// @009 ctl 16:7.b2 Throw | the echo repeats much longer while held.
const dub     = colJonas(7)
const dubVar  = change(dub.btn, 'jonas', 'Dub', 3, ['2-und', '4-und', 'Zweitakt'])
const DUB_RHYTHMS = ["~ ~ ~ ~ ~ ~ 0.8 ~ ~ ~ ~ ~ ~ ~ ~ ~", "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 0.8 ~",
  "<[~ ~ ~ ~ ~ ~ 0.8 ~ ~ ~ ~ ~ ~ ~ ~ ~] ~>"]
const dubChord = chordStack('db', c => [c.root, ...c.tones.slice(0, 3)])
const dubSound = pat => pat.s("sawtooth").attack(0.003).decay(0.18).sustain(0).release(0.05).hpf(250).pan(0.55)

const stemN7_dub = strip(throwEcho(bus(stack(
  dubSound(pick(dubVar, DUB_RHYTHMS.map(r => playOn(r, dubChord)))).mul(gain(0.12)),
  gate(above(dub.char, 0), dubSound(playOn("~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ 0.5 ~ ~ ~", dubChord)).mul(gain(dub.char.mul(0.12))))
), 2, dub.space, 0.35).fmap(v => ({ ...v, delay: Math.max(v.delay ?? 0, 0.3) })), dub.btn2), {
  lpf: expRange(dub.bright, 400, 4000),
  level: dub.level.range(0, 1),
})


// What the LC view shows for this track: the chapter (now, next) on column 8 button 1, and extra lines at the top
const lcChapter = () => [CHAPTERS[chapterLatch.now].name, CHAPTERS[chapterLatch.pending].name]
const lcHead    = () => [['Akkorde', CHAPTERS[chapterLatch.now].chords.map(c => c.name).join(' – ')]]
// Where the music is (LC view): the beat in the bar and the bar in the big cycle. A silent event per beat moves it at
// the moment the beat sounds (onTrigger, as in the set). chordAt(bar) = the chord of that bar ('' = none shown)
const CYCLE   = 4   // one phrase: 4 chords, one per bar
const chordAt = bar => CHAPTERS[chapterLatch.now].chords[bar % 4].name
const beatNow = { bar: null, beat: null }
const beatTick = pure(0).segment(4).fmap(() => ({})).onTrigger((hap, now, cps, t) => {
  const pos = hap.whole.begin.valueOf(), bar = Math.floor(pos + 1e-9), beat = Math.floor((pos - bar) * 4 + 1e-9)
  setTimeout(() => { beatNow.bar = bar; beatNow.beat = beat; lcView?.update() }, Math.max(0, (t - now) * 1000))
}, true)

// LC view of this evaluation: names from the tags in the editor (strudel.cc keeps the text in strudelMirror),
// buttons from the change() rows (row i = column i + 1), chapter and break on column 8
return { taps, showStatus, STATUS, lcChapter, lcHead, stems: { J1: stemJ1_kick, J2: stemJ2_noise, J3: stemJ3_sub, J4: stemJ4_bass, J5: stemJ5_clap, J6: stemJ6_hats, J7: stemJ7_perc, J8: stemJ8_shake, N1: stemN1_pad, N2: stemN2_stab, N3: stemN3_riff, N4: stemN4_acid, N5: stemN5_rhodes, N6: stemN6_voice, N7: stemN7_dub } }
})()

// ============================================================
// TRACK 008 — Groove Techno (from tracks/008/008-groove-techno-dual.strudel)
// ============================================================
// @008 layout Track 008 — groove techno (two controllers)
// @008 note Groove techno on F, 140 BPM. Jojo plays the foundation (kick, bass, drums), Jonas the colour (pads, dub chords, melodies) and the global column 8.
// @008 note Every row means the same everywhere: row 1 = brightness, row 2 = space, row 3 = character, fader = level, button 1 = next pattern (at the next bar), button 2 = a moment while held.
// @008 note Start with all faders down. Nothing sounds until Jonas' master fader (column 8) is up. Jonas' pad button 1 changes the chords, and Jojo's sub and bassline follow.
// @008 note The status box at the bottom right of the Strudel page shows chapter, break and each stem's pattern. Its button “als Fenster” opens it as a small window that stays on top (Chrome/Edge).
// @008 mode B16 Jojo — Foundation (beat + bass)
// @008 col B16:1 1 Kick
// @008 col B16:2 2 Rumble
// @008 col B16:3 3 Sub
// @008 col B16:4 4 Bassline
// @008 col B16:5 5 Clap
// @008 col B16:6 6 Hats
// @008 col B16:7 7 Percussion
// @008 col B16:8 8 Ride
// @008 row B16:k1 Row 1 \ Brightness
// @008 row B16:k2 Row 2 \ Space
// @008 row B16:k3 Row 3 \ Character
// @008 row B16:fader Fader \ Level
// @008 row B16:b1 Button 1 \ Change
// @008 row B16:b2 Button 2 \ Moment
// @008 mode 16 Jonas — Colour (chords + melodies) · column 8 = global
// @008 col 16:1 1 Pad
// @008 col 16:2 2 Dub Chords
// @008 col 16:3 3 Sequence
// @008 col 16:4 4 Lead
// @008 col 16:5 5 Answer
// @008 col 16:6 6 Pings
// @008 col 16:7 7 FX / Breath
// @008 col 16:8 8 Global
// @008 row 16:k1 Row 1 \ Brightness
// @008 row 16:k2 Row 2 \ Space
// @008 row 16:k3 Row 3 \ Character
// @008 row 16:fader Fader \ Level
// @008 row 16:b1 Button 1 \ Change
// @008 row 16:b2 Button 2 \ Moment
// @008 guide Playing together | Jojo builds the floor: kick first, rumble right next to it, then sub and hats, then clap, bassline and the groove (percussion, ride).
// @008 guide Playing together | Jonas colours it: pad or dub chords first (all knobs at 0 is a good start), then the sequence. Lead, answer and pings are for the peaks, the breathing FX for long transitions.
// @008 guide Playing together | The pad's button 1 changes the chords for both players: Jojo's sub and bassline move with it. Pad button 2 (freeze) holds the chord for everybody.
// @008 guide Playing together | Break: one press takes out kick, rumble, sub, bassline and clap at the next bar; hats, percussion, ride and all of Jonas' sounds keep going. Turn Tension up during the break, press again: everything is back on the one. Then let Tension go.
// @008 guide Every position sounds good | No filter closes completely. Sequence, answer and FX keep a little room even at space 0.
const T008 = (() => {
const ID = 3
const PHRASE = phraseOf(SET_TRACKS[3])
const ORBIT0 = 3
const focusOnly = button => button.fmap(v => SET.focus() === ID ? v : 0)

const ramp = (sig, from, to) => sig.fmap(v => Math.min(1, Math.max(0, (v - from) / (to - from))))
// Row-3 crossfade: 0..0.5 brings the extra layer in, 0.5..1 fades the main layer out
const fadeMain  = knob => ramp(knob, 1, 0.5)
const fadeExtra = knob => ramp(knob, 0, 0.5)
// Exponential knob range for filters (Hz), so every part of the knob travel is audible
const expRange = (knob, lo, hi) => knob.fmap(v => lo * Math.pow(hi / lo, v))

const bpm  = 140
const beat = 60 / bpm   // seconds per quarter note, for delay times

// Mapping of column n (1-8): brightness, space, character (knob rows 1-3), fader, button rows 1-2
const colMap = (read, n) => ({ bright: read(12 + n), space: read(20 + n), char: read(28 + n), level: read(4 + n), btn: read(36 + n), btn2: read(44 + n) })
const off = () => signal(() => 0)
// Column 8 (global) is read from both its Mode 16 and Mode 2 CCs, last moved wins: it works on both pages even on a
// controller whose column 8 sends CC + 48 in Mode 2
// One controller: Jojo on the plain CCs (Mode 1), Jonas on CC + 48 (Mode 2)
const alone    = !ccJojo
const colJonas = n => n === 8 ? SET.glob : colMap(n === 8 ? c => lastMoved(ccJonas(c), ccJonas(c + 48)) : alone ? c => ccJonas(c + 48) : ccJonas, n)
const colJojo  = n => !alone ? colMap(ccJojo, n) : n === 8 ? colMap(off, n) : colMap(ccJonas, n)

const gate  = (cond, pat) => cond.fmap(on => on ? pat : silence).innerJoin()
const above = (sig, x) => sig.fmap(v => v > x)
const and   = (a, b) => a.fmap(x => y => x && y).appLeft(b)
const held  = button => button.fmap(v => v > 0.5)

// Stateful controls, collected so the master can query them every tick (see stateTaps)
const taps = []

// Two inputs for one control: the value follows whichever moved last (stateful, so it is queried via stateTaps)
const lastMoved = (a, b) => {
  let pa = null, pb = null, v = 0
  const pat = a.fmap(x => y => {
    if (pa === null) v = Math.max(x, y)
    else if (y !== pb) v = y
    else if (x !== pa) v = x
    pa = x; pb = y
    return v
  }).appLeft(b)
  taps.push(pat)
  return pat
}

// Momentary button that steps through n states, one step per press (counts presses, not the held value).
// onChange(state) runs on every step (for the status box). Re-evaluating the code starts again at 0.
const cycleButton = (button, n, onChange = () => {}) => {
  button = focusOnly(button)   // set: presses count only for the track in focus
  let prev = 0, state = 0
  const pat = button.fmap(v => {
    if (v > 0.5 && prev <= 0.5) { state = (state + 1) % n; onChange(state) }
    prev = v
    return state
  })
  taps.push(pat)
  return pat
}

// A value that a button sets now but that takes over only at the next bar line (chapter, break, change).
// at(t) is asked with bar starts in real time (outside any reseed shift); it remembers the previous value for
// queries that still reach back into the old bar. pat = the value per bar.
const barLatch = (len = 1) => {
  const l = { pending: 0, now: 0, prev: 0, bar: -Infinity }
  l.at = t => {
    const bar = Math.floor(Number(t) / len)
    if (bar > l.bar) {
      if (l.pending !== l.now) { l.prev = l.now; l.now = l.pending; showStatus() }
      else l.prev = l.now
      l.bar = bar
    }
    return bar >= l.bar ? l.now : l.prev
  }
  l.pat = signal(t => l.at(t)).segment(1)
  taps.push(l.pat)
  return l
}

// 0 → 1 over `cycles` while a button is held, back to 0 on release (for risers)
const heldRamp = (button, cycles) => {
  let start = null
  const pat = button.fmap(v => t => {
    if (v <= 0.5) { start = null; return 0 }
    start ??= t
    return Math.min(1, Math.max(0, (t - start) / cycles))
  }).appLeft(signal(t => Number(t)))
  taps.push(pat)
  return pat
}

// Freeze: while the button is held, keep returning the value that was playing when it was pressed
const freeze = (button, pat) => {
  let kept = null
  return pat.fmap(v => b => b > 0.5 ? (kept ??= v) : (kept = null, v)).appLeft(button)
}


// ============================================================
// MOODS — all on F, so a switch keeps the root and only the colour changes
// ============================================================
const MOODS = [
  { scale: 'dorian',   name: 'warm' },    // F G A♭ B♭ C D E♭
  { scale: 'minor',    name: 'dunkel' },     // F G A♭ B♭ C D♭ E♭
  { scale: 'phrygian', name: 'eng' },   // F G♭ A♭ B♭ C D♭ E♭
]

// Rows of the status box, filled by change(): { label, latch, n, names } per player
const STATUS = { jojo: [], jonas: [] }
const showStatus = () => {
  if (!statusUi || SET.focus() !== ID) return
  const dots = v => [...Array(8).keys()].map(k => k === v ? '●' : '○').join('')
  const show = (r, v) => !r.names ? String(v + 1) : r.names[v]
  const line = (r, i) => (i + 1) + ' ' + r.label.padEnd(10) + ' ' + (r.n === 8 ? dots(r.latch.now) + ' ' : '') +
    show(r, r.latch.now) + (r.latch.pending !== r.latch.now ? ' → ' + show(r, r.latch.pending) : '')
  const soon = l => l.pending !== l.now ? ' (nächster Takt)' : ''
  statusUi.text.textContent = [
    ...SET.statusLines(),
    'Kapitel     A ' + MOODS[moodLatch.now].name +
      (moodLatch.pending !== moodLatch.now ? ' → ' + MOODS[moodLatch.pending].name : '') + soon(moodLatch),
    '', alone ? 'Mode 1 · Jojo' : 'Jojo', ...STATUS.jojo.map(line),
    '', alone ? 'Mode 2 · Jonas' : 'Jonas', ...STATUS.jonas.map(line),
  ].join('\n')
  lcView?.update()
}
// Button 1 of a stem: n patterns (default 8), one step per press, taking over at the next bar
const change = (button, who, label, n = 8, names) => {
  const latch = barLatch()
  cycleButton(button, n, s => { latch.pending = s; showStatus() })
  STATUS[who].push({ label, latch, n, names })
  return latch
}
// Pattern number i of a list, switched by a change latch
const pick = (latch, pats) => latch.pat.fmap(i => pats[i]).innerJoin()

// ============================================================
// GLOBAL (Jonas, column 8) — acts on both controllers
// ============================================================
// @008 ctl g.k1 Fog | 0 = clear, up = every filter pulled down to ~6 %: muffled, as if from the room next door.
// @008 ctl g.k2 Room | 0 = each sound's own room (row 2), up = everything drowns in reverb.
// @008 ctl g.k3 Tension | build-up: echo grows, filters open, from the middle a snare roll (clap fader). 0 = release.
// @008 ctl g.fader Master Level | volume of everything, both controllers. 0 = silence.
// @008 ctl g.b1 Chapter | mood: warm → dark → tense, at the next bar.
// @008 ctl g.b2 Break / Drop | 1st: beat out. 2nd: all back on the one.
const glob        = colJonas(8)
const globalFog   = glob.bright.fmap(f => Math.pow(0.06, f))
const globalRoom  = glob.space
const tension     = glob.char
const tensionEcho = ramp(tension, 0, 0.5).mul(0.45)     // delay send, 0..0.45
const tensionRoll = ramp(tension, 0.5, 1)               // snare roll, 0..1
// Factor on every lpf: fog darkens (down to 0.06), tension opens (up to 2.5)
const globalTone  = globalFog.fmap(f => o => f * o).appLeft(tension.fmap(t => 1 + 1.5 * t))
const globalLevel = glob.level.range(0, 1)

const moodLatch  = barLatch(PHRASE)
cycleButton(glob.btn, MOODS.length, s => { moodLatch.pending = s; showStatus() })
const breakLatch = barLatch()
cycleButton(glob.btn2, 2, s => { breakLatch.pending = s; showStatus() })
const mood    = moodLatch.pat
const scaleIn = octave => mood.fmap(m => 'F' + octave + ':' + MOODS[m].scale)
// Jojo's low end and backbeat, gated while the break is on
const beatOn   = breakLatch.pat.fmap(b => b === 0)
const beatOnly = pat => gate(beatOn, pat)

const audible = level => and(above(level, 0), above(globalLevel, 0))
// lpf × fog/tension, kept between 80 Hz and 18 kHz (fog never makes a stem silent)
const toned  = lpf => lpf.fmap(f => g => Math.min(18000, Math.max(80, f * g))).appLeft(globalTone)
// Reverb send: the stem's space knob (0..0.9), raised by the global Room up to 0.95
const roomOf = space => space.fmap(s => g => { const r = 0.9 * s; return r + (0.95 - r) * g }).appLeft(globalRoom)
// Change: read the stem's randomness 1024 cycles further per step (keeps bar alignment, new random values).
// Scales and the chord root are applied after reseed, so they follow real time.
const reseed = (latch, pat) => pat.early(latch.pat.fmap(v => v * 1024))

// Effect buses. Each orbit has one reverb and one delay, and every reverb costs a lot of CPU, so the stems share
// three orbits; stems on one orbit share room size and echo time/feedback.
// Orbit 1 = drums and bass: small room, short dotted-8th slap.
// Orbit 2 = all of Jonas' colour: dub room, dotted-8th echo with long feedback.
// Orbit 3 = rumble only: the reverb is the sound (kick tails rolling under the beat).
const BUSES = {
  1: { hall: 1.6, time: beat * 0.75, feedback: 0.3 },
  2: { hall: 4, time: beat * 0.75, feedback: 0.58 },
  3: { hall: 2.6, time: beat * 0.25, feedback: 0.45 },
}
// bus(): reverb from the space knob, and echo: the layer's own delay amount (or `echo` if it has none) × 2 × space,
// so space 0.5 = the designed amount; Tension's echo takes over where it is larger.
const bus = (pat, orbit, space, echo = 0) => pat
  .fmap(v => sc => e => ({ ...v, delay: Math.max(Math.min(0.9, (v.delay ?? echo) * sc), e) }))
  .appLeft(space.fmap(s => 2 * s)).appLeft(tensionEcho)
  .room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)
  .delaytime(BUSES[orbit].time).delayfeedback(BUSES[orbit].feedback)
// Reverb only, no echo (kick, sub and bass would smear)
const dryBus = (pat, orbit, space) => pat.room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit + ORBIT0)

// Channel strip: lpf × fog/tension (if given), level × master as postgain, gated while the fader or master is 0
const strip = (stem, { lpf, level }) => {
  const pat = lpf === undefined ? stem : stem.lpf(toned(lpf))
  return gate(audible(level), pat.postgain(level.mul(globalLevel)))
}
const drum = (names, bank = 'RolandTR909') => s(names).bank(bank)

// ============================================================
// HARMONY — Jonas' pad button 1 picks a progression, everybody follows its root
// ============================================================
// Chord roots as scale degrees (0 = F), one chord per 2 bars, 4 chords = 8 bars
const PROGS = [[0, 0, 0, 0], [0, 0, -2, -2], [0, 3, 0, 3], [0, -2, -3, -2], [0, 2, 3, 2], [0, 0, 4, 3], [3, 3, 0, 0], [0, 5, 3, 4]]
const PROG_NAMES = ['1', '1–6', '1–4', '1–6–5–6', '1–3–4–3', '1–5–4', '4–1', '1–6–4–5']
const PROG_PATS = PROGS.map(p => cat(...p).slow(2))
const pad      = colJonas(1)
const padVar   = change(pad.btn, 'jonas', 'Pad', 8, PROG_NAMES)
const harmRoot = freeze(pad.btn2, pick(padVar, PROG_PATS))
// Chord = shape (scale degrees above the root) on the current root; built once per root and shape
const CHORD_CACHE = {}
const chordOn = shape => harmRoot.fmap(r => CHORD_CACHE[shape + '@' + r] ??= n(stack(...shape.map(d => d + r)))).innerJoin()
const onRoot  = pat => pat.add(n(harmRoot))

// ============================================================
// JOJO 1 KICK — a sine kick tuned to C2 (the fifth of F, same pitch as the rumble; F1 at 44 Hz was inaudible on small
// speakers), with a little 909 click on top. No echo.
// ============================================================
// Punch: 0 = really soft (slow attack, small pitch drop, no click: a deep thump), 0.5 = round kick, 1 = hard
// (big fast pitch drop, sharp attack, 909 click, some drive). Each value goes soft → round → hard in two straight lines.
// @008 ctl B16:1.k1 Brightness | 0 = round but clear ↔ clicky attack (lpf 900–9000 Hz).
// @008 ctl B16:1.k2 Space | dry and close ↔ in a room (reverb).
// @008 ctl B16:1.k3 Punch | 0 = really soft thump, middle = round kick, 1 = hard and punchy.
// @008 ctl B16:1.fader Level | 0 = gone. Kick on every beat, tuned to C (fifth of F).
// @008 ctl B16:1.b1 Change | straight → ghost kick before the 1 → gap every 4th bar.
// @008 ctl B16:1.b2 Drop out | kick pauses while held.
const kick     = colJojo(1)
const kickVar  = change(kick.btn, 'jojo', 'Kick', 3, ['gerade', 'Geist vor 1', 'Lücke'])
const kickPunch = kick.char
// Value at punch 0 / 0.5 / 1, straight lines in between
const punch3 = (soft, round, hard) => kickPunch.fmap(p => p < 0.5 ? soft + (round - soft) * 2 * p : round + (hard - round) * (2 * p - 1))
const KICKS = ["1*4", "1 1 1 [1 ~ ~ 0.4]", "<[1*4] [1*4] [1*4] [1 1 1 ~]>"]
  .map(g => stack(
    gain(g).note("c2").s("sine").decay(punch3(0.55, 0.4, 0.3)).sustain(0).release(0.05)
      .attack(punch3(0.016, 0.004, 0.001))
      .penv(punch3(12, 24, 36)).pdecay(punch3(0.09, 0.05, 0.03)),
    gain(g).mul(gain(punch3(0, 0.3, 0.7))).s("bd").bank("RolandTR909")
  ).shape(punch3(0, 0, 0.4)).velocity(punch3(1, 1, 0.56)))   // level compensation: hard ≈ +3 dB, not +8

const stemJ1_kick = beatOnly(gate(kick.btn2.fmap(v => v <= 0.5), strip(dryBus(
  pick(kickVar, KICKS).mul(gain(0.8)), 1, kick.space), {
  lpf: expRange(kick.bright, 900, 9000),
  level: kick.level.range(0, 1),
})))

// ============================================================
// JOJO 2 RUMBLE — the kick's sound low-passed into a dark reverb, on the 3rd and 4th 16th of every beat (own orbit)
// ============================================================
// @008 ctl B16:2.k1 Brightness | 0 = warm rumble ↔ more of the kick's body in the tail (lpf 250–1800 Hz).
// @008 ctl B16:2.k2 Space | short rumble ↔ a long dark cloud (reverb never fully off: the reverb is the sound).
// @008 ctl B16:2.k3 Motion | still ↔ the filter breathes and the rumble echoes in 16ths.
// @008 ctl B16:2.fader Level | rumble under the kick, same pitch (C).
// @008 ctl B16:2.b1 Change | 3rd + 4th 16th → 2nd–4th → only the 3rd.
// @008 ctl B16:2.b2 Riser | a noise sweep rises over 2 bars while held.
const rumble     = colJojo(2)
const rumbleVar  = change(rumble.btn, 'jojo', 'Rumble', 3, ['3+4', '2+3+4', '3'])
const rumbleMove = rumble.char
const rumbleRise = heldRamp(rumble.btn2, 2)
const rumbleHit  = stack(
  note("c2").s("sine").penv(12).pdecay(0.05).decay(0.3).sustain(0).gain(0.5),
  s("bd").bank("RolandTR909").gain(0.2)
)
const RUMBLES = ["[~ ~ x x]*4", "[~ x x x]*4", "[~ ~ x ~]*4"].map(r => rumbleHit.struct(r))
// Riser: 16th noise bursts through a bandpass that climbs from 300 Hz to 6 kHz, getting louder.
// Not low-passed by the rumble filter (it is on the same column, but it is a high sound).
const rumbleRiser = gate(held(rumble.btn2), s("pink*16")
  .attack(0.03).sustain(0.8).release(0.15)
  .bpf(rumbleRise.fmap(r => 300 * Math.pow(20, r))).bpq(4)
  .gain(rumbleRise.mul(1.4)).pan(sine.fast(2)))   // pink noise: ~12 dB quieter than white at the same gain

const stemJ2_rumble = strip(stack(
  beatOnly(bus(pick(rumbleVar, RUMBLES)
    .lpf(toned(expRange(rumble.bright, 250, 1800)).fmap(f => m => w => f * (1 - 0.6 * m * w)).appLeft(rumbleMove).appLeft(sine.slow(2)))
    .mul(gain(0.67)).delay(rumbleMove.mul(0.4)), 3, rumble.space.fmap(s => 0.5 + 0.5 * s))),
  bus(rumbleRiser, 2, pure(0.3))
), {
  level: rumble.level.range(0, 0.68),   // was 1; mix: rumble −8 dB under the kick
})

// ============================================================
// JOJO 3 SUB — a pumping sine on the chord root: each note starts a 16th after the kick and holds until the next one
// ============================================================
// Sounds like a sub ducked by the kick (sidechain), without a compressor.
// @008 ctl B16:3.k1 Brightness | 0 = sine with a few overtones (audible on small speakers) ↔ warm and full.
// @008 ctl B16:3.k2 Space | dry ↔ a little room (reverb).
// @008 ctl B16:3.k3 Length | long, pumping notes ↔ short, bouncing ones.
// @008 ctl B16:3.fader Level | pumping sub, follows Jonas' chords.
// @008 ctl B16:3.b1 Change | pump → fifth on beat 4 → syncopated.
// @008 ctl B16:3.b2 Slide | every note bends up into its pitch while held.
const sub      = colJojo(3)
const subVar   = change(sub.btn, 'jojo', 'Sub', 3, ['Pumpe', 'Quinte', 'Synkope'])
const subClip  = sub.char.fmap(c => 1 - 0.65 * c)   // share of the note length that sounds
const subSlide = sub.btn2.fmap(v => v > 0.5 ? -5 : 0)
const SUBS = ["[~ 0@3]*4", "[~ 0@3] [~ 0@3] [~ 0@3] [~ 4@3]", "[~ 0@3] [~ 0@3] [~ 0@3] [~ 0 ~ 0]"]
  .map(p => onRoot(n(p)).scale(scaleIn(1)))
const subNotes = pick(subVar, SUBS)

const stemJ3_sub = beatOnly(strip(dryBus(stack(
  subNotes.s("sine").gain(0.9),
  subNotes.s("triangle").gain(sub.bright.fmap(b => 0.18 + 0.3 * b))
).attack(0.015).sustain(1).release(0.04).clip(subClip).penv(subSlide).pattack(0.07), 1, sub.space), {
  level: sub.level.range(0, 0.65),   // was 1; mix: sub −3 dB under the kick
}))

// ============================================================
// JOJO 4 BASSLINE — raw off-beat bass: a slightly overdriven square, no filter sweep, on the chord root
// ============================================================
// @008 ctl B16:4.k1 Brightness | 0 = round ↔ raw and buzzing (lpf 400–3000 Hz).
// @008 ctl B16:4.k2 Space | dry ↔ a little room (reverb).
// @008 ctl B16:4.k3 Groove | off-beats only ↔ extra 16th notes bouncing in between.
// @008 ctl B16:4.fader Level | off-beat bass, follows Jonas' chords.
// @008 ctl B16:4.b1 Change | off-beat → 3-3-2 → dub.
// @008 ctl B16:4.b2 Octave | one octave up while held.
const bassCol = colJojo(4)
const bassVar = change(bassCol.btn, 'jojo', 'Bass', 3, ['Offbeat', '3-3-2', 'Dub'])
const bassOct = bassCol.btn2.fmap(v => v > 0.5 ? 12 : 0)
// [main line, extra 16ths], scale degrees above the chord root (7 = octave)
const BASS_LINES = [
  ["[~ 0]*4", "[~ ~ ~ 7]*4"],
  ["[~ 0 ~ 0] [~ ~ 0 ~] [~ 0 ~ 0] [~ ~ 0 ~]", "[~ ~ ~ 2]*4"],
  ["[~ 0] ~ [~ 0] [~ ~ 0 ~]", "[~ ~ 7 ~] [~ 0 ~ ~] [~ ~ 7 ~] [~ 0 ~ ~]"],
].map(([main, extra]) => [onRoot(n(main)), onRoot(n(extra))])
const bassSound = pat => pat.scale(scaleIn(2)).add(note(bassOct)).s("square").superimpose(x => x.add(note(0.07)))
  .decay(0.14).sustain(0.1).release(0.05).lpq(2).shape(0.3)

const stemJ4_bass = beatOnly(strip(dryBus(stack(
  bassSound(pick(bassVar, BASS_LINES.map(l => l[0]))).gain(0.25),
  gate(above(bassCol.char, 0), bassSound(pick(bassVar, BASS_LINES.map(l => l[1]))).gain(bassCol.char.mul(0.2)))
), 1, bassCol.space), {
  lpf: expRange(bassCol.bright, 400, 3000),
  level: bassCol.level.range(0, 0.69),   // was 1; mix: bass −4 dB under the kick (groove at the middle)
}))

// ============================================================
// JOJO 5 CLAP — plain 909 clap on 2 and 4 (after 005); ghosts and double taps come in with row 3
// ============================================================
// @008 ctl B16:5.k1 Brightness | soft and far ↔ sharp crack (lpf 1.5–12 kHz).
// @008 ctl B16:5.k2 Space | dry ↔ far away (reverb + echo).
// @008 ctl B16:5.k3 Ghost notes | plain ↔ a quiet clap before beat 3 ↔ + small double taps.
// @008 ctl B16:5.fader Level | clap on 2 and 4. Also the level of Tension's snare roll.
// @008 ctl B16:5.b1 Change | plain → pickup → double clap.
// @008 ctl B16:5.b2 Roll | snare roll, growing over the bar, while held.
const clap      = colJojo(5)
const clapVar   = change(clap.btn, 'jojo', 'Clap', 3, ['plain', 'Vorschlag', 'Doppel'])
const clapGhost = clap.char
const clapSound = pat => pat.s("cp").bank("RolandTR909").attack(0.001).decay(0.12).sustain(0).release(0.06)
const CLAPS = ["~ 0.8 ~ 0.8", "~ 0.8 ~ [0.8 ~ ~ 0.35]", "~ 0.8 ~ <0.8 [0.8 0.5]>"].map(g => clapSound(gain(g)))

const stemJ5_clap = beatOnly(strip(bus(stack(
  pick(clapVar, CLAPS),
  gate(above(clapGhost, 0), clapSound(gain("~ ~ 0.22 ~").mul(gain(ramp(clapGhost, 0, 0.5))))),
  gate(above(clapGhost, 0.5), clapSound(gain("~ [~ 0.15] ~ ~").mul(gain(ramp(clapGhost, 0.5, 1))))),
  gate(held(clap.btn2), drum("sd*16").gain(saw.range(0.1, 0.5))),
  // Tension roll: 8ths → 16ths, louder as Tension rises
  gate(above(tensionRoll, 0), drum("sd*16").degradeBy(tensionRoll.fmap(t => 0.5 * (1 - t)))
    .gain(tensionRoll.fmap(t => 0.1 + 0.35 * t)))
).mul(gain(1.75)).hpf(400).pan(0.48), 1, clap.space, 0.2), {
  lpf: expRange(clap.bright, 1500, 12000),
  level: clap.level.range(0, 0.58),   // was 1; mix: clap −8 dB: players found it too loud, LUFS underrates transients
}))

// ============================================================
// JOJO 6 HATS — 909 hats: off-beat, plain 16ths, or driving (16ths swelling + soft open hats, after 005)
// ============================================================
// @008 ctl B16:6.k1 Brightness | soft hiss ↔ crisp and sharp (lpf 3–16 kHz).
// @008 ctl B16:6.k2 Space | dry ↔ far away (reverb + echo).
// @008 ctl B16:6.k3 Density | the pattern as it is ↔ + quiet 16ths ↔ + little 32nd rolls.
// @008 ctl B16:6.fader Level | hats. Keep playing in the break.
// @008 ctl B16:6.b1 Change | off-beat → plain 16ths → driving.
// @008 ctl B16:6.b2 Open | open hats on the off-beats while held.
const hats    = colJojo(6)
const hatVar  = change(hats.btn, 'jojo', 'Hats', 3, ['Offbeat', 'gerade', 'treibend'])
const hatDens = hats.char
const HATS = [
  drum("[~ hh]*4").gain(0.5),
  drum("hh*16").gain("[0.32 0.22 0.3 0.22]*4"),
  stack(drum("hh*16").gain(sine.fast(2).range(0.12, 0.42)), drum("[~ oh]*4").gain(0.16).decay(0.3)),
]

const stemJ6_hats = strip(bus(stack(
  pick(hatVar, HATS),
  gate(above(hatDens, 0), drum("hh*16").degradeBy(0.4).gain(ramp(hatDens, 0, 0.5).mul(0.12))),
  gate(above(hatDens, 0.5), drum("hh*32").degradeBy(0.8).gain(ramp(hatDens, 0.5, 1).mul(0.18))),
  gate(held(hats.btn2), drum("[~ oh]*4").gain(0.4))
).mul(gain(3.2)).pan(0.56), 1, hats.space, 0.2), {
  lpf: expRange(hats.bright, 3000, 16000),
  level: hats.level.range(0, 0.47),   // was 1; mix: hats −11 dB at full density
})

// ============================================================
// JOJO 7 PERCUSSION — soft tuned bongos (after 005's pillow bongos) in a steady pattern, plus a 909 rimshot
// ============================================================
// Notes F, C, E♭, A♭: in all three chapters.
// @008 ctl B16:7.k1 Brightness | woody ↔ metallic (FM and lpf 600–12000 Hz).
// @008 ctl B16:7.k2 Space | dry ↔ far away (reverb + echo).
// @008 ctl B16:7.k3 Density | steady pattern ↔ + fingertip ghost notes ↔ + little rolls.
// @008 ctl B16:7.fader Level | bongos and rimshot. Keep playing in the break.
// @008 ctl B16:7.b1 Change | pillow → gallop → 3-3-2.
// @008 ctl B16:7.b2 Fill | a bongo run down over the bar while held.
const perc     = colJojo(7)
const percVar  = change(perc.btn, 'jojo', 'Perkussion', 3, ['Kissen', 'Galopp', '3-3-2'])
const percDens = perc.char
const bongo = (notes, dec, g) => note(notes).s("sine").fm(perc.bright.mul(2)).fmh(2.76)
  .decay(dec).sustain(0).release(dec / 2).gain(g)
const rimshot = drum("[~ ~ ~ ~ ~ ~ rim ~]").gain(0.28)
const PERCS = [
  ["f4 ~ ~ f4 ~ c5 ~ ~", "~ c6 ~ f5 ~ ~ c6 ~"],
  ["f4 ~ f4 ~ ~ f4 ~ c5", "~ f5 ~ ~ c6 ~ f5 ~"],
  ["f4 ~ ~ f4 ~ ~ f4 ~", "~ ~ c6 ~ ~ ~ ~ f5 ~ ~ c6 ~ ~ ~ f5 ~"],
].map(([low, high]) => stack(bongo(low, 0.085, 0.55), bongo(high, 0.045, 0.7), rimshot))

const stemJ7_perc = strip(bus(stack(
  pick(percVar, PERCS),
  gate(above(percDens, 0), bongo("~ ~ eb5 ~ ~ ab5 ~ c5", 0.035, ramp(percDens, 0, 0.5).mul(0.5))),
  gate(above(percDens, 0.5), bongo("~ c6 ~ ab5 c6 ~ eb5 ~ c5 ~ ~ eb5 ~ c5 ab5 ~", 0.025, ramp(percDens, 0.5, 1).mul(0.45))),
  gate(held(perc.btn2), bongo("f5 eb5 c5 ab4 f5 eb5 c5 ab4 c5 ab4 f4 eb4 f4 ~ f4 ~", 0.05, 0.6))
).mul(gain(1.6)).pan(sine.slow(4).range(0.35, 0.65)), 1, perc.space, 0.3), {
  lpf: expRange(perc.bright, 600, 12000),
  level: perc.level.range(0, 0.6),   // was 1; mix: percussion −10 dB
})

// ============================================================
// JOJO 8 RIDE — 909 ride, swing on the 16ths
// ============================================================
// @008 ctl B16:8.k1 Brightness | dark shimmer ↔ bright sizzle (lpf 2.5–16 kHz).
// @008 ctl B16:8.k2 Space | dry ↔ far away (reverb + echo).
// @008 ctl B16:8.k3 Swing | straight ↔ swung, lazy (the in-between 16ths come late).
// @008 ctl B16:8.fader Level | ride. Keeps playing in the break.
// @008 ctl B16:8.b1 Change | off-beat → 8ths → 16ths.
// @008 ctl B16:8.b2 Double | double time while held.
const ride    = colJojo(8)
const rideVar = change(ride.btn, 'jojo', 'Ride', 3, ['Offbeat', 'Achtel', 'Sechzehntel'])
const RIDES = ["[~ 0.35]*4", "[0.3 0.2]*4", "[0.3 0.12 0.2 0.12]*4"].map(g => drum("rd").struct(g).gain(g))

const stemJ8_ride = strip(bus(pick(rideVar, RIDES)
  .fast(ride.btn2.fmap(v => v > 0.5 ? 2 : 1))
  .swingBy(ride.char.mul(0.6), 8)   // 0.6 = the off-16th lands on the last triplet
  .mul(gain(1.6)).pan(0.6), 1, ride.space, 0.25), {
  lpf: expRange(ride.bright, 2500, 16000),
  level: ride.level.range(0, 0.66),   // was 1; mix: ride −12 dB
})

// ============================================================
// JONAS 1 PAD — dark minor-9 chords on the progression, slow attack
// ============================================================
// @008 ctl 16:1.k1 Brightness | muffled ↔ open and airy (lpf 250–6000 Hz).
// @008 ctl 16:1.k2 Space | dry and close ↔ far away in a big room (reverb + echo).
// @008 ctl 16:1.k3 Swell | 0 = held chords. Up = the chord is re-struck on every half bar and breathes in and out.
// @008 ctl 16:1.fader Level | dark pad.
// @008 ctl 16:1.b1 Change | next of 8 chord progressions, for all.
// @008 ctl 16:1.b2 Freeze | holds the current chord while held, for everybody.
const padSwell = pad.char
const padChord = chordOn([0, 2, 4, 6, 8]).scale(scaleIn(3))
const padStill = stack(
  padChord.s("sawtooth").superimpose(x => x.add(note(0.1))).attack(0.9).sustain(0.8).release(2).gain(0.035)
    .pan(sine.slow(5).range(0.3, 0.7)),
  padChord.s("triangle").attack(0.6).sustain(0.8).release(2).gain(0.07)
)
const padBreath = padChord.struct("x*2").s("sawtooth,triangle")
  .attack(0.4).decay(0.5).sustain(0.15).release(0.8).gain(0.05).pan(sine.slow(5).range(0.3, 0.7))

const stemN1_pad = strip(bus(stack(
  gate(above(fadeMain(padSwell), 0), padStill.mul(gain(fadeMain(padSwell)))),
  gate(above(fadeExtra(padSwell), 0), padBreath.mul(gain(fadeExtra(padSwell))))
), 2, pad.space, 0.2), {
  lpf: expRange(pad.bright, 250, 6000),
  level: pad.level.range(0, 1),
})

// ============================================================
// JONAS 2 DUB CHORDS — raw minor-7 stabs: detuned saw + square, overdriven, a breath of noise, long dotted-8th echoes
// ============================================================
// All knobs at 0 = long, dark, dry chords (the favourite starting point).
// @008 ctl 16:2.k1 Brightness | warm and muffled ↔ bright, raw (lpf 400–7000 Hz).
// @008 ctl 16:2.k2 Space | dry ↔ the echoes repeat far into the distance.
// @008 ctl 16:2.k3 Length | long ringing chords ↔ short, choppy stabs.
// @008 ctl 16:2.fader Level | dub chord stabs (same chords as the pad).
// @008 ctl 16:2.b1 Change | next of 8 stab rhythms.
// @008 ctl 16:2.b2 Stab | a chord on every off-beat while held.
const chords   = colJonas(2)
const chordVar = change(chords.btn, 'jonas', 'Dub-Akkorde')
const chordLen = chords.char.fmap(c => 1.2 * Math.pow(0.07, c))   // decay seconds: 1.2 ↔ 0.08; middle = classic stab
const dubChord = chordOn([0, 2, 4, 6]).scale(scaleIn(3))
const CHORD_RHYTHMS = ["~ [~ x] ~ ~", "[~ ~ ~ x] ~ [~ ~ x ~] ~", "~ [~ x] ~ [~ x]", "x(3,8,2)", "x(3,16,3)",
  "[~ ~ x ~] ~ ~ [~ x ~ ~]", "~ ~ [~ x] [~ ~ ~ x]", "x(5,16,2)"]
const CHORD_PATS = CHORD_RHYTHMS.map(r => dubChord.struct(r))
// Noise breath on every stab: tape / vinyl grit
const CHORD_GRIT = CHORD_RHYTHMS.map(r => s("pink").struct(r))
const dubSound = pat => stack(
  pat.s("sawtooth").superimpose(x => x.add(note(0.12))).gain(1),
  pat.s("square").add(note(-0.08)).gain(0.5)
).decay(chordLen).sustain(0).release(chordLen).lpq(2).shape(0.35)

const stemN2_chords = strip(bus(stack(
  dubSound(pick(chordVar, CHORD_PATS)).gain(0.08).delay(0.55),
  pick(chordVar, CHORD_GRIT).decay(chordLen.mul(0.4)).sustain(0).hpf(2500).gain(0.03).delay(0.55),
  gate(held(chords.btn2), dubSound(dubChord.struct("[~ x]*4")).gain(0.08).delay(0.4))
), 2, chords.space), {
  lpf: expRange(chords.bright, 400, 7000),
  level: chords.level.range(0, 0.68),   // was 1; mix: melodic stems about −5 dB under the kick
})

// ============================================================
// JONAS 3 SEQUENCE — a hypnotic mallet loop: 3-, 5- or 7-step loops against the 4/4 (polymeter), mostly root and fifth
// ============================================================
// Soft FM mallet (low index, harmonic ratio) with a tiny random detune per note, so it sounds played, not programmed.
// Keeps a little room even at space 0.
// @008 ctl 16:3.k1 Brightness | soft wooden mallet ↔ sharp, glassy (lpf 1.5–12 kHz, more FM).
// @008 ctl 16:3.k2 Space | a little room ↔ far away (reverb + dub echo).
// @008 ctl 16:3.k3 Range | few notes of the loop ↔ every step, plus the 9th and 7th in between.
// @008 ctl 16:3.fader Level | hypnotic loop on the chord.
// @008 ctl 16:3.b1 Change | next of 8 loops (3, 5 or 7 steps).
// @008 ctl 16:3.b2 Octave | one octave up while held.
const seqCol   = colJonas(3)
const seqVar   = change(seqCol.btn, 'jonas', 'Sequenz')
const seqRange = seqCol.char
const seqOct   = seqCol.btn2.fmap(v => v > 0.5 ? 12 : 0)
const SEQS = ["{0 ~ 0 4 ~}%16", "{0 ~ 6 ~ 4 ~ 0}%16", "{0 4 ~}%16", "{0 ~ ~ 2 ~ 4 ~}%16", "{4 ~ 0 ~ 0}%16",
  "{0 ~ 3 ~ 0 4 ~}%16", "{6 ~ 4 ~ ~}%16", "{0 0 ~ 4 ~ 2 ~}%16"].map(p => n(p))

const stemN3_seq = strip(bus(onRoot(pick(seqVar, SEQS)
  .degradeBy(seqRange.fmap(r => 0.5 * (1 - r)))
  .sometimesBy(seqRange.mul(0.25), x => x.add(n("<1 -1>"))))   // passing notes: 9th / 7th
  .scale(scaleIn(4)).add(note(seqOct)).add(note(rand.range(-0.06, 0.06)))
  .s("sine").fm(seqCol.bright.range(0.4, 2)).fmh(2)
  .attack(0.003).decay(0.28).sustain(0).release(0.25)
  .gain(perlin.range(0.47, 0.74)).pan(sine.slow(3).range(0.35, 0.65)).delay(0.4),
  2, seqCol.space.fmap(s => 0.3 + 0.7 * s)), {
  lpf: expRange(seqCol.bright, 1500, 12000),
  level: seqCol.level.range(0, 0.8),   // was 1; mix: melodic stems about −5 dB under the kick
})

// ============================================================
// JONAS 4 LEAD — a warm, breathing line: longer notes, detuned saws + triangle, slight vibrato, gentle glide
// ============================================================
// @008 ctl 16:4.k1 Brightness | soft and warm ↔ open, a little reedy (lpf 600–6000 Hz).
// @008 ctl 16:4.k2 Space | a little room ↔ far away (reverb + echo).
// @008 ctl 16:4.k3 Glide | plain notes ↔ notes bend gently into their pitch (at most a semitone).
// @008 ctl 16:4.fader Level | lead line on the chord.
// @008 ctl 16:4.b1 Change | next of 8 lines.
// @008 ctl 16:4.b2 Echo throw | long echo on the line while held.
const lead      = colJonas(4)
const leadVar   = change(lead.btn, 'jonas', 'Lead')
const leadGlide = lead.char
const LEADS = ["0 _ ~ ~ 3 ~ 2 _ ~ ~ 0 ~ ~ ~ -1 ~", "~ ~ 0 _ ~ ~ 4 _ _ ~ 3 ~ 2 _ ~ ~", "0 ~ ~ 0 ~ ~ 2 _ ~ ~ ~ ~ -1 _ _ ~",
  // 5: on beats 1, 2 and 4, the 3 pushed a 16th before beat 3 (was all on weak 16ths: it sounded out of time)
  "4 _ _ ~ 3 _ ~ 2 _ _ ~ ~ 0 _ ~ ~", "0 _ ~ ~ 2 _ ~ 3 _ _ ~ ~ 2 ~ 0 _",
  "<[0 _ ~ ~ 3 ~ 2 _ ~ ~ 0 ~ ~ ~ ~ ~] [0 _ ~ ~ 3 ~ 4 _ ~ ~ 3 ~ 2 _ ~ ~]>", "6 _ ~ 4 _ ~ 3 _ ~ ~ 2 _ ~ 0 _ ~",
  "~ ~ ~ ~ 0 _ _ _ ~ ~ 3 _ 2 _ _ _"].map(p => n(p))
const throwEcho = (pat, button) => pat.fmap(v => b => b > 0.5 ? { ...v, delay: 0.85 } : v).appLeft(button)
const leadNotes = onRoot(pick(leadVar, LEADS)).scale(scaleIn(4))

const stemN4_lead = strip(throwEcho(bus(stack(
  leadNotes.s("sawtooth").superimpose(x => x.add(note(0.1))).gain(0.5),
  leadNotes.s("triangle").add(note(-12)).gain(0.6)
).attack(0.02).decay(0.3).sustain(0.5).release(0.2).lpq(1.5)
  .vib(4.5).vibmod(0.07)
  .penv(leadGlide.fmap(g => -g)).pattack(0.1)
  .gain(0.3).delay(0.3), 2, lead.space.fmap(s => 0.25 + 0.75 * s)), lead.btn2), {
  lpf: expRange(lead.bright, 600, 6000),
  level: lead.level.range(0, 0.86),   // was 1; mix: melodic stems about −5 dB under the kick
})

// ============================================================
// JONAS 5 ANSWER — short square blips at the end of every second bar, bouncing left and right through a long echo
// ============================================================
// @008 ctl 16:5.k1 Brightness | soft ↔ clear and bright (lpf 2–12 kHz).
// @008 ctl 16:5.k2 Space | some room and echo ↔ far away in space.
// @008 ctl 16:5.k3 Voices | 0 = one voice, 0.5 = + a third above, 1 = + a fifth: three-part blips.
// @008 ctl 16:5.fader Level | counter blips, a short phrase every second bar.
// @008 ctl 16:5.b1 Change | next of 8 phrase rhythms (new notes too).
// @008 ctl 16:5.b2 Answer | the phrase plays in every bar while held.
const ans       = colJonas(5)
const ansVar    = change(ans.btn, 'jonas', 'Antwort')
const ansVoices = ans.char
const ANS_RHYTHMS = ["~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ x ~ ~ x ~ ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x x x ~",
  "~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ x ~ x", "~ ~ ~ ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ ~ ~ ~ ~",
  "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x x ~ x ~ ~", "~ ~ ~ ~ x ~ ~ ~ ~ ~ x ~ ~ ~ x x"]
// Every second bar normally, every bar while button 2 is held
const ansEvery2 = pick(ansVar, ANS_RHYTHMS.map(r => pure(1).struct(r).mask("<0 1>")))
const ansEvery  = pick(ansVar, ANS_RHYTHMS.map(r => pure(1).struct(r)))
const ansRhythm = held(ans.btn2).fmap(b => b ? ansEvery : ansEvery2).innerJoin()
// Notes: random chord tones (root, 3rd, 5th, 7th, octave), new ones per change
const ANS_TONES = [0, 2, 4, 6, 7]
const ansNotes = n(reseed(ansVar, irand(5).segment(16).fmap(i => ANS_TONES[i])))
const ansVoice = (deg, g) => onRoot(ansRhythm.fmap(() => v => v).appLeft(ansNotes).add(n(deg)))
  .scale(scaleIn(5)).s("square").decay(0.07).sustain(0).release(0.05).gain(g)

const stemN5_ans = strip(bus(stack(
  ansVoice(0, 0.54),
  gate(above(ansVoices, 0), ansVoice(2, ramp(ansVoices, 0, 0.5).mul(0.42))),
  gate(above(ansVoices, 0.5), ansVoice(4, ramp(ansVoices, 0.5, 1).mul(0.36)))
).pan("[0.2 0.8]*8").delay(0.55), 2, ans.space.fmap(s => 0.35 + 0.65 * s)), {
  lpf: expRange(ans.bright, 2000, 12000),
  level: ans.level.range(0, 0.79),   // was 1; mix: answer −7 dB
})

// ============================================================
// JONAS 6 PINGS — a real glockenspiel (General MIDI soundfont) pinging on a 16th grid, long echoes
// ============================================================
// @008 ctl 16:6.k1 Brightness | soft glow ↔ ringing, bright (lpf 4–16 kHz).
// @008 ctl 16:6.k2 Space | dry ↔ far away (reverb + echo).
// @008 ctl 16:6.k3 Density | a few pings per bar ↔ a rain of pings (~70 % of the 16ths).
// @008 ctl 16:6.fader Level | glockenspiel pings.
// @008 ctl 16:6.b1 Change | next of 8 random ping patterns.
// @008 ctl 16:6.b2 Run | runs up and down the chord, denser and louder the longer it is held (full after 2 bars).
const pings    = colJonas(6)
const pingVar  = change(pings.btn, 'jonas', 'Pings')
const pingKeep = pings.char.fmap(d => 0.2 + 0.5 * d)   // share of 16ths
const pingRise = heldRamp(pings.btn2, 2)                // 0 → 1 over 2 bars while held
// Every bar keeps ringing after the next is struck (a metal bar, no damper)
const glock = pat => pat.s("gm_glockenspiel").release(1.2)
// A player's sweep: up and down the chord tones in 32nds, two octaves (scale degrees above the root)
const PING_RUN = n("[0 2 4 6 7 9 11 13 14 13 11 9 7 6 4 2]*2")

const stemN6_pings = strip(bus(onRoot(reseed(pingVar,
  glock(n(irand(10).segment(16))
    .degradeBy(pingKeep.fmap(k => 1 - k)))
    .gain(rand.range(0.14, 0.33))
    .pan(rand)
    .delay(0.5)
).stack(
  // Run: starts as a few scattered notes of the sweep and fills in over 2 bars (15 % → 90 % of the 32nds), getting
  // louder; random velocities keep it played, not ticking. Released = gone.
  gate(held(pings.btn2), glock(PING_RUN.degradeBy(pingRise.fmap(r => 0.85 - 0.75 * r)))
    .gain(pingRise.fmap(r => v => (0.18 + 0.27 * r) * v).appLeft(rand.range(0.7, 1)))
    .pan(sine.fast(2).range(0.3, 0.7)).delay(0.4))
)).scale(scaleIn(5)), 2, pings.space), {
  lpf: expRange(pings.bright, 4000, 16000),
  level: pings.level.range(0, 0.61),   // was 1; mix: pings −10 dB
})

// ============================================================
// JONAS 7 FX / BREATH — noise that breathes in and out slowly; with Amount, the chord pulses along in 8ths
// ============================================================
// Breathing = 16th noise grains whose level and bandpass follow a slow sine (one breath per 1, 2, 4 or 8 bars).
// @008 ctl 16:7.k1 Brightness | dark whoosh ↔ bright hiss (lpf 1.5–14 kHz).
// @008 ctl 16:7.k2 Space | some room ↔ far away (reverb + echo).
// @008 ctl 16:7.k3 Amount | 0 = only the breathing noise. Up = the chord pulses along in 8ths, at 1 also a 16th shimmer an octave up.
// @008 ctl 16:7.fader Level | slow breathing.
// @008 ctl 16:7.b1 Change | one breath per 2 → 4 → 8 → 1 bar(s).
// @008 ctl 16:7.b2 Open | the breath opens fully while held.
const fx       = colJonas(7)
const fxVar    = change(fx.btn, 'jonas', 'Atem', 4, ['2 Takte', '4 Takte', '8 Takte', '1 Takt'])
const fxAmount = fx.char
const FX_BREATHS = [2, 4, 8, 1].map(len => sine.slow(len))
// 0..1, eased so the quiet part is long and the peak short (like breathing); held button = fully open
const breath = pick(fxVar, FX_BREATHS).fmap(v => b => b > 0.5 ? 1 : Math.pow(v, 1.6)).appLeft(fx.btn2)
const fxNoise = s("pink*16").attack(0.04).sustain(0.8).release(0.12)
  .bpf(breath.fmap(b => 400 * Math.pow(10, b))).bpq(1.5)
  .gain(breath.fmap(b => 0.7 + 7 * b)).pan(sine.slow(3).range(0.3, 0.7))
const ramp01  = x => Math.min(1, Math.max(0, x))
const fxChord = chordOn([0, 4, 7]).scale(scaleIn(4))
const fxPulse = stack(
  fxChord.struct("x*8").s("triangle").attack(0.02).sustain(0.8).release(0.1)
    .gain(breath.fmap(b => a => 0.15 * b * ramp01(a / 0.5)).appLeft(fxAmount)),
  gate(above(fxAmount, 0.5), fxChord.add(note(12)).struct("x*16").s("sine").attack(0.01).sustain(0.6).release(0.08)
    .gain(breath.fmap(b => a => 0.09 * b * ramp01((a - 0.5) / 0.5)).appLeft(fxAmount)))
)

const stemN7_fx = strip(bus(stack(
  fxNoise,
  gate(above(fxAmount, 0), fxPulse)
).delay(0.3), 2, fx.space.fmap(s => 0.3 + 0.7 * s)), {
  lpf: expRange(fx.bright, 1500, 14000),
  level: fx.level.range(0, 0.48),   // was 1; mix: fx −10 dB at full amount (after the pink-noise boost)
})


// What the LC view shows for this track: the chapter (now, next) on column 8 button 1, and extra lines at the top
const lcChapter = () => ['A ' + MOODS[moodLatch.now].name, 'A ' + MOODS[moodLatch.pending].name]
const lcHead    = () => []
// Where the music is (LC view): the beat in the bar and the bar in the big cycle. A silent event per beat moves it at
// the moment the beat sounds (onTrigger, as in the set). chordAt(bar) = the chord of that bar ('' = none shown)
const CYCLE   = 8   // the progression: 4 chords × 2 bars
const chordAt = bar => ''
const beatNow = { bar: null, beat: null }
const beatTick = pure(0).segment(4).fmap(() => ({})).onTrigger((hap, now, cps, t) => {
  const pos = hap.whole.begin.valueOf(), bar = Math.floor(pos + 1e-9), beat = Math.floor((pos - bar) * 4 + 1e-9)
  setTimeout(() => { beatNow.bar = bar; beatNow.beat = beat; lcView?.update() }, Math.max(0, (t - now) * 1000))
}, true)

// LC view of this evaluation: names from the tags in the editor (strudel.cc keeps the text in strudelMirror),
// buttons from the change() rows (row i = column i + 1), chapter and break on column 8
return { taps, showStatus, STATUS, lcChapter, lcHead, stems: { J1: stemJ1_kick, J2: stemJ2_rumble, J3: stemJ3_sub, J4: stemJ4_bass, J5: stemJ5_clap, J6: stemJ6_hats, J7: stemJ7_perc, J8: stemJ8_ride, N1: stemN1_pad, N2: stemN2_chords, N3: stemN3_seq, N4: stemN4_lead, N5: stemN5_ans, N6: stemN6_pings, N7: stemN7_fx } }
})()

SET.tracks = [T007, T010, T009, T008]
SET.track = () => SET.tracks[SET.focus()]
SET.refresh = () => SET.track().showStatus()

// Every column of every track: 007 at half speed on the 140 grid, 008 transposed (+4 semitones to A)
const COLS = ['J1', 'J2', 'J3', 'J4', 'J5', 'J6', 'J7', 'J8', 'N1', 'N2', 'N3', 'N4', 'N5', 'N6', 'N7']
const midiOf = x => typeof x === 'number' ? x : noteToMidi(x)
const transposed = (v, semis) => v.note === undefined ? v : { ...v, note: midiOf(v.note) + semis }
const prep = (k, stem) => {
  const t = SET_TRACKS[k], p = t.slow === 1 ? stem : stem.slow(t.slow)
  return t.transpose ? p.fmap(v => transposed(v, t.transpose)) : p
}

// ---- Morph: one track's column turns into the next one's --------------------------------------------------------
// Within a window both columns are queried; their events are paired by an alignment that keeps their order (time,
// then pitch) and pays for distance in time and pitch, for a different sound, or for leaving an event alone.
// A pair of the same sound (s, bank, sample) becomes one event between the two: onset, length, pitch and every
// number glide (filters on a log scale); orbit, room size and echo time come from the nearer side (one reverb per
// orbit). A pair of two different sounds (e.g. 007's synth kick and 010's sine kick) moves together the same way, but
// stays two voices whose timbres cross over. An event without a partner thins out (short hits: each one leaves or
// enters at its own point of the way) or fades (long sounds).
const GAP = 0.25                     // cost of an unpaired event; a pair is taken while cheaper than two gaps
const CROSS = 0.15                   // extra cost of pairing two different sounds
const UNPITCHED = 0.15              // extra cost of pairing a pitched with an unpitched event
const SHORT = 0.3                    // events shorter than this (cycles) thin out instead of fading
const ORBIT_KEYS = new Set(['orbit', 'roomsize', 'roomfade', 'roomlp', 'roomdim', 'delaytime', 'delayfeedback', 'ir'])
const LOG_KEYS = new Set(['cutoff', 'hcutoff', 'bandf', 'freq'])
// Values a missing key stands for, so a key on one side only can still glide (e.g. a pitch envelope fading in)
const MISSING = { cutoff: 20000, hcutoff: 20, penv: 0, shape: 0, distort: 0, delay: 0, room: 0, vib: 0, vibmod: 0,
  fm: 0, pan: 0.5, gain: 1, postgain: 1, velocity: 1, resonance: 0, detune: 0, pdecay: 0, pattack: 0 }
const lerp = (a, b, u) => a + (b - a) * u
const classOf = e => e.v.s + '|' + (e.v.bank ?? '') + '|' + (e.v.note === undefined ? e.v.n ?? '' : '')
const pitchOf = e => e.v.note === undefined ? undefined : midiOf(e.v.note)
const hash = e => { const x = Math.sin(e.t * 12.9898 + (pitchOf(e) ?? 0) * 78.233 + e.d * 3.7) * 43758.5453; return x - Math.floor(x) }
const blend = (va, vb, u) => {
  const near = u < 0.5 ? va : vb, out = {}
  for (const k of new Set([...Object.keys(va), ...Object.keys(vb)])) {
    if (ORBIT_KEYS.has(k)) { if (near[k] !== undefined) out[k] = near[k]; continue }
    let a = va[k] ?? MISSING[k], b = vb[k] ?? MISSING[k]
    if (k === 'note' && a !== undefined && b !== undefined) { a = midiOf(a); b = midiOf(b) }
    if (typeof a === 'number' && typeof b === 'number')
      out[k] = LOG_KEYS.has(k) && a > 0 && b > 0 ? Math.exp(lerp(Math.log(a), Math.log(b), u)) : lerp(a, b, u)
    else if (near[k] !== undefined) out[k] = near[k]
  }
  return out
}
// Order-keeping alignment of two event lists (dynamic programming): [a, b] pairs, [a, null] / [null, b] alone
const align = (ea, eb, len) => {
  const n = ea.length, m = eb.length
  const cost = (a, b) => {
    const pa = pitchOf(a), pb = pitchOf(b)
    return ((a.t - b.t) / len) ** 2 + (pa !== undefined && pb !== undefined ? ((pa - pb) / 12) ** 2 : 0) +
      (classOf(a) === classOf(b) ? 0 : CROSS) + ((pa === undefined) !== (pb === undefined) ? UNPITCHED : 0)
  }
  const D = [...Array(n + 1)].map((_, i) => [...Array(m + 1)].map((_, j) => (i + j) * GAP))
  for (let i = 1; i <= n; i++) for (let j = 1; j <= m; j++)
    D[i][j] = Math.min(D[i - 1][j - 1] + cost(ea[i - 1], eb[j - 1]), D[i - 1][j] + GAP, D[i][j - 1] + GAP)
  const steps = []
  for (let i = n, j = m; i > 0 || j > 0;) {
    if (i > 0 && j > 0 && D[i][j] === D[i - 1][j - 1] + cost(ea[i - 1], eb[j - 1])) { steps.push([ea[--i], eb[--j]]) }
    else if (i > 0 && D[i][j] === D[i - 1][j] + GAP) steps.push([ea[--i], null])
    else steps.push([null, eb[--j]])
  }
  return steps
}
// One voice of a pair of different sounds: the shared numbers glide, its own sound and room stay, its level crosses
const voice = (own, other, u, g) => {
  const v = blend(own, other, u)
  for (const k of new Set([...Object.keys(own), ...Object.keys(other)])) {
    const ownsIt = k in own && (ORBIT_KEYS.has(k) || typeof own[k] !== 'number' || !(k in other) && !(k in MISSING))
    if (ownsIt) v[k] = own[k]
    else if (!(k in own) && (ORBIT_KEYS.has(k) || typeof other[k] !== 'number' || !(k in MISSING))) delete v[k]
  }
  v.postgain = (v.postgain ?? 1) * g
  return v
}
const render = ([a, b], u) => {
  if (a && b) {
    const t = lerp(a.t, b.t, u), d = lerp(a.d, b.d, u)
    if (classOf(a) === classOf(b)) return [{ t, d, v: blend(a.v, b.v, u), ctx: u < 0.5 ? a.ctx : b.ctx }]
    return [{ t, d, v: voice(a.v, b.v, u, fadeOut(u)), ctx: a.ctx }, { t, d, v: voice(b.v, a.v, 1 - u, fadeIn(u)), ctx: b.ctx }]
  }
  const e = a ?? b
  if (e.d < SHORT) return (a ? hash(e) >= u : hash(e) < u) ? [e] : []
  const g = a ? fadeOut(win(u, [0, 0.6])) : fadeIn(win(u, [0.4, 1]))
  return g > 0 ? [{ ...e, v: { ...e.v, postgain: (e.v.postgain ?? 1) * g } }] : []
}
const morph = (A, B, col) => {
  const per = MORPH[col].per, cache = new Map()
  const events = (pat, ws, we, state) => pat.query(state.setSpan(new TimeSpan(ws, we)))
    .filter(h => h.hasOnset())
    .map(h => ({ t: h.whole.begin.valueOf(), d: h.whole.end.valueOf() - h.whole.begin.valueOf(), v: h.value, ctx: h.context }))
    .filter(e => e.t >= ws - 1e-9 && e.t < we - 1e-9)
  // pitched events first at the same time, so a tuned kick body meets the other tuned body, not a sample
  const byOrder = (x, y) => x.t - y.t || (pitchOf(x) ?? 1000) - (pitchOf(y) ?? 1000)
  // The plan of a window is made once, at its first query, with the progress of that moment (so no event can move
  // across a query boundary and sound twice or not at all)
  const plan = (w, state) => {
    if (cache.has(w)) return cache.get(w)
    const ws = w / per, we = (w + 1) / per
    const a = events(A, ws, we, state), b = events(B, ws, we, state)
    const u = progress(col).u
    const out = align(a.sort(byOrder), b.sort(byOrder), 1 / per).flatMap(st => render(st, u))
    cache.set(w, out)
    if (cache.size > 16) cache.delete(cache.keys().next().value)
    return out
  }
  return new Pattern(state => {
    const b0 = state.span.begin.valueOf(), e0 = state.span.end.valueOf(), haps = []
    for (let w = Math.floor(b0 * per + 1e-9); w < e0 * per - 1e-9; w++)
      for (const ev of plan(w, state))
        if (ev.t >= b0 - 1e-9 && ev.t < e0 - 1e-9)
          haps.push(new Hap(new TimeSpan(ev.t, ev.t + ev.d), new TimeSpan(ev.t, Math.min(ev.t + ev.d, Math.max(e0, ev.t + 1e-6))), ev.v, ev.ctx))
    return haps
  })
}

// A column: on a plateau (u = 0 or 1) the track's own stem, unchanged; in between the morph of the two tracks
const column = col => {
  const pats = SET.tracks.map((t, k) => t.stems[col] ? prep(k, t.stems[col]) : silence)
  const plain = pats.map((p, k) => gate(signal(() => {
    const { i, u } = progress(col)
    return (i === k && u === 0) || (i === k - 1 && u === 1)
  }), p))
  const moving = pats.slice(0, -1).map((p, k) => gate(signal(() => {
    const { i, u } = progress(col)
    return i === k && u > 0 && u < 1
  }), morph(p, pats[k + 1], col)))
  return stack(...plain, ...moving)
}
const stems = COLS.map(column)
// Stateful controls of each track (see stateTaps in the tracks), queried only while the track is awake
const trackTaps = SET.tracks.map((t, k) => {
  const all = stack(...t.taps)
  return gate(signal(() => awake(k)), SET_TRACKS[k].slow === 1 ? all : all.slow(SET_TRACKS[k].slow)).filterValues(() => false)
})

// Tempo: a silent event per 8th note carries the tempo of the current position; the scheduler takes over its cps
// (keeping the bar count). It sits last in the master, so no other event of the same tick is timed with the new tempo.
// Its trigger also moves the beat in the LC view, at the moment the beat sounds.
const tempoStem = pure(0).segment(8).fmap(() => ({ cps: bpmAt(setState.smooth) / 240 }))
  .onTrigger((hap, now, cps, t) => {
    const tr = SET_TRACKS[focusOf(setState.smooth)]
    const inner = hap.whole.begin.valueOf() / tr.slow
    const bar = Math.floor(inner + 1e-9), beat = Math.floor((inner - bar) * 4 + 1e-9)
    if (setState.beat && setState.beat.bar === bar && setState.beat.beat === beat) return
    setTimeout(() => { setState.beat = { bar, beat, phrase: phraseOf(tr) }; lcView?.update() }, Math.max(0, (t - now) * 1000))
  }, true)
setcps(bpmAt(setState.smooth) / 240)

if (lcView) {
  const CC_ROW = { k1: 12, k2: 20, k3: 28, fader: 4, b1: 36, b2: 44 }   // CC = row base + column (Mode 16 / Mode 1)
  const ROWS = ['k1', 'k2', 'k3', 'fader', 'b1', 'b2']
  const code = globalThis.strudelMirror?.code ?? ''
  const TAGS_OF = SET_TRACKS.map(t => {
    const T = {}
    for (const m of code.matchAll(new RegExp('^// @' + t.id + ' (?:mode|col|ctl) (\\S+) (.*)$', 'gm'))) T[m[1]] = m[2]
    for (const m of code.matchAll(/^\/\/ @ctl (g\.\S+) (.*)$/gm)) T[m[1]] = m[2]
    return T
  })
  // Tag prefix of a page: dual file B16 (Jojo) / 16 (Jonas), single file 16 (Mode 1) / 2 (Mode 2)
  const prefix = page => page === 'jojo' ? 'B16' : '16'   // per-track tags stay in the dual form
  const esc = s => String(s).replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c])
  const isGlobal = (page, n) => n === 8 && (alone || page === 'jonas')
  // Short page title without the players' names: 'Mode 2 — Jonas: Colour (chords + melodies)' → 'Mode 2 — Chords +
  // melodies', 'Jonas — Colour (chords + melodies)' → 'Chords + melodies'
  const shortTitle = t => {
    const m = t.match(/^(.*?) — .*?\((.+?)\)/)
    if (!m) return t.split(' · ')[0]
    const what = m[2][0].toUpperCase() + m[2].slice(1)
    return /^Mode \d/.test(m[1]) ? m[1] + ' — ' + what : what
  }

  lcView.side = name => !alone && /jojo/i.test(name ?? '') ? 'jojo' : 'jonas'
  // Column 8 CCs ((cc - 4) % 8 == 0) are on both pages and keep the page
  lcView.pageOf = (side, cc) => !alone ? side : (cc - 4) % 8 === 0 ? lcView.page : cc > 52 ? 'jonas' : 'jojo'
  const valueOf = (page, n, row) => {
    const base = CC_ROW[row] + n
    const t = lcView.cc[alone ? 'jonas' : page]
    return alone && page === 'jonas' && n < 8 ? t[base + 48] : t[base] ?? (n === 8 ? t[base + 48] : undefined)
  }
  const pending = (now, next) => esc(now) + (next !== now ? '<span class=next> → ' + esc(next) + '</span>' : '')
  const choice = (page, n) => {
    if (isGlobal(page, n)) return pending(...SET.track().lcChapter())
    const r = SET.track().STATUS[page][n - 1]
    if (!r) return ''
    const show = i => !r.names ? (i + 1) + ' / ' + r.n : typeof r.names === 'function' ? r.names(i) : r.names[i]
    return pending(show(r.latch.now), show(r.latch.pending))
  }
  const cell = (page, n, row) => {
    const val = valueOf(page, n, row)
    const [name, desc] = (TAGS_OF[SET.focus()][isGlobal(page, n) ? 'g.' + row : prefix(page) + ':' + n + '.' + row] ?? '').split(' | ')
    const num = val === undefined ? '–' : Math.round(val * 100)
    const v = 'style="--v:' + (val ?? 0) + '"'
    const title = ' title="' + esc(desc ?? '').replace(/"/g, '&quot;') + '"'
    if (row === 'fader') return '<div class="cell fader"' + title + '><div class=bar ' + v + '><i></i></div>' +
      '<b>' + num + '</b><span>' + esc(name) + '</span></div>'
    if (row === 'b1') return '<div class="cell btn"' + title + '><span>' + esc(name) + '</span><b>' + choice(page, n) + '</b></div>'
    if (row === 'b2') {
      const on = isGlobal(page, n) ? setState.mode : (val ?? 0) > 0.5
      const what = isGlobal(page, n) ? esc(setState.mode ? 'Set' : 'Fog')
        : on ? 'gedrückt' : ''
      return '<div class="cell btn' + (on ? ' on' : '') + '"' + title + '><span>' + esc(name) + '</span><b>' + what + '</b></div>'
    }
    return '<div class="cell knob"' + title + '><div class=dial ' + v + '></div><b>' + num + '</b><span>' + esc(name) + '</span></div>'
  }
  // Bar in the cycle (bars) and beat in the bar (dots, the one ringed), then the bar's chord
  const marks = (n, on) => [...Array(n).keys()].map(k => '<i' + (k === on ? ' class=on' : '') + '></i>').join('')
  const beatHtml = () => beatNow.bar === null ? '–' : (beatNow.bar % CYCLE + 1) + ' / ' + CYCLE +
    '<span class=bars>' + marks(CYCLE, beatNow.bar % CYCLE) + '</span><span class=beats>' + marks(4, beatNow.beat) + '</span>' +
    (chordAt(beatNow.bar) ? '<span class=chord>' + esc(chordAt(beatNow.bar)) + '</span>' : '')
  lcView.css = [
    'html,body{margin:0;height:100%;background:#111;color:#eee;font:clamp(12px,1.25vw,24px)/1.3 system-ui,sans-serif}',
    '#lc{display:flex;flex-direction:column;gap:1vh;padding:1.5vh 1.5vw;box-sizing:border-box;height:100%;overflow:hidden}',
    '.head{display:flex;gap:2.5vw;align-items:baseline;flex-wrap:wrap}.head h1{margin:0;font-size:1.6em;color:var(--acc)}',
    '.head .k{opacity:.6;margin-right:.4em}.next{color:var(--acc)}',
    '.grid{flex:1;display:grid;grid-template-columns:repeat(8,1fr);grid-template-rows:auto repeat(3,minmax(0,1fr)) minmax(0,1.4fr) auto auto;gap:.8vh .8vw}',
    '.col{text-align:center;font-weight:600;padding:.3em;border-bottom:2px solid #333}.col.g{color:var(--acc)}',
    '.cell{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:.1em;min-width:0;min-height:0}',
    '.cell span{opacity:.7;font-size:.85em;overflow-wrap:anywhere}.cell b{font-variant-numeric:tabular-nums}',
    '.dial{width:min(5vw,6.5vh);aspect-ratio:1;border-radius:50%;',
    'background:conic-gradient(from -135deg,var(--acc) 0 calc(var(--v)*270deg),#333 0 270deg,transparent 0);',
    '-webkit-mask:radial-gradient(circle,transparent 52%,#000 54%);mask:radial-gradient(circle,transparent 52%,#000 54%)}',
    '.bar{position:relative;width:1.4vw;min-width:14px;flex:1;min-height:40px;background:#333;border-radius:4px;overflow:hidden}',
    '.bar i{position:absolute;left:0;right:0;bottom:0;height:calc(var(--v)*100%);background:var(--acc)}',
    '.btn{background:#222;border-radius:6px;padding:.5em .3em;justify-content:flex-start}.btn.on{background:var(--acc);color:#111}',
    '.btn.on span{opacity:.8}.btn b{font-size:1.05em}',
    '.beats{margin-left:.6em}.beats i{display:inline-block;width:.75em;height:.75em;border-radius:50%;background:#333;margin-left:.3em}',
    '.beats i:first-child{outline:2px solid #555}.beats i.on{background:var(--acc)}',
    '.bars{margin-left:.6em}.bars i{display:inline-block;width:1.1em;height:.55em;border-radius:2px;background:#333;margin-left:.15em}',
    '.bars i.on{background:var(--acc)}.chord{margin-left:.6em;font-weight:600;color:var(--acc)}',
  ].join('\n')
  lcView.draw = () => {
    const doc = lcView.win.document
    const root = doc.getElementById('lc')
    if (!root) return
    const page = lcView.page
    doc.documentElement.style.setProperty('--acc', page === 'jojo' ? '#f0a040' : '#50c8e8')
    const cols = [1, 2, 3, 4, 5, 6, 7, 8]
    root.innerHTML = '<div class=head><h1>' + esc(shortTitle(TAGS_OF[SET.focus()][prefix(page)] ?? (page === 'jojo' ? 'Mode 1' : 'Mode 2'))) + '</h1>' +
      '<div><span class=k>Kapitel</span>' + pending(...SET.track().lcChapter()) + '</div>' +
      SET.track().lcHead().map(([k, text]) => '<div><span class=k>' + esc(k) + '</span>' + esc(text) + '</div>').join('') +
      SET.headHtml(esc) +
      (code ? '' : '<div class=next>Namen fehlen: Editor nicht gefunden</div>') +
      (lcView.other ? '<div><span class=k>MIDI</span>' + esc(lcView.other) + '</div>' : '') + '</div>' +
      '<div class=grid>' +
      cols.map(n => '<div class="col' + (isGlobal(page, n) ? ' g' : '') + '">' +
        esc((TAGS_OF[SET.focus()][prefix(page) + ':' + n] ?? (isGlobal(page, n) ? '8 Global' : String(n))).replace(/^\d+\s*/, n + ' ')) + '</div>').join('') +
      ROWS.map(row => cols.map(n => cell(page, n, row)).join('')).join('') + '</div>'
  }
  // Another track's status box may be the one on the page now: the link moves into it
  if (statusUi?.box && lcView.link) statusUi.box.append(lcView.link)
  if (lcView.win && !lcView.win.closed) lcView.win.document.head.innerHTML = '<style>' + lcView.css + '</style>'
}
SET.refresh()


// ============================================================
// MASTER AUDIO MATRIX
// ============================================================
stack(
  stack(
    stack(...setTaps).filterValues(() => false),
    ...trackTaps,
    ...stems
  ).filterValues(v => (v.gain ?? 1) * (v.postgain ?? 1) > 0),   // safety net: drop anything that is silent anyway
  tempoStem
)
