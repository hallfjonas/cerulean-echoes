// ============================================================
// GLOBAL CONTROLS
// ============================================================
// Launch Control XL 3, Custom Mode 16 (ch 16): columns 1-7 = stems, column 8 = global
// knob row 1 = hpf (CC 13-20), row 2 = lpf (21-28), row 3 = character (29-36: softness, density, acid, feedback; 36 = swing), fader = level (5-12)
// The fader is the column's volume; every layer of a stem goes through it and the global level.
const cc = await midin()

const ramp = (sig, from, to) => sig.fmap(v => Math.min(1, Math.max(0, (v - from) / (to - from))))
// Row-3 density as a crossfade: 0..0.5 brings the extra layer in, 0.5..1 fades the main layer out,
// so at 1 only the extra layer plays
const fadeMain  = knob => ramp(knob, 1, 0.5)
const fadeExtra = knob => ramp(knob, 0, 0.5)
// Exponential knob range for filters (Hz), so every part of the knob travel is audible
const expRange = (knob, lo, hi) => knob.fmap(v => lo * Math.pow(hi / lo, v))

// Global column: column 8 sends CC n in Mode 16 and CC n + 48 in Mode 2. Both control the same thing,
// whichever was moved last wins (the comparison against the previous values detects the move).
const lastMoved = (a, b) => {
  let prevA, prevB, out = 0
  return a.fmap(x => y => {
    if (x !== prevA) { prevA = x; out = x }
    if (y !== prevB) { prevB = y; out = y }
    return out
  }).appLeft(b)
}
const ccGlobal = n => lastMoved(cc(n), cc(n + 48))

// Knobs are endless encoders that remember a separate position per mode, so taking the last-moved
// value would jump to the other mode's position. Instead each knob adds its own movement (delta) to one
// shared value: turning either knob nudges the same thing from where it currently is.
// Mode 16 is the home mode: its knob's first value is taken as is; the Mode 2 knob's first value is only
// remembered as its starting point (cc() reads 0 until the knob has sent anything).
const coupled = (a, b) => {
  let prevA, prevB, bSeen, val
  return a.fmap(x => y => {
    if (val === undefined) { val = x; prevA = x; prevB = y; bSeen = y !== 0 }
    if (x !== prevA) { val += x - prevA; prevA = x }
    if (y !== prevB) {
      if (bSeen) val += y - prevB
      bSeen = true
      prevB = y
    }
    val = Math.min(1, Math.max(0, val))
    return val
  }).appLeft(b)
}
const ccGlobalKnob = n => coupled(cc(n), cc(n + 48))

const bpm = 140
setcpm(bpm / 4)

const globalHpf   = ccGlobalKnob(20).fmap(v => 1000 * v * v)   // 0..1000 Hz, added to the stems' hpf; quadratic for fine control at the bottom
// Swing: shifts every offbeat 8th later, from straight (0) to a heavy shuffle (1, a bit past triplet feel)
const globalSwing = ccGlobalKnob(36).range(0, 0.25)
const globalLpf   = expRange(ccGlobalKnob(28), 100, 12800)   // melodies only
const globalLevel = ccGlobal(12).range(0, 1)

// Mode 2 (melodies): columns 1-7 use the Mode 16 layout with every CC + 48, continuing right after Mode 16
// (faders 53-59, knobs 61-67 / 69-75 / 77-83, buttons 85-91 / 93-99).
// Column 8 stays the global column in Mode 2 too (fader CC 60 via ccGlobal, knobs CC 68, 76, 84 via ccGlobalKnob).
// cc2(n) reads the Mode 2 control that sits where CC n sits in Mode 16.
// Column N = melody N: knob row 1 = wobble, row 2 = baseline lpf, row 3 = density, fader = level,
// button row 1 = overtone mode (momentary, steps Dur → Moll → Oktaven).
const cc2 = n => cc(n + 48)

// Melody
scale("B:minor")

register('acidenv', (x, pat) => pat
  // .lpf(100)       // Basisfrequenz des Filters
  .lpenv(x * 9)   // Filterhüllkurve (Envelope) basierend auf Eingabe x
  .lps(0.2)       // Sustain (Haltezeit)
  .lpd(0.12)      // Decay (Abklingzeit)
  .lpq(2)         // Q-Faktor (Resonanz) für spitze Filterkurven
)


// ============================================================
// STEMS Theb Beginning; Part 1: MAIN KICK
// ============================================================
const kickHpf   = expRange(cc(13), 20, 2000)   // up to 2 kHz: fully open takes out the whole body, only the click remains
const kickLpf   = expRange(cc(21), 100, 12800)
// Softness: crossfade from the 909 (0) to a soft synthesized sine kick (1).
// Kept dry on purpose (ambient drums stay dry); light saturation instead keeps the soft kick audible.
const kickSoft  = cc(29)
const kickLevel = cc(5).range(0, 1)

const stem1_kick = stack(
  // hard: 909
  s("[bd bd bd bd]").bank("RolandTR909")
    .attack(0.00)
    .dec(0.3)
    .sustain(0.15)
    .release(0.12)
    .gain(kickSoft.mul(-1).add(1)),

  // soft: sine with a gentle pitch drop, a round thump without click
  // c2 = root of the sub/bass, an octave above the c1 sub sine, so it doesn't sink into the sub
  note("c2*4").s("sine")
    .penv(14)        // pitch starts 14 semitones higher...
    .pdecay(0.07)    // ...and falls within 70 ms
    .attack(0.004)
    .decay(0.3)
    .sustain(0)
    .release(0.1)
    .gain(kickSoft.mul(0.5)),

  // round: 808 kick with its click smoothed by a short attack, full and warm in the low mids
  s("[bd bd bd bd]").bank("RolandTR808")
    .attack(0.005)
    .decay(0.4)
    .sustain(0)
    .gain(kickSoft.mul(0.8))
)
  .hpf(globalHpf.add(kickHpf))
  // softness also opens the lpf (+1.5 kHz), so the soft kick is never muffled
  .lpf(kickLpf.add(kickSoft.mul(1500)))
  .shape(kickSoft.mul(0.25))
  .postgain(kickLevel.mul(globalLevel))


  // STEM 2: SUB-BASS
  const subHpf   = expRange(cc(14), 20, 300)
  const subLpf   = expRange(cc(22), 80, 2000)
  const subDensity  = cc(30)
  const subLevel = cc(6).range(0, 2.0)

  const stem2_sub = stack(
    note("c2*4")
    .s("sawtooth")
    .hpf(globalHpf.add(subHpf))
    .lpf(subLpf)
    .decay(0.112)
    .sustain(0.05)
    .gain(fadeMain(subDensity)),

    // extra layer: pulsing eighths
    note("c2*8")
    .s("sawtooth")
    .hpf(globalHpf.add(subHpf))
    .lpf(subLpf)
    .decay(0.112)
    .sustain(0.05)
    .gain(fadeExtra(subDensity).mul(1.3).mul(sine.range(0, 3).slow(0.125))),

    note("c1*4")
    .s("sine")
    .hpf(globalHpf.add(subHpf))
    .lpf(subLpf)
    .decay(0.15)
    .sustain(0.1)
    .gain(fadeMain(subDensity))
  )
  .postgain(subLevel.mul(globalLevel))
  .room(0.2)
  .roomsize(0.8) // Großer Raum lässt den Sub massiv wummern

  // STEM 3: BASS
  const bassHpf   = expRange(cc(15), 20, 600)
  const bassLpf   = expRange(cc(23), 150, 4000)
  // Acid: 0 = warm, clean saw; 1 = squelchy 303 line (resonance, filter envelope, accents, a bit of drive).
  // Together with the lpf knob (cutoff) this is the classic 303 cutoff + resonance/env-mod pair.
  const bassAcid  = cc(31)
  const bassLevel = cc(7).range(0, 2)
  const bassAccents = "1 1 1.6 1 1 1.6 1 1"   // every third eighth opens the filter further

  const stem3_bass = note("<[c2 ~ c2 c2] [eb2 c2 ~ eb2]>*2")
    .s("sawtooth")
    .hpf(globalHpf.add(bassHpf))
    .lpf(bassLpf)
    .lpq(bassAcid.range(2, 18))
    .lpenv(bassAcid.mul(6).mul(bassAccents))
    .lpd(bassAcid.range(0.2, 0.1))
    .lps(0)
    .shape(bassAcid.mul(0.3))
    .decay(0.15)
    .sustain(0)
    .room(0.2)
    // high resonance gets loud, so the level drops a little as acid goes up
    .gain(bassLevel.mul(globalLevel).mul(bassAcid.mul(-0.35).add(1)))

// STEM 4: HATS
const hatsHpf   = expRange(cc(16), 300, 8000)
const hatsLpf   = expRange(cc(24), 2000, 16000)
const hatsDensity  = cc(32).range(0, 1)
const hatsLevel = cc(8).range(0, 1)

const stem4_hats = stack(
  // open hats
  s("[~ oh ~ oh] * 2").bank("RolandTR909")
  .dec(1.0)
  .hpf(hatsHpf)
  .lpf(hatsLpf)
  .room(0.2)
  .gain(fadeMain(hatsDensity)),

  // extra layer: groovey hats
  s("hh * 16").bank("RolandTR909")
  .dec(1.0)
  .hpf(hatsHpf)
  .lpf(hatsLpf)
  .gain(fadeExtra(hatsDensity).mul(sine.range(0.25, 1))),
)
  .postgain(hatsLevel.mul(globalLevel))

// STEM 5: CLAP

const clapHpf     = expRange(cc(17), 150, 3000)
const clapLpf     = expRange(cc(25), 1500, 15000)
const clapDensity = cc(33)
const clapRoom    = cc(41).range(0, 0.5)
const clapLevel   = cc(9).range(0, 2.5)

// Main clap — classic 909 backbeat
const clapMain = s("~ cp ~ cp")
  .bank("RolandTR909")
  .hpf(clapHpf)
  .lpf(clapLpf)
  .attack(0.001)
  .dec(0.12)
  .sustain(0)
  .release(0.06)
  .room(clapRoom)
  .roomsize(0.55)
  .gain(fadeMain(clapDensity))

// Quiet offbeat ghosts — add movement without clutter
const clapGhosts = s("~ ~ cp ~")
  .bank("RolandTR909")
  .hpf(clapHpf)
  .lpf(clapLpf)
  .dec(0.08)
  .room(clapRoom.mul(0.6))
  .gain(fadeExtra(clapDensity).mul(0.44))

// Sparse double taps — controlled rhythmic variation
const clapFills = s("~ [~ cp] ~ ~")
  .bank("RolandTR909")
  .hpf(clapHpf)
  .lpf(clapLpf)
  .dec(0.06)
  .room(clapRoom)
  .gain(fadeExtra(clapDensity).mul(0.24))

// extra layer: ghosts and fills
const stem5_clap = stack(
  clapMain,
  clapGhosts,
  clapFills
)
  .postgain(clapLevel.mul(globalLevel))

// STEM 6: STAB CHORDS
const stabHpf   = slider(0.5, 0, 1, 0.01).range(0, 2000)
const stabDecay = slider(0.5, 0, 1, 0.01).range(0.1, 0.2)
const stabLpf   = 800
const stabRoom  = 0.25
const stabSlow  = 1
const stabLevel = slider(0, 0, 1, 0.01).range(0, 2)

const stem6_stab = chord("<Cm7 ~ Cm7 ~> <Fm7 ~ Cm7 ~> <Ab^7 ~ Fm7 ~> <Cm7 ~ Bb ~>")
  .voicing()
  .s("sawtooth")
  .hpf(sine.range(stabHpf.mul(0.1), stabHpf).slow(stabSlow))
  .lpf(stabLpf)
  .lpq(4)
  .decay(0.18)
  .sustain(0)
  .room(stabRoom)
  .roomsize(0.65)
  .delay(0.25).delaytime(0.375).delayfeedback(0.3)
  .gain(stabLevel.mul(globalLevel))


// STEM 7: ACID PULSE
const acidHpf   = slider(0.5, 0, 1, 0.01).range(50, 2000)
const acidLpf   = slider(0.5, 0, 1, 0.01).range(300, 12000)
const acidRoom  = slider(0.5, 0, 1, 0.01).range(0, 1)
const acidLevel = slider(0, 0, 1, 0.01).range(0, 1)

const stem7_acid = note("<[~ c4 ~ c4] [~ eb4 ~ d4] [~ c4 ~ bb3] [~ f4 ~ g4]>")
  .s("sawtooth")
  .hpf(acidHpf)
  .lpf(saw.range(100, acidLpf).slow(8))
  .lpq(7)
  .decay(0.12)
  .room(acidRoom)
  .delay(0.3).delaytime(0.25).delayfeedback(0.4)
  .gain(acidLevel.mul(globalLevel))


// PILLOW BONGOS
const bongoHpf     = expRange(cc(18), 60, 600)
const bongoLpf     = expRange(cc(26), 1000, 10000)
const bongoDensity = cc(34)
const bongoLevel   = cc(10).range(0, 0.8)

// Soft wooden low drum: rounded, warm, gentle
const bongoLow = note("c4 ~ ~ c4 ~ g4 ~ ~")
  .s("sine")
  .decay(0.085)
  .sustain(0)
  .release(0.035)
  .gain(fadeMain(bongoDensity).mul(0.65))

// Higher, hollow hand taps
const bongoHigh = note("~ g5 ~ c5 ~ ~ g5 ~")
  .s("sine")
  .decay(0.045)
  .sustain(0)
  .release(0.025)
  .gain(fadeMain(bongoDensity).mul(0.85))

// Soft fingertip ghost notes
const bongoGhosts = note("~ ~ eb5 ~ ~ g5 ~ c5")
  .s("sine")
  .decay(0.035)
  .sustain(0)
  .release(0.02)
  .gain(fadeExtra(bongoDensity))

// Tiny, playful bouncy rolls
const bongoRoll = note("~ c6 ~ g5 c6 ~ eb5 ~")
  .s("sine")
  .decay(0.025)
  .sustain(0)
  .release(0.015)
  .gain(fadeExtra(bongoDensity).mul(1.5))

// Extra delicate taps for maximum density
const bongoFingers = note("c5 ~ ~ eb5 ~ c5 g5 ~")
  .s("sine")
  .decay(0.025)
  .sustain(0)
  .release(0.015)
  .gain(fadeExtra(bongoDensity).mul(1.36))

// extra layer: ghosts, rolls and fingers
const stem6_bongos = stack(
  bongoLow,
  bongoHigh,
  bongoGhosts,
  bongoRoll,
  bongoFingers
)
  .hpf(globalHpf.add(bongoHpf))
  .lpf(bongoLpf)
  .room(0.18)
  .roomsize(0.45)
  .postgain(bongoLevel.mul(globalLevel))


// LIQUID ACID SPACE
const spaceHpf      = expRange(cc(19), 80, 1200)
const spaceLpf      = expRange(cc(27), 800, 12000)   // top of the slow filter sweep
const spaceFeedback = cc(35).range(0.23115, 1.1426)
const spaceLevel    = cc(11).range(0, 0.7)
const stem7_space = stack(
  note("<c4 ~ eb4 g4 ~ bb4 ~ g4 ~ eb4>")
    .s("sawtooth")
    .hpf(globalHpf.add(spaceHpf))
    .lpf(sine.range(300, spaceLpf).slow(8))
    .lpq(12)
    .decay(0.3)
    .sustain(0.12)
    .release(0.4)
    .delay(0.7)
    .delaytime(0.375)
    .delayfeedback(spaceFeedback)
    .gain(0.55),

  // Sparse, high liquid droplets
  note("~ c6 ~ ~ ~ g5 ~ ~ eb6 ~ ~ ~")
    .s("sine")
    .hpf(globalHpf.add(spaceHpf))
    .lpf(spaceLpf)
    .decay(0.12)
    .sustain(0)
    .delay(0.8)
    .delaytime(0.5)
    .delayfeedback(spaceFeedback)
    .gain(0.2)

)
  .room(0.4)
  .roomsize(0.9)
  .gain(spaceLevel.mul(globalLevel))

// ============================================================
// MELODIES
// Every melody uses the same controls, numbered from melody 1:
// wobble knob (named ...Hpf), baseline lpf knob, density knob, level fader; see Mode 2 above
// ============================================================
const melodyMainLpf = 100
const baselineLpfMax = 800

// Character knob of a melody (0..1, named ...Hpf); it also drives that melody's bassline.
// 0      dry
// ~0.5   organic: audible slow detune drift and vibrato shared by all layers
// 1      acid: the wobble stays, on top a resonant 303 filter envelope with accents and a bit of drive
const wobble = (pat, knob) => {
  const organic = ramp(knob, 0, 0.5)
  const extra   = ramp(knob, 0.5, 1)
  const drift   = perlin.slow(2).range(-1, 1)    // same signals in every layer, so layers stay in tune with each other
  const vibrato = sine.slow(4).range(-1, 1)
  const jump    = rand.lt(extra.mul(0.15)).fmap(b => b ? 12 : 0)
  const drop    = rand.gt(extra.mul(0.25)).fmap(b => b ? 1 : 0)
  const level   = rand.mul(organic.mul(-0.3)).add(1)
  // Envelope: per-note random attack, decay and sustain, each widening from organic to extravagant
  const atkAmt  = organic.mul(0.06).add(extra.mul(0.25))
  const decAmt  = organic.mul(0.2).add(extra.mul(0.5))
  const susAmt  = organic.mul(0.2).add(extra.mul(0.5))
  // Pitch in cents via detune (control arithmetic on note values is not allowed, so no .add here)
  const cents   = drift.mul(organic.mul(55)).add(vibrato.mul(organic.mul(20)))  // up to ~55 cents drift + ~20 cents vibrato
    .add(rand.range(-1, 1).mul(organic.mul(15)))                                  // per-note scatter: ±15 cents
  // Acid (second half of the knob); these override the fixed acidenv(0.3) of the layers
  const accents = "1 1 1.6 1 1 1.6 1 1"           // every third eighth opens the filter further
  return pat
    .detune(cents)
    .vib(organic.range(2, 4))                    // gentle vibrato: speeds up slightly with the knob
    .vibmod(organic.mul(0.12))                   // depth in semitones, up to ~1/8 semitone
    .lpenv(extra.mul(6).add(2.7).mul(accents))   // 2.7 = acidenv(0.3), up to 8.7
    .lpq(extra.range(2, 16))
    .lpd(extra.range(0.12, 0.08))
    .lps(extra.range(0.2, 0))
    .shape(extra.mul(0.3))
    .postgain(extra.mul(-0.35).add(1))           // high resonance gets loud
    // TODO: This feature doesnt work so well
    // .trans(jump)                                 // occasional octave jumps
    // .velocity(drop.mul(level))                   // dropouts and level variation
    // .attack(rand.mul(atkAmt))                    // up to 60 ms organic, up to 0.25 s extravagant
    // .decay(rand.mul(decAmt).add(0.05))
    // .sustain(rand.mul(susAmt).mul(-1).add(1))    // sustain drops from 1 by up to susAmt
    // .release(rand.mul(extra.mul(0.3)).add(0.05))
}

// Momentary button that steps through n states, one step per press (counts presses, not the held value).
// Re-evaluating the code starts again at 0.
const cycleButton = (button, n) => {
  let prev = 0, state = 0
  return button.fmap(v => {
    if (v > 0.5 && prev <= 0.5) state = (state + 1) % n
    prev = v
    return state
  })
}

// Overtone modes, stepped by the melody's button
const DUR = 0, MOLL = 1, OKTAVEN = 2

// Voices above each melody note, in three entry groups set by the melody's density.
// Each voice gets amplitude 1/n (n = its partial number, or its rank in the chord).
// Dur:     the harmonic series (octave, fifth, major third), fits the baselines
// Moll:    a parallel minor 9 chord on every note, the classic techno chord-memory stab: m → m7 → m9
// Oktaven: octaves only, no third
const melody = (notes, density, level, knob, button) => {
  const dens = density
  const mode = cycleButton(button, 3)
  const overtone = (semis, n, from, to, modes) => wobble(note(notes)
    .sound("sawtooth")
    .trans(semis)
    .lpf(globalLpf.add(melodyMainLpf))
    .gain(ramp(dens, from, to).mul(1 / n)
      .mul(mode.fmap(m => modes.includes(m) ? 1 : 0))
      .mul(globalLevel).mul(level))   // overtones follow the level fader too
    .acidenv(0.3), knob)

  return stack(
    wobble(note(notes).sound("sawtooth").lpf(globalLpf.add(melodyMainLpf)).acidenv(0.3).gain(globalLevel.mul(level)), knob),
    // Group 1
    overtone(12, 2, 0.0, 0.3, [DUR, MOLL, OKTAVEN]),   // octave
    overtone(19, 3, 0.0, 0.3, [DUR]),                  // octave + fifth (3rd partial)
    overtone(15, 3, 0.0, 0.3, [MOLL]),                 // octave + minor third
    // Group 2
    overtone(24, 4, 0.3, 0.6, [DUR, OKTAVEN]),         // two octaves (4th partial)
    overtone(28, 5, 0.3, 0.6, [DUR]),                  // two octaves + major third (5th partial)
    overtone(19, 4, 0.3, 0.6, [MOLL]),                 // octave + fifth
    overtone(22, 5, 0.3, 0.6, [MOLL]),                 // octave + minor seventh
    // Group 3
    overtone(31, 6, 0.6, 0.9, [DUR]),                  // two octaves + fifth (6th partial)
    overtone(26, 6, 0.6, 0.9, [MOLL]),                 // ninth
    overtone(36, 6, 0.6, 0.9, [OKTAVEN])               // three octaves
  )
}

// Baseline: fades in with its lpf knob, from 0 up to baselineLpfMax
const baseline = (notes, lpf, knob) => wobble(note(notes)
  .sound("sawtooth")
  .lpf(lpf)
  .acidenv(0.3)
  .gain(globalLevel.mul(0.5)), knob)

// MELODY 1
const melody1Hpf    = cc2(13)
const melody1Density = cc2(29)
const melody1Level    = cc2(5)
const melody1Mode    = cc2(37)   // button row 1: steps Dur → Moll → Oktaven
const stem_melody1 = melody("[e2 e3 f2 f3 g2 g3 a2 a3]", melody1Density, melody1Level, melody1Hpf, melody1Mode)
const baseline1Lpf = cc2(21).range(0, baselineLpfMax)
// Octave-jumping eighths on E / F / G / A, following the melody's cycle
const stem_baseline1 = baseline("<[e1 e2 e1 e2 f1 f2 e1 g2] [a1 a2 a1 a2 g1 g2 a1 e2]>", baseline1Lpf, melody1Hpf)

// MELODY 2
const melody2Hpf     = cc2(14)
const melody2Density = cc2(30)
const melody2Level   = cc2(6)
const melody2Mode    = cc2(38)   // button row 1: steps Dur → Moll → Oktaven
const stem_melody2 = melody("[d3 e3 c3 f3 b2 g3 a2 a3]", melody2Density, melody2Level, melody2Hpf, melody2Mode)
const baseline2Lpf = cc2(22).range(0, baselineLpfMax)
// Root D with octave pops and passing tones from the melody (C, F, G, A)
const stem_baseline2 = baseline("<[d1 d2 d1 d2 c2 d2 a1 d2] [d1 d2 f1 d2 g1 d2 a1 d2]>", baseline2Lpf, melody2Hpf).decay(sine.range(0.4,0.6))

// MELODY 3
const melody3Hpf     = cc2(15)
const melody3Density = cc2(31)
const melody3Level   = cc2(7)
const melody3Mode    = cc2(39)   // button row 1: steps Dur → Moll → Oktaven
const stem_melody3 = melody("[a2 e3 c3 f3 b2 d3 g2 e3 a2 c3 f2 d3 g2 b2 e2 c3]*.5", melody3Density, melody3Level, melody3Hpf, melody3Mode)
// Energetic: driving octave-jumping eighths
const baseline3Lpf = cc2(23).range(0, baselineLpfMax)
const stem_baseline3 = baseline("<[a1 a1 a2 a1] [g1 g1 g2 g1]>*2", baseline3Lpf, melody3Hpf)

// MELODY 4
const melody4Hpf     = cc2(16)
const melody4Density = cc2(32)
const melody4Level   = cc2(8)
const melody4Mode    = cc2(40)   // button row 1: steps Dur → Moll → Oktaven
const stem_melody4 = melody("[c#3 f#3 a3 g3 c#3 f#3 a3 g3 c#3 f#3 g3 e3 c#3 f#3 g3 e3]*.5", melody4Density, melody4Level, melody4Hpf, melody4Mode)
// Chord tones of the melody (F#, C#, A, G, E), 8 steps to match the melody's cycle
const baseline4Lpf = cc2(24).range(0, baselineLpfMax)
const stem_baseline4 = baseline("<[f#1 f#2 ~ c#2 a1 ~ f#2 c#2] [f#1 f#2 ~ g1 e1 ~ c#2 f#2]>", baseline4Lpf, melody4Hpf)

// MELODY 5
const melody5Hpf     = cc2(17)
const melody5Density = cc2(33)
const melody5Level   = cc2(9)
const melody5Mode    = cc2(41)   // button row 1: steps Dur → Moll → Oktaven
const stem_melody5 = melody("[db3 f3 b3 e3]!2", melody5Density, melody5Level, melody5Hpf, melody5Mode)
const baseline5Lpf = cc2(25).range(0, baselineLpfMax)
// Melody's B / E / F / Db, with a turnaround on the second half of the cycle
const stem_baseline5 = baseline("<[b1 b2 e1 b2 b1 b2 f1 db2] [b1 b2 e1 b2 db2 b2 f1 b2]>", baseline5Lpf, melody5Hpf)

// MELODY 6
const melody6Hpf     = cc2(18)
const melody6Density = cc2(34)
const melody6Level   = cc2(10)
const melody6Mode    = cc2(42)   // button row 1: steps Dur → Moll → Oktaven
const stem_melody6 = melody("[c#3 f3 <a3 g3> e3]!2", melody6Density, melody6Level, melody6Hpf, melody6Mode)
// Energetic: pulsing octave c# / f eighths (f natural, as in the melody), with a g passing tone
const baseline6Lpf = cc2(26).range(0, baselineLpfMax)
const stem_baseline6 = baseline("<[c#1 c#2 c#1 c#2] [f1 f2 g1 f2]>*2", baseline6Lpf, melody6Hpf)

// MELODY 7
const melody7Hpf     = cc2(19)
const melody7Density = cc2(35)
const melody7Level   = cc2(11)
const melody7Mode    = cc2(43)   // button row 1: steps Dur → Moll → Oktaven
const stem_melody7 = melody("[db3 eb3 b3 f3]!", melody7Density, melody7Level, melody7Hpf, melody7Mode)
const baseline7Lpf = cc2(27).range(0, baselineLpfMax)
// Melody's Db / Eb / B / F (the old gb was not in the melody)
const stem_baseline7 = baseline("<[b1 ~ db2 b2 eb2 ~ f1 b2] [f1 ~ eb2 b1 db2 ~ b1 ~]>", baseline7Lpf, melody7Hpf)


// ============================================================
// MASTER AUDIO MATRIX
// ============================================================
stack(
  stem1_kick,
  stem2_sub,
  stem3_bass,
  stem4_hats,
  stem5_clap,
  stem6_bongos,
  stem7_space,
  stem_melody1,
  stem_melody2,
  stem_melody3,
  stem_melody4,
  stem_melody5,
  stem_melody6,
  stem_melody7,
  stem_baseline1,
  stem_baseline2,
  stem_baseline5,
  stem_baseline3,
  stem_baseline4,
  stem_baseline6,
  stem_baseline7
)
  .swingBy(globalSwing, 4)   // 4 slices per cycle = quarters, so the offbeat 8th of each gets pushed back
