// ============================================================
// TRACK 009 — happy house in A major, 124 BPM, in the two-controller layout (midi-layouts/templates/dual-lc.strudel)
// Jojo (foundation): kick, noise pump, sub, bassline, clap + snare, hats, congas / bongos, shaker / tambourine.
// Jonas (colour): strings, piano chords, arp, vocal hook, answer, bells, vocal chops + the global column 8.
// Chapter (global button 1): the chord progression for everybody, at the next phrase (4 bars):
//   Sonne I–V–vi–IV → Sehnsucht vi–IV–I–V → Disco IV–V–iii–vi → Gospel I–IV–ii–V. Everything follows its root.
// Drop: when the break ends, a crash marks the one.
// ============================================================
// Two Launch Control XL 3, both in Custom Mode 16 (same CCs), told apart by their MIDI input.
// Every column: knob row 1 = brightness, row 2 = space, row 3 = character, fader = level,
// button row 1 = change (next pattern, at the next bar), button row 2 = a moment (while held).
// One controller only (Jojo's missing, or the -single version): Mode 1 = Jojo (same CCs as Mode 16), Mode 2 = Jonas
// (CC + 48). Jojo's column 8 (shaker) stays off; column 8 is the global column on both pages.
// @layout Track 009 — happy house (two controllers)
// @note Happy house in A major, 124 BPM. Jojo plays the foundation (kick, bass, drums, congas), Jonas the colour (strings, piano, hook, chops) and the global column 8.
// @note Every row means the same everywhere: row 1 = brightness, row 2 = space, row 3 = character, fader = level, button 1 = next pattern (at the next bar), button 2 = a moment while held.
// @note Start with all faders down. Nothing sounds until Jonas' master fader (column 8) is up. Chapter (Jonas, column 8) changes the chords for everybody at the next 4-bar phrase.
// @note The status box at the bottom right of the Strudel page shows chapter, break and each stem's pattern. Its button “als Fenster” opens it as a small window that stays on top (Chrome/Edge).
// @mode B16 Jojo — Foundation (beat + bass)
// @col B16:1 1 Kick
// @col B16:2 2 Noise Pump
// @col B16:3 3 Sub
// @col B16:4 4 Bassline
// @col B16:5 5 Clap + Snare
// @col B16:6 6 Hats
// @col B16:7 7 Congas
// @col B16:8 8 Shaker / Tamb.
// @row B16:k1 Row 1 \ Brightness
// @row B16:k2 Row 2 \ Space
// @row B16:k3 Row 3 \ Character
// @row B16:fader Fader \ Level
// @row B16:b1 Button 1 \ Change
// @row B16:b2 Button 2 \ Moment
// @mode 16 Jonas — Colour (chords + melodies) · column 8 = global
// @col 16:1 1 Strings
// @col 16:2 2 Piano
// @col 16:3 3 Arp
// @col 16:4 4 Vocal Hook
// @col 16:5 5 Answer
// @col 16:6 6 Bells
// @col 16:7 7 Vocal Chops
// @col 16:8 8 Global
// @row 16:k1 Row 1 \ Brightness
// @row 16:k2 Row 2 \ Space
// @row 16:k3 Row 3 \ Character
// @row 16:fader Fader \ Level
// @row 16:b1 Button 1 \ Change
// @row 16:b2 Button 2 \ Moment
// @guide Playing together | Jojo builds the floor: kick first, then sub and the off-beat hats, then clap, bassline and the groove (congas, shaker). The noise pump glues to the kick.
// @guide Playing together | Jonas colours it: strings or piano first (all knobs at 0 is a good start), then arp and bells. Vocal hook and chops are for the peaks.
// @guide Playing together | Chapter changes the chords for both players at the next 4-bar phrase: sub, bassline and every melody follow. Strings button 2 (freeze) holds the chord for everybody.
// @guide Playing together | Build-up and drop: Jonas turns Tension up (echo, open filters, snare roll), presses Break at the top: the beat goes out, strings and piano float. Jojo holds the noise riser, Jonas presses Break again: everything is back on the one, with a crash. Then let Tension go.
// @guide Every position sounds good | No filter closes completely. Arp, hook and chops keep a little room even at space 0.
const JOJO  = 'LCXL3 Jojo MIDI Out'
const JONAS = 'LCXL3 Jonas MIDI Out'
// Jonas' controller by its macOS name; if that name is missing (other computer, other USB port), the first MIDI input
let ccJonas
try { ccJonas = await midin(JONAS) } catch (e) { console.warn('Jonas not found: using the first MIDI input'); ccJonas = await midin() }
// Single version (written by tools/lcxl-layout/make-single.mjs with SINGLE = true): don't look for Jojo's controller
const SINGLE = false
let ccJojo = null
if (!SINGLE) {
  try { ccJojo = await midin(JOJO) } catch (e) { console.warn('Jojo not found: one controller, Mode 1 = Jojo, Mode 2 = Jonas (CC + 48)') }
}

const ramp = (sig, from, to) => sig.fmap(v => Math.min(1, Math.max(0, (v - from) / (to - from))))
// Row-3 crossfade: 0..0.5 brings the extra layer in, 0.5..1 fades the main layer out
const fadeMain  = knob => ramp(knob, 1, 0.5)
const fadeExtra = knob => ramp(knob, 0, 0.5)
// Exponential knob range for filters (Hz), so every part of the knob travel is audible
const expRange = (knob, lo, hi) => knob.fmap(v => lo * Math.pow(hi / lo, v))

const bpm  = 124
const beat = 60 / bpm   // seconds per quarter note, for delay times
setcpm(bpm / 4)

// Mapping of column n (1-8): brightness, space, character (knob rows 1-3), fader, button rows 1-2
const colMap = (read, n) => ({ bright: read(12 + n), space: read(20 + n), char: read(28 + n), level: read(4 + n), btn: read(36 + n), btn2: read(44 + n) })
const off = () => signal(() => 0)
// Column 8 (global) is read from both its Mode 16 and Mode 2 CCs, last moved wins: it works on both pages even on a
// controller whose column 8 sends CC + 48 in Mode 2
// One controller: Jojo on the plain CCs (Mode 1), Jonas on CC + 48 (Mode 2)
const alone    = !ccJojo
const colJonas = n => colMap(n === 8 ? c => lastMoved(ccJonas(c), ccJonas(c + 48)) : alone ? c => ccJonas(c + 48) : ccJonas, n)
const colJojo  = n => !alone ? colMap(ccJojo, n) : n === 8 ? colMap(off, n) : colMap(ccJonas, n)

const gate  = (cond, pat) => cond.fmap(on => on ? pat : silence).innerJoin()
const above = (sig, x) => sig.fmap(v => v > x)
const and   = (a, b) => a.fmap(x => y => x && y).appLeft(b)
const held  = button => button.fmap(v => v > 0.5)

// Stateful controls, collected so the master can query them every tick (see stateTaps)
const taps = []

// Two inputs for one control: the value follows whichever moved last (stateful, so it is queried via stateTaps)
const lastMoved = (a, b) => {
  let pa = null, pb = null, v = 0
  const pat = a.fmap(x => y => {
    if (pa === null) v = Math.max(x, y)
    else if (y !== pb) v = y
    else if (x !== pa) v = x
    pa = x; pb = y
    return v
  }).appLeft(b)
  taps.push(pat)
  return pat
}

// Momentary button that steps through n states, one step per press (counts presses, not the held value).
// onChange(state) runs on every step (for the status box). Re-evaluating the code starts again at 0.
const cycleButton = (button, n, onChange = () => {}) => {
  let prev = 0, state = 0
  const pat = button.fmap(v => {
    if (v > 0.5 && prev <= 0.5) { state = (state + 1) % n; onChange(state) }
    prev = v
    return state
  })
  taps.push(pat)
  return pat
}

// A value that a button sets now but that takes over only at the next bar line, or with len = 4 at the next
// 4-bar phrase (chapter). at(t) is asked with bar starts in real time (outside any reseed shift); it remembers the
// previous value for queries that still reach back into the old bar. pat = the value per bar, since = the first
// bar of the current value (for the crash on the drop).
const barLatch = (len = 1) => {
  const l = { pending: 0, now: 0, prev: 0, bar: -Infinity, since: null }
  l.at = t => {
    const bar = Math.floor(Number(t) / len)
    if (bar > l.bar) {
      if (l.pending !== l.now) { l.prev = l.now; l.now = l.pending; l.since = bar * len; showStatus() }
      else l.prev = l.now
      l.bar = bar
    }
    return bar >= l.bar ? l.now : l.prev
  }
  l.pat = signal(t => l.at(t)).segment(1)
  taps.push(l.pat)
  return l
}

// 0 → 1 over `cycles` while a button is held, back to 0 on release (for risers)
const heldRamp = (button, cycles) => {
  let start = null
  const pat = button.fmap(v => t => {
    if (v <= 0.5) { start = null; return 0 }
    start ??= t
    return Math.min(1, Math.max(0, (t - start) / cycles))
  }).appLeft(signal(t => Number(t)))
  taps.push(pat)
  return pat
}

// Freeze: while the button is held, keep returning the value that was playing when it was pressed
const freeze = (button, pat) => {
  let kept = null
  return pat.fmap(v => b => b > 0.5 ? (kept ??= v) : (kept = null, v)).appLeft(button)
}

// ============================================================
// CHAPTERS — chord progressions in A major, one chord per bar, 4 bars = one phrase
// ============================================================
// Roots as scale degrees (0 = A). Stacked thirds on them: A, Bm, C♯m, D, E, F♯m (sevenths: Amaj7, Bm7, … E7).
const CHAPTERS = [
  { name: 'Sonne',     roots: [0, 4, 5, 3], chords: 'A – E – F♯m – D' },     // I–V–vi–IV
  { name: 'Sehnsucht', roots: [5, 3, 0, 4], chords: 'F♯m – D – A – E' },     // vi–IV–I–V
  { name: 'Disco',     roots: [3, 4, 2, 5], chords: 'D – E – C♯m – F♯m' },   // IV–V–iii–vi
  { name: 'Gospel',    roots: [0, 3, 1, 4], chords: 'A – D – Bm – E' },      // I–IV–ii–V
]
const scaleIn = octave => 'A' + octave + ':major'

// Status box at the bottom right: chapter, break, and which pattern each stem plays.
// Its button moves the text into a small always-on-top window (Document Picture-in-Picture, Chrome/Edge), so it
// stays visible over the layout PDF; closing that window puts it back. Kept on globalThis, so re-evaluating
// reuses the open window. Only in the browser; the Node tools have no page to draw on.
const hasPage = typeof document !== 'undefined' && !!document.createElement
const statusUi = !hasPage ? null : globalThis.houseStatus ??= (() => {
  const box = document.createElement('div')
  box.style.cssText = 'position:fixed;right:12px;bottom:12px;z-index:1000;padding:8px 12px;' +
    'background:rgba(0,0,0,.75);border-radius:6px'
  const text = document.createElement('pre')
  text.style.cssText = 'margin:0;color:#eee;font:13px/1.5 monospace'
  const pop = document.createElement('button')
  pop.textContent = '⧉ als Fenster'
  pop.style.cssText = 'margin-top:6px;font:12px sans-serif;cursor:pointer'
  pop.onclick = async () => {
    if (!window.documentPictureInPicture) { pop.textContent = 'geht nur in Chrome/Edge'; return }
    const pip = await documentPictureInPicture.requestWindow({ width: 380, height: 490 })
    pip.document.body.style.cssText = 'margin:0;padding:8px 12px;background:#111'
    pip.document.body.append(text)
    box.style.display = 'none'
    pip.addEventListener('pagehide', () => { box.prepend(text); box.style.display = '' })
  }
  box.append(text, pop)
  document.body.appendChild(box)
  return { text }
})()

// Rows of the status box, filled by change(): { label, latch, n, names } per player
const STATUS = { jojo: [], jonas: [] }
const showStatus = () => {
  if (!statusUi) return
  const dots = v => [...Array(8).keys()].map(k => k === v ? '●' : '○').join('')
  const show = (r, v) => !r.names ? String(v + 1) : r.names[v]
  const line = (r, i) => (i + 1) + ' ' + r.label.padEnd(10) + ' ' + (r.n === 8 ? dots(r.latch.now) + ' ' : '') +
    show(r, r.latch.now) + (r.latch.pending !== r.latch.now ? ' → ' + show(r, r.latch.pending) : '')
  const ch = chapterLatch
  statusUi.text.textContent = [
    'Kapitel     ' + CHAPTERS[ch.now].name +
      (ch.pending !== ch.now ? ' → ' + CHAPTERS[ch.pending].name + ' (nächste Phrase)' : ''),
    'Akkorde     ' + CHAPTERS[ch.now].chords,
    'Break       ' + (breakLatch.now ? 'Beat aus' : 'Beat an') +
      (breakLatch.pending !== breakLatch.now ? ' → ' + (breakLatch.pending ? 'aus' : 'an') + ' (nächster Takt)' : ''),
    '', alone ? 'Mode 1 · Jojo' : 'Jojo', ...STATUS.jojo.map(line),
    '', alone ? 'Mode 2 · Jonas' : 'Jonas', ...STATUS.jonas.map(line),
  ].join('\n')
}
// Button 1 of a stem: n patterns (default 8), one step per press, taking over at the next bar
const change = (button, who, label, n = 8, names) => {
  const latch = barLatch()
  cycleButton(button, n, s => { latch.pending = s; showStatus() })
  STATUS[who].push({ label, latch, n, names })
  return latch
}
// Pattern number i of a list, switched by a change latch
const pick = (latch, pats) => latch.pat.fmap(i => pats[i]).innerJoin()

// ============================================================
// GLOBAL (Jonas, column 8) — acts on both controllers
// ============================================================
// @ctl g.k1 Fog | 0 = clear, up = every filter pulled down to ~6 %: muffled, as if from outside the club.
// @ctl g.k2 Room | 0 = each sound's own room (row 2), up = everything drowns in reverb.
// @ctl g.k3 Tension | build-up: echo grows, filters open, from the middle a snare roll (clap fader). 0 = release.
// @ctl g.fader Master Level | volume of everything, both controllers. 0 = silence.
// @ctl g.b1 Chapter | next chord progression for all, at the next 4-bar phrase.
// @ctl g.b2 Break / Drop | 1st: beat out. 2nd: all back on the one, with a crash.
const glob        = colJonas(8)
const globalFog   = glob.bright.fmap(f => Math.pow(0.06, f))
const globalRoom  = glob.space
const tension     = glob.char
const tensionEcho = ramp(tension, 0, 0.5).mul(0.45)     // delay send, 0..0.45
const tensionRoll = ramp(tension, 0.5, 1)               // snare roll, 0..1
// Factor on every lpf: fog darkens (down to 0.06), tension opens (up to 2.5)
const globalTone  = globalFog.fmap(f => o => f * o).appLeft(tension.fmap(t => 1 + 1.5 * t))
const globalLevel = glob.level.range(0, 1)

const chapterLatch = barLatch(4)
cycleButton(glob.btn, CHAPTERS.length, s => { chapterLatch.pending = s; showStatus() })
const breakLatch = barLatch()
cycleButton(glob.btn2, 2, s => { breakLatch.pending = s; showStatus() })
// Jojo's low end and backbeat, gated while the break is on
const beatOn   = breakLatch.pat.fmap(b => b === 0)
const beatOnly = pat => gate(beatOn, pat)

const audible = level => and(above(level, 0), above(globalLevel, 0))
// lpf × fog/tension, kept between 80 Hz and 18 kHz (fog never makes a stem silent)
const toned  = lpf => lpf.fmap(f => g => Math.min(18000, Math.max(80, f * g))).appLeft(globalTone)
// Reverb send: the stem's space knob (0..0.9), raised by the global Room up to 0.95
const roomOf = space => space.fmap(s => g => { const r = 0.9 * s; return r + (0.95 - r) * g }).appLeft(globalRoom)
// Change: read the stem's randomness 1024 cycles further per step (keeps bar alignment, new random values).
// The chord root is applied after reseed, so it follows real time.
const reseed = (latch, pat) => pat.early(latch.pat.fmap(v => v * 1024))

// Effect buses. Each orbit has one reverb and one delay, and every reverb costs a lot of CPU, so the stems share
// two orbits; stems on one orbit share room size and echo time/feedback.
// Orbit 1 = drums and bass: small room, short dotted-8th slap.
// Orbit 2 = all of Jonas' colour (and the noise riser): a warm hall, dotted-8th echo (the classic house piano echo).
const BUSES = {
  1: { hall: 1.4, time: beat * 0.75, feedback: 0.3 },
  2: { hall: 3.5, time: beat * 0.75, feedback: 0.5 },
}
// bus(): reverb from the space knob, and echo: the layer's own delay amount (or `echo` if it has none) × 2 × space,
// so space 0.5 = the designed amount; Tension's echo takes over where it is larger.
const bus = (pat, orbit, space, echo = 0) => pat
  .fmap(v => sc => e => ({ ...v, delay: Math.max(Math.min(0.9, (v.delay ?? echo) * sc), e) }))
  .appLeft(space.fmap(s => 2 * s)).appLeft(tensionEcho)
  .room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit)
  .delaytime(BUSES[orbit].time).delayfeedback(BUSES[orbit].feedback)
// Reverb only, no echo (kick, sub and bass would smear)
const dryBus = (pat, orbit, space) => pat.room(roomOf(space)).roomsize(BUSES[orbit].hall).orbit(orbit)

// Channel strip: lpf × fog/tension (if given), level × master as postgain, gated while the fader or master is 0
const strip = (stem, { lpf, level }) => {
  const pat = lpf === undefined ? stem : stem.lpf(toned(lpf))
  return gate(audible(level), pat.postgain(level.mul(globalLevel)))
}
const drum = (names, bank = 'RolandTR909') => s(names).bank(bank)

// ============================================================
// HARMONY — Chapter picks the progression, everybody follows its root; strings button 2 freezes it for all
// ============================================================
const PROG_PATS = CHAPTERS.map(c => cat(...c.roots))   // one chord per bar, the phrase starts with chord 1
const pad       = colJonas(1)
const harmRoot  = freeze(pad.btn2, pick(chapterLatch, PROG_PATS))
// Chord = shape (scale degrees above the root) on the current root; built once per root and shape
const CHORD_CACHE = {}
const chordOn = shape => harmRoot.fmap(r => CHORD_CACHE[shape + '@' + r] ??= n(stack(...shape.map(d => d + r)))).innerJoin()
const onRoot  = pat => pat.add(n(harmRoot))

// ============================================================
// JOJO 1 KICK — four on the floor: a sine body tuned to E2 (the fifth of A, audible on small speakers) + the 909 kick
// ============================================================
// Softness up = the pitch drop gets smaller and slower, the attack fades in, the 909 fades out: a deep, soft thump.
// @ctl B16:1.k1 Brightness | 0 = round but clear ↔ clicky attack (lpf 900–9000 Hz).
// @ctl B16:1.k2 Space | dry and close ↔ in a room (reverb).
// @ctl B16:1.k3 Softness | 0 = round 909 kick ↔ 1 = very soft, deep thump without click.
// @ctl B16:1.fader Level | 0 = gone. Four-on-the-floor kick, tuned to E (fifth of A).
// @ctl B16:1.b1 Change | straight → pickup before the 1 → gap every 4th bar.
// @ctl B16:1.b2 Drop out | kick pauses while held.
const kick     = colJojo(1)
const kickVar  = change(kick.btn, 'jojo', 'Kick', 3, ['gerade', 'Auftakt', 'Lücke'])
const kickSoft = kick.char
const KICKS = ["1*4", "1 1 1 [1 ~ ~ 0.4]", "<[1*4] [1*4] [1*4] [1 1 1 ~]>"]
  .map(g => stack(
    gain(g).note("e2").s("sine").decay(kickSoft.fmap(s => 0.35 + 0.15 * s)).sustain(0).release(0.05)
      .attack(kickSoft.fmap(s => 0.003 + 0.012 * s))
      .penv(kickSoft.fmap(s => 24 - 12 * s)).pdecay(kickSoft.fmap(s => 0.04 + 0.04 * s)),
    gain(g).mul(gain(kickSoft.fmap(s => 0.5 * (1 - s)))).s("bd").bank("RolandTR909")
  ))

const stemJ1_kick = beatOnly(gate(kick.btn2.fmap(v => v <= 0.5), strip(dryBus(
  pick(kickVar, KICKS).mul(gain(0.8)), 1, kick.space), {
  lpf: expRange(kick.bright, 900, 9000),
  level: kick.level.range(0, 1),
})))

// ============================================================
// JOJO 2 NOISE PUMP — noise glued to the kick: it swells in after every kick and stops before the next one
// (sounds like a sidechained noise layer), or a swoosh up into every second bar
// ============================================================
// @ctl B16:2.k1 Brightness | dull whoosh ↔ airy hiss (lpf 2–14 kHz).
// @ctl B16:2.k2 Space | dry ↔ far away (reverb + echo).
// @ctl B16:2.k3 Motion | still ↔ the filter breathes and the noise wanders left and right.
// @ctl B16:2.fader Level | noise that pumps with the kick.
// @ctl B16:2.b1 Change | pump → off-beat → swoosh (2 bars).
// @ctl B16:2.b2 Riser | a noise sweep rises over 2 bars while held.
const noiseCol  = colJojo(2)
const noiseVar  = change(noiseCol.btn, 'jojo', 'Rauschen', 3, ['Pumpe', 'Offbeat', 'Swoosh'])
const noiseMove = noiseCol.char
const noiseRise = heldRamp(noiseCol.btn2, 2)
const upHalf = v => Math.max(0, 2 * v - 1)   // 0 in the first half of the bar, then 0 → 1
const NOISES = [
  s("[~ pink@3]*4").attack(0.12).sustain(0.7).release(0.03).hpf(1200).gain(2.4),
  s("[~ pink]*4").attack(0.06).sustain(0.5).release(0.05).hpf(2500).gain(2.4),
  // Swoosh: 16th grains over the second half of every second bar, the bandpass rising from 500 Hz to 8 kHz
  s("pink*16").mask("<0 [0 1]>").attack(0.02).sustain(0.8).release(0.1)
    .bpf(saw.fmap(v => 500 * Math.pow(16, upHalf(v)))).bpq(2).gain(saw.fmap(v => 0.3 + 1.8 * upHalf(v))),
]
// Riser: 16th noise bursts through a bandpass that climbs from 300 Hz to 6 kHz, getting louder.
// Not low-passed by the pump's filter (it is on the same column, but it is a high sound). Keeps playing in the break.
const noiseRiser = gate(held(noiseCol.btn2), s("pink*16")
  .attack(0.03).sustain(0.8).release(0.15)
  .bpf(noiseRise.fmap(r => 300 * Math.pow(20, r))).bpq(4)
  .gain(noiseRise.mul(0.35)).pan(sine.fast(2)))

const stemJ2_noise = strip(stack(
  beatOnly(bus(pick(noiseVar, NOISES)
    .lpf(toned(expRange(noiseCol.bright, 2000, 14000)).fmap(f => m => w => f * (1 - 0.7 * m * w)).appLeft(noiseMove).appLeft(sine.slow(2)))
    .pan(noiseMove.fmap(m => p => 0.5 + m * (p - 0.5)).appLeft(sine.slow(3))), 1, noiseCol.space, 0.15)),
  bus(noiseRiser, 2, pure(0.3))
), {
  level: noiseCol.level.range(0, 1),
})

// ============================================================
// JOJO 3 SUB — a sine on the chord root (A1 = 55 Hz): each note starts a 16th after the kick (ducked, without a compressor)
// ============================================================
// @ctl B16:3.k1 Brightness | 0 = sine with a few overtones (audible on small speakers) ↔ warm and full.
// @ctl B16:3.k2 Space | dry ↔ a little room (reverb).
// @ctl B16:3.k3 Length | long, pumping notes ↔ short, bouncing ones.
// @ctl B16:3.fader Level | sub on the chord root, follows the chapter.
// @ctl B16:3.b1 Change | pump → off-beat → half bars.
// @ctl B16:3.b2 Slide | every note bends up into its pitch while held.
const sub      = colJojo(3)
const subVar   = change(sub.btn, 'jojo', 'Sub', 3, ['Pumpe', 'Offbeat', 'Halbe'])
const subClip  = sub.char.fmap(c => 1 - 0.65 * c)   // share of the note length that sounds
const subSlide = sub.btn2.fmap(v => v > 0.5 ? -5 : 0)
const SUBS = ["[~ 0@3]*4", "[~ 0]*4", "[~ 0@7]*2"].map(p => onRoot(n(p)).scale(scaleIn(1)))
const subNotes = pick(subVar, SUBS)

const stemJ3_sub = beatOnly(strip(dryBus(stack(
  subNotes.s("sine").gain(0.5),
  subNotes.s("triangle").gain(sub.bright.fmap(b => 0.1 + 0.17 * b))
).attack(0.015).sustain(1).release(0.04).clip(subClip).penv(subSlide).pattack(0.07), 1, sub.space), {
  level: sub.level.range(0, 1),
}))

// ============================================================
// JOJO 4 BASSLINE — bouncy house bass: saw + square, a short filter envelope (a little squelch), slightly driven
// ============================================================
// @ctl B16:4.k1 Brightness | 0 = round and woody ↔ buzzing, squelchy (lpf 300–2500 Hz + envelope).
// @ctl B16:4.k2 Space | dry ↔ a little room (reverb).
// @ctl B16:4.k3 Groove | the line as it is ↔ extra 16th notes bouncing in between.
// @ctl B16:4.fader Level | bouncy bass, follows the chapter.
// @ctl B16:4.b1 Change | octave bounce → off-beat → disco.
// @ctl B16:4.b2 Octave | one octave up while held.
const bassCol = colJojo(4)
const bassVar = change(bassCol.btn, 'jojo', 'Bass', 3, ['Oktave', 'Offbeat', 'Disco'])
const bassOct = bassCol.btn2.fmap(v => v > 0.5 ? 12 : 0)
// [main line, extra 16ths], scale degrees above the chord root (7 = octave, 4 = fifth, 2 = third)
const BASS_LINES = [
  ["[~ 0 ~ 7]*4", "[~ ~ 0 ~]*4"],
  ["[~ 0]*4", "[~ ~ ~ 7]*4"],
  ["[0 ~ 7 ~] [0 ~ 7 ~] [0 ~ 7 ~] [0 ~ 4 ~]", "[~ ~ ~ 2]*4"],
].map(([main, extra]) => [onRoot(n(main)), onRoot(n(extra))])
const bassSound = pat => pat.scale(scaleIn(2)).add(note(bassOct)).s("sawtooth").superimpose(x => x.s("square").add(note(-0.07)))
  .attack(0.003).decay(0.16).sustain(0.25).release(0.06).lpq(5).lpenv(2.5).lpdecay(0.12).lpsustain(0).shape(0.25)

const stemJ4_bass = beatOnly(strip(dryBus(stack(
  bassSound(pick(bassVar, BASS_LINES.map(l => l[0]))).gain(0.18),
  gate(above(bassCol.char, 0), bassSound(pick(bassVar, BASS_LINES.map(l => l[1]))).gain(bassCol.char.mul(0.14)))
), 1, bassCol.space), {
  lpf: expRange(bassCol.bright, 300, 2500),
  level: bassCol.level.range(0, 1),
}))

// ============================================================
// JOJO 5 CLAP + SNARE — 909 clap with a quieter 909 snare underneath, on 2 and 4
// ============================================================
// @ctl B16:5.k1 Brightness | soft and far ↔ sharp crack (lpf 1.5–12 kHz).
// @ctl B16:5.k2 Space | dry ↔ far away (reverb + echo).
// @ctl B16:5.k3 Ghost notes | plain ↔ a quiet clap before beat 3 ↔ + small double taps.
// @ctl B16:5.fader Level | clap + snare on 2 and 4. Also the level of Tension's snare roll.
// @ctl B16:5.b1 Change | plain → pickup → double clap.
// @ctl B16:5.b2 Roll | snare roll, growing over the bar, while held.
const clap      = colJojo(5)
const clapVar   = change(clap.btn, 'jojo', 'Clap', 3, ['plain', 'Vorschlag', 'Doppel'])
const clapGhost = clap.char
const clapSound = pat => stack(
  pat.s("cp").bank("RolandTR909"),
  pat.mul(gain(0.45)).s("sd").bank("RolandTR909")
).attack(0.001).decay(0.14).sustain(0).release(0.06)
const CLAPS = ["~ 0.8 ~ 0.8", "~ 0.8 ~ [0.8 ~ ~ 0.35]", "~ 0.8 ~ <0.8 [0.8 0.5]>"].map(g => clapSound(gain(g)))

const stemJ5_clap = beatOnly(strip(bus(stack(
  pick(clapVar, CLAPS),
  gate(above(clapGhost, 0), clapSound(gain("~ ~ 0.22 ~").mul(gain(ramp(clapGhost, 0, 0.5))))),
  gate(above(clapGhost, 0.5), clapSound(gain("~ [~ 0.15] ~ ~").mul(gain(ramp(clapGhost, 0.5, 1))))),
  gate(held(clap.btn2), drum("sd*16").gain(saw.range(0.1, 0.5))),
  // Tension roll: 8ths → 16ths, louder as Tension rises
  gate(above(tensionRoll, 0), drum("sd*16").degradeBy(tensionRoll.fmap(t => 0.5 * (1 - t)))
    .gain(tensionRoll.fmap(t => 0.1 + 0.35 * t)))
).mul(gain(1.5)).hpf(300).pan(0.48), 1, clap.space, 0.2), {
  lpf: expRange(clap.bright, 1500, 12000),
  level: clap.level.range(0, 1),
}))

// ============================================================
// JOJO 6 HATS — the house off-beat: an open 909 hat between the kicks, plus closed 16ths in the other patterns
// ============================================================
// @ctl B16:6.k1 Brightness | soft hiss ↔ crisp and sharp (lpf 3–16 kHz).
// @ctl B16:6.k2 Space | dry ↔ far away (reverb + echo).
// @ctl B16:6.k3 Density | the pattern as it is ↔ + quiet 16ths ↔ + little 32nd rolls.
// @ctl B16:6.fader Level | off-beat open hat. Keeps playing in the break.
// @ctl B16:6.b1 Change | off-beat → + 16ths → disco (swelling 16ths).
// @ctl B16:6.b2 Open | open hats on every 8th while held.
const hats    = colJojo(6)
const hatVar  = change(hats.btn, 'jojo', 'Hats', 3, ['Offbeat', '16tel', 'Disco'])
const hatDens = hats.char
const offHat  = drum("[~ oh]*4").gain(0.4)
const HATS = [
  offHat,
  stack(offHat, drum("hh*16").gain("[0.22 0.12 0 0.14]*4")),
  stack(offHat, drum("hh*16").gain(sine.fast(2).range(0.08, 0.3))),
]

const stemJ6_hats = strip(bus(stack(
  pick(hatVar, HATS),
  gate(above(hatDens, 0), drum("hh*16").degradeBy(0.4).gain(ramp(hatDens, 0, 0.5).mul(0.12))),
  gate(above(hatDens, 0.5), drum("hh*32").degradeBy(0.8).gain(ramp(hatDens, 0.5, 1).mul(0.18))),
  gate(held(hats.btn2), drum("oh*8").gain(0.3))
).mul(gain(1.2)).pan(0.56), 1, hats.space, 0.2), {
  lpf: expRange(hats.bright, 3000, 16000),
  level: hats.level.range(0, 1),
})

// ============================================================
// JOJO 7 CONGAS — TR-727 latin percussion: conga low (n 4), bongo high / low (n 2 / 3); agogo bells (n 0 / 1) with density
// ============================================================
// @ctl B16:7.k1 Brightness | soft and woody ↔ crisp slap (lpf 600–12000 Hz).
// @ctl B16:7.k2 Space | dry ↔ far away (reverb + echo).
// @ctl B16:7.k3 Density | steady pattern ↔ + fingertip ghost notes ↔ + agogo bells.
// @ctl B16:7.fader Level | congas and bongos. Keep playing in the break.
// @ctl B16:7.b1 Change | pillow → gallop → latin.
// @ctl B16:7.b2 Fill | a conga run over the bar while held.
const perc     = colJojo(7)
const percVar  = change(perc.btn, 'jojo', 'Congas', 3, ['Kissen', 'Galopp', 'Latin'])
const percDens = perc.char
const conga = (pat, g) => n(pat).s("perc").bank("RolandTR727").gain(g)
const PERCS = ["4 ~ ~ 2 ~ ~ 3 ~ 4 ~ ~ 2 ~ 3 ~ ~", "~ ~ 2 2 ~ ~ 4 ~ ~ ~ 2 2 ~ 3 4 ~", "3 ~ 2 ~ 4 ~ 2 3 ~ 2 ~ 4 ~ ~ 2 ~"]
  .map(p => conga(p, perlin.range(0.2, 0.3)))

const stemJ7_perc = strip(bus(stack(
  pick(percVar, PERCS),
  gate(above(percDens, 0), conga(irand(2).add(2).segment(16), ramp(percDens, 0, 0.5).mul(0.09)).degradeBy(0.55)),
  gate(above(percDens, 0.5), conga("~ 0 ~ ~ 1 ~ ~ 0 ~ ~ 1 ~ 0 ~ ~ ~", ramp(percDens, 0.5, 1).mul(0.13))),
  gate(held(perc.btn2), conga("2 2 3 3 2 3 4 4 2 2 3 3 4 3 4 4", 0.25))
).pan(sine.slow(4).range(0.35, 0.65)), 1, perc.space, 0.3), {
  lpf: expRange(perc.bright, 600, 12000),
  level: perc.level.range(0, 1),
})

// ============================================================
// JOJO 8 SHAKER / TAMBOURINE — TR-727 maracas on 16ths, TR-707 tambourine
// ============================================================
// @ctl B16:8.k1 Brightness | soft shimmer ↔ bright sizzle (lpf 4.5–16 kHz).
// @ctl B16:8.k2 Space | dry ↔ far away (reverb + echo).
// @ctl B16:8.k3 Swing | straight ↔ swung, lazy (the in-between 16ths come late).
// @ctl B16:8.fader Level | shaker and tambourine. Keep playing in the break.
// @ctl B16:8.b1 Change | shaker → tambourine on 2 and 4 → both.
// @ctl B16:8.b2 Double | double time while held.
const shake    = colJojo(8)
const shakeVar = change(shake.btn, 'jojo', 'Shaker', 3, ['Shaker', 'Tamburin', 'beides'])
const maracas  = g => gain(g).s("sh").bank("RolandTR727").n(1)
const tambo    = g => gain(g).s("tb").bank("RolandTR707")
const SHAKERS = [
  maracas("[0.35 0.18 0.26 0.18]*4"),
  stack(maracas("[0.3 0.18]*4"), tambo("~ 0.4 ~ 0.4")),
  stack(maracas("[0.3 0.15 0.22 0.15]*4"), tambo("[~ 0.28]*4")),
]

const stemJ8_shake = strip(bus(pick(shakeVar, SHAKERS)
  .fast(shake.btn2.fmap(v => v > 0.5 ? 2 : 1))
  .swingBy(shake.char.mul(0.6), 8)   // 0.6 = the off-16th lands on the last triplet
  .mul(gain(3)).pan(0.62), 1, shake.space, 0.25), {
  lpf: expRange(shake.bright, 4500, 16000),
  level: shake.level.range(0, 1),
})

// Drop: a 909 crash on the one of the bar where the break ends (no fader of its own, master level only)
const dropNow = signal(t => breakLatch.at(t) === 0 && Math.floor(Number(t)) === breakLatch.since).segment(1)
const stemCrash = gate(and(dropNow, above(globalLevel, 0)),
  dryBus(drum("cr").gain(0.3), 1, pure(0.3)).postgain(globalLevel))

// ============================================================
// JONAS 1 STRINGS — warm string pad: detuned saws on the chord (sevenths), slow attack
// ============================================================
// @ctl 16:1.k1 Brightness | muffled ↔ open and airy (lpf 400–6000 Hz).
// @ctl 16:1.k2 Space | dry and close ↔ far away in a big room (reverb + echo).
// @ctl 16:1.k3 Pump | 0 = held strings. Up = they pump with the kick (re-struck every beat, like a sidechain).
// @ctl 16:1.fader Level | warm strings on the chapter's chords.
// @ctl 16:1.b1 Change | voicing: warm → bright → wide.
// @ctl 16:1.b2 Freeze | holds the current chord while held, for everybody.
const padVar  = change(pad.btn, 'jonas', 'Streicher', 3, ['warm', 'hell', 'weit'])
const padPump = pad.char
// Voicings in scale degrees above the root: seventh chord, upper chord tones, spread (low root, 3rd, 7th, 5th up)
const PAD_VOICINGS = [[0, 2, 4, 6], [2, 4, 7, 9], [-7, 2, 6, 11]].map(v => chordOn(v).scale(scaleIn(3)))
const padChord = pick(padVar, PAD_VOICINGS)
const strings  = pat => pat.s("sawtooth").superimpose(x => x.add(note(0.12))).pan(sine.slow(5).range(0.3, 0.7))
const padStill = strings(padChord).attack(0.6).sustain(0.8).release(1.5).gain(0.3)
const padBeat  = strings(padChord.struct("[~ x@3]*4")).attack(0.12).sustain(0.8).release(0.05).gain(0.3)

const stemN1_pad = strip(bus(stack(
  gate(above(fadeMain(padPump), 0), padStill.mul(gain(fadeMain(padPump)))),
  gate(above(fadeExtra(padPump), 0), padBeat.mul(gain(fadeExtra(padPump))))
), 2, pad.space, 0.15), {
  lpf: expRange(pad.bright, 400, 6000),
  level: pad.level.range(0, 1),
})

// ============================================================
// JONAS 2 PIANO — the house piano: chord stabs (triad + octave) with a dotted-8th echo, a little drive
// ============================================================
// Piano samples (strudel.cc loads them by default) + a quiet triangle copy for warmth.
// @ctl 16:2.k1 Brightness | warm and muffled ↔ bright, ringing (lpf 600–10000 Hz).
// @ctl 16:2.k2 Space | dry ↔ the echoes repeat far into the room.
// @ctl 16:2.k3 Rhythm | long ringing chords ↔ short, choppy stabs.
// @ctl 16:2.fader Level | piano chords on the chapter's chords.
// @ctl 16:2.b1 Change | next of 8 piano rhythms.
// @ctl 16:2.b2 Stab | a chord on every off-beat while held.
const piano      = colJonas(2)
const pianoVar   = change(piano.btn, 'jonas', 'Piano')
const pianoLen   = piano.char.fmap(c => 1.4 * Math.pow(0.08, c))   // decay seconds: 1.4 ↔ 0.11
const pianoChord = chordOn([0, 2, 4, 7]).scale(scaleIn(4))
const PIANO_RHYTHMS = ["x ~ ~ x ~ ~ x ~", "[~ x]*4", "x ~ ~ x ~ ~ x ~ ~ ~ x ~ x ~ ~ ~", "[~ ~ x ~] [~ x ~ ~] [x ~ ~ x] [~ ~ x ~]",
  "x ~ ~ ~ ~ ~ x ~ ~ ~ x ~ ~ ~ ~ ~", "~ x ~ x ~ ~ x ~ ~ x ~ x ~ ~ x ~", "<[x ~ ~ x ~ ~ x ~] [~ ~ x ~ ~ x ~ ~]>",
  "x ~ x ~ ~ x ~ x ~ ~ x ~ x ~ ~ ~"]
const PIANO_PATS = PIANO_RHYTHMS.map(r => pianoChord.struct(r))
const pianoSound = pat => stack(
  pat.s("piano").gain(0.3),
  pat.s("triangle").gain(0.05)
).decay(pianoLen).sustain(0).release(pianoLen.mul(0.5)).shape(0.15)

const stemN2_piano = strip(bus(stack(
  pianoSound(pick(pianoVar, PIANO_PATS)).delay(0.4),
  gate(held(piano.btn2), pianoSound(pianoChord.struct("[~ x]*4")).delay(0.3))
), 2, piano.space), {
  lpf: expRange(piano.bright, 600, 10000),
  level: piano.level.range(0, 1),
})

// ============================================================
// JONAS 3 ARP — bright 16th pluck over the chord tones (stepwise, no octave leaps), with echo
// ============================================================
// Keeps a little room even at space 0.
// @ctl 16:3.k1 Brightness | soft plucks ↔ sharp, sparkling (lpf 1.2–10 kHz).
// @ctl 16:3.k2 Space | a little room ↔ far away (reverb + echo).
// @ctl 16:3.k3 Range | few notes of the arp ↔ every 16th, plus the 9th and 6th in between.
// @ctl 16:3.fader Level | bright arp on the chord.
// @ctl 16:3.b1 Change | next of 8 arp shapes.
// @ctl 16:3.b2 Octave | one octave up while held.
const arp      = colJonas(3)
const arpVar   = change(arp.btn, 'jonas', 'Arp')
const arpRange = arp.char
const arpOct   = arp.btn2.fmap(v => v > 0.5 ? 12 : 0)
// Scale degrees above the root: 0 2 4 = triad, 7 = octave, 9 = tenth (reached stepwise)
const ARPS = ["[0 2 4 7]*4", "[7 4 2 0]*4", "[0 2 4 2]*4", "[0 2 4 7 9 7 4 2]*2", "[0 ~ 2 4 ~ 2 4 ~]*2",
  "{0 2 4 7 4}%16", "[4 2 0 2]*4", "<[0 2 4 7]*4 [2 4 7 9]*4>"].map(p => n(p))

const stemN3_arp = strip(bus(onRoot(pick(arpVar, ARPS)
  .degradeBy(arpRange.fmap(r => 0.5 * (1 - r)))
  .sometimesBy(arpRange.mul(0.25), x => x.add(n("<1 5>"))))   // passing notes: 9th / 6th
  .scale(scaleIn(4)).add(note(arpOct))
  .s("sawtooth").attack(0.002).decay(0.12).sustain(0).release(0.08).lpq(3)
  .gain(perlin.range(0.55, 0.8)).pan(sine.slow(3).range(0.3, 0.7)).delay(0.35),
  2, arp.space.fmap(s => 0.3 + 0.7 * s)), {
  lpf: expRange(arp.bright, 1200, 10000),
  level: arp.level.range(0, 1),
})

// ============================================================
// JONAS 4 VOCAL HOOK — the main melody: detuned saws through a vowel filter (“aah / ooh”), slight vibrato
// ============================================================
// Melodies as scale degrees above the chord root (0 root, 2 third, 4 fifth, 5 sixth, 7 octave), so they always fit.
// @ctl 16:4.k1 Brightness | soft and hushed ↔ open, bright voice (lpf 600–6000 Hz).
// @ctl 16:4.k2 Space | a little room ↔ far away (reverb + echo).
// @ctl 16:4.k3 Glide | plain notes ↔ notes bend gently into their pitch (at most a semitone).
// @ctl 16:4.fader Level | the vocal hook on the chord.
// @ctl 16:4.b1 Change | next of 8 hooks.
// @ctl 16:4.b2 Echo throw | long echo on the hook while held.
const hook      = colJonas(4)
const hookVar   = change(hook.btn, 'jonas', 'Hook')
const hookGlide = hook.char
const HOOKS = ["4 _ ~ 4 ~ 2 _ ~ 0 _ ~ ~ 2 ~ 4 ~", "~ ~ 7 _ ~ 4 ~ 4 _ ~ 2 ~ 4 _ _ ~", "0 _ 2 _ 4 _ ~ 4 ~ 5 4 ~ 2 _ ~ ~",
  "<[7 _ ~ 7 ~ 4 _ ~ ~ ~ 2 ~ 4 _ ~ ~] [4 _ ~ 4 ~ 2 _ ~ 0 _ _ _ ~ ~ ~ ~]>", "~ 4 ~ 4 ~ 4 2 _ ~ 2 ~ 2 0 _ ~ ~",
  "2 _ _ ~ 4 _ _ ~ 7 _ _ _ 5 _ 4 _", "~ ~ ~ ~ 4 _ 4 _ ~ 2 _ ~ 0 _ ~ ~", "7 _ 4 _ 2 _ 4 _ ~ ~ 2 ~ 0 _ ~ ~"].map(p => n(p))
const throwEcho = (pat, button) => pat.fmap(v => b => b > 0.5 ? { ...v, delay: 0.85 } : v).appLeft(button)
const hookNotes = onRoot(pick(hookVar, HOOKS)).scale(scaleIn(4))

const stemN4_hook = strip(throwEcho(bus(hookNotes
  .s("sawtooth").superimpose(x => x.add(note(0.1))).vowel("<a a o a>")
  .attack(0.03).decay(0.2).sustain(0.7).release(0.15)
  .vib(5).vibmod(0.08)
  .penv(hookGlide.fmap(g => -g)).pattack(0.08)
  .gain(0.13).delay(0.3), 2, hook.space.fmap(s => 0.25 + 0.75 * s)), hook.btn2), {
  lpf: expRange(hook.bright, 600, 6000),
  level: hook.level.range(0, 1),
})

// ============================================================
// JONAS 5 ANSWER — a short organ phrase at the end of every second bar, bouncing left and right through the echo
// ============================================================
// Organ = a square with a sine an octave up, short (the classic house organ stab, soft).
// @ctl 16:5.k1 Brightness | soft ↔ clear and bright (lpf 1.5–10 kHz).
// @ctl 16:5.k2 Space | some room and echo ↔ far away.
// @ctl 16:5.k3 Voices | 0 = one voice, 0.5 = + a third above, 1 = + a fifth: three-part organ.
// @ctl 16:5.fader Level | answer phrase, every second bar.
// @ctl 16:5.b1 Change | next of 8 phrase rhythms (new notes too).
// @ctl 16:5.b2 Answer | the phrase plays in every bar while held.
const ans       = colJonas(5)
const ansVar    = change(ans.btn, 'jonas', 'Antwort')
const ansVoices = ans.char
const ANS_RHYTHMS = ["~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ x ~ ~ x ~ ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x x x ~",
  "~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ x ~ x", "~ ~ ~ ~ ~ ~ x ~ ~ ~ x ~ ~ ~ x ~", "~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ ~ ~ ~ ~",
  "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x x ~ x ~ ~", "~ ~ ~ ~ x ~ ~ ~ ~ ~ x ~ ~ ~ x x"]
// Every second bar normally, every bar while button 2 is held
const ansEvery2 = pick(ansVar, ANS_RHYTHMS.map(r => pure(1).struct(r).mask("<0 1>")))
const ansEvery  = pick(ansVar, ANS_RHYTHMS.map(r => pure(1).struct(r)))
const ansRhythm = held(ans.btn2).fmap(b => b ? ansEvery : ansEvery2).innerJoin()
// Notes: random chord tones (root, 3rd, 5th, octave, 10th), new ones per change
const ANS_TONES = [0, 2, 4, 7, 9]
const ansNotes = n(reseed(ansVar, irand(5).segment(16).fmap(i => ANS_TONES[i])))
const ansVoice = (deg, g) => onRoot(ansRhythm.fmap(() => v => v).appLeft(ansNotes).add(n(deg)))
  .scale(scaleIn(4)).s("square").superimpose(x => x.s("sine").add(note(12)))
  .decay(0.12).sustain(0.1).release(0.08).gain(g)

const stemN5_ans = strip(bus(stack(
  ansVoice(0, 0.48),
  gate(above(ansVoices, 0), ansVoice(2, ramp(ansVoices, 0, 0.5).mul(0.38))),
  gate(above(ansVoices, 0.5), ansVoice(4, ramp(ansVoices, 0.5, 1).mul(0.32)))
).pan("[0.25 0.75]*8").delay(0.5), 2, ans.space.fmap(s => 0.35 + 0.65 * s)), {
  lpf: expRange(ans.bright, 1500, 10000),
  level: ans.level.range(0, 1),
})

// ============================================================
// JONAS 6 BELLS — FM bells on chord tones on a 16th grid (low FM index: bell, not quack), long echoes
// ============================================================
// @ctl 16:6.k1 Brightness | soft glow ↔ glittering (lpf 3–16 kHz).
// @ctl 16:6.k2 Space | dry ↔ far away (reverb + echo).
// @ctl 16:6.k3 Density | a few bells per bar ↔ a rain of bells (~70 % of the 16ths).
// @ctl 16:6.fader Level | bells on the chord.
// @ctl 16:6.b1 Change | next of 8 random bell patterns.
// @ctl 16:6.b2 Burst | a quick rain of bells while held.
const bells    = colJonas(6)
const bellVar  = change(bells.btn, 'jonas', 'Glocken')
const bellKeep = bells.char.fmap(d => 0.15 + 0.55 * d)   // share of 16ths
const BELL_TONES = [0, 2, 4, 7, 9, 11, 14]
const bellNote = steps => n(irand(7).segment(steps).fmap(i => BELL_TONES[i]))

const stemN6_bells = strip(bus(onRoot(stack(
  reseed(bellVar, bellNote(16)
    .degradeBy(bellKeep.fmap(k => 1 - k))
    .s("sine").fm(rand.range(0.3, 1.1)).fmh(3.5)   // non-integer ratio = bell, low index = no quack
    .decay(rand.range(0.2, 0.6)).sustain(0).release(0.3)
    .gain(rand.range(0.5, 1.1))
    .pan(rand)
    .delay(0.5)),
  // Burst: its own layer, every 32nd, louder than the bells, so it stands out at any density
  gate(held(bells.btn2), bellNote(32).s("sine").fm(0.8).fmh(3.5)
    .decay(rand.range(0.05, 0.15)).sustain(0).gain(rand.range(0.8, 1.3)).pan(rand).delay(0.4))
)).scale(scaleIn(5)), 2, bells.space), {
  lpf: expRange(bells.bright, 3000, 16000),
  level: bells.level.range(0, 1),
})

// ============================================================
// JONAS 7 VOCAL CHOPS — short “ah / eh / oh” syllables on syncopated 16ths, chord tones (no samples: saw + vowel filter)
// ============================================================
// @ctl 16:7.k1 Brightness | muffled ↔ bright, crisp syllables (lpf 1.2–10 kHz).
// @ctl 16:7.k2 Space | a little room ↔ far away (reverb + echo).
// @ctl 16:7.k3 Amount | subtle (the rhythm only) ↔ wild: extra chops an octave up, with echo.
// @ctl 16:7.fader Level | vocal chops on the chord.
// @ctl 16:7.b1 Change | next of 8 chop rhythms (new syllables too).
// @ctl 16:7.b2 Stutter | the chop stutters on every 16th while held.
const chops   = colJonas(7)
const chopVar = change(chops.btn, 'jonas', 'Chops')
const chopAmt = chops.char
const CHOP_RHYTHMS = ["~ ~ x ~ ~ ~ x ~ ~ ~ ~ ~ x ~ ~ ~", "~ x ~ ~ ~ x ~ ~ ~ ~ ~ ~ ~ ~ x ~", "~ ~ x x ~ ~ x ~ ~ ~ ~ ~ ~ ~ ~ ~",
  "~ ~ ~ x ~ ~ x ~ ~ ~ ~ x ~ ~ x ~", "x ~ ~ x ~ ~ ~ ~ ~ ~ x ~ ~ ~ ~ ~", "~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ x x ~",
  "~ x ~ x ~ ~ ~ ~ ~ x ~ x ~ ~ ~ ~", "<[~ ~ x ~ ~ ~ x ~ ~ ~ ~ ~ x ~ ~ ~] [~ ~ ~ ~ ~ ~ ~ ~ ~ ~ x ~ x ~ x ~]>"]
const CHOP_TONES = [0, 2, 4, 7]
const VOWELS     = ['a', 'e', 'o', 'a', 'i']
const chopNotes  = n(reseed(chopVar, irand(4).segment(16).fmap(i => CHOP_TONES[i])))
const chopVowel  = reseed(chopVar, irand(5).segment(16).fmap(i => VOWELS[i]))
const chopSound  = (pat, octave) => onRoot(pat).scale(scaleIn(octave))
  .s("sawtooth").superimpose(x => x.add(note(0.1))).vowel(chopVowel)
  .attack(0.005).decay(0.11).sustain(0).release(0.05)
const chopMain = pick(chopVar, CHOP_RHYTHMS.map(r => pure(1).struct(r))).fmap(() => v => v).appLeft(chopNotes)
// Stutter: one note per beat, repeated on every 16th
const chopStutter = n(reseed(chopVar, irand(4).segment(4).fmap(i => CHOP_TONES[i]))).struct("x*16")

const stemN7_chops = strip(bus(stack(
  chopSound(chopMain, 4).gain(0.15).delay(0.25),
  gate(above(chopAmt, 0), chopSound(chopNotes.degradeBy(chopAmt.fmap(a => 1 - 0.35 * a)), 5)
    .gain(chopAmt.mul(0.12)).pan(rand).delay(0.55)),
  gate(held(chops.btn2), chopSound(chopStutter, 4).gain(saw.range(0.08, 0.15)))
), 2, chops.space.fmap(s => 0.25 + 0.75 * s)), {
  lpf: expRange(chops.bright, 1200, 10000),
  level: chops.level.range(0, 1),
})

// Stateful controls (button counters, bar latches, risers) only see a change when they are queried.
// Gated stems are not queried, so this queries every one of them on every scheduler tick and drops the result:
// presses still count and chapter/break still switch while faders are down.
const stateTaps = stack(...taps).filterValues(() => false)
showStatus()


// ============================================================
// MASTER AUDIO MATRIX
// ============================================================
stack(
  stemJ1_kick,
  stemJ2_noise,
  stemJ3_sub,
  stemJ4_bass,
  stemJ5_clap,
  stemJ6_hats,
  stemJ7_perc,
  stemJ8_shake,
  stemCrash,
  stemN1_pad,
  stemN2_piano,
  stemN3_arp,
  stemN4_hook,
  stemN5_ans,
  stemN6_bells,
  stemN7_chops,
  stateTaps
)
  .filterValues(v => (v.gain ?? 1) * (v.postgain ?? 1) > 0)   // safety net: drop anything that is silent anyway
