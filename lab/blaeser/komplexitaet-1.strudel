// ============================================================
// KOMPLEXITÄT 1: eight proposals for what the brass complexity knob (row 3) does (009 Jonas 5)
// ============================================================
// @engine 3
// User (2026-11-08): complexity on the brass works but only adds hits — sometimes cool, but not much of a lift. Rebuild
// the slider in a lab, one column per proposal. Every column = the brass of track 009 Jonas 5 (full section, warm voicing,
// the six figures on button 1, lift on button 2 held); only row 3 differs. Row 3 at 0 = the plain figure everywhere.
//   1 More hits (as now: pickups and answers join, softer) — the reference
//   2 Melody: the lead starts to move — 0 one note, then every second hit a chord tone lower, then a contour over the
//     figure (up and down through the chord tones), at the top passing notes of the scale on the pickups
//   3 Phrase end: fills at the end of the 8-bar phrase (and of bar 4) — a pickup run into the one, then a longer fill,
//     at the top a whole shout bar 8 (house: change bar 4 and 8, keep the rest — lab/keys rule)
//   4 Articulation: accents (louder, brighter first hits), then scoops into the long notes, then a shake (vibrato) on
//     long notes and a short fall on the last note of the phrase
//   5 Syncopation: the hits move earlier — first the long notes are anticipated by a 16th, then the downbeat hits too
//     (pushed against the kick), at the top stop-time gaps (beat 1 of bars 2 and 6 left out)
//   6 Call and answer: the section splits — trumpets play the figure, the horns and trombones answer it two beats later,
//     then the answer in harmony, at the top a third answer an octave up
//   7 Harmony: unison → octaves → triads → four-part with 9ths (the voicing gets richer, the rhythm stays)
//   8 Combined (my proposal): melody (2) to the middle, then phrase-end fills (3), at the top articulation (4)
// Sounds as Jonas 5 (Sonatina Symphonic Orchestra, CC Sampling Plus 1.0; VSCO 2 CE falls, CC0). Not heard.
//
// Launch Control XL 3: candidates in Custom Mode 16 (channel 16), drums, bass, keys and the progression in Mode 2.
// @layout Komplexität 1 (lab/blaeser, 009 Jonas 5: eight proposals for the complexity knob)
// @note Every column = Jonas 5 brass; the six figures on button 1; only row 3 (complexity) differs from column to column.
// @note Row 3 at 0 = the plain figure everywhere; turn it slowly up and compare.
// @guide What to listen for | Which knob makes the brass more interesting without getting busy? Which feels like a real lift?
// @guide Live | Button 2 held = lift (voices, brightness, +3 dB) as in the track.
// @mode 16 Mode 16 — Candidates
// @col 16:1 1 More hits
// @col 16:2 2 Melody
// @col 16:3 3 Phrase end
// @col 16:4 4 Articulation
// @col 16:5 5 Syncopation
// @col 16:6 6 Call + answer
// @col 16:7 7 Harmony
// @col 16:8 8 Combined
// @row 16:k1 Row 1 \ Brightness
// @row 16:k2 Row 2 \ Space
// @row 16:k3 Row 3 \ Complexity
// @row 16:fader Fader \ Level
// @row 16:b1 Button 1 \ Figure
// @row 16:b2 Button 2 \ Lift (held)
// @ctl 16:1-8.k1 Brightness | dull ↔ bright (low-pass 0.9–8 kHz).
// @ctl 16:1-8.k2 Space | room at 0 ↔ hall and dotted-8th echo.
// @ctl 16:1.k3 More hits | core → + pickups and answers → + small extra hits.
// @ctl 16:2.k3 Melody | one note → every 2nd hit lower → a contour → + passing notes.
// @ctl 16:3.k3 Phrase end | none → pickup run into bar 1 → + bar 4 → shout fill in bar 8.
// @ctl 16:4.k3 Articulation | plain → accents → + scoops → + shake and a fall at the phrase end.
// @ctl 16:5.k3 Syncopation | on the grid → long notes early → all early → + stop-time gaps.
// @ctl 16:6.k3 Call + answer | trumpets alone → horns answer → in harmony → + an answer an octave up.
// @ctl 16:7.k3 Harmony | unison → octaves → triads → four-part with 9ths.
// @ctl 16:8.k3 Combined | melody → + phrase-end fills → + articulation.
// @ctl 16:1-8.fader Level | 0 = off.
// @ctl 16:1-8.b1 Figure | push → 3-3-2 → shout → double push → 3-3-2 long → swell + push, next bar.
// @ctl 16:1-8.b2 Lift | held: the section grows over 2 bars; back over 1 bar after.
// @mode 2 Mode 2 — Context
// @col 2:5 5 Progression
// @col 2:6 6 Drums
// @col 2:7 7 Bass
// @col 2:8 8 Keys
// @ctl 2:5.b1 Next | next progression (all 21), at the next 8-bar phrase.
// @ctl 2:5.b2 Previous | previous progression, at the next 8-bar phrase.
// @ctl 2:6.fader Drums | 909 kick, off-beat hat, clap, shaker.
// @ctl 2:6.k1 Swing | 50 % straight ↔ 70 %; 55–58 % = house.
// @ctl 2:6.b2 Drums out | everything but the drums while held.
// @ctl 2:7.fader Bass | off-beat bass on the chord root.
// @ctl 2:8.fader Keys | the keys of 009, following the progression.

const BOARD = { id: 'komplex1', title: 'Komplexität 1' }
const bpm = 124
const BAR = 240 / bpm   // seconds per bar

const SSO = 'https://raw.githubusercontent.com/peastman/sso/master/Sonatina%20Symphonic%20Orchestra/Samples/'
const VSCO = 'https://raw.githubusercontent.com/sgossner/VSCO-2-CE/master/Brass/OldTrombone/Fall/'
const ssoMap = (dir, pre, notes, post = '') => Object.fromEntries(notes.map(n => [n, SSO + dir + '/' + pre + n.replace('#', '%23') + post + '.wav']))
const up8 = n => n.replace(/\d$/, d => +d + 1)
if (typeof samples === 'function') await samples({
  sso_tp: ssoMap('Trumpets', 'trumpets-stc-rr1-', ['e3', 'g3', 'a#3', 'c#4', 'e4', 'g4', 'a#4', 'c#5', 'e5', 'g5', 'a#5']),
  sso_tb: ssoMap('Trombones', 'trombones-stc-rr1-', ['e2', 'g2', 'a#2', 'c#3', 'e3', 'g3', 'a#3', 'c#4', 'e4']),
  sso_hn: ssoMap('Horns', 'horns-stc-rr1-', ['e2', 'g2', 'a#2', 'c#3', 'e3', 'g3', 'a#3', 'c#4', 'e4', 'g4', 'a#4']),
  sso_tp_sus: ssoMap('Trumpets', 'trumpets-sus-', ['e3', 'g3', 'a#3', 'c#4', 'e4', 'g4', 'a#4', 'c#5', 'e5', 'g5']),
  sso_tb_sus: ssoMap('Trombones', 'trombones-sus-', ['e2', 'g2', 'a#2', 'c#3', 'e3', 'g3', 'a#3', 'c#4', 'e4']),
  sso_hn_sus: ssoMap('Horns', 'horns-sus-mp-', ['e2', 'g2', 'a#2', 'c#3', 'e3', 'g3', 'a#3', 'c#4', 'e4', 'g4', 'a#4'], '-PB-loop'),
  vs_fall: Object.fromEntries(['G1', 'A1', 'A#1', 'C2', 'C#2', 'D2', 'D#2', 'E2', 'F2', 'G2', 'G#2', 'A2', 'A#2', 'B2']
    .map(n => [up8(n).toLowerCase(), VSCO + 'Trombone_Fall_' + n.replace('#', '%23') + '_1.wav'])),
})

const makeCols = h => {
  const SC = { dorian: [9, 11, 0, 2, 4, 6, 7], aeolian: [9, 11, 0, 2, 4, 5, 7] }
  const modeAt = k => SC[HARMONIES[latch('harm', Math.floor(k / 16), 8)][3]]
  const pcsOf = name => { const c = CH[name]; return [...new Set([md(c.bass, 12), ...c.keys.map(x => md(x, 12))])] }
  const leadOf = name => { const p = pcsOf(name); let best = 67; for (let m = 67; m <= 76; m++) if (p.includes(md(m, 12)) && Math.abs(m - 72) < Math.abs(best - 72)) best = m; return best }
  const below = (name, top, n) => { const p = pcsOf(name), o = []; for (let m = top - 1; m >= top - 12 && o.length < n; m--) if (p.includes(md(m, 12))) o.push(m); return o }
  const chordStep = (name, m, n) => { const p = pcsOf(name); let x = m, s = 0; const d = Math.sign(n); while (s < Math.abs(n)) { x += d; if (p.includes(md(x, 12))) s++ } return x }
  const scaleStep = (m, sc, n) => { let x = m; const d = Math.sign(n); for (let i = 0; i < Math.abs(n); i++) { x += d; while (!sc.includes(md(x, 12))) x += d } return x }
  const levelOf = c => { const v = S.val[29 + c] ?? 0.3; return v < 0.25 ? 0 : v < 0.5 ? 1 : v < 0.75 ? 2 : 3 }
  const LIFT = {}
  const liftOf = c => {
    const st = LIFT[c] ??= { r: 0, t: performance.now() }, now = performance.now(), dt = Math.min(500, now - st.t)
    st.t = now
    st.r = S.held[45 + c] ? Math.min(1, st.r + dt / (2 * BAR * 1000)) : Math.max(0, st.r - dt / (BAR * 1000))
    return st.r
  }
  const MS = 16 / (BAR * 1000)
  const N = (p, len, lv = 0, kind = 'hit') => ({ p, len, lv, kind })
  // the six figures of Jonas 5 (lv = the old "more hits" level)
  const FIG = [
    ['Push', 32, [N(14, 1), N(16, 3), N(30, 1), N(0, 3), N(13, 1, 1), N(29, 1, 1), N(22, 1, 2), N(8, 1, 2)]],
    ['3-3-2 + Antwort', 32, [N(0, 1), N(3, 1), N(6, 2), N(24, 1), N(27, 3), N(10, 1, 1), N(23, 1, 1), N(31, 1, 2), N(14, 1, 2)]],
    ['Shout', 16, [N(0, 1), N(3, 1), N(6, 1), N(10, 2), N(12, 1), N(14, 1, 1), N(15, 1, 2), N(8, 1, 2)]],
    ['Doppel-Push', 32, [N(13, 1), N(14, 1), N(16, 2), N(29, 1), N(30, 1), N(0, 2), N(6, 1, 1), N(22, 1, 1), N(23, 1, 2), N(10, 1, 2)]],
    ['3-3-2 lang', 32, [N(0, 1), N(3, 1), N(6, 1), N(16, 1), N(19, 1), N(22, 2), N(28, 1, 1), N(30, 1, 1), N(12, 1, 2), N(27, 1, 2)]],
    ['Schweller + Push', 32, [N(24, 6, 0, 'swell'), N(30, 1), N(0, 2), N(3, 1, 1), N(6, 1, 1), N(10, 1, 2), N(14, 1, 2)]],
  ]
  const ENS = { lead: [['sso_tp', 0.45, 0, 0.45], ['sso_hn', 0.45, 6, 0.55]], dbl: [['sso_tp', 0.32, 9, 0.6]],
    harm: [['sso_hn', 0.4, 8, 0.5], ['sso_tp', 0.25, 4, 0.6]], low: [['sso_tb', 0.5, 11, 0.6]] }
  const SUS = { sso_tp: ['sso_tp_sus', 0.8], sso_hn: ['sso_hn_sus', 0.45], sso_tb: ['sso_tb_sus', 0.6] }
  // Phrase-end fills (in the figure's 16ths of an 8-bar phrase = 128): a pickup run into the one, a longer fill, a shout bar
  const FILL_RUN = [N(125, 1), N(126, 1), N(127, 1)].map((n, i) => ({ ...n, run: i - 3 }))
  const FILL_4 = [N(61, 1), N(62, 1), N(63, 1)].map((n, i) => ({ ...n, run: i - 3 }))
  const FILL_SHOUT = [N(112, 1), N(115, 1), N(118, 2), N(122, 1), N(124, 2)].map(n => ({ ...n, shout: true }))
  // A note event list for one 16th: figure notes + the column's own additions, then each note → the section's voices
  const play = (c, mode, L, notes) => new Pattern(state => {
    const b0 = state.span.begin.valueOf(), e0 = state.span.end.valueOf(), out = []
    const v0 = S.val[29 + c] ?? 0.3, lvl = levelOf(c), lift = liftOf(c), lg = Math.pow(10, 3 * lift / 20)
    const m = mode === 'combined' ? (lvl <= 1 ? 'melody' : lvl === 2 ? 'melody+fill' : 'all') : mode
    for (let k = Math.floor(b0 * 16) - 4; k < e0 * 16 + 2; k++) {
      const p = md(k, L), p128 = md(k, 128)
      // the figure: column 1 adds the extra hits with the knob (as now), all others play the core figure only
      let hits = notes.filter(n => n.p === p && n.lv <= (mode === 'hits' ? Math.min(2, lvl) : 0))
      // phrase end (3) / combined from level 2
      const fillLvl = mode === 'fill' ? lvl : m === 'melody+fill' ? 2 : m === 'all' ? 3 : 0
      if (fillLvl >= 1) hits = hits.concat(FILL_RUN.filter(n => n.p === p128))
      if (fillLvl >= 2) hits = hits.concat(FILL_4.filter(n => n.p === p128))
      if (fillLvl >= 3) { if (p128 >= 112) hits = FILL_SHOUT.filter(n => n.p === p128).concat(FILL_RUN.filter(n => n.p === p128)) }
      else if (fillLvl >= 1 && p128 >= 125) hits = hits.filter(n => n.run !== undefined)   // the run replaces the figure there
      // call + answer (6): the answer = the figure two beats later, on horns and trombones
      const answers = mode === 'answer' && lvl >= 1 ? notes.filter(n => n.lv === 0 && md(n.p + 8, L) === p) : []
      const all = [...hits.map(n => ({ n, ans: 0 })), ...answers.map(n => ({ n, ans: 1 })), ...(mode === 'answer' && lvl >= 3 ? answers.map(n => ({ n, ans: 2 })) : [])]
      for (const { n, ans } of all) {
        const kind = n.kind ?? 'hit', held = kind === 'swell'
        // syncopation (5): anticipate — level 1 long notes, level 2 all downbeat hits; level 3 stop-time gaps
        let shift = 0
        if (mode === 'sync') {
          if (lvl >= 3 && (md(k, 128) === 16 || md(k, 128) === 80)) continue
          if ((lvl >= 1 && n.len >= 2) || (lvl >= 2 && md(p, 4) === 0)) shift = -1
        }
        const kk = k + shift, name = h.chordAt(kk, true), sc = modeAt(kk)
        let lead = leadOf(name)
        // melody (2 / combined): the lead moves with the hit's index in the figure
        const idx = notes.filter(x => x.lv === 0).findIndex(x => x === n)
        const melLvl = mode === 'melody' ? lvl : mode === 'combined' ? Math.min(2, lvl) : 0
        if (melLvl >= 1 && idx >= 0 && idx % 2 === 1) lead = chordStep(name, lead, -1)
        if (melLvl >= 2 && idx >= 0) lead = chordStep(name, leadOf(name), [0, -1, 1, 0, -1, -2, 1, 0][idx % 8] || 0) || lead
        if (n.run !== undefined) lead = scaleStep(leadOf(h.chordAt(k + (-n.run), true)), sc, n.run)
        if (melLvl >= 3 && n.lv > 0) lead = scaleStep(lead, sc, 1)
        const artLvl = mode === 'artic' ? lvl : m === 'all' ? 3 : 0
        const first = idx === 0 || n.p === 0
        const acc = artLvl >= 1 && first ? 1.3 : 1, br = artLvl >= 1 && first ? 1.25 : 1
        const base = { dur: n.len === 1 ? 0.9 : n.len - 0.3, clip: 1, bright: (0.75 + 0.6 * lift) * br,
          attack: held ? 0.6 * n.len / 16 * BAR : 0.003, release: held ? 0.35 : n.len >= 3 ? 0.2 : 0.12,
          ...(artLvl >= 2 && n.len >= 2 ? { penv: 1.5, pattack: 0.07, prelease: 4 } : {}),
          ...(artLvl >= 3 && n.len >= 3 ? { vib: 5.5, vibmod: 0.25 } : {}) }
        // harmony (7): 0 unison (lead + doubling), 1 + octave below, 2 triad, 3 four-part with the 9th
        const harmLvl = mode === 'harmony' ? lvl : 2
        const close = below(name, lead, 3)
        let harm = held ? [close[1], close[2], close[0] - 12] : close.slice(0, 2)
        if (mode === 'harmony') harm = lvl < 2 ? [] : lvl === 2 ? close.slice(0, 2) : [...close.slice(0, 2), scaleStep(CH[name].bass + 24, sc, 1)]
        const lowOn = mode !== 'harmony' || harmLvl >= 1
        const soft = (n.lv > 0 ? 0.7 : 1) * acc * (ans ? 0.85 : 1)
        let voices
        if (ans === 1) voices = [[['sso_hn', 0.45, 6, 0.6], lead - 12], [['sso_tb', 0.4, 10, 0.65], lead - 12],
          ...(lvl >= 2 ? close.slice(0, 2).map(x => [['sso_hn', 0.35, 8, 0.6], x - 12]) : [])]
        else if (ans === 2) voices = [[['sso_tp', 0.3, 5, 0.35], lead + 12]]
        else if (mode === 'answer') voices = [[ENS.lead[0], lead], [ENS.dbl[0], lead]]
        else voices = [...ENS.lead.map(x => [x, lead]), ...(lowOn ? ENS.low.map(x => [x, lead - 12]) : []), ...ENS.dbl.map(x => [x, lead]),
          ...harm.flatMap(x => ENS.harm.map(y => [y, x])), ...(lift > 0.5 ? [[ENS.lead[0], lead + 12]] : [])]
        for (const [[s0, g, ms, pan], note] of voices) {
          if (note === undefined || Number.isNaN(note)) continue
          const [s, g2] = held ? SUS[s0] : [s0, 1]
          const t0 = (kk + (ms + 8 * h.hash(k, note, s.length)) * MS) / 16   // never early (lost in the swing)
          if (t0 < b0 - 1e-9 || t0 >= e0 - 1e-9) continue
          out.push(new Hap(new TimeSpan(t0, t0 + base.dur / 16), new TimeSpan(t0, Math.min(t0 + base.dur / 16, e0)),
            { ...base, s, note, gain: g * g2 * soft * lg, pan }, {}))
        }
        // articulation level 3: a short fall on the last note of the 8-bar phrase
        if (artLvl >= 3 && p128 >= 120 && n.len >= 2 && !ans) {
          const t0 = (kk - 190 * MS) / 16
          if (t0 >= b0 - 1e-9 && t0 < e0 - 1e-9) out.push(new Hap(new TimeSpan(t0, t0 + 0.25), new TimeSpan(t0, Math.min(t0 + 0.25, e0)),
            { s: 'vs_fall', note: md(lead - 12 - 43, 12) + 43, gain: 0.8 * lg, attack: 0.01, release: 0.25, pan: 0.6 }, {}))
        }
      }
    }
    return out
  })
  const MODES = [['Mehr Schläge', 'hits'], ['Melodie', 'melody'], ['Phrasenende', 'fill'], ['Artikulation', 'artic'],
    ['Synkopen', 'sync'], ['Ruf + Antwort', 'answer'], ['Harmonik', 'harmony'], ['Kombiniert', 'combined']]
  return MODES.map(([name, mode], c) => ({ name, k3: 'own', k3name: 'Komplexität', b2: 'own', space: 'bus', floor: 0.3,
    hall: 2.5, range: [900, 8000], gain: 0.42, pats: FIG.map(([fname, L, notes]) => [fname, play(c, mode, L, notes)]) }))
}

// ============================================================
// ENGINE 3 — engine 2 + chord progressions over 8 bars (Mode 2 column 5 button 1, at the next 8-bar phrase; keys,
// bass and every chord-following voice go along) + “fire” buttons for interjections. Only the part above differs.
// Source: tools/stem-lab/engine3.strudel-part, copied in by sync.mjs (boards marked `// @engine 3`)
// ============================================================
const exp = (lo, hi) => v => lo * Math.pow(hi / lo, v)
const md = (k, n) => ((k % n) + n) % n
const clamp = (x, lo, hi) => Math.max(lo, Math.min(hi, x))
const hash = (a, b, c) => {
  let h = Math.imul(a + 0x9e3779b9 | 0, 0x85ebca6b) ^ Math.imul(b + 0x632be59b | 0, 0xc2b2ae35) ^ Math.imul(c + 0x27d4eb2f | 0, 0x165667b1)
  h ^= h >>> 15; h = Math.imul(h, 0x2c1b3c6d); h ^= h >>> 12; h = Math.imul(h, 0x297a2d39); h ^= h >>> 15
  return (h >>> 0) / 4294967296
}

// Harmony as in track 009: Am9 in Kerri Chandler's shape (G3 B3 C4 E4), D9 = F♯3 A3 C4 E4; the melody notes are the
// pentatonic of the chord (A minor pentatonic over Am9, D major pentatonic over D9, as PENTA in the track)
// More chords for the progressions (voiced around F3–E4 like the Kerri shape, mostly without the root; deg = the root as a
// scale degree counted by letter from A: A 0, B 1, C 2, D 3, E 4, F 5, G 6 — the same in A dorian and A aeolian)
const CH = {
  Am9: { name: 'Am9', bass: 33, deg: 0, keys: [55, 59, 60, 64] },
  D9: { name: 'D9', bass: 38, deg: 3, keys: [54, 57, 60, 64] },
  Am7: { name: 'Am7', bass: 33, deg: 0, keys: [55, 57, 60, 64] },
  Cmaj7: { name: 'Cmaj7', bass: 36, deg: 2, keys: [55, 59, 60, 64] },
  Cadd9: { name: 'Cadd9', bass: 36, deg: 2, keys: [55, 60, 62, 64] },
  Em7: { name: 'Em7', bass: 40, deg: 4, keys: [55, 59, 62, 64] },
  Fmaj7: { name: 'Fmaj7', bass: 41, deg: 5, keys: [53, 57, 60, 64] },
  Fadd9: { name: 'Fadd9', bass: 41, deg: 5, keys: [53, 55, 57, 60] },
  Gadd9: { name: 'Gadd9', bass: 43, deg: 6, keys: [55, 57, 59, 62] },
  G11: { name: 'G11', bass: 43, deg: 6, keys: [53, 55, 60, 62] },
  Dm7: { name: 'Dm7', bass: 38, deg: 3, keys: [53, 57, 60, 62] },
  D6: { name: 'D6', bass: 38, deg: 3, keys: [54, 57, 59, 62] },
  Bm7: { name: 'Bm7', bass: 35, deg: 1, keys: [54, 57, 59, 62] },
  // 2026-11-08 for progressions 17–21
  'G7/F': { name: 'G7/F', bass: 41, deg: 5, keys: [53, 55, 59, 62] },     // G7 over F (Modjo), F G B D
  G7sus2: { name: 'G7sus2', bass: 43, deg: 6, keys: [53, 55, 57, 62] },   // F G A D (Roger Sanchez)
  'Am/C': { name: 'Am/C', bass: 36, deg: 2, keys: [55, 57, 60, 64] },     // Am7 shape over C
}
// Progressions over 8 bars: [name = the chords, as on the buttons; bars, push, scale]; the record is in the comment. Sources: tracks/009-house/recherche-harmonie.md (round 1:
// Attack / MAW / Kerri; round 2: Hooktheory TheoryTabs of the records — chord order from there, BAR LENGTHS MINE).
// A bar is a chord name or [[name, 16ths], …]; push = how many 16ths early the next chord comes in (Kerri Chandler's
// push, 2 = an 8th); scale = the mode melodies use over it (dorian has F♯, aeolian F).
const x2 = bars => [...bars, ...bars]
const HARMONIES = [
  // a board's button 1 steps through them (PROG_NEXT) or picks 1–8 directly (PROG_KEYS); Mode 2 col. 5: next / previous
  ['Am9 D9', x2(['Am9', 'Am9', 'D9', 'D9']), 2, 'dorian'],                         // track 009 as it is
  ['Am7 C Em7', x2(['Am7', 'Am7', 'Cmaj7', 'Em7']), 2, 'dorian'],                // To Be In Love
  ['Am7 D6 G', x2(['Am7', 'Am7', 'D6', 'Gadd9']), 2, 'dorian'],          // You Don't Know Me
  ['Am F G', x2(['Am9', 'Am9', 'Fmaj7', 'Gadd9']), 2, 'aeolian'],         // Can You Feel It
  ['F G Am', x2(['Fadd9', 'G11', 'Am9', 'Am9']), 2, 'aeolian'],             // Finally
  ['Em7 Fmaj7', ['Em7', 'Fmaj7', 'Em7', 'Fmaj7', 'Em7', 'Fmaj7', 'Em7', 'Am7'], 2, 'aeolian'],  // Music Sounds Better
  ['Fmaj7 G', x2(['Fmaj7', 'Fmaj7', 'Gadd9', 'Gadd9']), 2, 'aeolian'],        // One More Time
  ['F Am C Dm', ['Fmaj7', 'Fmaj7', 'Am7', 'Am7', 'Cmaj7', 'Cmaj7', 'Dm7', 'Dm7'], 2, 'aeolian'],  // Dreamer
  // 9–16
  ['Am9 C Bm C', x2(['Am9', 'Cadd9', 'Bm7', 'Cadd9']), 2, 'dorian'],    // Wishing I Were Home
  ['Am7 Dm7', x2(['Am7', 'Am7', 'Dm7', 'Dm7']), 2, 'aeolian'],            // Everybody Everybody
  ['C F Am Em', x2(['Cmaj7', 'Fadd9', 'Am7', 'Em7']), 2, 'aeolian'],  // Romeo (relative minor)
  ['F Em Am', x2(['Fmaj7', 'Em7', 'Am7', 'Am7']), 2, 'aeolian'],         // Make a Move on Me
  ['Am7 Em7 … D9', ['Am7', 'Am7', 'Em7', 'Em7', 'Am7', 'Am7', 'Em7', 'D9'], 2, 'dorian'],   // Attack Magazine example
  ['Am9 D9 (4+4)', ['Am9', 'Am9', 'Am9', 'Am9', 'D9', 'D9', 'D9', 'D9'], 2, 'dorian'],
  ['Am9 D9 (3/8+5/8)', Array(8).fill([['Am9', 6], ['D9', 10]]), 0, 'dorian'],
  ['Am9', Array(8).fill('Am9'), 2, 'dorian'],
  // 17–21 (2026-11-08): more classic house records from recherche-harmonie.md (Hooktheory / Attack), at the end so the
  // numbers of 1–16 stay; chord order from the sources, BAR LENGTHS MINE. Mode 2 col. 5 button 2 (previous) reaches them fast
  ['C F', x2(['Cmaj7', 'Cmaj7', 'Fmaj7', 'Fmaj7']), 2, 'aeolian'],            // Frankie Knuckles, The Whistle Song (relative)
  ['F Em Am G', x2(['Fmaj7', 'Em7', 'Am7', 'G11']), 2, 'aeolian'],            // Daft Punk, Digital Love (G7sus4 = G11 shape)
  ['Am G/F F Dm', ['Am9', 'Am7', 'G7/F', 'Fadd9', 'Dm7', 'Dm7', 'Am9', 'Am7'], 2, 'aeolian'],   // Modjo, Lady
  ['F C G Am', ['Fmaj7', 'Cmaj7', 'Fmaj7', 'G7sus2', 'Am7', 'G7sus2', 'Am7', 'Am/C'], 2, 'aeolian'],   // Roger Sanchez, Another Chance
  ['Em Am', x2(['Em7', 'Em7', 'Am9', 'Am9']), 2, 'aeolian'],                  // Kerri Chandler, Keep Me Inside
]
// each progression as 128 chord names, one per 16th
const H128 = HARMONIES.map(([, bars]) => bars.flatMap(b => typeof b === 'string' ? Array(16).fill(b)
  : b.flatMap(([n, len]) => Array(len).fill(n))))
const POOL = {}
const inRange = (pcs, lo, hi) => POOL[pcs.join() + ':' + lo + ':' + hi] ??= (() => {
  const o = []; for (let m = lo; m <= hi; m++) if (pcs.includes(md(m, 12))) o.push(m); return o })()
// A stab: the n lowest notes from `lo` up whose pitch classes are in the keys' voicing (Am9: E G B, D9: E F♯ A, …)
const stabOf = (c, lo, n) => inRange(c.keys.map(x => md(x, 12)), lo, lo + 24).slice(0, n)
// The chord as a pattern (one value per 16th): the voicing's notes from `lo` up, `n` of them. push: the last two 16ths
// of a bar already play the next bar's chord (Kerri Chandler's push, as the keys). chordName is defined below.
const CHORD_PATS = {}
// The chord at 16th k (absolute), with or without the progression's push
const chordAt = (k, push = true) => {
  const p = push ? HARMONIES[latch('harm', Math.floor(k / 16), 8)][2] : 0, kk = k + p
  return H128[latch('harm', Math.floor(kk / 16), 8)][md(kk, 128)]
}
const k16 = t => Math.round(t * 16)
const chordPat = (lo, n, push = true) => signal(t => chordAt(k16(t), push)).segment(16)
  .fmap(name => CHORD_PATS[name + lo + ':' + n] ??= note(stack(...stabOf(CH[name], lo, n)))).innerJoin()
// The chord's root as a MIDI note per 16th: oct 1 = the bass (A1 / C2 / D2 / E2), 2 = an octave up, …
const rootPat = (oct = 2, push = true) => signal(t => CH[chordAt(k16(t), push)].bass + 12 * (oct - 1)).segment(16)
// The chord's root as a scale degree of A dorian (A 0, C 2, D 3, E 4), per 16th
const rootDeg = (push = false) => signal(t => CH[chordAt(k16(t), push)].deg).segment(16)
// The progression's mode as a Strudel scale name per 16th, e.g. 'A3:aeolian' (for melodies: n(…).scale(h.scale(3)))
const scalePat = oct => signal(t => 'A' + oct + ':' + HARMONIES[latch('harm', Math.floor(k16(t) / 16), 8)][3]).segment(16)
// Held chords: one event per chord, as long as the chord lasts (at most 4 bars, then struck again), from `lo` up, n notes
const padPat = (lo, n, push = true) => new Pattern(state => {
  const b0 = state.span.begin.valueOf(), e0 = state.span.end.valueOf(), out = []
  // the chord sounding at 16th k starts at its change point c, struck again every 64 16ths after c
  const startOf = k => {
    const name = chordAt(k, push)
    let c = k
    while (c > k - 64 && chordAt(c - 1, push) === name) c--   // (CPU) no chord lasts longer than 4 bars but one
    if (c === k - 64) c = 64 * Math.floor(k / 64)   // no change in sight (one chord): strike on the 4-bar grid
    return c + 64 * Math.floor((k - c) / 64)
  }
  for (let s = startOf(Math.floor(b0 * 16)); s < e0 * 16;) {
    const name = chordAt(s, push)
    let e = s + 1
    while (e - s < 64 && chordAt(e, push) === name) e++
    const w0 = s / 16, w1 = e / 16, p0 = Math.max(w0, b0), p1 = Math.min(w1, e0)
    if (p1 > p0) for (const m of stabOf(CH[name], lo, n))
      out.push(new Hap(new TimeSpan(w0, w1), new TimeSpan(p0, p1), { note: m }, {}))
    s = e
  }
  return out
})
// A voice that follows the chord: idx = a pattern of indexes into the chord's notes from `lo` up (0 = lowest)
const arpPat = (lo, idx, push = true) => new Pattern(state => idx.query(state).map(h => h.withValue(i => {
  const notes = stabOf(CH[chordAt(k16(h.whole.begin.valueOf()), push)], lo, 8)
  return { note: notes[md(i, notes.length)] }
})))
// Live controls for boards whose row 3 / button 2 do their own job (column option k3 / b2 = 'own'):
// knob(cc) = the knob's value 0..1, held(cc) = 1 while the button is held (S is defined below; read at query time)
const knobSig = cc => signal(() => S.val[cc] ?? 0)
const heldSig = cc => signal(() => S.held[cc] ? 1 : 0)
// 0 → 1 over `bars` while the button is held (a ramp for risers / sweeps), 0 when released
const rampSig = (cc, bars) => signal(() => S.held[cc] ? Math.min(1, (performance.now() - (S.since?.[cc] ?? performance.now())) / (bars * 240000 / bpm)) : 0)
// Helpers handed to the board's makeCols
// fired(i, bar) = button 1 of column i (option b1: 'fire') was pressed for this bar; occurrence-free helpers for boards
const firedFor = (i, bar) => (S.fire?.[i] ?? null) === bar
const H = { chord: chordPat, pad: padPat, arp: arpPat, root: rootPat, rootDeg, scale: scalePat, chordAt, knob: knobSig, held: heldSig,
  ramp: rampSig, fired: firedFor, hash }
const COLS = makeCols(H)

// State survives re-evaluation. Mode 16: fader 5-12, knobs 13-36, buttons 37-52. Mode 2 = + 48.
const S = globalThis[BOARD.id] ??= { val: {}, held: {}, pend: {}, at: {}, seed: {} }
COLS.forEach((c, i) => { S.val[5 + i] ??= i === 0 ? 0.8 : 0; S.val[13 + i] ??= 0.6; S.val[21 + i] ??= 0; S.val[29 + i] ??= 0.3 })
S.val[58] ??= 0.6; S.val[66] ??= 0.3; S.val[59] ??= 0.6; S.val[60] ??= 0.5   // drums, swing, bass, keys
const swingPct = () => 0.5 + 0.2 * S.val[66]
const drumsLevel = () => S.held[98] ? 0 : S.val[58]
// A column's pattern list: [name, pattern]
const patsOf = i => COLS[i].pats
// A choice made now takes over at the next bar (len 8: at the next 8-bar phrase); fixed once a bar is first asked
const latch = (key, bar, len = 1) => {
  const b = Math.floor(bar / len), m = S.at[key] ??= {}
  if (!(b in m)) { m[b] = S.pend[key] ?? 0; for (const x in m) if (+x < b - 8) delete m[x] }
  return m[b]
}
const latchNow = key => { const m = S.at[key] ?? {}, ks = Object.keys(m).map(Number); return ks.length ? m[Math.max(...ks)] : 0 }
const hasPage = typeof document !== 'undefined' && !!document.createElement
const isLCXL = port => /LCXL|Launch Control/i.test(port.name) && !/DAW/i.test(port.name)
const access = hasPage && navigator.requestMIDIAccess ? await navigator.requestMIDIAccess() : null
if (access && globalThis.knobsSyncedFor !== BOARD.id) {
  const out = [...access.outputs.values()].find(isLCXL)
  if (out) {
    for (let cc = 13; cc <= 36; cc++) out.send([0xBF, cc, Math.round((S.val[cc] ?? 0) * 127)])
    globalThis.knobsSyncedFor = BOARD.id
  }
}

// Status box (bottom right) with the dashboard link; other boards' boxes are removed
let statusBox = null, statusText = null
if (hasPage) {
  for (const id of ['board-status', 'keys-lab-status', 'stem-lab-status']) document.getElementById(id)?.remove()
  statusBox = document.createElement('div')
  statusBox.id = 'stem-lab-status'
  statusBox.style.cssText = 'position:fixed;right:12px;bottom:12px;z-index:1000;padding:8px 12px;' +
    'background:rgba(0,0,0,.75);border-radius:6px'
  statusText = document.createElement('pre')
  statusText.style.cssText = 'margin:0;color:#eee;font:13px/1.5 monospace'
  statusBox.append(statusText)
  document.body.appendChild(statusBox)
}
const beatNow = { bar: null, beat: null }
const pct = v => Math.round((v ?? 0) * 100)
const harmNow = () => latchNow('harm')

// DASHBOARD — a big window with every control of Mode 16 and the Mode 2 context on top. The link opens a tab named
// stem-lab-view; strudel.cc replaces window.open, so the handle comes from the native open of a hidden iframe.
const view = !hasPage ? null : globalThis.stemLabView ??= { win: null }
const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c])
const VIEW_CSS = [
  'html,body{margin:0;height:100%;background:#111;color:#eee;font:clamp(12px,1.25vw,24px)/1.3 system-ui,sans-serif}',
  '#lc{display:flex;flex-direction:column;gap:1vh;padding:1.5vh 1.5vw;box-sizing:border-box;height:100%;overflow:hidden}',
  '.head{display:flex;gap:2.5vw;align-items:center;flex-wrap:wrap}.head h1{margin:0;font-size:1.6em;color:#50c8e8}',
  '.k{opacity:.6;margin-right:.4em}.next,.acc{color:#50c8e8}',
  '.grid{flex:1;display:grid;grid-template-columns:repeat(' + COLS.length + ',1fr);grid-template-rows:auto repeat(3,minmax(0,1fr)) minmax(0,1.4fr) 4.6em 3em;gap:.8vh .8vw}',
  '.col{text-align:center;font-weight:600;padding:.3em;border-bottom:2px solid #333}.col.live{color:#50c8e8;border-color:#50c8e8}',
  '.cell{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:.1em;min-width:0;min-height:0}',
  '.cell span,.cell b{max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cell span{opacity:.7;font-size:.85em}.cell b{font-variant-numeric:tabular-nums}',
  '.dial{width:min(5vw,6.5vh);aspect-ratio:1;border-radius:50%;',
  'background:conic-gradient(from -135deg,#50c8e8 0 calc(var(--v)*270deg),#333 0 270deg,transparent 0);',
  '-webkit-mask:radial-gradient(circle,transparent 52%,#000 54%);mask:radial-gradient(circle,transparent 52%,#000 54%)}',
  '.bar{position:relative;width:1.4vw;min-width:14px;flex:1;min-height:40px;background:#333;border-radius:4px;overflow:hidden}',
  '.bar i{position:absolute;left:0;right:0;bottom:0;height:calc(var(--v)*100%);background:#50c8e8}',
  '.btn{background:#222;border-radius:6px;padding:.5em .3em;justify-content:flex-start;overflow:hidden}.btn.on{background:#50c8e8;color:#111}',
  '.pat{font:.7em monospace;letter-spacing:.03em;opacity:.85;overflow-wrap:anywhere}',
  '.beats i,.bars i{display:inline-block;background:#333;margin-left:.3em}.beats i{width:.75em;height:.75em;border-radius:50%}',
  '.bars i{width:1.1em;height:.55em;border-radius:2px}.beats i.on,.bars i.on{background:#50c8e8}',
].join('\n')
const pending = (now, next) => esc(now) + (next !== now ? '<span class=next> → ' + esc(next) + '</span>' : '')
const drawView = () => {
  if (!view?.win || view.win.closed) return
  const root = view.win.document.getElementById('lc')
  if (!root) return
  const h = harmNow(), hp = S.pend.harm ?? 0
  const marks = (n, on) => [...Array(n).keys()].map(k => '<i' + (k === on ? ' class=on' : '') + '></i>').join('')
  const bar = beatNow.bar
  const where = bar === null ? '–' : '<span class=bars>' + marks(8, md(bar, 8)) + '</span><span class=beats>' +
    marks(4, beatNow.beat) + '</span> <b class=acc>' + esc(chordAt(bar * 16 + 4 * beatNow.beat, false)) + '</b>'
  const knob = (v, name) => '<div class="cell knob"><div class=dial style="--v:' + (v ?? 0) + '"></div><b>' + pct(v) +
    '</b><span>' + esc(name) + '</span></div>'
  const cells = COLS.map((c, i) => {
    const now = latchNow(i), next = S.pend[i] ?? 0, pats = patsOf(i)
    return {
      k1: knob(S.val[13 + i], 'Hell'), k2: knob(S.val[21 + i], c.k2name ?? 'Raum'), k3: knob(S.val[29 + i], c.k3name ?? 'Länge'),
      fader: '<div class="cell fader"><div class=bar style="--v:' + (S.val[5 + i] ?? 0) + '"><i></i></div><b>' +
        pct(S.val[5 + i]) + '</b><span>Pegel</span></div>',
      b1: typeof PROG_NEXT !== 'undefined' && PROG_NEXT.includes(37 + i) ? '<div class="cell btn"><b>' +
        pending(HARMONIES[harmNow()][0], HARMONIES[S.pend.harm ?? 0][0]) + '</b></div>' :
        typeof PROG_KEYS !== 'undefined' && PROG_KEYS.includes(37 + i) ? '<div class="cell btn' +
        (harmNow() === PROG_KEYS.indexOf(37 + i) ? ' on' : '') + '"><b>' +
        pending(HARMONIES[PROG_KEYS.indexOf(37 + i)][0], HARMONIES[PROG_KEYS.indexOf(37 + i)][0]) +
        ((S.pend.harm ?? 0) === PROG_KEYS.indexOf(37 + i) && harmNow() !== PROG_KEYS.indexOf(37 + i) ? '<span class=next> ←</span>' : '') + '</b></div>' :
        c.b1 === 'fire' ? '<div class="cell btn' + (S.fire?.[i] != null && S.fire[i] >= (beatNow.bar ?? 0) ? ' on' : '') +
        '"><b>' + esc(c.b1name ?? 'Jetzt!') + '</b></div>' : '<div class="cell btn"><b>' + pending(pats[now][0], pats[next][0]) + '</b></div>',
      b2: '<div class="cell btn' + (S.held[45 + i] ? ' on' : '') + '"><b>' + esc(c.b2name ?? 'Echo-Wurf') + '</b></div>',
    }
  })
  root.innerHTML = '<div class=head><h1>' + esc(BOARD.title) + '</h1>' +
    '<div><span class=k>Harmonie</span>' + pending(HARMONIES[h][0], HARMONIES[hp][0]) + '</div>' +
    '<div><span class=k>Takt</span>' + where + '</div>' +
    '<div><span class=k>Drums</span>' + (S.held[98] ? '<b class=acc>AUS</b>' : pct(drumsLevel())) + '</div>' +
    '<div><span class=k>Swing</span>' + pct(swingPct()) + ' %</div><div><span class=k>Bass</span>' + pct(S.val[59]) +
    '</div><div><span class=k>Keys</span>' + pct(S.val[60]) + '</div></div>' +
    '<div class=grid>' +
    COLS.map((c, i) => '<div class="col' + ((S.val[5 + i] ?? 0) > 0 ? ' live' : '') + '">' + (i + 1) + ' ' + esc(c.name) + '</div>').join('') +
    ['k1', 'k2', 'k3', 'fader', 'b1', 'b2'].map(r => cells.map(c => c[r]).join('')).join('') + '</div>'
}
if (view) {
  for (const old of document.querySelectorAll('a')) if (old.target === 'stem-lab-view' || old.target === 'keys-lab-view') old.remove()
  view.opener ??= (() => { const f = document.createElement('iframe'); f.style.display = 'none'; document.body.append(f); return f })()
  const link = document.createElement('a')
  link.textContent = '▣ LC groß'
  link.href = 'about:blank'
  link.target = 'stem-lab-view'
  link.style.cssText = 'display:inline-block;margin-top:6px;padding:1px 6px;font:12px sans-serif;color:#000;' +
    'background:#ddd;border-radius:3px;text-decoration:none;cursor:pointer'
  link.onclick = () => setTimeout(() => {
    try {
      const w = view.opener.contentWindow.open('', 'stem-lab-view')
      if (!w) { link.textContent = '▣ LC groß (Tab nicht gefunden)'; return }
      view.win = w
      w.document.title = BOARD.title
      w.document.head.innerHTML = '<style>' + VIEW_CSS + '</style>'
      w.document.body.innerHTML = '<div id=lc></div>'
      drawView()
    } catch (e) { link.textContent = '▣ LC groß: ' + e.message; console.error(e) }
  }, 100)
  statusBox.append(link)
  if (view.win && !view.win.closed) {
    view.win.document.title = BOARD.title
    view.win.document.head.innerHTML = '<style>' + VIEW_CSS + '</style>'
    if (!view.win.document.getElementById('lc')) view.win.document.body.innerHTML = '<div id=lc></div>'
  }
}
const showStatus = () => {
  if (statusText) {
    const h = harmNow(), hp = S.pend.harm ?? 0
    statusText.textContent = [
      BOARD.title + ' · Harmonie ' + HARMONIES[h][0] + (hp !== h ? ' → ' + HARMONIES[hp][0] : ''),
      'Drums ' + (S.held[98] ? 'AUS' : pct(drumsLevel())) + ' · Swing ' + pct(swingPct()) + ' % · Bass ' + pct(S.val[59]) +
        ' · Keys ' + pct(S.val[60]) + ' · ' + bpm + ' BPM',
      '',
      ...COLS.map((c, i) => {
        const now = latchNow(i), next = S.pend[i] ?? 0, pats = patsOf(i)
        return (i + 1) + ' ' + c.name.padEnd(18) + ('Pegel ' + pct(S.val[5 + i])).padEnd(10) +
          (c.b1 === 'fire' ? '' : pats[now][0] + (next !== now ? ' → ' + pats[next][0] : ''))
      }),
    ].join('\n')
  }
  drawView()
}
const onMidi = e => {
  const [status, cc, value] = e.data
  if ((status & 0xf0) !== 0xb0) return
  if ((cc >= 5 && cc <= 36) || (cc >= 53 && cc <= 84)) S.val[cc] = value / 127
  else if (typeof PROG_NEXT !== 'undefined' && PROG_NEXT.includes(cc)) {   // a board's “next progression” buttons
    if (value > 63 && !S.held[cc]) { S.pend.harm = ((S.pend.harm ?? 0) + 1) % HARMONIES.length; S.held[cc] = true; showStatus() }
    else if (value <= 63) S.held[cc] = false
    return
  }
  else if (typeof PROG_KEYS !== 'undefined' && PROG_KEYS.includes(cc)) {   // a board's direct progression buttons
    if (value > 63 && !S.held[cc]) { S.pend.harm = PROG_KEYS.indexOf(cc); S.held[cc] = true; showStatus() }
    else if (value <= 63) S.held[cc] = false
    return
  }
  else if (cc === 97) {   // Mode 2 column 5 button 2: previous progression (on press)
    if (value > 63 && !S.held[97]) { S.pend.harm = ((S.pend.harm ?? 0) - 1 + HARMONIES.length) % HARMONIES.length; S.held[97] = true; showStatus() }
    else if (value <= 63) S.held[97] = false
    return
  }
  else if ((cc >= 45 && cc <= 52) || (cc >= 93 && cc <= 100)) {
    if (value > 63 && !S.held[cc]) (S.since ??= {})[cc] = performance.now()   // when it was pressed (for ramps)
    S.held[cc] = value > 63
  }
  else if (value === 0) return
  else if (cc >= 37 && cc <= 44) {
    const i = cc - 37
    if (!COLS[i]) return
    if (COLS[i].b1 === 'fire') {
      // fire at the column's step (fireAt, default 14 = the “and” of beat 4) of this bar, or of the next bar when too late
      const at = COLS[i].fireAt ?? 14, bar = beatNow.bar ?? 0, step = 4 * (beatNow.beat ?? 0)
      ;(S.fire ??= {})[i] = step + 2 < at ? bar : bar + 1
    } else S.pend[i] = ((S.pend[i] ?? 0) + 1) % patsOf(i).length
  }
  else if (cc === 89) S.pend.harm = ((S.pend.harm ?? 0) + 1) % HARMONIES.length
  else return
  showStatus()
}
if (access) for (const input of access.inputs.values()) {
  if (!isLCXL(input)) continue
  if (globalThis.boardListener) input.removeEventListener('midimessage', globalThis.boardListener)
  input.addEventListener('midimessage', onMidi)
}
globalThis.boardListener = onMidi
showStatus()

// 16 steps per bar; fn(step, bar, k) returns events with dur in 16ths; swing moves the odd 16ths late
const grid = fn => new Pattern(state => {
  const b0 = state.span.begin.valueOf(), e0 = state.span.end.valueOf(), out = []
  const late = k => md(k, 2) === 1 ? 2 * (swingPct() - 0.5) : 0
  for (let k = Math.floor(b0 * 16) - 1; k < e0 * 16 + 1; k++) {
    const t0 = (k + late(k)) / 16
    if (t0 < b0 - 1 / 16 || t0 >= e0 + 1 / 16) continue
    for (const { dur = 1, ...v } of fn(md(k, 16), Math.floor(k / 16), k) ?? []) {
      if (t0 < b0 - 1e-9 || t0 >= e0 - 1e-9) continue
      out.push(new Hap(new TimeSpan(t0, t0 + dur / 16), new TimeSpan(t0, Math.min(t0 + dur / 16, e0)), v, {}))
    }
  }
  return out
})
const chordName = bar => chordAt(bar * 16, false)

// A column: the pattern picked by button 1 (taking over at the next bar), swung like the drums, then the channel
// strip per event from the knobs: Brightness = low-pass over the column's range (brighter also ±2 dB louder), Space =
// a 1/8 echo first, the room from 0.35 on, Length = note length ×0.5 … ×4 (clip), Level = fader, button 2 held = echo
// throw (dotted 8th, long tail). A voice may carry `bright` (a factor on its cutoff, e.g. for accents); a voice's own
// low-pass (e.g. a recipe's lpf) is kept when it is lower than the Brightness knob's.
const column = i => {
  const c = COLS[i], built = c.pats.map(([, p]) => p)
  // gate (CPU): a column whose fader is at 0 is not queried at all; checked per 16th, so it starts right away
  const sel = signal(t => (S.val[5 + i] ?? 0) > 0 ? latch(i, Math.floor(t)) : -1).segment(16)
  return sel.fmap(p => p < 0 ? silence : built[p]).innerJoin()
    .swingBy(signal(() => 2 * (swingPct() - 0.5)), 8)
    .filterValues(() => (S.val[5 + i] ?? 0) > 0)
    .fmap(({ bright = 1, ...v }) => {
      const level = S.val[5 + i] ?? 0, br = S.val[13 + i] ?? 0.6, sp = S.val[21 + i] ?? 0, ln = S.val[29 + i] ?? 0.3
      const [clo, chi] = c.range ?? [300, 8000]
      let room, ef
      if (c.space === 'bus') {
        // as the tracks' bus(): the voice's own echo amount × 2 × space, space never below the column's floor (a
        // little room even at 0), dotted-8th echo with a long tail; room 0.9 × space
        const s2 = (c.floor ?? 0.3) + (1 - (c.floor ?? 0.3)) * sp
        room = 0.9 * s2
        ef = { delay: Math.min(0.9, (v.delay ?? 0) * 2 * s2), delaytime: 0.75 * 60 / bpm, delayfeedback: 0.55 }
      } else {
        room = 0.8 * Math.max(0, (sp - 0.35) / 0.65)
        const ev = sp > 0 ? Math.min(1, 0.4 + 1.2 * sp) : 0
        ef = ev > 0 ? { delay: 0.6 * ev, delaytime: 30 / bpm, delayfeedback: 0.15 + 0.35 * ev } : {}
      }
      const fx = c.b2 !== 'own' && S.held[45 + i] ? { delay: 0.65, delaytime: 0.75 * 60 / bpm, delayfeedback: 0.62 } : {}
      const clip = c.k3 === 'own' ? {} : { clip: (v.clip ?? 1) * (c.len ?? 1) * exp(0.5, 4)(ln) }
      return { release: 0.1, ...v, cutoff: Math.min(18000, v.cutoff ?? 18000, exp(clo, chi)(br) * bright), room, roomsize: c.hall ?? 2,
        ...clip, postgain: level * Math.pow(10, 4 * (br - 0.5) / 20) * (c.gain ?? 1), ...ef, ...fx, orbit: 3 }
    })
}

// Context: a dry house loop (909 kick, off-beat open hat, clap on 2 and 4, quiet shaker), the bass on the root and
// the keys of 009 (Steinway + Rhodes Mark I half each, Kerri voicing, the chain rhythm with push)
const JRH = 'https://raw.githubusercontent.com/sfzinstruments/jlearman.jRhodes3d/master/jRhodes3d-mono/'
const OWN = 'https://raw.githubusercontent.com/hallfjonas/cerulean-echoes/johannes/samples/vcsl-keys/'
const notesMap = (keys, file) => Object.fromEntries(keys.map(k => [k.toLowerCase(), file(k)]))
if (typeof samples === 'function') await samples({
  stein: notesMap(['F#3', 'G#3', 'A#3', 'C4', 'D4', 'E4'], k => OWN + 'JHPiano_Sus_Close_' + k.replace('#', '%23') + '_vl3_rr1.flac'),
  jrh: notesMap(['G3', 'B3', 'D4', 'F4'], k => JRH + { G3: 'A_055__G3', B3: 'A_059__B3', D4: 'A_062__D4', F4: 'A_065__F4' }[k] + '_3.flac'),
})
const KEYS_PAT = '.x..x..x.x..x..x'
const context = grid((step, bar) => {
  const out = [], l = drumsLevel(), bl = S.val[59], kl = S.val[60]
  const next = CH[chordAt(bar * 16 + step, true)]
  if (l > 0) {
    if (step % 4 === 0) out.push({ s: 'bd', bank: 'RolandTR909', gain: 0.6, decay: 0.25, sustain: 0, postgain: l })
    if (step % 4 === 2) out.push({ s: 'oh', bank: 'RolandTR909', gain: 0.3, decay: 0.12, sustain: 0, postgain: l })
    if (step === 4 || step === 12) out.push({ s: 'cp', bank: 'RolandTR909', gain: 0.5, postgain: l })
    out.push({ s: 'sh', bank: 'RolandTR727', n: 1, gain: step % 2 ? 0.3 : 0.18, postgain: l })
  }
  if (bl > 0 && step % 4 === 2) out.push({ s: 'triangle', note: next.bass, gain: 0.45,
    decay: 0.15, sustain: 0.3, release: 0.05, cutoff: 900, postgain: bl, dur: 1.5 })
  if (kl > 0 && KEYS_PAT[step] === 'x') for (const n of next.keys) out.push(
    { s: 'stein', note: n, gain: 0.6 * 0.49 / 0.955 * 0.99 * 0.707, cutoff: 2800, postgain: kl, dur: 1.2, release: 0.15 },
    { s: 'jrh', note: n, gain: 0.6 * 0.292 / 0.955 * 0.902 * 0.707, cutoff: 1100, postgain: kl, dur: 1.2, release: 0.15 })
  return out.map(v => ({ ...v, orbit: 1 }))
})

const beatTick = pure(0).segment(4).fmap(() => ({})).onTrigger((hap, now, cps, t) => {
  const pos = hap.whole.begin.valueOf(), bar = Math.floor(pos + 1e-9), b = Math.floor((pos - bar) * 4 + 1e-9)
  setTimeout(() => { beatNow.bar = bar; beatNow.beat = b; showStatus() }, Math.max(0, (t - now) * 1000))
}, true)
setcpm(bpm / 4)

// A board may define MASTER(pattern) (e.g. a filter on everything, FX lab); it gets columns + context
const master = typeof MASTER === 'function' ? MASTER : (p => p)
stack(master(stack(...COLS.map((_, i) => column(i)), context)))
  .filterValues(v => (v.gain ?? 1) * (v.postgain ?? 1) > 0)   // safety net: drop anything that is silent anyway
  .stack(beatTick)   // silent, after the safety net: moves the dashboard and the status box with the beat
