// ============================================================
// HOUSE PIANO LAB: seven keyboard sounds × six iconic house riffs × three progressions, over a dry house loop
// ============================================================
// Question behind this board: what makes house piano classy and happy instead of “trembling chords”? Three things:
// the SOUND (a bright, slightly thin piano, often layered: the Korg M1 sound of the 90s; or Rhodes / organ),
// the RHYTHM (short, syncopated stabs with gaps, pushes before the beat, call and response: not held chords) and
// the CHORDS (7ths and 9ths, voiced close together in the middle of the keyboard, the top note singing).
// Columns 1-7 = sounds (samples: the Salamander grand and General MIDI soundfonts), column 8 = riff, progression,
// swing and the context loop. All dry by default: classy house is dry; the room comes with each sound's Space knob.
//
// Launch Control XL 3 in Custom Mode 16 (channel 16). Columns 1-7: fader = level, knob 1 = brightness,
// knob 2 = space, knob 3 = length, button 1 = solo (press again = all), button 2 = the sound's switch.
// Column 8: fader = context loop, knob 1 = swing, knob 2 = humanize, button 1 = riff, button 2 = progression.
// @layout House Piano Lab (lab/stems)
// @note Seven keyboard sounds, six iconic house riffs, three progressions, over a dry house loop. Pull up one sound at a time, change the riff (column 8, button 1) and hear what the rhythm does.
// @note Classy house is dry: start with every Space at 0. Swing (column 8, knob 1) at 55-60 % gives the MPC feel.
// @note The status box at the bottom right shows sound, riff, progression and chords.
// @guide The sound | The 90s house piano is the Korg M1 “Piano 8'”: a bright, thin, compressed piano, a little chorus, often an organ underneath (column 2 imitates it). Deep house uses Rhodes (3) or the DX e-piano (4); organ stabs (5) are the other 90s classic.
// @guide The rhythm | House piano is a drum: short stabs, gaps, hits before the beat (the “push”). 3-3-2 stabs, off-beats, a two-bar call and response, a rolling gospel left hand, one big chord as a throw-in. Held chords for whole bars sound like a pad, not like house.
// @guide The chords | 7ths and 9ths (Amaj7, F♯m7, Am9, D9), close together around middle C, so the chords move by small steps. Happy = major 7ths. Deep = a minor 9 / dominant 9 vamp (Dorian). Italo = plain triads, big and bright.
// @guide What to try | Riff 1 with the M1 sound (2), then the same riff with Rhodes (3): same notes, different decade. Riff 5 (throw-in) shows how much a gap is worth. Then swing up to 58 % and humanize a little.
// @mode 16 Mode 16 — House Piano Lab
// @col 16:1 1 Grand, dry
// @col 16:2 2 M1 style (90s)
// @col 16:3 3 Rhodes (deep)
// @col 16:4 4 DX e-piano
// @col 16:5 5 Organ stab
// @col 16:6 6 Clavinet
// @col 16:7 7 Vibraphone
// @col 16:8 8 Riff + context

const exp = (lo, hi) => v => lo * Math.pow(hi / lo, v)
const lin = (lo, hi) => v => lo + (hi - lo) * v
const ms  = x => x < 1 ? Math.round(x * 1000) + ' ms' : x.toFixed(2) + ' s'
const hz  = x => x < 1000 ? Math.round(x) + ' Hz' : (x / 1000).toFixed(1) + ' kHz'
const num = d => x => x.toFixed(d)
const hash = (k, salt = 0) => { const x = Math.sin(k * 12.9898 + salt * 78.233) * 43758.5453; return x - Math.floor(x) }

// Every sound has the same three knobs (brightness, space, length); each sound its own range and switch.
// voice(note, g, alt, len) → events for one note. len = note length in seconds from knob 3.
const KNOBS = (lpf, len) => [['Hell', 0.6, exp(...lpf), hz], ['Raum', 0, lin(0, 0.8), num(2)], ['Länge', 0.4, exp(...len), ms]]
const SOUNDS = [
  { name: 'Flügel trocken', alt: 'Oktave oben', knobs: KNOBS([1500, 14000], [0.15, 1.5]),
    // @ctl 16:1.k1 Brightness | 1.5–14 kHz low-pass.
    // @ctl 16:1.k2 Space | 0 = dry ↔ a room.
    // @ctl 16:1.k3 Length | 150 ms–1.5 s: short stabs ↔ ringing.
    // @ctl 16:1.fader Level | the Salamander grand, dry, the low end cut (the bass has it).
    // @ctl 16:1.b2 Octave up | on: top note doubled an octave up.
    voice: (note, g, alt, len) => [{ s: 'piano', note, gain: 0.7 * g, decay: len, sustain: 0, release: 0.4 * len, hcutoff: 140 }] },
  { name: 'M1-Stil (90er)', alt: 'Orgel darunter', knobs: KNOBS([2000, 14000], [0.12, 1]),
    // @ctl 16:2.k1 Brightness | 2–14 kHz low-pass.
    // @ctl 16:2.k2 Space | 0 = dry ↔ a room.
    // @ctl 16:2.k3 Length | 120 ms–1 s.
    // @ctl 16:2.fader Level | the 90s house piano: grand + DX e-piano + a detuned copy, thin and bright, a little saturated.
    // @ctl 16:2.b2 Organ under | on: a quiet organ layer (M1 feel).
    voice: (note, g, alt, len) => {
      const env = { decay: len, sustain: 0, release: 0.3 * len, hcutoff: 280, shape: 0.15 }
      return [{ s: 'piano', note, gain: 0.55 * g, ...env }, { s: 'piano', note: note + 0.1, gain: 0.3 * g, ...env, pan: 0.65 },
        { s: 'gm_epiano2', note: note + 12, gain: 0.18 * g, ...env, pan: 0.35 },
        ...(alt ? [{ s: 'gm_drawbar_organ', note, gain: 0.2 * g, decay: len, sustain: 0.3, release: 0.1 }] : [])]
    } },
  { name: 'Rhodes (Deep House)', alt: 'Phaser', knobs: KNOBS([800, 9000], [0.2, 2]),
    // @ctl 16:3.k1 Brightness | 800 Hz–9 kHz low-pass: warm ↔ barking.
    // @ctl 16:3.k2 Space | 0 = dry ↔ a room.
    // @ctl 16:3.k3 Length | 200 ms–2 s.
    // @ctl 16:3.fader Level | Rhodes (soundfont): the warm, round keys of deep house.
    // @ctl 16:3.b2 Phaser | on: a slow phaser, the 70s / Larry Heard swirl.
    voice: (note, g, alt, len) => [{ s: 'gm_epiano1', note, gain: 0.8 * g, decay: len, sustain: 0.1, release: 0.3 * len,
      ...(alt ? { phaserrate: 0.5, phaserdepth: 0.6 } : {}) }] },
  { name: 'DX-E-Piano', alt: 'Chorus', knobs: KNOBS([1500, 12000], [0.15, 1.5]),
    // @ctl 16:4.k1 Brightness | 1.5–12 kHz low-pass.
    // @ctl 16:4.k2 Space | 0 = dry ↔ a room.
    // @ctl 16:4.k3 Length | 150 ms–1.5 s.
    // @ctl 16:4.fader Level | the FM e-piano of the 80s (DX7 style): glassy, bell-like, very house.
    // @ctl 16:4.b2 Chorus | on: a detuned copy, wider and shimmering.
    voice: (note, g, alt, len) => [{ s: 'gm_epiano2', note, gain: 0.75 * g, decay: len, sustain: 0.05, release: 0.3 * len },
      ...(alt ? [{ s: 'gm_epiano2', note: note + 0.12, gain: 0.4 * g, decay: len, sustain: 0.05, release: 0.3 * len, pan: 0.8 }] : [])] },
  { name: 'Orgel-Stab (90er)', alt: 'Drawbar', knobs: KNOBS([1000, 10000], [0.08, 0.6]),
    // @ctl 16:5.k1 Brightness | 1–10 kHz low-pass.
    // @ctl 16:5.k2 Space | 0 = dry ↔ a room.
    // @ctl 16:5.k3 Length | 80–600 ms: organ stabs are short.
    // @ctl 16:5.fader Level | the percussive organ of 90s house: short, clicky stabs.
    // @ctl 16:5.b2 Drawbar | on: drawbar organ, rounder, gospel.
    voice: (note, g, alt, len) => [{ s: alt ? 'gm_drawbar_organ' : 'gm_percussive_organ', note, gain: 0.6 * g, decay: len, sustain: 0, release: 0.05 }] },
  { name: 'Clavinet (Funk)', alt: 'Wah', knobs: KNOBS([1500, 12000], [0.06, 0.5]),
    // @ctl 16:6.k1 Brightness | 1.5–12 kHz low-pass.
    // @ctl 16:6.k2 Space | 0 = dry ↔ a room.
    // @ctl 16:6.k3 Length | 60–500 ms.
    // @ctl 16:6.fader Level | Clavinet: funky, plucked, for disco and funky house.
    // @ctl 16:6.b2 Wah | on: an auto-wah on every note.
    voice: (note, g, alt, len) => [{ s: 'gm_clavinet', note, gain: 0.6 * g, decay: len, sustain: 0, release: 0.05,
      ...(alt ? { lpenv: 3, lpdecay: 0.12, resonance: 10 } : {}) }] },
  { name: 'Vibraphon', alt: 'Marimba', knobs: KNOBS([1500, 12000], [0.2, 2]),
    // @ctl 16:7.k1 Brightness | 1.5–12 kHz low-pass.
    // @ctl 16:7.k2 Space | 0 = dry ↔ a room.
    // @ctl 16:7.k3 Length | 200 ms–2 s.
    // @ctl 16:7.fader Level | vibraphone: soft, jazzy, deep house of the late 80s.
    // @ctl 16:7.b2 Marimba | on: marimba instead, woody and dry.
    voice: (note, g, alt, len) => [{ s: alt ? 'gm_marimba' : 'gm_vibraphone', note, gain: 0.7 * g, decay: len, sustain: 0, release: 0.3 * len }] },
]
// @ctl 16:1.b1 Solo | only this sound; press again = all.
// @ctl 16:2.b1 Solo | only this sound; press again = all.
// @ctl 16:3.b1 Solo | only this sound; press again = all.
// @ctl 16:4.b1 Solo | only this sound; press again = all.
// @ctl 16:5.b1 Solo | only this sound; press again = all.
// @ctl 16:6.b1 Solo | only this sound; press again = all.
// @ctl 16:7.b1 Solo | only this sound; press again = all.
// @ctl 16:8.k1 Swing | 50 % (straight) ↔ 70 %: the in-between 16ths come late (MPC swing; 55–60 % = classic house).
// @ctl 16:8.k2 Humanize | 0 = every hit equally loud ↔ played by hand (loose velocities).
// @ctl 16:8.fader Context | a dry house loop: 909 kick, off-beat hat, clap, shaker, bass on the chord root.
// @ctl 16:8.b1 Riff | stabs, off-beat, call, gospel, throw-in, anthem.
// @ctl 16:8.b2 Progression | happy → deep → Italo.

// Riffs over 2 bars (32 sixteenths): x = chord, g = quiet ghost chord, t = top note alone, u = the chord tone above
// the top (the melody steps up), L = left hand: the root in octaves, low. '.' = rest.
const RIFFS = [
  ['3-3-2-Stabs',      'x..x..x...x..x.. x..x..x...x.x...'],
  ['Offbeat',          '..x...x...x...x. ..x...x...x...xg'],
  ['Ruf & Antwort',    'x..x..x......... ..t.t.u...t.....'],
  ['Gospel-Roll',      'L.x.gx.x.Lx.gx.x L.x.gx.xL.x.gxgx'],
  ['Einwurf',          'x............... ..........x..x..'],
  ['8tel-Hymne',       'x.g.x.g.x.g.x.g. x.g.x.g.x.g.x.gx'],
].map(([name, s]) => [name, [...s.replace(/ /g, '')]])
// Progressions: one chord per bar; pcs = pitch classes (0 = C) of the right hand, root = for the left hand and bass
const PROGS = [
  ['Happy', [['Amaj7', 9, [9, 1, 4, 8]], ['F♯m7', 6, [6, 9, 1, 4]], ['Dmaj7', 2, [2, 6, 9, 1]], ['E6', 4, [4, 8, 11, 1]]]],
  ['Deep',  [['Am9', 9, [0, 4, 7, 11]], ['D9', 2, [6, 9, 0, 4]], ['Am9', 9, [0, 4, 7, 11]], ['D9', 2, [6, 9, 0, 4]]]],
  ['Italo', [['F♯m', 6, [6, 9, 1]], ['D', 2, [2, 6, 9]], ['A', 9, [9, 1, 4]], ['E', 4, [4, 8, 11]]]],
]
// Close voicing: every pitch class once between C4 and B4, so neighbouring chords move by small steps
const voicing = pcs => pcs.map(pc => 60 + pc).sort((a, b) => a - b)
const VEL = { x: 0.8, g: 0.35, t: 0.7, u: 0.7, L: 0.7 }

const S = globalThis.housePianoLab ??= { val: {}, solo: -1, alt: SOUNDS.map(() => false), riff: 0, prog: 0 }
SOUNDS.forEach((c, i) => {
  S.val[5 + i] ??= i === 1 ? 0.8 : 0
  c.knobs.forEach(([, start], r) => { S.val[13 + 8 * r + i] ??= start })
})
S.val[12] ??= 0.6; S.val[20] ??= 0.3; S.val[28] ??= 0.2
const knobVals = i => SOUNDS[i].knobs.map(([, , map], r) => map(S.val[13 + 8 * r + i]))
const bpm = 124
const swingPct = () => 0.5 + 0.2 * S.val[20]

const hasPage = typeof document !== 'undefined'
const isLCXL = port => /LCXL|Launch Control/i.test(port.name) && !/DAW/i.test(port.name)
const access = hasPage && navigator.requestMIDIAccess ? await navigator.requestMIDIAccess() : null
if (access && globalThis.knobsSyncedFor !== 'house-piano-lab') {
  const out = [...access.outputs.values()].find(isLCXL)
  if (out) {
    for (let cc = 13; cc <= 36; cc++) out.send([0xBF, cc, Math.round((S.val[cc] ?? 0) * 127)])
    globalThis.knobsSyncedFor = 'house-piano-lab'
  }
}
let statusBox = hasPage ? document.getElementById('board-status') : null
if (hasPage && !statusBox) {
  statusBox = document.createElement('pre')
  statusBox.id = 'board-status'
  statusBox.style.cssText = 'position:fixed;right:12px;bottom:12px;z-index:1000;margin:0;padding:8px 12px;' +
    'background:rgba(0,0,0,.75);color:#eee;font:13px/1.5 monospace;border-radius:6px;pointer-events:none'
  document.body.appendChild(statusBox)
}
const showStatus = () => {
  if (!statusBox) return
  const [pname, chords] = PROGS[S.prog]
  statusBox.textContent = [
    'Riff ' + RIFFS[S.riff][0] + ' · ' + pname + ': ' + chords.map(c => c[0]).join(' – ') + ' · ' + bpm + ' BPM',
    'Swing ' + Math.round(swingPct() * 100) + ' % · Humanize ' + Math.round(S.val[28] * 100) + ' · Kontext ' + Math.round(S.val[12] * 100),
    ...SOUNDS.map((c, i) => (i + 1) + (S.solo === i ? ' SOLO ' : S.solo >= 0 ? '  --  ' : '      ') + c.name.padEnd(22) +
      ('Pegel ' + Math.round(S.val[5 + i] * 100)).padEnd(10) +
      c.knobs.map(([label, , , fmt], r) => (label + ' ' + fmt(knobVals(i)[r])).padEnd(16)).join('') + (S.alt[i] ? c.alt : '')),
  ].join('\n')
}
const onMidi = e => {
  const [status, cc, value] = e.data
  if ((status & 0xf0) !== 0xb0) return
  if (cc >= 5 && cc <= 36) S.val[cc] = value / 127
  else if (value === 0) return
  else if (cc >= 37 && cc <= 43) S.solo = S.solo === cc - 37 ? -1 : cc - 37
  else if (cc >= 45 && cc <= 51) S.alt[cc - 45] = !S.alt[cc - 45]
  else if (cc === 44) S.riff = (S.riff + 1) % RIFFS.length
  else if (cc === 52) S.prog = (S.prog + 1) % PROGS.length
  else return
  showStatus()
}
if (access) for (const input of access.inputs.values()) {
  if (!isLCXL(input)) continue
  if (globalThis.boardListener) input.removeEventListener('midimessage', globalThis.boardListener)
  input.addEventListener('midimessage', onMidi)
}
globalThis.boardListener = onMidi
showStatus()

// 16 steps per bar; fn(step, bar, k) returns events; swing moves the odd 16ths late, each step is computed from its
// own number, so a late event is found by the query it falls into (no doubles, nothing lost)
const grid = fn => new Pattern(state => {
  const b0 = state.span.begin.valueOf(), e0 = state.span.end.valueOf(), out = []
  const late = k => ((k % 2) + 2) % 2 === 1 ? 2 * (swingPct() - 0.5) : 0   // in 16ths
  for (let k = Math.floor(b0 * 16) - 1; k < e0 * 16 - 1e-9; k++) {
    const t = (k + late(k)) / 16
    if (t < b0 - 1e-9 || t >= e0 - 1e-9) continue
    for (const { dur = 2, ...v } of fn(((k % 16) + 16) % 16, Math.floor(k / 16), k) ?? [])
      out.push(new Hap(new TimeSpan(t, t + dur / 16), new TimeSpan(t, Math.min(t + dur / 16, e0)), v, {}))
  }
  return out
})
const chordOf = bar => PROGS[S.prog][1][((bar % 4) + 4) % 4]

const piano = grid((step, bar, k) => {
  const sym = RIFFS[S.riff][1][(bar % 2) * 16 + step]
  if (sym === '.') return
  const [, root, pcs] = chordOf(bar), notes = voicing(pcs), top = notes[notes.length - 1]
  const above = notes.map(n => n + 12).find(n => n > top) ?? top + 12
  const g = VEL[sym] * (1 - S.val[28] * 0.5 * hash(k, 3))
  return SOUNDS.flatMap((c, i) => {
    const level = S.val[5 + i]
    if (level <= 0 || (S.solo >= 0 && S.solo !== i)) return []
    const [lpf, room, len] = knobVals(i), alt = S.alt[i]
    let play = sym === 't' ? [top] : sym === 'u' ? [above] : sym === 'L' ? [36 + root, 48 + root] : notes
    if (i === 0 && alt && (sym === 'x' || sym === 'g')) play = [...play, top + 12]
    return play.flatMap(n => c.voice(n, g, alt, len)).map(v => ({ ...v, cutoff: lpf, room, roomsize: 2, orbit: 2, postgain: level }))
  })
})
// Context: a dry house loop (909 kick, off-beat open hat, clap on 2 and 4, quiet shaker, bass on the root off-beats)
const context = grid((step, bar) => {
  const l = S.val[12]
  if (l <= 0) return
  const out = [], root = chordOf(bar)[1]
  if (step % 4 === 0) out.push({ s: 'bd', bank: 'RolandTR909', gain: 0.6, decay: 0.25, sustain: 0 })
  if (step % 4 === 2) out.push({ s: 'oh', bank: 'RolandTR909', gain: 0.3, decay: 0.12, sustain: 0 })
  if (step === 4 || step === 12) out.push({ s: 'cp', bank: 'RolandTR909', gain: 0.5 })
  out.push({ s: 'sh', bank: 'RolandTR727', n: 1, gain: step % 2 ? 0.35 : 0.2 })
  if (step % 4 === 2) out.push({ s: 'triangle', note: 33 + ((root - 9 + 12) % 12), gain: 0.4, decay: 0.15, sustain: 0.3, release: 0.05, cutoff: 900 })
  return out.map(v => ({ ...v, postgain: l, orbit: 1 }))
})
setcpm(bpm / 4)

stack(piano, context).filterValues(v => (v.gain ?? 1) * (v.postgain ?? 1) > 0)
