
// --- CHAPTER 1: ISOLATION STEMS ---

// kick 0
$: note("c1 ~ <~ c1> ~").s("sine")
  .penv(14).pdecay(0.04).decay(0.9).sustain(0)
  .lpf(70)
  .gain(saw.range(0, 0.85).slow(16))
  .orbit(0)

// bass 1
$: note("<[c2, g2, d3] [c2, eb2, bb3] [f2, c3, g3] [c2, g2, d3]>")
  .s("sawtooth").lpf(sine.range(800, 1800).slow(3))
  // .slow(saw.range(8, 1).slow(32))
  .attack(2.0)
  .release(1.0)
  .room(0.5)
  .gain(0.4)
  .orbit(1)

// hats 2
$: stack(
  s("hh*8").bank("RolandTR909")
    .gain(0.68)
    .hpf("11500")
    .swingBy(1/6, 4))
    .orbit(2)

// percussion 3/4

// lead 5/6
$: note("<[~ g5] ~ [~ eb6] ~ [bb5 ~] ~ [~ c6]>")
  .s("sine").decay(0.22).sustain(0)
  .delay(0.65).delaytime(0.375).delayfeedback(0.65)
  .gain(1.0)
  .room(0.75)
  .orbit(5)

// texture 7
$: s("crackle*8")
  .degradeBy(0.45)
  .hpf(7500)
  .pan(sine.range(0.15, 0.85).slow(12))
  .gain(0.14)
  .orbit(7)