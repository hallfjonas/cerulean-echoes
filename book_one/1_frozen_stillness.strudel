// ╔═══════════════════════════════════════════════════════════════════════╗
// ║ CHAPTER 1: FROZEN STILLNESS (Final Proposed Scene)                     ║
// ║ Mood: Isolation · Suspended Grief · Quiet Emptiness                   ║
// ║ Character: Sparse, Cold, Wide Spatial Field                           ║
// ╚═══════════════════════════════════════════════════════════════════════╝

setcpm(120/4)

// 1. Subterranean Pulse (Suspended Sub-Thud)
const sub_pulse = note("c1 ~ ~ ~").s("sine")
  .penv(12).pdecay(0.04).decay(0.8).sustain(0)
  .lpf(70).gain(0.7)

// 2. Glacial Cold Pad Drone (Open C Minor Void)
const cold_pad = note("<[c2, g2, d3] [c2, eb2, bb3]>")
  .s("sawtooth")
  .lpf(sine.range(180, 450).slow(16))
  .lpq(2)
  .attack(3.0).release(4.0)
  .room(0.85).roomsize(0.9)
  .gain(0.35)

// 3. Isolated Ice Clicks & Crackle (Spatial Organic Texture)
const ice_crackle = s("crackle*4")
  .degradeBy(0.4)
  .hpf(8000)
  .pan(sine.range(0.2, 0.8).slow(8))
  .gain(0.12)

// 4. Distant High Resonances (Sparse Crystalline Echoes)
const ice_resonances = note("<[~ g5] [~ ~ eb6 ~] [bb5 ~] ~>")
  .s("sine")
  .decay(0.2).sustain(0)
  .delay(0.6).delaytime(0.375).delayfeedback(0.6)
  .room(0.7)
  .gain(0.18)

// FULL CHAPTER 1 STACK
stack(
  sub_pulse,
  cold_pad,
  ice_crackle,
  ice_resonances
)