// ============================================================
// BASS BOARD: eight bass sounds side by side, playing rhythmic basslines, to compare and layer
// ============================================================
// Launch Control XL 3, the same custom mode as the drum board (MIDI channel 16): column N = bass sound N
// knob row 1 = note length (CC 13-20), row 2 = lowpass (21-28), row 3 = reverb (29-36), fader = level (5-12)
// button row 1 = bassline (37-44), button row 2 = octave (45-52); both momentary, each press steps on
// All columns start on the same bassline, so they can be layered; different basslines on two columns clash.
const cc = await midin()

// The knobs are endless encoders that keep their own position, so the first turn would jump from the default
// in the code to that position. Instead, tell the controller where the knobs start, so the board starts
// on a short, round bass: notes 0.25 s long, lowpass 250 Hz, a little reverb. Once per page load and track,
// so re-evaluating while playing doesn't reset the knobs.
const isLCXL = port => /LCXL|Launch Control/i.test(port.name) && !/DAW/i.test(port.name)
const access = await navigator.requestMIDIAccess()
const START = { length: 68, lowpass: 37, reverb: 19 }
if (globalThis.knobsSyncedFor !== 'bass') {
  const out = [...access.outputs.values()].find(isLCXL)
  if (out) {
    for (let i = 0; i < 8; i++) {
      out.send([0xBF, 13 + i, START.length])    // 0xBF = control change on channel 16
      out.send([0xBF, 21 + i, START.lowpass])
      out.send([0xBF, 29 + i, START.reverb])
    }
    globalThis.knobsSyncedFor = 'bass'
  }
}

const bpm = 118
setcpm(bpm / 4)

// Basslines (button row 1), all in A minor, one bar = 16 sixteenths
const BASSLINES = [
  "<[~ a1]*4 [~ a1]*4 [~ f1]*4 [~ g1]*4>",              // 1  offbeat: on the "and" between the kicks, the classic house/techno bass
  "[~ a1 a1 a1]*4",                                     // 2  rolling: three sixteenths after each kick
  "[a1 a2]*4",                                          // 3  octave eighths: root and octave alternate
  "<[a1 ~ ~ a1 ~ ~ a2 ~ ~ ~ a1 ~ c2 ~ g1 ~] [a1 ~ ~ a1 ~ ~ a2 ~ ~ ~ f1 ~ e1 ~ g1 ~]>",  // 4  syncopated groove
]
const OCTAVES = ['normal', '+1 Okt.']   // single quotes: Strudel parses double-quoted strings as mini notation

// Status box at the bottom right of the page: which bassline and octave each column plays.
// The drum board uses the same box and listener, so switching tracks on one page replaces them.
const SOUNDS = ['Sinus', 'Dreieck', 'Saw warm', 'Square', 'Supersaw', 'FM', 'Sub+Okt.', 'Pluck']
const status = SOUNDS.map(() => ({ line: 0, octave: 0 }))
let statusBox = document.getElementById('board-status')
if (!statusBox) {
  statusBox = document.createElement('pre')
  statusBox.id = 'board-status'
  statusBox.style.cssText = 'position:fixed;right:12px;bottom:12px;z-index:1000;margin:0;padding:8px 12px;' +
    'background:rgba(0,0,0,.75);color:#eee;font:13px/1.5 monospace;border-radius:6px;pointer-events:none'
  document.body.appendChild(statusBox)
}
const showStatus = () => {
  statusBox.textContent = status.map(({ line, octave }, i) =>
    (i + 1) + ' ' + SOUNDS[i].padEnd(10) + 'Line ' + (line + 1) + '  ' + OCTAVES[octave]
  ).join('\n')
}
showStatus()

// Buttons: read straight from the MIDI input, so every press counts at once.
// Each press (value > 0) steps on; the release (0) is ignored. Re-evaluating replaces the old listener.
const onButton = e => {
  const [statusByte, num, value] = e.data
  if ((statusByte & 0xf0) !== 0xb0 || value === 0) return
  if (num >= 37 && num <= 44) status[num - 37].line = (status[num - 37].line + 1) % BASSLINES.length
  else if (num >= 45 && num <= 52) status[num - 45].octave = (status[num - 45].octave + 1) % OCTAVES.length
  else return
  showStatus()
}
for (const input of access.inputs.values()) {
  if (!isLCXL(input)) continue
  if (globalThis.boardListener) input.removeEventListener('midimessage', globalThis.boardListener)
  input.addEventListener('midimessage', onButton)
}
globalThis.boardListener = onButton

// cc() reads 0 until a control has been moved. knob() returns def until then.
const knob = (n, def) => {
  let moved = false
  return cc(n).fmap(v => {
    if (v !== 0) moved = true
    return moved ? v : def
  })
}

// One column: makeSound gets the note pattern and returns the voice; the column adds the shared controls.
// Length:  50 ms .. 1 s (exponential): how long each note rings. Short = tight and punchy, long = notes run into each other.
// Lowpass: 80 Hz .. 4 kHz (exponential), with a little resonance. Low = dark and round, high = bright and buzzy.
//          A pure sine has no overtones to filter, so on column 1 this knob does nothing.
// Reverb:  dry .. medium, in a growing room. Each column has its own orbit (= own reverb).
// trim:    rough loudness match between the sounds (bright waveforms are louder at the same gain)
const column = (i, makeSound, trim = 1) => {
  const length  = knob(13 + i, START.length / 127).fmap(v => 0.05 * Math.pow(20, v))
  const lowpass = knob(21 + i, START.lowpass / 127).fmap(v => 80 * Math.pow(50, v))
  const reverb  = knob(29 + i, START.reverb / 127)
  const line    = signal(() => status[i].line)
  const octave  = signal(() => status[i].octave * 12)
  const notes   = line.pick(BASSLINES.map(l => note(l))).trans(octave)
  return makeSound(notes)
    .attack(0.005)
    .decay(length)
    .sustain(0)
    .release(0.05)
    .lpf(lowpass)
    .lpq(3)
    .room(reverb.mul(0.5))
    .roomsize(reverb.range(0.5, 4))
    .orbit(i + 1)
    .postgain(cc(5 + i).mul(trim))
}

// 1  Sine: the purest and softest, only the fundamental. Felt more than heard on small speakers.
const col1 = column(0, n => n.s("sine"), 1)
// 2  Triangle: like the sine plus a few soft overtones, so it stays audible on small speakers (example B)
const col2 = column(1, n => n.s("triangle"), 0.9)
// 3  Warm saw: a sawtooth, rich in overtones; with the lowpass mostly closed it sounds like a warm analog bass
const col3 = column(2, n => n.s("sawtooth").lpq(1), 0.5)
// 4  Square: hollow and woody, a bit like a clarinet when the lowpass opens
const col4 = column(3, n => n.s("square"), 0.45)
// 5  Supersaw: several detuned saws, wide and shimmering, a pad bass
const col5 = column(4, n => n.s("supersaw").unison(5).detune(0.15), 0.35)
// 6  FM: a sine modulated by another sine, a soft, slightly glassy growl
const col6 = column(5, n => n.s("sine").fm(1.2).fmh(1), 0.7)
// 7  Sub + octave: sine for the depth plus a quiet triangle an octave up, so the bass is heard everywhere
const col7 = column(6, n => stack(n.s("sine"), n.s("triangle").trans(12).gain(0.4)), 0.8)
// 8  Pluck: a sawtooth whose filter snaps open at each note and closes again (filter envelope), a squelchy bass
const col8 = column(7, n => n.s("sawtooth").lpenv(4).lpattack(0.005).lpdecay(0.15).lpsustain(0), 0.5)

stack(col1, col2, col3, col4, col5, col6, col7, col8)
