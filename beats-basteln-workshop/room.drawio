        <mxCell id="c25" value="v5 – real device sizes: P1/P4 (facing each other) each own a Launch Control XL3, P2/P3 share the Launchkey 25 MK4 at the table end (1 m = 200 px)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120.0" y="20.0" width="1100.0" height="30.0" as="geometry" />
        </mxCell>
