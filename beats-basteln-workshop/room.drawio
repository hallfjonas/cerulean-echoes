          <mxGeometry x="70.0" y="120.0" width="30.0" height="740.0" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
