        <mxCell id="c31" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="330.0" y="853.0" width="240.0" height="14.0" as="geometry" />
