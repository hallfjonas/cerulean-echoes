          <mxGeometry x="330.0" y="853.0" width="240.0" height="14.0" as="geometry" />
        </mxCell>
        <mxCell id="c32" value="Window (centred, width assumed ~1.2 m)" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300.0" y="870.0" width="300.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="" style="rounded=0;html=1;fillColor=#4a90d9;strokeColor=#4a90d9;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="120.0" y="950.0" width="40.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="c34" value="" style="rounded=0;html=1;fillColor=#e67e22;strokeColor=#e67e22;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="165.0" y="950.0" width="40.0" height="22.0" as="geometry" />
        </mxCell>
        <mxCell id="c35" value="&lt;b&gt;Good-sound band&lt;/b&gt; of speaker A (blue) and B (orange): ±30° around each speaker's axis (LP-6 V2 listening window, flat response). The LP-6 is specified for 120° coverage, so up to ±60° is still usable but gets duller. &lt;b&gt;Darker overlap = stereo sweet zone.&lt;/b&gt; Speakers are toed-in towards the centre of the group." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="215.0" y="940.0" width="565.0" height="60.0" as="geometry" />
        </mxCell>
        <mxCell id="c36" value="&lt;b&gt;v5 – feedback incorporated&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#10;&lt;b&gt;Device sizes (top view, to scale):&lt;/b&gt; Launchkey 25 MK4 46.1 × 25.1 cm, Launch Control XL3 25.0 × 23.9 cm (heights 7.9 / 4.3 cm don't matter in plan view). Figures 45 cm Ø.&lt;br&gt;&lt;br&gt;&#10;&lt;b&gt;Who controls what:&lt;/b&gt;&lt;br&gt;&#10;• P1 (north) and P4 (south) face each other across the table and each have their own LC XL3 right in front of them, flush with the table edge.&lt;br&gt;&#10;• The LK lies across the east end of the table with its keys (white strip) facing east, towards P2 and P3, who stand side by side at the short end and share it.&lt;br&gt;&#10;• The 2i2 and the MacBook stay on the table towards the west; the screens are further west.&lt;br&gt;&lt;br&gt;&#10;&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse:collapse;font-size:11px;&quot;&gt;&#10;&lt;tr&gt;&lt;th&gt;Metric&lt;/th&gt;&lt;th&gt;v4&lt;/th&gt;&lt;th&gt;v5&lt;/th&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;Max distance between players&lt;/td&gt;&lt;td&gt;1.30 m&lt;/td&gt;&lt;td&gt;&lt;b&gt;1.00 m&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;Avg distance between players&lt;/td&gt;&lt;td&gt;0.94 m&lt;/td&gt;&lt;td&gt;&lt;b&gt;0.72 m&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;P1 → own LC / P4 → own LC&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;0.11 m / 0.11 m&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;P2 → LK / P3 → LK&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;0.08 m / 0.08 m&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;P1/P4 → other LC&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;0.65 m&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;P1 / P4 → LK&lt;/td&gt;&lt;td&gt;–&lt;/td&gt;&lt;td&gt;0.31 m / 0.31 m&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;Speaker distance / spacing&lt;/td&gt;&lt;td&gt;1.4 m / 1.25 m&lt;/td&gt;&lt;td&gt;1.46 m / 1.24 m&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;Stereo angle at group centre&lt;/td&gt;&lt;td&gt;54°&lt;/td&gt;&lt;td&gt;50°&lt;/td&gt;&lt;/tr&gt;&#10;&lt;tr&gt;&lt;td&gt;Max off-axis angle of a player&lt;/td&gt;&lt;td&gt;28°&lt;/td&gt;&lt;td&gt;&lt;b&gt;21°&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&#10;&lt;/table&gt;&lt;br&gt;&#10;distances are from the player's centre to the nearest edge of the device.&lt;br&gt;&lt;br&gt;&#10;&lt;b&gt;Speakers:&lt;/b&gt; unchanged by this step, since the player positions did not move (A 335°, B 25°, toed-in to the group centre, already as far apart as the Schrank allows). Stereo angle ~50° (ideal ~60°), all players within ±21° of both axes. Tilt the LP-6 down ~24° (speakers ≈ 2.3 m high)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f9f9f9;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="830.0" y="120.0" width="440.0" height="740.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
