{
  "name": "cerulean-echoes-tools",
  "private": true,
  "type": "module",
  "description": "Tools for the tracks: tests, the player, SuperCollider checks, sound lab",
  "scripts": {
    "verify-sc": "node verify/verify-sc.mjs",
    "path-lint": "node path-lint.mjs",
    "track-map": "node track-map.mjs",
    "test": "node --test --test-concurrency=1 'trajectory/*.test.mjs' 'sc-test/*.test.mjs' 'stems/*.test.mjs' 'sound-lab/*.test.mjs' 'launcher/*.test.mjs'",
    "check-stems": "node stems/check-stems.mjs",
    "stems": "node stems/stems.mjs",
    "sample-lab": "node sound-lab/sample-lab.mjs",
    "stem-lab": "node sound-lab/stem-lab.mjs",
    "launcher": "bash launcher/build.sh"
  }
}
