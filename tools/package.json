{
  "name": "cerulean-echoes-tools",
  "private": true,
  "type": "module",
  "description": "Offline checks for the Strudel tracks: equivalence/CPU test, per-stem loudness, LC XL 3 layout sheets",
  "scripts": {
    "postinstall": "node strudel-sim/patch-core.mjs",
    "compare": "node strudel-sim/compare.mjs",
    "measure": "node strudel-sim/measure.mjs",
    "layouts": "node lcxl-layout/gen-layout.mjs ../tracks/*.strudel ../sound-samples/*.strudel",
    "watch": "node lcxl-layout/watch.mjs"
  },
  "dependencies": {
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/tonal": "1.2.6",
    "node-web-audio-api": "2.2.0",
    "superdough": "1.3.0"
  }
}
