{
  "name": "cerulean-echoes-tools",
  "private": true,
  "type": "module",
  "description": "Offline checks for the Strudel tracks: equivalence/CPU test, per-stem loudness",
  "scripts": {
    "postinstall": "node strudel-sim/patch-core.mjs",
    "compare": "node strudel-sim/compare.mjs",
    "measure": "node strudel-sim/measure.mjs",
    "set": "node set/make-set.mjs && node set/check-set.mjs 2",
    "continuum": "node set/check-continuum.mjs",
    "verify": "node verify/verify.mjs",
    "path-lint": "node path-lint.mjs",
    "track-map": "node track-map.mjs",
    "scenario": "node strudel-sim/scenario.mjs",
    "audibility": "node strudel-sim/audibility.mjs",
    "shared": "node shared/sync.mjs",
    "test": "node --test 'trajectory/*.test.mjs' 'producer/*.test.mjs' 'sc-test/*.test.mjs' 'stems/*.test.mjs' 'sound-lab/*.test.mjs'",
    "check-stems": "node stems/check-stems.mjs",
    "sample-lab": "node sound-lab/sample-lab.mjs",
    "producer": "node producer/make-track.mjs"
  },
  "dependencies": {
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "node-web-audio-api": "2.2.0",
    "superdough": "1.3.0"
  }
}
