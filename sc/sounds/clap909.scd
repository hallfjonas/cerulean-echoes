// Clap: the TR-909 clap, rim shot and snare (tidal-drum-machines, sc/samples/CREDITS.md) on the sampler voice sdSample.
~ce.loadSound(\sdSample).copy.putAll((name: \clap909, role: \clap,
	about: "TR-909 clap, rim and snare on the sdSample voice",
	files: ["tr909/cp-00.wav", "tr909/rim-00.wav", "tr909/sd-00.wav"]))
