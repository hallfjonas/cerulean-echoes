{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "track.schema.json",
  "title": "Stem track (format 1)",
  "description": "Stem versions on the 14 LC slots plus the track-wide frame. See docs/features/stems.md.",
  "type": "object",
  "required": ["format", "name", "about", "tempo", "genre", "frame", "chapters", "slots"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": 1 },
    "name": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "about": { "type": "string", "minLength": 1, "maxLength": 60 },
    "tempo": { "type": "number", "minimum": 40, "maximum": 200 },
    "swing": { "type": "number", "minimum": 0, "maximum": 1 },
    "genre": { "enum": ["ambient", "ambient-house", "house", "techno", "groove-techno", "edm", "classical", "rock"] },
    "frame": { "type": "string", "pattern": "^[A-Za-z0-9-]+\\.scd$" },
    "chapters": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 20 }
    },
    "slots": {
      "type": "object",
      "propertyNames": { "pattern": "^[12]:[1-7]$" },
      "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9]+/[a-z0-9-]+\\.stem$" }
    }
  }
}
