// .lpenv(x * 9).lps(.2).lpd(.12)

scale("dorian")

register('acidenv', (x, pat) => pat
  .lpf(100)       // Basisfrequenz des Filters
  .lpenv(x * 9)   // Filterhüllkurve (Envelope) basierend auf Eingabe x
  .lps(0.2)       // Sustain (Haltezeit)
  .lpd(0.12)      // Decay (Abklingzeit)
  .lpq(2)         // Q-Faktor (Resonanz) für spitze Filterkurven
)   

setcps(.54) // gentle, floating tempo

$: n("<0 4 0 9 7 5 <3 2 1 0> 9 7 5 <3 2 1 4> -1>*12").scale("dorian").trans(24).orbit(1).sound("sawtooth").acidenv(.4).pianoroll()
// $: n("<0 4 0 9 7 5 <3 2 1 0> 9 7 5 <3 2 1 4> -1>*12").scale("dorian").trans(19).orbit(1).sound("sawtooth").acidenv(.4).pianoroll()
